  "ingredients": [
    {
      "name": "1 磅新鲜碎猪肉香肠",
      "amount": ""
    },
    {
      "name": "3 汤匙洋葱碎",
      "amount": ""
    },
    {
      "name": "0.5 茶匙大蒜粉",
      "amount": ""
    },
    {
      "name": "0.25 茶匙黑胡椒粉",
      "amount": ""
    },
    {
      "name": "1 杯加工奶酪酱",
      "amount": ""
    },
    {
      "name": "16 盎司鸡尾酒黑麦面包",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "在一个大煎锅中，用中火煮香肠，直至其变成棕色并煮熟。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将洋葱、大蒜粉、黑胡椒和加工奶酪放入煎锅中搅拌。搅拌直至奶酪融化并且成分充分混合。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将 1 汤匙混合物涂抹在每片鸡尾酒黑麦上。趁热食用。"
    }
  ],
