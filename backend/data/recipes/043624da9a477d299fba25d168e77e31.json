    "World"
  ],
  "difficulty": 1,
  "time_cost": 85,
  "cover_image": "images/a8894ca3344b1926f94a54f907e65561.webp",
  "nutrition_tip": "这个甜的烤库格尔食谱是用杏花蜜、嫩鸡蛋面、……",
  "ingredients": [
    {
      "name": "1 包（8 盎司）宽鸡蛋面",
      "amount": ""
    },
    {
      "name": "0.5 杯白糖",
      "amount": ""
    },
    {
      "name": "0.25 杯黄油，软化",
      "amount": ""
    },
    {
      "name": "3 个鸡蛋，打散",
      "amount": ""
    },
    {
      "name": "1 包（3 盎司）奶油干酪，软化",
      "amount": ""
    },
    {
      "name": "1 茶匙香草精",
      "amount": ""
    },
    {
      "name": "1 杯杏花蜜",
      "amount": ""
    },
    {
      "name": "1 杯牛奶",
      "amount": ""
    },
    {
      "name": "0.5 杯金色葡萄干",
      "amount": ""
    },
    {
      "name": "1.5 杯玉米片面包屑",
      "amount": ""
    },
    {
      "name": "1 茶匙肉桂粉",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 350 华氏度（175 摄氏度）。在 9x9 英寸的烤盘上涂上少许油脂。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在一个大平底锅中倒入淡盐水并煮沸。将鸡蛋面煮沸，煮8至10分钟，直至咬起来又软又硬；流走。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将面条、1/2 杯糖、1/4 杯黄油、鸡蛋、奶油干酪和 1 茶匙香草精放入碗中；加入杏花蜜和牛奶。加入葡萄干搅拌直至均匀分布。将混合物转移到准备好的烤盘中。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将玉米片屑、剩余的 1/4 杯糖、剩余的 1/2 杯黄油、剩余的 1 茶匙香草精和肉桂放入碗中混合；铺在鸡蛋面条混合物上。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "在预热的烤箱中烘烤约 45 分钟，直至起泡并呈浅棕色。"
    }
  ],
