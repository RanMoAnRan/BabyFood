{
  "id": "f49a50263f2f94286f7fbeb2ae966e33",
  "title": "新月形苹果派",
  "min_age_month": 12,
  "tags": [
    "Dessert",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 25,
  "cover_image": "images/87477adb9c10ad36d42d15c4d22179e8.webp",
  "nutrition_tip": "这个带有新月形卷皮的苹果派配方是用青苹果苹果制成的……",
  "ingredients": [
    {
      "name": "1 个小青苹果，去皮，去核，切成 8 片（1/2 英寸）片",
      "amount": ""
    },
    {
      "name": "3 汤匙黄油，融化",
      "amount": ""
    },
    {
      "name": "1 罐（8 盎司）Pillsbury® 冷藏新月形餐卷",
      "amount": ""
    },
    {
      "name": "0.33333334326744 杯包装红糖",
      "amount": ""
    },
    {
      "name": "1 茶匙苹果派香料",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 375 华氏度（190 摄氏度）。在饼干片上铺上羊皮纸。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将苹果片与 1 ½ 汤匙融化的黄油放入碗中，搅拌均匀；放在一边。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将月牙卷面团分成8个三角形。将红糖和苹果派香料混合在一个小碗中；均匀地撒在三角形上。在每个三角形上放 1 个苹果片。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将面团包裹在苹果片上，从每个三角形的长边开始；放在准备好的饼干片上。刷上卷好的三角形，涂上剩余的 1 ½ 汤匙融化的黄油。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "在预热的烤箱中烘烤 10 至 12 分钟，直至呈深金黄色且苹果变软。冷却 5 分钟后即可享用。"
    }
  ],
