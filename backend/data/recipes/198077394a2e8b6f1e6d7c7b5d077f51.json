{
  "id": "198077394a2e8b6f1e6d7c7b5d077f51",
  "title": "白巧克力澳洲坚果饼干",
  "min_age_month": 12,
  "tags": [
    "Dessert",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 45,
  "cover_image": "images/1657559af8ae483c500a92020c99617e.webp",
  "nutrition_tip": "这些白巧克力澳洲坚果饼干上镶嵌着巧克力片和……",
  "ingredients": [
    {
      "name": "1 杯黄油，软化",
      "amount": ""
    },
    {
      "name": "0.75 杯包装淡红糖",
      "amount": ""
    },
    {
      "name": "0.5 杯白糖",
      "amount": ""
    },
    {
      "name": "2 个鸡蛋",
      "amount": ""
    },
    {
      "name": "0.5 茶匙香草精",
      "amount": ""
    },
    {
      "name": "0.5 茶匙杏仁提取物",
      "amount": ""
    },
    {
      "name": "2.5 杯通用面粉",
      "amount": ""
    },
    {
      "name": "1 茶匙小苏打",
      "amount": ""
    },
    {
      "name": "0.5 茶匙盐",
      "amount": ""
    },
    {
      "name": "1 杯粗切碎的澳洲坚果",
      "amount": ""
    },
    {
      "name": "1 杯粗碎白巧克力",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。将烤箱预热至 350 华氏度（175 摄氏度）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将黄油、红糖和白糖放入一个大碗中，用电动搅拌机搅拌至松软。一次打入一个鸡蛋，然后加入香草精和杏仁精搅拌。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将面粉、小苏打和盐放入另一个碗中。逐渐将面粉混合物搅拌到黄油混合物中直至混合。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将澳洲坚果和白巧克力拌入面团中，直至均匀分布。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将圆形勺子面团放在未抹油的饼干片上，间隔 2 英寸。轻轻地按下每个面团球，以帮助饼干在烘烤过程中均匀分布。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "放入预热好的烤箱中烘烤约10分钟至金黄色。将饼干放在烤盘上稍微冷却，然后转移到金属架上完全冷却。享受！"
    }
  ],
