  "nutrition_tip": "这个简单的 5 种成分的绿豆食谱，以新鲜的绿豆炒......",
  "ingredients": [
    {
      "name": "1 磅新鲜青豆，修剪并折成两半",
      "amount": ""
    },
    {
      "name": "3 汤匙黄油",
      "amount": ""
    },
    {
      "name": "3 瓣大蒜，切碎",
      "amount": ""
    },
    {
      "name": "0.125 茶匙柠檬胡椒调味料，或更多调味料",
      "amount": ""
    },
    {
      "name": "加盐调味",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将青豆放入大煎锅中，盖上水；煮沸。将热量调至中低，煮 3 至 5 分钟，直至豆子开始软化。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "沥干并返回煎锅。加入黄油，搅拌 1 至 2 分钟直至融化。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "加入大蒜；煮1至2分钟，直至变软并散发出香味。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "食用前用柠檬胡椒调味料和盐调味。"
    }
  ],
