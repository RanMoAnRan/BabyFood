  ],
  "difficulty": 1,
  "time_cost": 105,
  "cover_image": "images/b5dc7810bbbc188225227b991939f393.webp",
  "nutrition_tip": "一个家庭最喜欢的南瓜雪纺派，里面有慕斯状的馅料和果酱……",
  "ingredients": [
    {
      "name": "1 汤匙无味明胶",
      "amount": ""
    },
    {
      "name": "0.25 杯冷水",
      "amount": ""
    },
    {
      "name": "4 个大巴氏灭菌鸡蛋，分开并分开",
      "amount": ""
    },
    {
      "name": "1.25 杯白糖，分开",
      "amount": ""
    },
    {
      "name": "1.25 杯南瓜泥",
      "amount": ""
    },
    {
      "name": "0.66666668653488 杯淡奶",
      "amount": ""
    },
    {
      "name": "0.5 茶匙肉桂粉",
      "amount": ""
    },
    {
      "name": "0.5 茶匙五香粉粉",
      "amount": ""
    },
    {
      "name": "0.5 茶匙肉豆蔻粉",
      "amount": ""
    },
    {
      "name": "0.25 茶匙姜粉",
      "amount": ""
    },
    {
      "name": "0.25 茶匙盐",
      "amount": ""
    },
    {
      "name": "1 个（9 英寸）准备好的全麦饼干皮",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在一个小碗中将水和明胶一起搅拌，然后静置约 5 分钟。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "同时，将蛋黄放入中火安全碗中，搅拌至浓稠。加入 1 杯糖、南瓜泥和淡奶，直至充分混合。加入肉桂、五香粉、肉豆蔻、生姜和盐；混合直至充分混合。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将碗放在双锅上，用沸水煮 15 到 20 分钟，不断搅拌，直至浓稠。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "加入明胶混合物，搅拌直至完全溶解。离火冷却 15 至 20 分钟，直至混合物变稠并用勺子滴下时形成小堆。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "当南瓜混合物冷却时，在中等玻璃、金属或陶瓷碗中搅打蛋白，直至形成软峰。逐渐加入剩余的 1/4 杯糖，继续搅拌直至形成硬性发泡。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "将冷却的南瓜混合物拌入蛋清混合物中。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "将馅料转移到全麦饼干皮上，放入冰箱冷藏直至变硬，大约需要 1 小时。"
    },
    {
      "step_index": 9,
      "img": "",
      "text": "准备好上桌后，切片即可享用！"
    }
  ],
