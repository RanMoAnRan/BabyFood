  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在一个大锅中用中火加热橄榄油。拌入洋葱，用牛至、盐、小茴香和月桂叶调味。煮并搅拌直至洋葱变软；加入芹菜、青椒、墨西哥辣椒和大蒜。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "加入青辣椒，煮至热透。拌入素食汉堡碎；把火调小，盖上锅盖，煮5分钟"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "拌入西红柿；用辣椒粉和黑胡椒调味。加入芸豆、鹰嘴豆和黑豆。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "煮沸，将火调至小火，煮 45 分钟。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "拌入玉米，继续煮5分钟即可食用。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "上菜并享用。"
    }
  ],
