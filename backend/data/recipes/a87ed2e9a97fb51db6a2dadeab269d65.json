{
  "id": "a87ed2e9a97fb51db6a2dadeab269d65",
  "title": "5 成分薄荷皮",
  "min_age_month": 12,
  "tags": [
    "Candy",
    "American",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 145,
  "cover_image": "images/7b9897395bb69e3f9a1953bfb2a3f279.webp",
  "nutrition_tip": "自制薄荷树皮很容易用半甜和白巧克力层制作......",
  "ingredients": [
    {
      "name": "8 盎司优质半甜巧克力，破碎",
      "amount": ""
    },
    {
      "name": "2 茶匙菜籽油，分开",
      "amount": ""
    },
    {
      "name": "0.5 茶匙薄荷提取物，分开",
      "amount": ""
    },
    {
      "name": "8 盎司优质白巧克力，碎成块",
      "amount": ""
    },
    {
      "name": "25 颗薄荷糖，压碎，分开",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "在 9 英寸方形平底锅上铺上羊皮纸或蜡纸，抚平皱纹。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将半甜巧克力和 1 茶匙菜籽油混合在双层锅炉的顶部，在刚刚沸腾的水中。经常搅拌，用橡皮抹刀刮擦侧面以避免烧焦，直到巧克力融化。从火上移开并加入 1/4 茶匙薄荷提取物搅拌。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将融化的巧克力倒入准备好的平底锅中，均匀铺开以覆盖底部。将 1/2 碎糖果撒在巧克力上，冷藏约 1 小时直至完全硬化。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将白巧克力和剩余的 1 茶匙菜籽油混合在双层锅炉的顶部，在刚刚沸腾的水中。经常搅拌，用橡皮抹刀刮擦侧面以避免烧焦，直到白巧克力融化。从火上移开并加入剩余的 1/4 茶匙薄荷提取物搅拌。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将融化的白巧克力倒入锅中，直接覆盖在硬化的巧克力层上；均匀分布。将剩余的碎糖撒在上面，轻轻压入。冷藏约 1 小时，直至完全硬化。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "从锅中取出，切成小块即可食用。"
    }
  ],
