{
  "id": "b72ddfc446941f0e9d42122477a501ae",
  "title": "干锅煎面包",
  "min_age_month": 12,
  "tags": [],
  "difficulty": 1,
  "time_cost": 0,
  "cover_image": "images/edaf6e4cbfd4899b52fbb71b5248d791.webp",
  "nutrition_tip": "这种纳瓦霍面包的变体使用一半全麦面粉来增加营养......",
  "ingredients": [],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "在一个大碗中，混合面粉、泡打粉和盐。搅拌均匀（或使用叉子）。加入温水和油，搅拌直至混合。如果您喜欢较硬的面包，请在撒了面粉的平面上搅拌约 10 次。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "让它休息一分钟，然后铺在轻轻喷涂的饼干片上，厚度为 1 英寸。用叉子在面团上戳洞。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在涂有油脂的煎锅中用中火烹饪，每面煎约 15 分钟。使用两个升降机可以轻松转动。"
    }
  ],
