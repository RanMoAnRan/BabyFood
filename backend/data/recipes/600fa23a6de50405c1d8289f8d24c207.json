    "American"
  ],
  "difficulty": 1,
  "time_cost": 70,
  "cover_image": "images/760266d2f8bb02f5fe7f3b7e9f846993.webp",
  "nutrition_tip": "这道哈希棕色砂锅菜是用烤箱烘烤的奶酪制成的快速而简单的舒适食品......",
  "ingredients": [
    {
      "name": "1 包（2 磅）冷冻土豆泥，解冻",
      "amount": ""
    },
    {
      "name": "1 罐（10.5 盎司）浓缩奶油鸡汤",
      "amount": ""
    },
    {
      "name": "2 杯切达干酪丝",
      "amount": ""
    },
    {
      "name": "1 罐（8 盎司）酸奶油",
      "amount": ""
    },
    {
      "name": "1 杯黄油，融化，分开",
      "amount": ""
    },
    {
      "name": "0.5 杯切碎的洋葱",
      "amount": ""
    },
    {
      "name": "0.5 茶匙盐",
      "amount": ""
    },
    {
      "name": "0.5 茶匙黑胡椒粉",
      "amount": ""
    },
    {
      "name": "1 杯碎玉米片",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。将烤箱预热至 350 华氏度（175 摄氏度）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将薯饼、切达干酪、浓缩汤、酸奶油、1/2 融化的黄油、洋葱、盐和胡椒粉放入碗中混合。将混合物转移到 9x13 英寸的烤盘中。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在上面撒上玉米片，然后淋上剩余的融化黄油。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在预热的烤箱中烘烤，直到砂锅边缘冒泡且顶部呈金黄色，1小时至1小时30分钟"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "上菜并享用！"
    }
  ],
