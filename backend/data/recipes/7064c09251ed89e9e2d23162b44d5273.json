  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将糖和橙汁放入中型平底锅中，用中火加热；搅拌直至糖溶解。添加蔓越莓；煮大约 10 分钟，偶尔搅拌，直到它们开始爆裂。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "转移到碗中；蔓越莓酱冷却后会变稠。"
