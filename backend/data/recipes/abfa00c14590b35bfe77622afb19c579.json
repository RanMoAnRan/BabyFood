  "nutrition_tip": "这些美味的香蕉饼干很软，像蛋糕一样，而且很快就会消失！该…",
  "ingredients": [
    {
      "name": "1.5 杯通用面粉",
      "amount": ""
    },
    {
      "name": "2 根中等成熟的香蕉，捣碎，或更多适量",
      "amount": ""
    },
    {
      "name": "0.5 杯白糖",
      "amount": ""
    },
    {
      "name": "0.25 杯黄油，融化",
      "amount": ""
    },
    {
      "name": "0.25 杯核桃碎",
      "amount": ""
    },
    {
      "name": "1 个大鸡蛋",
      "amount": ""
    },
    {
      "name": "1 茶匙小苏打",
      "amount": ""
    },
    {
      "name": "0.25 茶匙盐",
      "amount": ""
    },
    {
      "name": "1汤匙白糖",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将烤箱预热至 325 华氏度（165 摄氏度）。在烤盘上铺上羊皮纸。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将面粉、香蕉、1/2 杯糖、黄油、核桃、鸡蛋、小苏打和盐一起放入碗中，直至充分混合。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将 3 汤匙面团放在准备好的烤盘上，间隔约 2 到 3 英寸。将剩余的 1 汤匙糖撒在饼干上。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "在预热的烤箱中烘烤 15 至 20 分钟，直至呈金黄色且边缘凝固。"
    }
  ],
