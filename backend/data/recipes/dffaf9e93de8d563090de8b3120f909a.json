{
  "id": "dffaf9e93de8d563090de8b3120f909a",
  "title": "糖饼干糖霜",
  "min_age_month": 12,
  "tags": [
    "Dessert",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 10,
  "cover_image": "images/ecbb4025fc5b52611b9fe2c27debf764.webp",
  "nutrition_tip": "这种糖饼干糖霜制作起来又快又容易，只需 4 种简单的原料……",
  "ingredients": [
    {
      "name": "0.5 杯起酥油",
      "amount": ""
    },
    {
      "name": "4 杯糖果糖",
      "amount": ""
    },
    {
      "name": "5 汤匙牛奶，或根据需要更多",
      "amount": ""
    },
    {
      "name": "1 茶匙香草精，或更多适量",
      "amount": ""
    },
    {
      "name": "食用色素",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在一个大碗中搅拌起酥油直至呈奶油状。逐渐混合在糖果中。少量糖，与 5 汤匙牛奶交替，直至光滑。加入香草精，继续搅拌约 5 分钟，直至糖霜变得坚硬且有光泽，如果需要，可添加更多牛奶。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "加入食用色素，如果使用多种颜色，则分成较小的碗。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在饼干上涂上糖霜或填充裱花袋并根据需要装饰饼干。"
    }
  ],
