  "title": "Shorecook 腰果脆",
  "min_age_month": 12,
  "tags": [
    "Dessert",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 50,
  "cover_image": "images/01badd1ccab4c62d6068b710abea0a4a.webp",
  "nutrition_tip": "这种自制的腰果脆是用简单的原料在米中制作起来轻而易举的……",
  "ingredients": [
    {
      "name": "2 汤匙黄油，分开",
      "amount": ""
    },
    {
      "name": "1.5 杯咸腰果",
      "amount": ""
    },
    {
      "name": "1 杯白糖",
      "amount": ""
    },
    {
      "name": "0.5 杯淡玉米糖浆",
      "amount": ""
    },
    {
      "name": "1 茶匙香草精",
      "amount": ""
    },
    {
      "name": "1 茶匙小苏打",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "在烤盘上涂上一汤匙黄油。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将腰果、糖和玉米糖浆放入一个大的微波炉安全玻璃或陶瓷碗中。用微波炉加热约 6 1/2 分钟，直至糖融化且混合物变热。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将剩余的 1 汤匙黄油和香草精搅拌到腰果混合物中。用微波炉加热，再加热约 2 1/2 分钟。将小苏打加入腰果混合物中，搅拌至变轻并起泡沫。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将混合物倒入准备好的烤盘上。倾斜纸张直至其开始扩散，或根据需要使用涂有黄油的硅胶抹刀。你不必用脆片覆盖整个烤盘。冷却至凝固，约30分钟；碎。"
    }
  ],
