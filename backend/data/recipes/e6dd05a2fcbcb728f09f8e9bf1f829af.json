{
  "id": "e6dd05a2fcbcb728f09f8e9bf1f829af",
  "title": "传统施普林格",
  "min_age_month": 12,
  "tags": [
    "Dessert",
    "German"
  ],
  "difficulty": 1,
  "time_cost": 540,
  "cover_image": "images/ec77bdde380bd3ec441a32be901ddce2.webp",
  "nutrition_tip": "Springerle 饼干是一种具有数百年历史的茴香味德国圣诞饼干...",
  "ingredients": [
    {
      "name": "烹饪喷雾",
      "amount": ""
    },
    {
      "name": "1.5 汤匙 碎茴香籽",
      "amount": ""
    },
    {
      "name": "3.5 杯通用面粉",
      "amount": ""
    },
    {
      "name": "1 茶匙泡打粉",
      "amount": ""
    },
    {
      "name": "2 杯糖",
      "amount": ""
    },
    {
      "name": "4 个鸡蛋",
      "amount": ""
    },
    {
      "name": "0.5 茶匙香草精",
      "amount": ""
    },
    {
      "name": "0.25 杯糖果糖",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "用烹饪喷雾喷洒 4 个饼干片；撒上茴香籽，放在一边备用。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将面粉和泡打粉放入一个大碗中，直至充分混合。将糖、鸡蛋和香草精放入另一个大碗中；用电动搅拌器搅拌 5 至 8 分钟，直至出现浅色泡沫。将面粉混合物逐渐搅拌到鸡蛋混合物中，形成厚面团。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "一次处理一把面团，将其擀到撒有少许面粉的表面上，直至 1/4 英寸厚。轻轻筛选糖果加糖在面团上。将弹簧模具放在面团上；用力均匀地按下，直到模具的设计出现在面团中。取出模具。用小刀在每个饼干周围切开，然后将它们放在准备好的饼干片上，间隔 2 英寸。重复，直到所有面团都用完。用轻质棉布盖住饼干，晾干 8 小时或过夜。这些设计将保留在饼干中。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "准备烘烤时，将烤箱预热至 250 华氏度（120 摄氏度）。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "在预热的烤箱中烘烤饼干，直至顶部呈浅棕色且饼干凝固，需要 25 至 30 分钟。转移到金属架上完全冷却。存放在密封容器中。"
    }
  ],
