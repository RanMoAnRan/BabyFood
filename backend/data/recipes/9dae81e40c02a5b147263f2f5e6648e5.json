{
  "id": "9dae81e40c02a5b147263f2f5e6648e5",
  "title": "巧克力巧克力饼干",
  "min_age_month": 12,
  "tags": [
    "Dessert",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 25,
  "cover_image": "images/db2f3108cb8a2d8ed3c8c0dc04e0d7b0.webp",
  "nutrition_tip": "这些巧克力巧克力饼干让人无法抗拒，这要归功于双重…",
  "ingredients": [
    {
      "name": "1.5 杯白糖",
      "amount": ""
    },
    {
      "name": "1 杯黄油，软化",
      "amount": ""
    },
    {
      "name": "2 个鸡蛋",
      "amount": ""
    },
    {
      "name": "2 茶匙香草精",
      "amount": ""
    },
    {
      "name": "2 杯通用面粉",
      "amount": ""
    },
    {
      "name": "0.66666668653488 杯可可粉",
      "amount": ""
    },
    {
      "name": "0.75 茶匙小苏打",
      "amount": ""
    },
    {
      "name": "0.25 茶匙盐",
      "amount": ""
    },
    {
      "name": "2 杯半甜巧克力片",
      "amount": ""
    },
    {
      "name": "0.5 杯核桃碎",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。将烤箱预热至 350 华氏度（175 摄氏度）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在一个大碗中搅拌糖、黄油、鸡蛋和香草精，直至松软。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将面粉、可可粉、小苏打和盐放入另一个碗中；加入黄油混合物中搅拌直至充分混合。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将巧克力片和核桃放入面团中搅拌直至均匀分布。将圆形汤匙面团放在未抹油的烤盘上，间隔 2 英寸。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "在预热的烤箱中烘烤 8 到 10 分钟直至凝固。在饼干片上稍微冷却，然后转移到金属架上完全冷却。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "享受吧！"
    }
  ],
