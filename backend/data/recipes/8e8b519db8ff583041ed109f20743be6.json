  "nutrition_tip": "这个汉堡肉饼食谱结合了碎牛肉、面包屑和调味料......",
  "ingredients": [
    {
      "name": "1 个大鸡蛋",
      "amount": ""
    },
    {
      "name": "0.5 茶匙盐",
      "amount": ""
    },
    {
      "name": "0.5 茶匙黑胡椒粉",
      "amount": ""
    },
    {
      "name": "1 磅碎牛肉",
      "amount": ""
    },
    {
      "name": "0.5 杯细干面包屑",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将户外烤架预热至高温，并在烤架上涂少许油。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将鸡蛋、盐和胡椒放入一个中等大小的碗中搅拌。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "加入碎牛肉和面包屑；用手或叉子搅拌直至充分混合。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "形成四个 3/4 英寸厚的肉饼。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将肉饼放在预热的烤架上。盖上盖子，每面煮 6 至 8 分钟，或煮至所需的熟度。插入中心的即时读数温度计读数应至少为 160 华氏度（70 摄氏度）。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "趁热享用吧！"
    }
  ],
