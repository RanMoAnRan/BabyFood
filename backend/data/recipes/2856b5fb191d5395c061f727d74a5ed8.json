  "title": "最好的免烤樱桃芝士蛋糕",
  "min_age_month": 12,
  "tags": [
    "Dessert",
    "American",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 140,
  "cover_image": "images/8df21af7880c70c2f67a5c7ef3d43a9e.webp",
  "nutrition_tip": "这个免烤樱桃芝士蛋糕有全麦饼干皮和简单的樱桃派......",
  "ingredients": [
    {
      "name": "1.25 杯全麦饼干屑",
      "amount": ""
    },
    {
      "name": "0.25 杯无盐黄油，融化",
      "amount": ""
    },
    {
      "name": "0.25 杯白糖",
      "amount": ""
    },
    {
      "name": "1 包（8 盎司）奶油干酪，软化",
      "amount": ""
    },
    {
      "name": "1 杯糖粉",
      "amount": ""
    },
    {
      "name": "1 茶匙香草精",
      "amount": ""
    },
    {
      "name": "1 杯浓奶油",
      "amount": ""
    },
    {
      "name": "1罐（12.5盎司）樱桃派馅料（或您选择的其他馅料）",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "制作面包皮：将全麦饼干屑、黄油和糖放入碗中混合，直至充分混合并易碎。将混合物压入 9 英寸的馅饼盘中，尽可能压到两侧。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "制作馅料：将奶油芝士、糖粉和香草放入碗中，用电动搅拌机搅拌至光滑且可涂抹。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在冰镇的玻璃或金属碗中用电动搅拌器搅拌奶油，直至形成软峰。拌入奶油干酪混合物直至光滑。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将馅料倒入准备好的饼皮中，并用抹刀抹平顶部。冷藏约2至3小时直至变硬。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "将樱桃派馅料涂在冷冻芝士蛋糕上。立即食用或冷藏直至食用。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "享受吧！"
    }
  ],
