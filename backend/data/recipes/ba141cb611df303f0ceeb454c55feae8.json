  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将烤箱预热至 375 华氏度（190 摄氏度）。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "留出 12 到 18 块完整的姜饼。将剩余的饼干压碎，直至获得 1 1/2 杯细面包屑。保留任何剩余的 cookie 以供其他用途。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将姜饼屑、红糖和融化的黄油放入碗中混合，直至充分混合。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将混合物压入 9 英寸弹簧盘的底部。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "将整块姜饼直立放置在弹簧盘的边缘，压入底部并在必要时稍微重叠，以便它们牢固地站立。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "在预热的烤箱中烘烤约 7 分钟直至凝固。填充前将外壳完全冷却。"
    }
