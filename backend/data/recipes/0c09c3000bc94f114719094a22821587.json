  "nutrition_tip": "这种奶油玉米布丁，由整粒玉米和奶油式玉米制成，烘烤......",
  "ingredients": [
    {
      "name": "5 个大鸡蛋",
      "amount": ""
    },
    {
      "name": "0.33333334326744 杯黄油，融化并稍微冷却",
      "amount": ""
    },
    {
      "name": "0.25 杯白糖",
      "amount": ""
    },
    {
      "name": "0.5 杯牛奶",
      "amount": ""
    },
    {
      "name": "0.25 杯玉米淀粉",
      "amount": ""
    },
    {
      "name": "1 罐（15.25 盎司）整粒玉米，沥干",
      "amount": ""
    },
    {
      "name": "2 罐（14.75 盎司）奶油玉米罐头",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。将烤箱预热至 400 华氏度（200 摄氏度）。在 2 夸脱的砂锅盘上涂抹油脂。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在一个大碗中轻轻搅拌鸡蛋。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "加入牛奶、融化的黄油、糖和玉米淀粉；搅拌直至充分混合。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "加入沥干的玉米和奶油玉米，直至完全混合。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将混合物倒入准备好的砂锅中。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "在预热的烤箱中烘烤约1小时，直至顶部呈金黄色。"
    }
  ],
