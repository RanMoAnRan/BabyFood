      "name": "1 个澳洲青苹果 - 去皮、去核并切片",
      "amount": ""
    },
    {
      "name": "2.5 汤匙水",
      "amount": ""
    },
    {
      "name": "1 汤匙玉米淀粉",
      "amount": ""
    },
    {
      "name": "1.5 汤匙白糖",
      "amount": ""
    },
    {
      "name": "1 撮肉桂粉，或适量",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 350 华氏度（175 摄氏度）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将苹果片放入小烤盘中。将水和玉米淀粉放入小碗中搅拌；与苹果片一起搅拌。在上面撒上糖和肉桂粉。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在预热的烤箱中煮约 15 分钟，直至苹果变软。"
    }
  ],
