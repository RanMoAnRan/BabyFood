  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将烤箱预热至 350 华氏度（175 摄氏度）。在 9x13 英寸的烤盘上涂上油脂并撒上面粉。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "制作蛋糕：在一个大碗中将面粉、糖、小苏打和盐搅拌在一起。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "加入鸡蛋和酸奶油搅拌至光滑，然后拌入大黄。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "倒入准备好的盘子中并均匀铺开。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "制作糖粉奶油细末：在一个中等大小的碗中将糖和黄油搅拌直至光滑。加入面粉搅拌直至混合物易碎。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "将混合物撒在蛋糕上，然后撒上肉桂粉。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "在预热的烤箱中烘烤，直到插入中心的牙签拔出来时是干净的，大约需要 45 分钟。"
    },
    {
      "step_index": 9,
      "img": "",
      "text": "上菜并享用！"
    }
  ],
