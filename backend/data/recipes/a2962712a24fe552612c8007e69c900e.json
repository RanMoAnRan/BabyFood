  "nutrition_tip": "这个大黄蛋糕充满了美味、新鲜的春天大黄，上面......",
  "ingredients": [
    {
      "name": "2 杯通用面粉",
      "amount": ""
    },
    {
      "name": "1.25 杯白糖",
      "amount": ""
    },
    {
      "name": "1 茶匙小苏打",
      "amount": ""
    },
    {
      "name": "0.5 茶匙盐",
      "amount": ""
    },
    {
      "name": "2 个鸡蛋，打散",
      "amount": ""
    },
    {
      "name": "1 杯酸奶油",
      "amount": ""
    },
    {
      "name": "3 杯大黄丁",
      "amount": ""
    },
    {
      "name": "1 杯白糖",
      "amount": ""
    },
    {
      "name": "0.25 杯黄油，软化",
      "amount": ""
    },
    {
      "name": "0.25 杯通用面粉",
      "amount": ""
    },
    {
      "name": "0.25 茶匙肉桂粉，或适量",
      "amount": ""
    }
