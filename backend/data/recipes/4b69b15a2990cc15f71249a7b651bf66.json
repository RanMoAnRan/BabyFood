  "title": "焦糖脆饼方块",
  "min_age_month": 12,
  "tags": [
    "Dessert",
    "British",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 195,
  "cover_image": "images/e50a2e2988f6593e3489351ab58b8361.webp",
  "nutrition_tip": "焦糖方块（又名百万富翁的脆饼）由三层......",
  "ingredients": [
    {
      "name": "1.25 杯通用面粉",
      "amount": ""
    },
    {
      "name": "0.66666668653488 杯无盐黄油，软化",
      "amount": ""
    },
    {
      "name": "0.25 杯白糖",
      "amount": ""
    },
    {
      "name": "0.5 杯无盐黄油",
      "amount": ""
    },
    {
      "name": "0.5 杯包装淡红糖",
      "amount": ""
    },
    {
      "name": "0.5 杯甜炼乳",
      "amount": ""
    },
    {
      "name": "2 汤匙 淡玉米糖浆",
      "amount": ""
    },
    {
      "name": "1.25 杯牛奶巧克力片",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 350 华氏度（175 摄氏度）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "制作脆饼：将面粉、软化黄油和糖在一个中等大小的碗中混合，直至充分混合且易碎。压入9英寸方形烤盘的底部。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在预热的烤箱中烘烤约 20 分钟，直至表面干燥并呈浅金黄色。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "制作焦糖：将黄油、红糖、炼乳和玉米糖浆放入平底锅中，用中低火煮沸。煮沸5分钟，然后离火，用木勺剧烈搅拌约3分钟。倒在烤好的饼皮上（饼皮可以是热的也可以是凉的）。在室温下静置 2 至 3 小时，直至焦糖开始变硬。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将巧克力放入微波炉安全碗中，高火加热 1 分钟，然后搅拌并继续加热，每隔 20 秒搅拌一次，直至巧克力融化且光滑。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "将巧克力倒在焦糖层上，均匀铺开以完全覆盖。放入冰箱冷藏约 30 分钟，直至巧克力凝固。切成条。"
    }
  ],
