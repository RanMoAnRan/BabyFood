  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将烤箱预热至 400 华氏度（200 摄氏度）。将 18 个松饼杯垫上纸垫。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将蔓越莓酱、牛奶、油、鸡蛋和香草精放入碗中搅拌均匀。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将面粉、红糖、白糖、泡打粉、肉桂、豆蔻和盐放入另一个碗中搅拌。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将干成分搅拌到湿成分中，直到面糊刚好湿润。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "倒入准备好的松饼杯中。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "放入预热好的烤箱中烘烤约20分钟至金黄色。"
    }
  ],
