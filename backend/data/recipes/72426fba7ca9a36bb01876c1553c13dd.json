{
  "id": "72426fba7ca9a36bb01876c1553c13dd",
  "title": "炸火鸡胸肉",
  "min_age_month": 12,
  "tags": [
    "Dinner",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 1490,
  "cover_image": "images/d8ec4a51faf68f5e23a05115d2697e5e.webp",
  "nutrition_tip": "油炸火鸡胸肉是煎整只火鸡的好方法。这个食谱…",
  "ingredients": [
    {
      "name": "2 汤匙海盐",
      "amount": ""
    },
    {
      "name": "1 汤匙现磨黑胡椒",
      "amount": ""
    },
    {
      "name": "1 汤匙红辣椒片",
      "amount": ""
    },
    {
      "name": "1 汤匙 蒜粒",
      "amount": ""
    },
    {
      "name": "1 汤匙辣椒粉",
      "amount": ""
    },
    {
      "name": "1 块（7 磅）火鸡胸肉",
      "amount": ""
    },
    {
      "name": "2 加仑煎炸菜籽油",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将海盐、黑胡椒、红辣椒片、蒜粒和辣椒粉放入一个小罐子中。密封罐子并摇动直至调味料充分混合。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将整个香料混合物涂抹在火鸡胸肉上，将其完全覆盖。用铝箔牢牢包裹住乳房并冷藏 24 小时。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将乳房从冰箱中取出，在室温下静置约 20 分钟。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "同时，将油倒入一个足以容纳油和火鸡胸肉的有盖锅中。将油加热至 325 华氏度（165 摄氏度）。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将鸡胸肉轻轻放入油中，盖上锅盖，煎至中心不再呈粉红色且汁液清澈，大约需要 25 分钟。插入中心的即时读数温度计读数应至少为 165 华氏度（74 摄氏度）。"
    }
  ],
