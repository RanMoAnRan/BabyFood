{
  "id": "dd172638e0c10bbb3c54fa85e71a3de2",
  "title": "法式薄饼",
  "min_age_month": 12,
  "tags": [
    "Breakfast",
    "French"
  ],
  "difficulty": 1,
  "time_cost": 30,
  "cover_image": "images/2309ee0c2b22147b4ce732232951620f.webp",
  "nutrition_tip": "这些法式薄饼薄而精致，作为早餐或甜点非常美味。",
  "ingredients": [
    {
      "name": "1 杯通用面粉",
      "amount": ""
    },
    {
      "name": "1 茶匙白糖",
      "amount": ""
    },
    {
      "name": "0.25 茶匙盐",
      "amount": ""
    },
    {
      "name": "3 个鸡蛋",
      "amount": ""
    },
    {
      "name": "2 杯牛奶",
      "amount": ""
    },
    {
      "name": "2 汤匙黄油，融化",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将面粉、糖和盐筛入碗中；放在一边。在一个大碗中用电动搅拌机将鸡蛋和牛奶搅拌在一起。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "加入面粉混合物，搅拌至光滑；加入融化的黄油搅拌。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在煎锅或煎锅上涂抹少许油脂；用中高温加热。将面糊倒入或舀到烤盘上，每个薄饼使用大约 2 汤匙。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "立即旋转煎锅，将面糊摊成薄薄的一层。煮 1 到 2 分钟，直到薄饼顶部不再湿且底部变成浅棕色。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "摇动锅或用抹刀松开；将其翻转或翻转，煮至另一面变成浅棕色，再煮约 1 分钟。对剩余的面糊重复上述步骤。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "搭配您选择的馅料或配料，尽情享用吧！"
    }
  ],
