  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "用中高温加热一个大煎锅。在热煎锅中煮碎牛肉并搅拌 5 至 7 分钟，直至变成棕色且易碎。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "用洋葱粉、大蒜盐、芹菜盐和小茴香给牛肉调味。将番茄酱倒在牛肉上，搅拌均匀，小火煮约 5 分钟，直至稍微变稠。"
    }
  ],
