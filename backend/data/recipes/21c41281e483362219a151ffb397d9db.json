  "nutrition_tip": "火鸡土豆汤不一定很无聊！搭配混合蔬菜，丰富的…",
  "ingredients": [
    {
      "name": "2 杯去皮切丁的土豆",
      "amount": ""
    },
    {
      "name": "2 杯冷冻混合蔬菜",
      "amount": ""
    },
    {
      "name": "0.25 杯洋葱丁",
      "amount": ""
    },
    {
      "name": "0.25 杯芹菜丁",
      "amount": ""
    },
    {
      "name": "1 茶匙切碎的新鲜欧芹",
      "amount": ""
    },
    {
      "name": "2 杯 Swanson® 鸡汤",
      "amount": ""
    },
    {
      "name": "1.5 杯 剩下的熟火鸡丁",
      "amount": ""
    },
    {
      "name": "0.5 茶匙家禽调味料",
      "amount": ""
    },
    {
      "name": "1.5 杯脱脂半杯",
      "amount": ""
    },
    {
      "name": "0.25 杯通用面粉",
