{
  "id": "daf6c5f9476f541d5df13fa6969c5230",
  "title": "南瓜派蛋糕",
  "min_age_month": 6,
  "tags": [
    "Dessert",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 70,
  "cover_image": "images/5a93e88a0f2e80390b5a4e91e781e9ac.webp",
  "nutrition_tip": "这个南瓜派蛋糕食谱捕捉了南瓜派的所有味道，但更多......",
  "ingredients": [
    {
      "name": "1 包（15.25 盎司）黄色蛋糕粉",
      "amount": ""
    },
    {
      "name": "1 个大鸡蛋",
      "amount": ""
    },
    {
      "name": "0.5 杯人造黄油",
      "amount": ""
    },
    {
      "name": "1 罐（29 盎司）南瓜泥",
      "amount": ""
    },
    {
      "name": "0.66 杯淡奶",
      "amount": ""
    },
    {
      "name": "0.5 杯白糖",
      "amount": ""
    },
    {
      "name": "1.5 茶匙肉桂粉",
      "amount": ""
    },
    {
      "name": "1 杯红糖",
      "amount": ""
    },
    {
      "name": "0.25 杯人造黄油",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 350 华氏度（175 摄氏度）。在 9x13 英寸的平底锅上涂抹油脂并撒上面粉。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "从包装中保留 1 杯蛋糕粉；放在一边。将剩余的蛋糕粉、1 个鸡蛋和 ½ 杯融化的黄油放入碗中，直至均匀湿润；压入 9x13 英寸的平底锅中。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将剩余的 3 个鸡蛋、南瓜、淡奶、白糖和肉桂放入同一个碗中直至混合；倒在地壳上。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将保留的 1 杯蛋糕粉和红糖放入另一个碗中；用 2 刀或糕点搅拌机切入 1/4 杯黄油，直至混合物呈粗面包屑状。撒在南瓜馅上。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "在预热好的烤箱中烘烤50分钟。存放在冰箱中。"
    }
  ],
