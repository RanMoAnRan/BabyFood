{
  "id": "ce643389dcd8a5339519dbd033a1bd37",
  "title": "卡罗尔的肉桂华夫饼",
  "min_age_month": 12,
  "tags": [
    "Breakfast",
    "Brunch",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 30,
  "cover_image": "images/421b6544abfd90bcd1e671207178afb6.webp",
  "nutrition_tip": "在面糊中添加糖和肉桂有助于使这些华夫饼变得非常美味……",
  "ingredients": [
    {
      "name": "2 杯通用面粉",
      "amount": ""
    },
    {
      "name": "0.5 杯红糖",
      "amount": ""
    },
    {
      "name": "0.25 杯白糖",
      "amount": ""
    },
    {
      "name": "4 茶匙泡打粉",
      "amount": ""
    },
    {
      "name": "2.5 茶匙肉桂粉",
      "amount": ""
    },
    {
      "name": "0.25 茶匙盐",
      "amount": ""
    },
    {
      "name": "1.75 杯牛奶",
      "amount": ""
    },
    {
      "name": "0.5 杯植物油",
      "amount": ""
    },
    {
      "name": "1 茶匙香草精",
      "amount": ""
    },
    {
      "name": "2 个蛋白",
      "amount": ""
    },
    {
      "name": "烹饪喷雾",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将面粉、红糖、白糖、泡打粉、肉桂和盐一起放入碗中搅拌，直至没有结块。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将牛奶、植物油和香草精搅拌到面粉混合物中，直至面糊完全混合。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在大玻璃或金属搅拌碗中搅打蛋白，直至形成软峰。提起搅拌器或直接向上搅拌：蛋白会形成柔软的土堆，而不是尖峰。折叠成面糊。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "根据制造商的说明预热华夫饼熨斗。涂上烹饪喷雾。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "在预热的华夫饼熨斗中分批烹调，直至酥脆并呈金黄色，大约需要 2 分钟。对剩余的面糊重复上述步骤。"
    }
  ],
