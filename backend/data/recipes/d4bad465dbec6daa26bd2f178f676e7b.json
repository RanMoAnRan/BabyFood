  "nutrition_tip": "青苹果中的果胶有助于这款蔓越莓酱的搭配，并带来另一种……",
  "ingredients": [
    {
      "name": "1 包（12 盎司）新鲜蔓越莓，冲洗并分类",
      "amount": ""
    },
    {
      "name": "2 个大青苹果 - 去皮、去核、切丁",
      "amount": ""
    },
    {
      "name": "1 杯水",
      "amount": ""
    },
    {
      "name": "1 杯白糖",
      "amount": ""
    },
    {
      "name": "0.5 茶匙肉桂粉",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将蔓越莓、苹果、水、糖和肉桂放入中型平底锅中，中火加热；煮沸。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将火调至小火，煮约 20 分钟，直至蔓越莓爆裂和苹果变软。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "远离火源并完全冷却。上桌，或盖上盖子冷藏直至可以上桌。"
    }
  ],
