  "nutrition_tip": "这种快速简单的瑞典肉丸酱今晚将冷冻肉丸变成…",
  "ingredients": [
    {
      "name": "1 杯牛肉高汤",
      "amount": ""
    },
    {
      "name": "1 杯浓奶油",
      "amount": ""
    },
    {
      "name": "3 汤匙通用面粉",
      "amount": ""
    },
    {
      "name": "1汤匙酱油",
      "amount": ""
    },
    {
      "name": "0.5 茶匙黑胡椒粉，或更多适量",
      "amount": ""
    },
    {
      "name": "0.5 茶匙干迷迭香，压碎，或更多适量",
      "amount": ""
    },
    {
      "name": "10 盎司冷冻熟肉丸，解冻",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将高汤、奶油、面粉、酱油、1/2 茶匙胡椒粉和 1/2 茶匙迷迭香放入大平底锅中，用小火搅拌至光滑。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "煮约 10 分钟，偶尔搅拌，直至变稠。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "拌入解冻的肉丸，继续煮至肉丸热透，再煮约 5 分钟。插入肉丸中心的即时读数温度计读数应至少为 160 华氏度（71 摄氏度）。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "上菜前品尝并调整调味料。"
    }
  ],
