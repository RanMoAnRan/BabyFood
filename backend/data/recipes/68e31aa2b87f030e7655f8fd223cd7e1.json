  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 325 华氏度（165 摄氏度）。在 2 夸脱的烤盘上涂上大量油脂。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将苹果均匀地放在准备好的烤盘中。将 ½ 杯糖、½ 杯山核桃和肉桂放入碗中；撒在苹果上。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将剩余的 1 杯糖、面粉、泡打粉和盐放入碗中，直至充分混合。将淡奶、融化的黄油和打好的鸡蛋放入另一个碗中搅拌直至混合；加入面粉混合物中搅拌直至光滑。将面糊倒在苹果上；撒上剩余的 1/4 杯山核桃。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在预热的烤箱中烘烤55分钟。"
    }
  ],
