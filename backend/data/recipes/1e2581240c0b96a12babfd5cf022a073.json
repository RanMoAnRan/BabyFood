{
  "id": "1e2581240c0b96a12babfd5cf022a073",
  "title": "苹果冰箱泡菜",
  "min_age_month": 12,
  "tags": [
    "Condiment",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 10225,
  "cover_image": "images/73e7fbf33a3fceeb348a22e947a0f1cf.webp",
  "nutrition_tip": "这个食谱将新鲜苹果片混合在冰箱中腌制一周......",
  "ingredients": [
    {
      "name": "1 杯水",
      "amount": ""
    },
    {
      "name": "1 杯苹果醋",
      "amount": ""
    },
    {
      "name": "1 杯白糖",
      "amount": ""
    },
    {
      "name": "1 汤匙整个多香果浆果",
      "amount": ""
    },
    {
      "name": "1 汤匙整个丁香",
      "amount": ""
    },
    {
      "name": "1 汤匙 肉豆蔻粉",
      "amount": ""
    },
    {
      "name": "1 汤匙 姜末",
      "amount": ""
    },
    {
      "name": "6 个苹果 - 去皮、去核并切片",
      "amount": ""
    },
    {
      "name": "0.5 杯柠檬汁",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "检查 2 个夸脱大小的罐子是否有裂纹，环是否生锈，丢弃任何有缺陷的罐子。浸泡在沸水中，直到苹果泡菜准备好。用温肥皂水清洗新的、未使用的盖子和环。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将水、醋、糖、多香果、丁香、肉豆蔻和姜放入小锅中混合；用中高火煮沸，搅拌直至糖溶解。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "同时，将苹果和柠檬汁放入碗中；装入热的、消毒过的罐子中。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将沸腾的糖浆倒在苹果上，填充至距离顶部 1/4 英寸以内。用湿纸巾擦拭边缘以去除任何残留物。顶部盖上盖子并拧紧螺丝环。将罐子放在室温下直至冷却，大约 2 小时。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "用手指按压眼睑中心，确保眼睑不会上下移动。将罐子放入冰箱；至少等待 1 周后再打开。"
    }
  ],
