  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "在慢炖锅上涂抹少许油脂。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "混合红薯：将沥干的红薯放入一个大碗中，用土豆捣碎器捣碎直至光滑。加入融化的黄油和两种糖。加入牛奶、鸡蛋和橙汁，搅拌均匀。转移到准备好的慢炖锅中。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "制作配料：将山核桃、红糖、面粉和融化的黄油放入一个小碗中。将配料涂在红薯上。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "盖上盖子，高火煮 3 到 4 小时。"
    }
  ],
