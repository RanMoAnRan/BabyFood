{
  "id": "21526342e736207e9592f70ef2ac5cce",
  "title": "美味的南瓜面包",
  "min_age_month": 6,
  "tags": [
    "Brunch",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 70,
  "cover_image": "images/3994f8c5313e115da6a2b6baa17eaf46.webp",
  "nutrition_tip": "用新鲜南瓜和核桃（或葡萄干！）制成的南瓜面包非常美味……",
  "ingredients": [
    {
      "name": "3.25 杯通用面粉",
      "amount": ""
    },
    {
      "name": "3 杯白糖",
      "amount": ""
    },
    {
      "name": "2 茶匙小苏打",
      "amount": ""
    },
    {
      "name": "1.5 茶匙盐",
      "amount": ""
    },
    {
      "name": "1 茶匙肉豆蔻粉",
      "amount": ""
    },
    {
      "name": "1 茶匙肉桂粉",
      "amount": ""
    },
    {
      "name": "2 杯新鲜南瓜泥（来自煮或烤的南瓜）",
      "amount": ""
    },
    {
      "name": "1 杯植物油",
      "amount": ""
    },
    {
      "name": "0.66666668653488 杯水",
      "amount": ""
    },
    {
      "name": "4 个大鸡蛋",
      "amount": ""
    },
    {
      "name": "0.5 杯核桃碎",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 350 华氏度（175 摄氏度）。在三个 7x3 英寸的面包盘上涂上油脂并撒上面粉。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将面粉、糖、小苏打、盐、肉豆蔻和肉桂放入一个大搅拌碗中搅拌直至充分混合。加入南瓜泥、油、水和鸡蛋；用电动搅拌机搅拌直至充分混合。拌入核桃。将面糊均匀地分布在准备好的平底锅中。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在预热的烤箱中烘烤约 1 小时，直至用牙签插入每个面包的中心，取出时是干净的。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "从烤箱中取出并将平底锅放在金属架上。切片前让其完全冷却。"
    }
  ],
