{
  "id": "9b62aee522925f9d1fbd218a54eabf83",
  "title": "克里奥尔鸡",
  "min_age_month": 12,
  "tags": [],
  "difficulty": 1,
  "time_cost": 0,
  "cover_image": "images/013409272203758107e51791e6afd66e.webp",
  "nutrition_tip": "你的储藏室里有罐装西红柿吗？试试这个克里奥尔鸡食谱。",
  "ingredients": [],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将鸡肉切成块。将面粉、盐、胡椒粉和辣椒粉的混合物滚入其中。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将鸡肉放入煎锅中融化的脂肪中煎成棕色。加入洋葱；煮2到3分钟。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "加水，盖上锅盖，煮约 30 分钟或直至几乎变软，如有必要，可加更多的水。偶尔搅拌一下，以免粘连。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "加入青椒和西红柿。再煮约30分钟。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "搭配调味热面条或米饭。"
    }
  ],
