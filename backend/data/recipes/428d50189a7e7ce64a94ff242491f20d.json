  "id": "428d50189a7e7ce64a94ff242491f20d",
  "title": "酿辣椒汤",
  "min_age_month": 8,
  "tags": [
    "Soup",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 60,
  "cover_image": "images/c0b626405912617e946479d1d423b010.webp",
  "nutrition_tip": "酿辣椒汤配碎牛肉、青椒、米饭和西红柿是一道……",
  "ingredients": [
    {
      "name": "1 磅牛腰肉碎",
      "amount": ""
    },
    {
      "name": "1 个青椒，切碎",
      "amount": ""
    },
    {
      "name": "1 杯切碎的洋葱",
      "amount": ""
    },
    {
      "name": "1罐（29盎司）番茄丁",
      "amount": ""
    },
    {
      "name": "1 罐（15 盎司）番茄酱",
      "amount": ""
    },
    {
      "name": "1 罐（14 盎司）鸡汤",
      "amount": ""
    },
    {
      "name": "0.25 茶匙干百里香",
      "amount": ""
    },
    {
      "name": "0.25 茶匙干鼠尾草",
      "amount": ""
    },
    {
      "name": "盐和胡椒调味",
      "amount": ""
    },
    {
      "name": "2 杯水",
      "amount": ""
    },
    {
      "name": "1 杯白米饭",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "用中高温加热一个大煎锅。在热煎锅中煮碎牛肉并搅拌 5 至 7 分钟，直至变成棕色且易碎。排干并丢弃油脂。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "加入青椒和洋葱；煮约 5 分钟，搅拌直至洋葱变软并变成半透明。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "加入西红柿、番茄酱、肉汤、百里香和鼠尾草；用盐和胡椒调味。盖上锅盖，小火煮约 30 至 45 分钟，直至辣椒变软。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "同时，将水和米在平底锅中煮沸。将火调至中低，盖上锅盖，小火煮 20 至 25 分钟，直至米变软且水分被吸收。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "将煮熟的米饭倒入汤中；加热即可食用。"
    }
  ],
