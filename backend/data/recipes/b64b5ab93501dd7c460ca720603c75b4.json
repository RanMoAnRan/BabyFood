{
  "id": "b64b5ab93501dd7c460ca720603c75b4",
  "title": "“剩菜”西兰花土豆汤",
  "min_age_month": 6,
  "tags": [],
  "difficulty": 1,
  "time_cost": 0,
  "cover_image": "images/3677b99eca3677915bae11c6815f5d05.webp",
  "nutrition_tip": "一道美味的白手起家的汤，在……的帮助下很快就做好了。",
  "ingredients": [],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将西兰花、洋葱和肉汤放入大平底锅中混合。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "煮沸。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "减少热量。盖上锅盖，煮约 10 分钟或直至蔬菜变软。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在汤中加入牛奶。慢慢拌入土豆泥。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "煮，不断搅拌，直至起泡且变稠。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "用盐和胡椒调味；如果汤开始变得太稠，则加入一点牛奶或水。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "用勺子舀入碗中。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "在每份食物上撒上约 1 汤匙奶酪。"
    }
  ],
  "warnings": [],
