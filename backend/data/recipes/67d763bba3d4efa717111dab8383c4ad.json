  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在 2 夸脱的平底锅中用中火融化黄油；加入洋葱、青椒、芹菜和大蒜。煮约 5 至 7 分钟，搅拌直至洋葱变软、灯笼椒变软。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "加入玉米淀粉。加入炖番茄、番茄酱、水、伍斯特酱、辣椒粉、卡真调味料和辣椒酱。煮沸，经常搅拌。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "加入虾、柠檬汁和新鲜百里香；煮约 5 分钟，直至虾外部呈亮粉色且肉不透明。"
    }
