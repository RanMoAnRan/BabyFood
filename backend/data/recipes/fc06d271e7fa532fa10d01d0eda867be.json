  "nutrition_tip": "Tacos al Pastor 是一种经典的墨西哥炸玉米饼，由腌制在液体中的嫩猪肉制成。",
  "ingredients": [
    {
      "name": "1 个番茄",
      "amount": ""
    },
    {
      "name": "3 个干瓜希略智利辣椒，去籽",
      "amount": ""
    },
    {
      "name": "2 个干安乔智利辣椒，去籽",
      "amount": ""
    },
    {
      "name": "1 个菠萝，切成 3/4 英寸厚",
      "amount": ""
    },
    {
      "name": "0.5 杯橙汁",
      "amount": ""
    },
    {
      "name": "1 个洋葱，切成四等分",
      "amount": ""
    },
    {
      "name": "0.25 杯白醋",
      "amount": ""
    },
    {
      "name": "2 个阿多波酱墨西哥辣椒",
      "amount": ""
    },
    {
      "name": "1 汤匙盐，或适量",
      "amount": ""
    },
    {
      "name": "2 瓣大蒜，压碎",
      "amount": ""
    },
    {
      "name": "3 丁香",
      "amount": ""
    },
    {
      "name": "1 茶匙小茴香籽",
      "amount": ""
    },
    {
      "name": "1 茶匙干牛至",
      "amount": ""
    },
    {
      "name": "2 磅去骨猪腰肉，切成薄片",
      "amount": ""
    },
    {
      "name": "0.5 杯切碎的洋葱",
      "amount": ""
    },
    {
      "name": "0.5 杯切碎的新鲜香菜",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "在脊形烤盘上用中高火将番茄煮至稍微变黑，大约需要 5 分钟。从火上移开并冷却直至易于处理。剥去外皮并去除种子。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将一小锅水煮沸。加入瓜吉略辣椒和安乔智利辣椒；煮约5分钟直至变软。流走。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将番茄肉、软化的智利辣椒、2片菠萝、橙汁、切成四等分的洋葱、醋、墨西哥辣椒、盐、大蒜、丁香、小茴香籽和牛至放入搅拌机中混合；搅拌直至光滑。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将猪肉片放入玻璃或陶瓷烤盘中。将混合的混合物倒在猪肉上，确保所有面都均匀地涂上。用保鲜膜盖住烤盘。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将猪肉放入冰箱腌制 4 小时至过夜。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "将剩余的菠萝片放在有脊的烤盘上，用中火煮至稍微变黑变软，每面约 5 分钟。切成小块。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "擦拭烤盘并用中高温预热。将腌制好的猪肉放入热锅中，翻动一次，直至变成褐色，煮 4 至 5 分钟。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "将猪肉逆着纹理粗粗地切成小块。与菠萝、切碎的洋葱和香菜一起食用。"
    }
  ],
