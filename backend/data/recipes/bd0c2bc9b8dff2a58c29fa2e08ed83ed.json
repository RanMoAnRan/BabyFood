  ],
  "difficulty": 1,
  "time_cost": 85,
  "cover_image": "images/7b96674afe66dae48b743f4b471e9598.webp",
  "nutrition_tip": "很棒的虾开胃菜！与饼干或烤法式面包一起食用。",
  "ingredients": [
    {
      "name": "1 罐（10.75 盎司）浓缩番茄汤",
      "amount": ""
    },
    {
      "name": "2 个（0.25 盎司）信封无味明胶",
      "amount": ""
    },
    {
      "name": "0.5 杯冷水",
      "amount": ""
    },
    {
      "name": "6 盎司奶油干酪，软化",
      "amount": ""
    },
    {
      "name": "1 杯蛋黄酱",
      "amount": ""
    },
    {
      "name": "1 磅熟虾",
      "amount": ""
    },
    {
      "name": "1 杯芹菜末",
      "amount": ""
    },
    {
      "name": "0.5 杯 洋葱，切碎",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "在小平底锅或微波炉中加热汤。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在一个中等大小的碗中，将明胶放入冷水中搅拌。将热番茄汤混入明胶液中。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在一个中等大小的搅拌碗中，将奶油干酪和蛋黄酱混合在一起。将汤混合物混入蛋黄酱和奶油干酪混合物中。搅拌均匀。加入虾、芹菜和葱。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将混合物倒入 1 夸脱的模具中并冷藏至少 1 小时，但最好过夜。上菜前脱模放在盘子上。"
    }
  ],
