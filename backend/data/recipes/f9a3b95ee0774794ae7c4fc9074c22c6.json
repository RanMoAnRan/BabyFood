  ],
  "difficulty": 1,
  "time_cost": 20,
  "cover_image": "images/bf1053370112868ba36a1a9a8e8d44d6.webp",
  "nutrition_tip": "威尔士干酪是一种光滑的奶酪酱，用芥末和啤酒调味，在...",
  "ingredients": [
    {
      "name": "0.25 杯黄油",
      "amount": ""
    },
    {
      "name": "0.25 杯通用面粉",
      "amount": ""
    },
    {
      "name": "0.5 茶匙盐",
      "amount": ""
    },
    {
      "name": "0.25 茶匙胡椒粉",
      "amount": ""
    },
    {
      "name": "0.25 茶匙干芥末",
      "amount": ""
    },
    {
      "name": "0.25 茶匙伍斯特酱",
      "amount": ""
    },
    {
      "name": "2 滴辣椒酱（例如 Tabasco®）",
      "amount": ""
    },
    {
      "name": "1 杯全脂牛奶",
      "amount": ""
    },
    {
      "name": "0.5 杯啤酒",
      "amount": ""
    },
    {
      "name": "0.5 磅切达干酪，切丝",
      "amount": ""
    },
    {
      "name": "6 片面包",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在平底锅中用小火融化黄油。加入面粉、盐、胡椒、芥末、伍斯特酱和辣椒酱。煮约 5 分钟，搅拌直至光滑且起泡。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将平底锅从火上移开。逐渐加入牛奶，然后重新加热并持续搅拌直至混合物沸腾。慢慢倒入啤酒；煮并搅拌 1 分钟。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将切达干酪分成小份融化到混合物中，直至完全混合。将烤箱架设置在距热源约 6 英寸的位置，并预热烤箱的烤肉机。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "在一侧烤面包片。将未烘烤的一面朝上放在烤盘上。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "将奶酪酱舀到未烤的一面。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "在预热的烤炉下煮 2 到 3 分钟，直至奶酪酱冒泡并呈金黄色。趁热食用。"
    }
  ],
