  "nutrition_tip": "这些葡萄果冻肉丸是用慢炖锅用冷冻鸡尾酒粉制成的……",
  "ingredients": [
    {
      "name": "1 罐（32 盎司）葡萄果冻",
      "amount": ""
    },
    {
      "name": "2 瓶（12 盎司）番茄辣椒酱（例如 Heinz®）",
      "amount": ""
    },
    {
      "name": "1 撮辣椒",
      "amount": ""
    },
    {
      "name": "1 袋（6 磅）冷冻鸡尾酒大小的肉丸",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将葡萄果冻、辣椒酱和辣椒放入平底锅中，用中火加热；煮5至10分钟直至温热。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将肉丸放入慢炖锅中，并在上面撒上葡萄果冻混合物。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "低火煮 3 到 4 小时。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "趁热享用吧！"
    }
  ],
