{
  "id": "1feecb11cd55c35eea8ec09f0396298c",
  "title": "俄罗斯茶饼",
  "min_age_month": 12,
  "tags": [
    "Dessert",
    "Russian",
    "Eastern European",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 50,
  "cover_image": "images/673d386a86b4b4d6a7e175758282f749.webp",
  "nutrition_tip": "俄罗斯茶饼是用甜糖粉卷起来的光滑坚果饼干。 …",
  "ingredients": [
    {
      "name": "1 杯无盐黄油，软化",
      "amount": ""
    },
    {
      "name": "1 茶匙香草精",
      "amount": ""
    },
    {
      "name": "2 杯通用面粉",
      "amount": ""
    },
    {
      "name": "6 汤匙糖粉",
      "amount": ""
    },
    {
      "name": "1 杯切碎的核桃",
      "amount": ""
    },
    {
      "name": "0.33333334326744 杯糖粉，或根据需要更多",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将烤箱预热至 350 华氏度（175 摄氏度）。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将黄油和香草精放入一个中等大小的碗中，用电动搅拌机搅拌 2 到 3 分钟，直至光滑。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将面粉和 6 汤匙糖粉放入单独的碗中搅拌。添加到黄油混合物中并搅拌直至混合。加入核桃，搅拌直至混合；混合物可能易碎。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "取一小勺面团，在双手之间搓成 1 英寸的球。将球放在未抹油的饼干片上，间隔 2 英寸。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "在预热的烤箱中烘烤约 12 分钟，直至边缘刚刚变成金黄色。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "从烤箱中取出并转移到金属架上冷却 15 分钟。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "将剩余的 1/3 杯糖粉放入小碗中。将冷却的饼干在糖粉中滚动一到两次。"
    },
    {
      "step_index": 9,
      "img": "",
      "text": "享受吧！"
    }
  ],
