{
  "id": "05dae44d9959effe796218698d5852fe",
  "title": "七层沙拉",
  "min_age_month": 12,
  "tags": [
    "Salad",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 25,
  "cover_image": "images/ea6931f66178e0131ac3ce7767fcea02.webp",
  "nutrition_tip": "在一个大玻璃碗中制作这道 7 层沙拉，这样晚餐的客人就可以看到所有的东西……",
  "ingredients": [
    {
      "name": "1 磅培根",
      "amount": ""
    },
    {
      "name": "1 颗大头卷心生菜 - 冲洗、干燥并切碎",
      "amount": ""
    },
    {
      "name": "1 个红洋葱，切碎",
      "amount": ""
    },
    {
      "name": "1 包（10 盎司）冷冻青豆，解冻",
      "amount": ""
    },
    {
      "name": "10 盎司切达干酪丝",
      "amount": ""
    },
    {
      "name": "1 杯切碎的花椰菜",
      "amount": ""
    },
    {
      "name": "1.25 杯蛋黄酱",
      "amount": ""
    },
    {
      "name": "0.66666668653488 杯磨碎的帕尔马干酪",
      "amount": ""
    },
    {
      "name": "2 汤匙白糖",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将培根放入大煎锅中，用中高火煮，偶尔翻转，直至均匀变成棕色，大约 10 分钟。将培根片放在纸巾上沥干水分；弄碎并放在一边。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "制作沙拉：将切碎的生菜放入大玻璃盘或碗中；上面放一层红洋葱、豌豆、切碎的奶酪、花椰菜和培根。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "制作调料：将蛋黄酱、帕尔马干酪和糖放入碗中搅拌直至光滑。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将调料淋在沙拉上，然后冷藏直至冷却。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "上菜并享用！"
    }
  ],
