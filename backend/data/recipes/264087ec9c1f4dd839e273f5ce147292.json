{
  "id": "264087ec9c1f4dd839e273f5ce147292",
  "title": "奶油芝士可拉奇",
  "min_age_month": 12,
  "tags": [
    "Snack",
    "Dessert",
    "Polish"
  ],
  "difficulty": 1,
  "time_cost": 205,
  "cover_image": "images/0701a577246ada0facc2796bd9bdff9e.webp",
  "nutrition_tip": "Kolacky 是奶油芝士糕点，你可以在里面填上你最喜欢的果酱……",
  "ingredients": [
    {
      "name": "3 盎司奶油干酪",
      "amount": ""
    },
    {
      "name": "0.5 杯黄油，软化",
      "amount": ""
    },
    {
      "name": "1 杯通用面粉",
      "amount": ""
    },
    {
      "name": "0.5 杯任意口味果酱",
      "amount": ""
    },
    {
      "name": "0.33333334326744 杯装饰用糖",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将奶油干酪和黄油在碗中混合直至光滑。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "逐渐加入面粉直至混合。将面团揉成球状；盖上碗并冷藏至少 3 小时或过夜。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将烤箱预热至 350 华氏度（180 摄氏度）。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "在撒了面粉的糕点板上将面团擀成 1/8 英寸的厚度。切成 2 .5 英寸的正方形，并在中心放置约 1/2 茶匙果酱或蜜饯。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "重叠对角并捏在一起密封。放在未涂油的烤盘上。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "在预热的烤箱中烘烤约 10 至 12 分钟至金黄色。放在金属架上冷却。在科拉基上轻轻撒上糖粉。"
    }
  ],
