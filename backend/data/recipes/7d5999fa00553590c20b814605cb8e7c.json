{
  "id": "7d5999fa00553590c20b814605cb8e7c",
  "title": "汉堡土豆砂锅",
  "min_age_month": 8,
  "tags": [
    "Dinner",
    "American",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 100,
  "cover_image": "images/5debeda8e29bd751e67090212e992810.webp",
  "nutrition_tip": "汉堡土豆砂锅菜是老菜，但却是美味！这个食谱将磨碎的…",
  "ingredients": [
    {
      "name": "1 磅瘦碎牛肉",
      "amount": ""
    },
    {
      "name": "1 罐（10.5 盎司）浓缩奶油蘑菇汤",
      "amount": ""
    },
    {
      "name": "0.75 杯牛奶",
      "amount": ""
    },
    {
      "name": "0.5 杯切碎的洋葱",
      "amount": ""
    },
    {
      "name": "盐和黑胡椒粉适量",
      "amount": ""
    },
    {
      "name": "3 杯去皮切成薄片的土豆",
      "amount": ""
    },
    {
      "name": "1 杯切达干酪丝",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。将烤箱预热至 350 华氏度（175 摄氏度）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "用中高温加热一个大煎锅。在热煎锅中煮碎牛肉并搅拌 5 至 7 分钟，直至变成棕色且易碎。排干并丢弃油脂。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将浓缩汤、牛奶、洋葱、盐和胡椒粉放入一个中等大小的碗中，直至混合。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将土豆、汤混合物和棕色碎牛肉交替放入 2 夸脱的烤盘中。用箔纸紧紧地盖住盘子。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "在预热的烤箱中烘烤约 1 至 1 ½ 小时，直至土豆变软。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "取下箔纸，在上面撒上切达干酪，然后继续烘烤 5 到 10 分钟，直到奶酪融化并起泡。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "上菜并享用。"
    }
  ],
