  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "遵循奶油通心粉和奶酪的基本配方，但使用胡椒杰克奶酪，而不是切达干酪。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "用中高火加热 10 英寸煎锅。煮碎牛肉，用盐和胡椒轻轻调味，直到大部分液体蒸发，大约需要 5 分钟。加入辣椒粉、莎莎酱和辣椒搅拌；煮2至3分钟。加入香菜，然后将混合物搅拌到通心粉中。趁热食用。"
    }
