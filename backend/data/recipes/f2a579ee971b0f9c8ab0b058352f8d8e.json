  "id": "f2a579ee971b0f9c8ab0b058352f8d8e",
  "title": "简单的火鸡盐水",
  "min_age_month": 12,
  "tags": [
    "Dinner",
    "American",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 645,
  "cover_image": "images/5c5bed65945c2ea09ea37fa49df0d137.webp",
  "nutrition_tip": "用红糖和香料制成的简单火鸡盐水是拥有美味的关键......",
  "ingredients": [
    {
      "name": "1 加仑水",
      "amount": ""
    },
    {
      "name": "2 杯粗盐",
      "amount": ""
    },
    {
      "name": "1.5 杯 深红糖",
      "amount": ""
    },
    {
      "name": "3 片大月桂叶",
      "amount": ""
    },
    {
      "name": "1 汤匙全黑胡椒",
      "amount": ""
    },
    {
      "name": "2.5 茶匙干迷迭香",
      "amount": ""
    },
    {
      "name": "2.5 茶匙干百里香",
      "amount": ""
    },
    {
      "name": "12 整个丁香",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在一个大汤锅中将水煮沸。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "加入盐和红糖搅拌至溶解；回到沸腾状态。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "添加月桂叶、花椒、迷迭香、百里香和丁香。将火调至中低，煮 15 至 20 分钟。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "使用前将其从火上移开并完全冷却。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "将解冻的火鸡放入一个大的非反应容器中。倒入冷却的盐水。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "倒入足够的凉水，使液体淹没火鸡。冷藏8至12小时。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "将火鸡从盐水中取出，放在柜台上约 2 小时。"
    },
    {
      "step_index": 9,
      "img": "",
      "text": "按照您最喜欢的食谱来烹饪火鸡。"
    }
  ],
