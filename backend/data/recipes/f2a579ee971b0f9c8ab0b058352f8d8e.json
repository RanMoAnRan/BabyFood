  "cover_image": "images/5c5bed65945c2ea09ea37fa49df0d137.webp",
  "nutrition_tip": "A simple turkey brine made with brown sugar and spices is the key to having a mo…",
  "ingredients": [
    {
      "name": "1 gallon water",
      "amount": ""
    },
    {
      "name": "2 cups kosher salt",
      "amount": ""
    },
    {
      "name": "1.5 cups dark brown sugar",
      "amount": ""
    },
    {
      "name": "3 large bay leaves",
      "amount": ""
    },
    {
      "name": "1 tablespoon whole black peppercorns",
      "amount": ""
    },
    {
      "name": "2.5 teaspoons dried rosemary",
      "amount": ""
    },
    {
      "name": "2.5 teaspoons dried thyme",
      "amount": ""
    },
    {
      "name": "12 whole cloves",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "Gather all ingredients."
    },
    {
      "step_index": 2,
      "img": "",
      "text": "Bring water to a boil in a large stockpot."
    },
    {
      "step_index": 3,
      "img": "",
      "text": "Stir in salt and brown sugar until dissolved; return to a boil."
    },
    {
      "step_index": 4,
      "img": "",
      "text": "Add bay leaves, peppercorns, rosemary, thyme, and cloves. Reduce heat to medium-low and simmer for 15 to 20 minutes."
    },
    {
      "step_index": 5,
      "img": "",
      "text": "Remove from the heat and let cool completely before using."
    },
    {
      "step_index": 6,
      "img": "",
      "text": "Place thawed turkey into a large non-reactive container. Pour in cooled brine."
    },
    {
      "step_index": 7,
      "img": "",
      "text": "Pour in enough cool water to cover turkey with liquid. Refrigerate 8 to 12 hours."
    },
    {
      "step_index": 8,
      "img": "",
      "text": "Remove turkey from brine and let sit on counter for about 2 hours."
    },
    {
      "step_index": 9,
      "img": "",
      "text": "Follow your favorite recipe to cook your turkey."
    }
  ],
