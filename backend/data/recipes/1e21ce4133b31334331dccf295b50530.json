  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "step_index": 2,
      "img": "",
      "text": "Sift flour, baking soda, salt, cinnamon, and nutmeg into a bowl; mix well. Stir in pumpkin, brown sugar, buttermilk, egg, and butter until well blended. Pour batter into a 9x5-inch loaf pan; smooth the top."
    },
    {
      "step_index": 3,
      "img": "",
      "text": "Bake in the preheated oven until a toothpick inserted into center comes out clean, about 1 hour."
    }
  ],
