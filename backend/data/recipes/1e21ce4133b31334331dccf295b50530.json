  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 350 华氏度（175 摄氏度）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将面粉、小苏打、盐、肉桂和肉豆蔻筛入碗中；搅拌均匀。加入南瓜、红糖、酪乳、鸡蛋和黄油，搅拌均匀。将面糊倒入9x5英寸的烤盘中；使顶部光滑。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在预热的烤箱中烘烤约 1 小时，直到插入中心的牙签拔出时干净为止。"
    }
  ],
