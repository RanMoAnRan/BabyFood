{
  "id": "12276a2af798acff3bcf5dd0bfbc7261",
  "title": "经典麸皮松饼",
  "min_age_month": 12,
  "tags": [
    "Breakfast",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 30,
  "cover_image": "images/c2765540ae49a0c0cb6ecfbca647ea70.webp",
  "nutrition_tip": "用麦麸制成的麸皮松饼是全家人美味的纤维来源......",
  "ingredients": [
    {
      "name": "1.5 杯麦麸",
      "amount": ""
    },
    {
      "name": "1 杯酪乳",
      "amount": ""
    },
    {
      "name": "0.66666668653488 杯 红糖",
      "amount": ""
    },
    {
      "name": "0.33333334326744 杯植物油",
      "amount": ""
    },
    {
      "name": "1 个鸡蛋",
      "amount": ""
    },
    {
      "name": "0.5 茶匙香草精",
      "amount": ""
    },
    {
      "name": "1 杯通用面粉",
      "amount": ""
    },
    {
      "name": "1 茶匙小苏打",
      "amount": ""
    },
    {
      "name": "1 茶匙泡打粉",
      "amount": ""
    },
    {
      "name": "0.5 茶匙盐",
      "amount": ""
    },
    {
      "name": "0.5 杯葡萄干",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将烤箱预热至 375 华氏度（190 摄氏度）。在 12 个松饼杯上涂上油脂或铺上松饼纸衬垫。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将麦麸和酪乳放入一个大碗中混合；静置 10 分钟。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "同时，将红糖、油、鸡蛋和香草精放入另一个碗中，搅拌至松软；搅拌成酪乳混合物。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将面粉、小苏打、泡打粉和盐一起过筛；搅拌至酪乳混合物中直至混合。拌入葡萄干；将面糊倒入准备好的松饼杯中，每个杯填满 2/3。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "在预热的烤箱中烘烤约 15 至 20 分钟，直至轻压时顶部弹回。在罐中短暂冷却，然后转移到金属架上完全冷却。享受！"
    }
  ],
