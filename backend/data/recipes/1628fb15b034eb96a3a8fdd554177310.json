  "id": "1628fb15b034eb96a3a8fdd554177310",
  "title": "蔓越莓沙拉",
  "min_age_month": 12,
  "tags": [
    "Side Dish",
    "Dessert",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 20,
  "cover_image": "images/8b2271f89f5c3bce140c76a5c052bdf6.webp",
  "nutrition_tip": "这个蔓越莓沙拉结合了新鲜的蔓越莓、橙子、菠萝和核桃……",
  "ingredients": [
    {
      "name": "2 杯蔓越莓",
      "amount": ""
    },
    {
      "name": "1 个大橙子，切成小块",
      "amount": ""
    },
    {
      "name": "1 杯白糖",
      "amount": ""
    },
    {
      "name": "1 杯切碎的芹菜",
      "amount": ""
    },
    {
      "name": "1 杯切碎的核桃",
      "amount": ""
    },
    {
      "name": "1 杯菠萝碎，沥干",
      "amount": ""
    },
    {
      "name": "1 包（3 盎司）覆盆子味 Jell-O® 混合物",
      "amount": ""
    },
    {
      "name": "2 杯热水",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将蔓越莓、橙子（包括果皮）和糖放入食品加工机中。一起搅拌，直到蔓越莓和橙子粗碎并与糖充分混合。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "转移到碗中。加入芹菜、核桃和菠萝，搅拌直至完全混合。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将明胶放入碗中，倒入热水；立即搅拌至完全溶解。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将明胶倒在蔓越莓混合物上。搅拌混合。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "倒入您选择的模具中并冷却直至准备好上桌。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "享受吧！"
    }
  ],
