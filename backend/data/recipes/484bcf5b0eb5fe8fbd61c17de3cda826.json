  "nutrition_tip": "这款湿润的柠檬蓝莓蛋糕充满了多汁的蓝莓，配有柠檬汁……",
  "ingredients": [
    {
      "name": "1 茶匙黄油，或根据需要",
      "amount": ""
    },
    {
      "name": "12 盎司新鲜蓝莓",
      "amount": ""
    },
    {
      "name": "1 汤匙通用面粉",
      "amount": ""
    },
    {
      "name": "1 茶匙柠檬汁",
      "amount": ""
    },
    {
      "name": "1 杯白糖",
      "amount": ""
    },
    {
      "name": "2 个鸡蛋",
      "amount": ""
    },
    {
      "name": "1 杯酸奶油",
      "amount": ""
    },
    {
      "name": "0.5 杯植物油",
      "amount": ""
    },
    {
      "name": "1 茶匙香草精",
      "amount": ""
    },
    {
      "name": "0.25 茶匙盐",
      "amount": ""
    },
    {
      "name": "2 杯通用面粉",
      "amount": ""
    },
    {
      "name": "2 茶匙泡打粉",
      "amount": ""
    },
    {
      "name": "1 汤匙柠檬汁",
      "amount": ""
    },
    {
      "name": "0.5 汤匙 柠檬皮碎",
      "amount": ""
    },
    {
      "name": "2 汤匙糖果糖，或根据需要",
      "amount": ""
    }
