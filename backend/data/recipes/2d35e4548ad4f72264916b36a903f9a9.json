  "title": "胡萝卜、核桃和葡萄干蒸粗麦粉",
  "min_age_month": 12,
  "tags": [],
  "difficulty": 1,
  "time_cost": 0,
  "cover_image": "images/3f54f9deba83929e82c9c6bf4480d680.webp",
  "nutrition_tip": "这道速煮谷物菜肴带有一丝甜味和坚果味，可搭配……",
  "ingredients": [],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "在 4 夸脱的平底锅中，用中火煮并搅拌蒸粗麦粉、橄榄油、核桃、盐、胡椒和香料，直到蒸粗麦粉开始变成棕色。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "慢慢加水，然后加入葡萄干和胡萝卜。覆盖。用高火煮沸。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "从火上移开，静置 10 分钟。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "用叉子弄松。立即上菜。"
    }
  ],
