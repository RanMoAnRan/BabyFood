  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将酪乳和无花果放入平底锅中，用中低火轻轻加热至软化，持续 10 至 15 分钟；搁置直至冷却。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将烤箱预热至 350 华氏度（175 摄氏度）。给管盘涂上油脂。在铝箔的一侧涂上油脂。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将面粉、糖、发酵粉、肉豆蔻、肉桂和盐一起过筛到碗中。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将鸡蛋放入另一个大碗中，用电动搅拌器高速搅拌 1 分钟。加入冷却的无花果和酪乳混合物、面包屑、融化的黄油、杏仁、橙子果酱、橙皮和橙子香草调味料；低速搅拌直至混合。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "逐渐加入过筛的面粉混合物，直至完全混合。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "将面糊舀入准备好的平底锅中，并用涂有油脂的箔纸覆盖。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "在预热的烤箱中烘烤约 1 小时 15 分钟至 2 小时，直至变硬并从烤盘两侧拉开。"
    },
    {
      "step_index": 9,
      "img": "",
      "text": "从烤箱中取出并在锅中冷却 10 分钟。转到金属架上。"
    }
  ],
