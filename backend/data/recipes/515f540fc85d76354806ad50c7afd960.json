  "nutrition_tip": "这种无花果布丁是用干无花果、杏仁和香料制成的，湿润而浓稠。...",
  "ingredients": [
    {
      "name": "1.75 杯酪乳",
      "amount": ""
    },
    {
      "name": "12 盎司干 Calimyrna 无花果，粗略切碎",
      "amount": ""
    },
    {
      "name": "1.5 杯白色全麦面粉（例如 King Arthur®）",
      "amount": ""
    },
    {
      "name": "1 杯白糖",
      "amount": ""
    },
    {
      "name": "2.5 茶匙泡打粉",
      "amount": ""
    },
    {
      "name": "1 茶匙肉豆蔻粉",
      "amount": ""
    },
    {
      "name": "1 茶匙肉桂粉",
      "amount": ""
    },
    {
      "name": "1 茶匙盐",
      "amount": ""
    },
    {
      "name": "3 个鸡蛋",
      "amount": ""
    },
    {
      "name": "1.5 杯干面包屑",
      "amount": ""
    },
    {
      "name": "0.5 杯黄油，融化",
      "amount": ""
    },
    {
      "name": "1 包（2.45 盎司）杏仁片",
      "amount": ""
    },
    {
      "name": "3 汤匙 橙子果酱",
      "amount": ""
    },
    {
      "name": "1 汤匙 磨碎的橙皮碎",
      "amount": ""
    },
    {
      "name": "0.5 茶匙橙子香草调味料（例如 Fiori di Sicilia®",
      "amount": ""
    }
