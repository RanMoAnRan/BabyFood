{
  "id": "c488cb8af66899511cd4a365c77e4ac4",
  "title": "蔓越莓苹果法罗馅",
  "min_age_month": 12,
  "tags": [],
  "difficulty": 1,
  "time_cost": 0,
  "cover_image": "images/75fbd43e00ef410223ef0f2d80fa605f.webp",
  "nutrition_tip": "今年传统的感恩节馅料有所改变。",
  "ingredients": [],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "在小锅中用高火将汤煮沸。一旦高汤达到一个碗，加入法罗并搅拌。将火调小，盖上锅盖，煮 15-20 分钟或直至所有液体消失。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将炒锅放在中火上，加入橄榄油。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "一旦洋葱变成半透明，加入苹果和葱。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "继续炒1-2分钟，直到苹果稍微变软。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将法罗和炒混合物放入搅拌碗中混合。加入大蒜粉、柠檬汁、葱、欧芹、调味盐、黑胡椒和蔓越莓。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "作为感恩节替代品或搭配任何秋季菜肴。享受！"
    }
  ],
  "warnings": [],
