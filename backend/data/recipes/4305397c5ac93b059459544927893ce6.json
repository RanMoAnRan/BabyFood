  "cover_image": "images/d05d0cb42fcabe7ee6ce50ccc6aa4ef6.webp",
  "nutrition_tip": "制作起来又快又容易，这个意大利爱情蛋糕的食谱有一个巧克力蛋糕……",
  "ingredients": [
    {
      "name": "1 包（18.25 盎司）巧克力蛋糕粉",
      "amount": ""
    },
    {
      "name": "1 杯水",
      "amount": ""
    },
    {
      "name": "4 个鸡蛋",
      "amount": ""
    },
    {
      "name": "1/2 杯植物油",
      "amount": ""
    },
    {
      "name": "2 品脱部分脱脂乳清干酪",
      "amount": ""
    },
    {
      "name": "0.75 杯白糖",
      "amount": ""
    },
    {
      "name": "1 茶匙香草精",
      "amount": ""
    },
    {
      "name": "1 包（3.9 盎司）速溶巧克力布丁粉",
      "amount": ""
    },
    {
      "name": "1 杯牛奶",
      "amount": ""
    },
    {
      "name": "1 个（12 盎司）容器冷冻搅打配料，解冻",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 350 华氏度（175 摄氏度）。在 9x13 英寸的烤盘上涂上少许油脂。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将蛋糕粉、水、3 个鸡蛋和油放入一个大碗中；用电动搅拌机搅拌约 2 分钟，直至充分混合。将面糊倒入准备好的烤盘中。放在一边。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "制作乳清干酪层：将​​乳清干酪、糖、香草精和剩余的 4 个鸡蛋放入另一个碗中；混合得很好。将乳清干酪混合物均匀地铺在蛋糕面糊的顶部。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在预热的烤箱中烘烤，直至插在中心的牙签拔出时干净为止。如果使用玻璃烤盘，则烘烤约 1 小时 15 分钟；如果使用金属烤盘，则烘烤约 1 ½ 小时。在浇头之前让蛋糕完全冷却。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "制作配料：将布丁粉和牛奶搅拌至变稠。加入搅打过的配料。铺在冷却的蛋糕上。"
    }
  ],
