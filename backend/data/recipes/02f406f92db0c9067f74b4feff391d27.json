  "nutrition_tip": "这个提拉米苏蛋糕，有3层咖啡味海绵蛋糕，咖啡利口酒……",
  "ingredients": [
    {
      "name": "1 包（15.25 盎司）湿白蛋糕粉",
      "amount": ""
    },
    {
      "name": "1 杯水",
      "amount": ""
    },
    {
      "name": "3 个大蛋白",
      "amount": ""
    },
    {
      "name": "0.33 杯植物油",
      "amount": ""
    },
    {
      "name": "1 茶匙速溶咖啡粉",
      "amount": ""
    },
    {
      "name": "0.25 杯咖啡",
      "amount": ""
    },
    {
      "name": "1 汤匙咖啡味利口酒",
      "amount": ""
    },
    {
      "name": "1 罐（8 盎司）马斯卡彭奶酪",
      "amount": ""
    },
    {
      "name": "0.5 杯糖果糖",
      "amount": ""
    },
    {
      "name": "2 汤匙咖啡味利口酒",
      "amount": ""
    },
    {
      "name": "2 杯浓奶油",
      "amount": ""
    },
    {
      "name": "0.25 杯糖果糖",
      "amount": ""
    },
    {
      "name": "2 汤匙咖啡味利口酒",
      "amount": ""
    },
    {
      "name": "2 汤匙不加糖可可粉",
      "amount": ""
    },
    {
      "name": "1 块（1 盎司）方形半甜巧克力",
