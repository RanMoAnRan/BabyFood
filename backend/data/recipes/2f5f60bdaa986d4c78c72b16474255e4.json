{
  "id": "2f5f60bdaa986d4c78c72b16474255e4",
  "title": "简单的自制馅饼皮",
  "min_age_month": 12,
  "tags": [
    "Dessert",
    "American",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 40,
  "cover_image": "images/2a73af28837442707c035207ee6ac9c5.webp",
  "nutrition_tip": "约翰厨师的馅饼皮食谱在食品加工机中快速混合在一起......",
  "ingredients": [
    {
      "name": "2.5 杯通用面粉",
      "amount": ""
    },
    {
      "name": "1 杯无盐黄油 - 冷藏，切成汤匙大小的块",
      "amount": ""
    },
    {
      "name": "0.5 茶匙盐",
      "amount": ""
    },
    {
      "name": "7 汤匙冰水",
      "amount": ""
    },
    {
      "name": "1 汤匙苹果醋",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将面粉、黄油和盐放入食品加工机中混合。脉冲约 10 次（1 秒）脉冲，直到混合物看起来像粗面包屑。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在小碗中搅拌冰水和醋。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将1/2的冰水混合物倒入面粉混合物中；脉冲进行组合，大约 3 个（1 秒）脉冲。倒入剩余的冰水混合物；脉冲直至混合物开始聚集，大约 8 个（1 秒）脉冲。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将面团翻到木质表面上，拍成圆形，然后将其分成两半。将每一半形成一个大约 5 英寸宽的圆盘。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "用保鲜膜包裹每个光盘并冷藏至少 30 分钟，直到可以使用。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "用于您最喜欢的馅饼食谱。"
    }
  ],
