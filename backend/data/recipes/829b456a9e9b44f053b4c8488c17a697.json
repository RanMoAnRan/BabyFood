  "cover_image": "images/e063b700421efd7b5d17f2f53fb6272a.webp",
  "nutrition_tip": "这个美味的牛肉和蔬菜砂锅食谱，配上意大利面南瓜，磨碎……",
  "ingredients": [
    {
      "name": "1 个意大利面南瓜，切半并去籽",
      "amount": ""
    },
    {
      "name": "1 磅碎牛肉",
      "amount": ""
    },
    {
      "name": "0.5 杯青椒丁",
      "amount": ""
    },
    {
      "name": "0.5 杯 红甜椒丁",
      "amount": ""
    },
    {
      "name": "0.25 杯 红洋葱丁",
      "amount": ""
    },
    {
      "name": "1 瓣大蒜，切碎",
      "amount": ""
    },
    {
      "name": "1 罐（14.5 盎司）意大利式番茄丁，沥干",
      "amount": ""
    },
    {
      "name": "0.5 茶匙干牛至",
      "amount": ""
    },
    {
      "name": "0.5 茶匙干罗勒",
      "amount": ""
    },
    {
      "name": "0.25 茶匙盐",
      "amount": ""
    },
    {
      "name": "0.25 茶匙黑胡椒粉",
      "amount": ""
    },
    {
      "name": "2.25 杯切达干酪丝",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 375 华氏度（190 摄氏度）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将南瓜切面朝下放在烤盘上"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在预热的烤箱中烘烤约 40 分钟直至变软。凉爽的;用叉子将肉刮成意大利面条状的丝。放在一边。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将烤箱温度降低至 350 华氏度（175 摄氏度）。在砂锅菜上涂上少许油脂。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "在大煎锅中用中火煮碎牛肉并搅拌，直至均匀变成棕色且易碎。流走。拌入青椒、红洋葱和大蒜；煮并搅拌直至蔬菜变软。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "将南瓜和西红柿搅拌到牛肉混合物中；用牛至、罗勒、盐和黑胡椒调味。煮并搅拌直至热透。关火，加入 2 杯奶酪搅拌直至融化。转移到准备好的砂锅中。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "在预热好的烤箱中烘烤25分钟。将剩余的 1/4 杯奶酪撒在上面；继续烘烤约 5 分钟，直至奶酪融化。"
    }
  ],
