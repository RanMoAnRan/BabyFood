  "nutrition_tip": "用这个快速简单的食谱在微波炉中制作完美的荷兰酱......",
  "ingredients": [
    {
      "name": "2 个大蛋黄",
      "amount": ""
    },
    {
      "name": "0.25 个中等大小的柠檬，榨汁或调味",
      "amount": ""
    },
    {
      "name": "1 撮盐",
      "amount": ""
    },
    {
      "name": "1 撮辣椒",
      "amount": ""
    },
    {
      "name": "0.25 杯咸黄油，融化",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在碗中搅拌蛋黄。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将柠檬汁、盐和辣椒一起放入微波炉安全碗中，搅拌至光滑。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将融化的黄油慢慢倒入蛋黄混合物中，同时搅拌使其混合。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将酱汁放入微波炉中，中火加热 15 至 20 秒；搅拌直至充分混合。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "享受吧！"
    }
