{
  "id": "8bba1ad0a7ea4ed86780a8abe9f492f4",
  "title": "羽衣甘蓝和红薯粉上的鸡蛋",
  "min_age_month": 12,
  "tags": [],
  "difficulty": 1,
  "time_cost": 0,
  "cover_image": "images/ccde1c569b1c754843241a69b6090504.webp",
  "nutrition_tip": "这道烘焙早餐菜是南方经典的现代演绎，以鸡蛋和......",
  "ingredients": [],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 350 °F。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在 4 个舒芙蕾盘上涂上 1 茶匙植物油。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在红薯上切3到4道口；用微波炉煮至软。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "当红薯冷却到足以处理、去皮、切成块并在食品加工机中打成泥时。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "在平底锅中加热剩余的植物油，炒羽衣甘蓝约5分钟。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "在一个中等大小的平底锅中，将水和牛奶煮沸，加入粗玉米粉和红薯；煮5分钟。远离热源；拌入炒羽衣甘蓝。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "将粗粒混合物均匀地分在 4 个舒芙蕾盘中（或全部放入砂锅盘中）。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "用大勺子的背面在粗粉混合物中压出 4 个凹陷。小心地将一个鸡蛋打入每个空洞中。"
    },
    {
      "step_index": 9,
      "img": "",
      "text": "不盖盖子烘烤 30 分钟，直至鸡蛋煮熟。食用前冷却 10 分钟。"
    }
  ],
