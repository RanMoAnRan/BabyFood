  "nutrition_tip": "这道慢炖锅汉堡汤配通心粉配方让我变得完整、丰盛……",
  "ingredients": [
    {
      "name": "1 磅瘦碎牛肉",
      "amount": ""
    },
    {
      "name": "4.5 杯水",
      "amount": ""
    },
    {
      "name": "1 罐（28 盎司）碎番茄",
      "amount": ""
    },
    {
      "name": "0.5（32 液体盎司）容器牛肉汤",
      "amount": ""
    },
    {
      "name": "1 罐（15.25 盎司）整粒甜玉米（例如 Green Giant® Niblets®），不沥干",
      "amount": ""
    },
    {
      "name": "2 茎芹菜，切成薄片",
      "amount": ""
    },
    {
      "name": "1 个中等大小的洋葱，切碎",
      "amount": ""
    },
    {
      "name": "1 杯冷冻利马豆",
      "amount": ""
    },
    {
      "name": "0.75 杯大麦",
      "amount": ""
    },
    {
      "name": "1 块牛肉汤",
      "amount": ""
    },
    {
      "name": "1 茶匙辣椒粉",
      "amount": ""
    },
    {
      "name": "1 片月桂叶",
      "amount": ""
    },
    {
      "name": "0.5 茶匙意大利调味料",
      "amount": ""
    },
    {
      "name": "2 杯肘形通心粉",
      "amount": ""
    },
    {
      "name": "1 汤匙切碎的新鲜欧芹，或适量",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "在大煎锅中用中高火煮碎牛肉并搅拌，直至变成棕色且易碎，持续 5 到 7 分钟。排出多余的油脂。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将牛肉转移到慢炖锅中；加入水、西红柿、肉汤、未沥干的玉米、芹菜、洋葱、利马豆、大麦、肉汤、辣椒粉、月桂叶和意大利调味料。盖上慢炖锅。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "低火煮 6 小时。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "当计时器还剩 15 分钟时，将一大锅淡盐水煮沸。在沸水中煮肘部通心粉，偶尔搅拌，直到咬起来又软又硬，大约需要 8 分钟。流走。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将通心粉搅拌到汤中，直至混合并加热透。用欧芹装饰。"
    }
  ],
