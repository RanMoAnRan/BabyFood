  "difficulty": 1,
  "time_cost": 15,
  "cover_image": "images/f01a52f5aa64fcb5f784bdee3acf60dc.webp",
  "nutrition_tip": "这个 Rolo 椒盐卷饼食谱很容易用迷你椒盐卷饼、Rolo 巧克力卡拉制作......",
  "ingredients": [
    {
      "name": "20 个小迷你椒盐卷饼",
      "amount": ""
    },
    {
      "name": "20 颗巧克力焦糖糖果（例如 Rolo®）",
      "amount": ""
    },
    {
      "name": "20 个半山核桃",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。将烤箱预热至 300 华氏度（150 摄氏度）。在饼干片上铺上羊皮纸。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将椒盐卷饼单层排列在准备好的饼干片上。在每个椒盐卷饼上放一颗焦糖。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在预热的烤箱中烘烤约 4 分钟，直至焦糖软化。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "从烤箱中取出，立即将半个山核桃压入每个热焦糖中。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "食用前完全冷却。"
    }
  ],
