  "title": "鸡肉炒",
  "min_age_month": 12,
  "tags": [
    "Dinner",
    "Asian Inspired",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 40,
  "cover_image": "images/32a2097c87fc20e717a68cb8aeca9885.webp",
  "nutrition_tip": "这个鸡肉炒菜食谱用鸡肉片、蔬菜做起来又快又容易……",
  "ingredients": [
    {
      "name": "4 杯水",
      "amount": ""
    },
    {
      "name": "2 杯白米饭",
      "amount": ""
    },
    {
      "name": "0.66666668653488 杯 酱油",
      "amount": ""
    },
    {
      "name": "0.25 杯红糖",
      "amount": ""
    },
    {
      "name": "1 汤匙玉米淀粉",
      "amount": ""
    },
    {
      "name": "1 汤匙 鲜姜末",
      "amount": ""
    },
    {
      "name": "1 汤匙 蒜末",
      "amount": ""
    },
    {
      "name": "0.25 茶匙红辣椒片",
      "amount": ""
    },
    {
      "name": "3 块去皮去骨鸡胸肉，切成薄片",
      "amount": ""
    },
    {
      "name": "2汤匙芝麻油，分开",
      "amount": ""
    },
    {
      "name": "1 颗西兰花，切成小花",
      "amount": ""
    },
    {
      "name": "1 个洋葱，切成大块",
      "amount": ""
    },
    {
      "name": "1 杯胡萝卜片",
      "amount": ""
    },
    {
      "name": "1罐（8盎司）荸荠片，沥干",
      "amount": ""
    },
    {
      "name": "1 个青椒，切成火柴棍",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将水和米放入平底锅中，用大火煮沸。将火调至中低，盖上锅盖，小火煮 20 至 25 分钟，直至米饭变软且液体被吸收。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "同时，将酱油、红糖和玉米淀粉放入一个中等大小的玻璃或陶瓷碗中；搅拌至光滑。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "加入姜、蒜和红辣椒片搅拌；加入鸡肉，搅拌均匀。盖上盖子并在冰箱中腌制至少 15 分钟。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "在炒锅或大煎锅中用中高温加热 1 汤匙芝麻油。加入西兰花、洋葱、胡萝卜、荸荠和甜椒；煮约 5 分钟，搅拌直至变软。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "将蔬菜放入盘中；放在一边。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "在同一个炒锅或煎锅中用中高温加热剩余的 1 汤匙芝麻油。加入鸡肉，保留腌料，煮至褐色，每面约 2 分钟。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "拌入蔬菜和保留的腌料。煮沸；煮5到7分钟，搅拌直至鸡肉中心不再呈粉红色且蔬菜变软。"
    },
    {
      "step_index": 9,
      "img": "",
      "text": "浇在米饭上。"
    }
  ],
