  ],
  "difficulty": 1,
  "time_cost": 215,
  "cover_image": "images/b231fcc3dfad72e04d9846996d53601c.webp",
  "nutrition_tip": "这是最好的不伦瑞克炖菜！这是南方人最喜欢的配猪肉末......",
  "ingredients": [
    {
      "name": "1 汤匙橄榄油",
      "amount": ""
    },
    {
      "name": "1 杯切碎的洋葱",
      "amount": ""
    },
    {
      "name": "2 茎芹菜，切碎",
      "amount": ""
    },
    {
      "name": "1.5 磅碎猪肉",
      "amount": ""
    },
    {
      "name": "1.5 磅碎牛肉",
      "amount": ""
    },
    {
      "name": "1 只（3 磅）整只煮熟的鸡肉，去骨并切丝",
      "amount": ""
    },
    {
      "name": "3 罐（14.5 盎司）整罐去皮番茄，带液体，切碎",
      "amount": ""
    },
    {
      "name": "1 杯番茄酱",
      "amount": ""
    },
    {
      "name": "0.5 杯山核桃味烧烤酱",
      "amount": ""
    },
    {
      "name": "1 茶匙辣酱（适量）",
      "amount": ""
    },
    {
      "name": "盐和胡椒调味",
      "amount": ""
    },
    {
      "name": "1 个中等青椒",
      "amount": ""
    },
    {
      "name": "3 罐（14.75 盎司）奶油风格玉米",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "在一个大汤锅中用中火加热油。加入洋葱和芹菜；煮约 5 分钟，搅拌直至半透明。加入猪肉和牛肉拌匀；煮约 10 分钟，搅拌直至均匀变成棕色且易碎。不要排水。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "加入鸡丝、西红柿及其液体、番茄酱、烧烤酱、辣酱、盐和胡椒。将整个青椒浸入混合物中。将火调小，煮约 2 小时，偶尔搅拌，直至变稠。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "拌入玉米并继续煮 1 小时，或达到所需的稠度。去掉青椒；切碎并返回炖菜或丢弃。"
    }
  ],
