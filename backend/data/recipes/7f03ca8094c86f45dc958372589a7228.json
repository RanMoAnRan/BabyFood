      "amount": ""
    },
    {
      "name": "1 个洋葱，切丁",
      "amount": ""
    },
    {
      "name": "1 罐（16 盎司）番茄酱",
      "amount": ""
    },
    {
      "name": "1 杯番茄酱",
      "amount": ""
    },
    {
      "name": "0.25 杯红酒",
      "amount": ""
    },
    {
      "name": "2 汤匙切碎的新鲜罗勒",
      "amount": ""
    },
    {
      "name": "1 汤匙切碎的新鲜牛至",
