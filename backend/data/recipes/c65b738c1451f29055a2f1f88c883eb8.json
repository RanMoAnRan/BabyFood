{
  "id": "c65b738c1451f29055a2f1f88c883eb8",
  "title": "新英格兰蛤蜊浓汤",
  "min_age_month": 8,
  "tags": [
    "Soup",
    "New England",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 50,
  "cover_image": "images/688ebf12e235c643683f90a91ce68788.webp",
  "nutrition_tip": "这道新英格兰蛤蜊浓汤配有洋葱、土豆、蛤蜊和培根，味道浓郁……",
  "ingredients": [
    {
      "name": "4 片培根，切丁",
      "amount": ""
    },
    {
      "name": "1.5 杯切碎的洋葱",
      "amount": ""
    },
    {
      "name": "4 杯去皮切丁的土豆",
      "amount": ""
    },
    {
      "name": "1.5 杯水",
      "amount": ""
    },
    {
      "name": "1.5 茶匙盐",
      "amount": ""
    },
    {
      "name": "0.5 茶匙黑胡椒粉适量",
      "amount": ""
    },
    {
      "name": "3 杯对半",
      "amount": ""
    },
    {
      "name": "3 汤匙黄油",
      "amount": ""
    },
    {
      "name": "2 罐（10 盎司）蛤蜊碎",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将培根丁放入大汤锅中，中火加热；煮并搅拌直至几乎酥脆。加入洋葱；煮约 5 分钟，搅拌直至变软。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "拌入土豆，加水；用盐和胡椒调味并煮沸。将火调至小火，不盖锅盖，小火煮约 15 分钟，直至土豆变软。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "倒入一半并加入黄油。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将蛤蜊沥干，保留蛤蜊液；将蛤蜊和1/2的蛤蜊液倒入汤中搅拌。煮约 5 分钟，直至热透，但不要沸腾。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "上菜并享用！"
    }
  ],
