{
  "id": "2ea73636f49f3a5d8a1e606fa2be7e82",
  "title": "超级美味的托斯卡纳汤",
  "min_age_month": 8,
  "tags": [
    "Lunch",
    "Italian Inspired",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 75,
  "cover_image": "images/d2de279a55f3fba781ff781dbc3c2f21.webp",
  "nutrition_tip": "Zuppa Toscana 由香肠、土豆、奶油、菠菜和红辣椒片制成......",
  "ingredients": [
    {
      "name": "1 磅散装淡味意大利香肠",
      "amount": ""
    },
    {
      "name": "1.25 茶匙碎红辣椒片",
      "amount": ""
    },
    {
      "name": "4 片培根，切成 1/2 英寸的块",
      "amount": ""
    },
    {
      "name": "1 个大洋葱，切丁",
      "amount": ""
    },
    {
      "name": "1 汤匙 蒜末",
      "amount": ""
    },
    {
      "name": "5 罐（13.75 盎司）鸡汤",
      "amount": ""
    },
    {
      "name": "6 个中等大小的土豆，切成薄片",
      "amount": ""
    },
    {
      "name": "1 杯浓奶油",
      "amount": ""
    },
    {
      "name": "0.25 束新鲜菠菜，去除坚硬的茎",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将意大利香肠和红辣椒片放入荷兰烤箱中，用中火煮 10 到 15 分钟，直至变脆、变成棕色且不再呈粉红色。沥干并放在一边。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在同一个荷兰烤箱中用中火将培根煮至酥脆，大约需要 10 分钟。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "沥干，在荷兰烤箱的底部留下几汤匙培根的水滴。拌入洋葱和大蒜；煮约 5 分钟，直至洋葱变软且半透明。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "拌入鸡汤，用大火煮沸。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "加入土豆，小火煮约 20 分钟，直至叉子变软。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "将热量降至中等；加入奶油、煮熟的香肠和菠菜。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "煮并搅拌直至菠菜枯萎且香肠变热；服务。"
    }
  ],
