{
  "id": "b1ff5e1a077ebe2a08d90b77b8c9dc9e",
  "title": "自制狗零食（花生酱和南瓜）",
  "min_age_month": 12,
  "tags": [
    "Snack",
    "American",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 55,
  "cover_image": "images/60f634c6bfbc328e5be81d822f8c33db.webp",
  "nutrition_tip": "这些松脆的南瓜狗零食是用花生酱和全麦面粉制成的......",
  "ingredients": [
    {
      "name": "2.5 杯全麦面粉",
      "amount": ""
    },
    {
      "name": "2 个大鸡蛋",
      "amount": ""
    },
    {
      "name": "0.5 杯罐装南瓜",
      "amount": ""
    },
    {
      "name": "2 汤匙花生酱",
      "amount": ""
    },
    {
      "name": "0.5 茶匙盐",
      "amount": ""
    },
    {
      "name": "0.5 茶匙肉桂粉",
      "amount": ""
    },
    {
      "name": "1 茶匙水，或更多（如有必要）",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。将烤箱预热至 350 华氏度（175 摄氏度）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将面粉、鸡蛋、南瓜、花生酱、盐和肉桂放入碗中；用抹刀搅拌直至混合。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将混合物转移到工作表面并用手进行操作，直到混合物开始聚集在一起。一次添加 1 茶匙水（仅在需要时），以帮助面团变得容易加工，但不要添加太多，因为它应该又干又硬。将面团擀成 1/2 英寸的厚度。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "切成 1/2 英寸的块并转移到烤盘上。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "在预热的烤箱中烘烤约 40 分钟，直至狗粮呈金黄色且松脆。在给你的狗吃之前先让它冷却。"
    }
  ],
