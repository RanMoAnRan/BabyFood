{
  "id": "d2aaab688861493602179e2bfd005577",
  "title": "奶油芦笋汤",
  "min_age_month": 8,
  "tags": [
    "Soup",
    "American",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 40,
  "cover_image": "images/b2163ee691ff2741e10861b4e7b339a4.webp",
  "nutrition_tip": "这芦笋汤非常容易做，用新鲜芦笋、肉汤、酸奶油……",
  "ingredients": [
    {
      "name": "1 磅新鲜芦笋，修剪并切成 1 英寸的块",
      "amount": ""
    },
    {
      "name": "1罐（14.5盎司）鸡汤，分开",
      "amount": ""
    },
    {
      "name": "0.5 杯切碎的洋葱",
      "amount": ""
    },
    {
      "name": "2 汤匙黄油",
      "amount": ""
    },
    {
      "name": "2 汤匙通用面粉",
      "amount": ""
    },
    {
      "name": "1 茶匙盐",
      "amount": ""
    },
    {
      "name": "1 撮黑胡椒粉",
      "amount": ""
    },
    {
      "name": "1 杯牛奶",
      "amount": ""
    },
    {
      "name": "0.5 杯酸奶油",
      "amount": ""
    },
    {
      "name": "1 茶匙新鲜柠檬汁",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将芦笋、1/2 杯鸡汤和洋葱放入大锅中；盖上盖子并用大火煮沸。将火调至中低，不盖锅盖，小火煮约 12 分钟，直至芦笋变软。将混合物转移到搅拌机中；打成泥直至光滑并放在一边。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在同一个平底锅中，用中低火融化黄油。加入面粉、盐和胡椒粉搅拌；煮2分钟，不断搅拌。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将热量调至中等；加入剩余的鸡汤，不断搅拌，直到混合物沸腾。加入芦笋泥和牛奶。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将酸奶油放入小碗中，加入一勺热汤搅拌直至混合；倒入汤中，加入柠檬汁搅拌。将汤加热至食用温度，但不要沸腾。立即上菜。"
    }
  ],
