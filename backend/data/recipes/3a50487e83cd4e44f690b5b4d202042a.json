  ],
  "difficulty": 1,
  "time_cost": 45,
  "cover_image": "images/59872a7156f182851fa2048cd426e2a7.webp",
  "nutrition_tip": "这些墨西哥布努埃洛斯炸得金黄酥脆——撒上糖和碎辣椒……",
  "ingredients": [
    {
      "name": "4 个大鸡蛋",
      "amount": ""
    },
    {
      "name": "0.25 杯白糖",
      "amount": ""
    },
    {
      "name": "1 茶匙植物油",
      "amount": ""
    },
    {
      "name": "1.5 杯通用面粉，再加一些用于揉捏",
      "amount": ""
    },
    {
      "name": "1 茶匙泡打粉",
      "amount": ""
    },
    {
      "name": "1 茶匙盐",
      "amount": ""
    },
    {
      "name": "1 杯白糖",
      "amount": ""
    },
    {
      "name": "1 茶匙肉桂粉",
      "amount": ""
    },
    {
      "name": "1 杯煎炸植物油",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将鸡蛋和 1/4 杯糖放入一个大碗中，搅拌至浓稠并呈柠檬色；加入 1 茶匙植物油。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将 1 ½ 杯面粉、泡打粉和盐混合；逐渐加入鸡蛋混合物中，搅拌均匀直至混合均匀。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将面团放在撒有面粉的板上，充分揉捏直至面团光滑。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将面团分成 16 个大小均匀的球。将每个擀平并卷成直径约 5 英寸的非常薄的圆圈。不盖盖子，放在蜡纸上静置约 10 分钟。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "同时，将 1 杯糖和肉桂粉放入一个小碗中，直至混合均匀；放在一边。将深锅中的油加热至 350 华氏度（175 摄氏度）。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "小心地将一圈面团放入热油中；煎至金黄色，翻转一次，每面约30秒。转移到衬有纸巾的盘子上沥干；撒上肉桂糖混合物。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "对剩余的面团重复上述步骤。食用或完全冷却并储存在密封容器中。"
    }
  ],
