{
  "id": "18f1adfdfe1d44bc4e1574c5e95d272f",
  "title": "提前制作火鸡肉汁",
  "min_age_month": 8,
  "tags": [
    "Sauce",
    "American",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 195,
  "cover_image": "images/1c24b8daf05eee511ec45855940b6f14.webp",
  "nutrition_tip": "提前做好的火鸡肉汁，可以让您在感恩节那天腾出时间！烤肉…",
  "ingredients": [
    {
      "name": "6 个大火鸡翅",
      "amount": ""
    },
    {
      "name": "2 个中等大小的洋葱，去皮并切成四等分",
      "amount": ""
    },
    {
      "name": "1 杯水",
      "amount": ""
    },
    {
      "name": "8 杯鸡汤，分开",
      "amount": ""
    },
    {
      "name": "0.75 杯切碎的胡萝卜",
      "amount": ""
    },
    {
      "name": "0.5 茶匙干百里香",
      "amount": ""
    },
    {
      "name": "0.75 杯通用面粉",
      "amount": ""
    },
    {
      "name": "2 汤匙黄油",
      "amount": ""
    },
    {
      "name": "0.25 茶匙黑胡椒粉",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将烤箱预热至 400 华氏度（200 摄氏度）。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将火鸡翅单层放入大烤盘中；将洋葱撒在上面。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在预热的烤箱中烤至鸡翅变成棕色，大约需要 1 小时 15 分钟。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将鸡翅和洋葱转移到 5 夸脱的汤锅中。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "在烤盘中加水并搅拌，刮掉烤盘底部的棕色碎片。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "将水和锅屑倒入汤锅中。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "加入 6 杯鸡汤、胡萝卜和百里香，搅拌。用中高火煮沸。"
    },
    {
      "step_index": 9,
      "img": "",
      "text": "将火调至中低，不盖盖子小火煮 1 ½ 小时。"
    },
    {
      "step_index": 10,
      "img": "",
      "text": "将鸡翅转移到切菜板上，静置直至冷却到可以处理。剥去皮和肉。丢弃皮肤并保留肉以供其他用途。"
    },
    {
      "step_index": 11,
      "img": "",
      "text": "将汤锅中的内容物通过大过滤器倒入 3 夸脱的平底锅中。按压过滤器中的蔬菜以提取剩余的液体；丢弃蔬菜。"
    },
    {
      "step_index": 12,
      "img": "",
      "text": "撇去火鸡汤中的脂肪，然后慢慢煮沸。"
    },
    {
      "step_index": 13,
      "img": "",
      "text": "将面粉放入碗中剩余的 2 杯鸡汤中，搅拌至光滑。"
    },
    {
      "step_index": 14,
      "img": "",
      "text": "将面粉混合物逐渐搅拌到煮沸的火鸡汤中。小火煮 3 到 4 分钟，偶尔搅拌，直到肉汁变稠。拌入黄油和胡椒。"
    },
    {
      "step_index": 15,
      "img": "",
      "text": "立即食用，或冷却并存放在密封容器中。冷藏最多 3 天或冷冻最多 3 个月。"
    }
  ],
