      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 350 华氏度（175 摄氏度）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "切掉南瓜顶部；预订。刮出种子。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在南瓜腔内加入红糖和黄油；撒上肉桂粉。更换南瓜顶。将南瓜转移到底部有少量水的烤盘中。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在预热的烤箱中烘烤约30分钟直至变软。"
    }
