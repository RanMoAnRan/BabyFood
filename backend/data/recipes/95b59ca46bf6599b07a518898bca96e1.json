  "nutrition_tip": "烤鸡胸肉在烤箱中烹制，外皮酥脆可口，使用…",
  "ingredients": [
    {
      "name": "2 个大带皮带骨鸡胸肉",
      "amount": ""
    },
    {
      "name": "0.25 杯特级初榨橄榄油",
      "amount": ""
    },
    {
      "name": "0.5 茶匙大蒜，切碎",
      "amount": ""
    },
    {
      "name": "0.5 茶匙粗海盐",
      "amount": ""
    },
    {
      "name": "0.5 茶匙黑胡椒碎",
      "amount": ""
    },
    {
      "name": "0.25 茶匙干迷迭香",
      "amount": ""
    },
    {
      "name": "0.25 茶匙干罗勒",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "用橄榄油和大蒜擦鸡胸肉；撒上盐、黑胡椒、迷迭香和罗勒。将鸡肉放入一个大烤盘中。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "冷藏至少 45 分钟。同时，将烤箱预热至 375 华氏度（190 摄氏度）。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在预热的烤箱中烘烤 45 至 60 分钟，直至鸡肉骨头处不再呈粉红色且汁液清澈。插入胸肉最厚部分的即时读数温度计读数应为 165 华氏度（75 摄氏度）。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "趁热享用吧！"
    }
  ],
