  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "在一个大锅中用中火加热油。加入肉和洋葱；煮约 5 分钟，搅拌直至洋葱半透明。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "倒入番茄丁、辣椒、牛肉汤和智利辣椒。加入蒜盐和孜然。用盐和胡椒调味。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "煮沸，转小火，小火煮 1 小时。如果需要的话，在煨煮过程中再加一点牛肉汤或水。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "拌入土豆块，小火煮至土豆变软，再煮约 30 分钟。"
    }
