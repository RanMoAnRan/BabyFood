  "nutrition_tip": "这款香蕉西葫芦面包由于西葫芦丝和……而变得美味湿润。",
  "ingredients": [
    {
      "name": "3 个大鸡蛋",
      "amount": ""
    },
    {
      "name": "1 杯白糖",
      "amount": ""
    },
    {
      "name": "1 杯磨碎的西葫芦",
      "amount": ""
    },
    {
      "name": "0.75 杯植物油",
      "amount": ""
    },
    {
      "name": "2 根香蕉，捣碎",
      "amount": ""
    },
    {
      "name": "0.66666668653488 杯包装红糖",
      "amount": ""
    },
    {
      "name": "2 茶匙香草精",
      "amount": ""
    },
    {
      "name": "3.5 杯通用面粉",
      "amount": ""
    },
    {
      "name": "1 汤匙肉桂粉",
      "amount": ""
    },
    {
      "name": "1.5 茶匙泡打粉",
      "amount": ""
    },
    {
      "name": "1 茶匙小苏打",
      "amount": ""
    },
    {
      "name": "1 茶匙盐",
      "amount": ""
    },
    {
      "name": "0.5 杯蔓越莓干",
      "amount": ""
    },
    {
