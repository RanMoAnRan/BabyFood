  "nutrition_tip": "这种快速简单的海鲜烘焙以大比目鱼、扇贝和虾为特色……",
  "ingredients": [
    {
      "name": "2 块（4 盎司）大比目鱼片",
      "amount": ""
    },
    {
      "name": "6 个扇贝",
      "amount": ""
    },
    {
      "name": "6 只去皮去肠的大虾，尾巴仍连着",
      "amount": ""
    },
    {
      "name": "0.33333334326744 杯干白葡萄酒",
      "amount": ""
    },
    {
      "name": "2 汤匙融化的黄油",
      "amount": ""
    },
    {
      "name": "1 汤匙柠檬汁",
      "amount": ""
    },
    {
      "name": "1 茶匙蒜末",
      "amount": ""
    },
    {
      "name": "0.5 茶匙海鲜调味料，例如 Old Bay™",
      "amount": ""
    },
    {
      "name": "盐和胡椒调味",
      "amount": ""
    },
    {
      "name": "1 汤匙切碎的新鲜欧芹",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 450 华氏度（230 摄氏度）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将大比目鱼、扇贝和虾放入玻璃烤盘中。淋上葡萄酒、融化的黄油和柠檬汁。撒上大蒜和海鲜调味料，然后用盐和胡椒调味。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在预热的烤箱中烘烤 10 到 12 分钟，直至大比目鱼变白并用叉子轻松剥落。上菜前撒上欧芹。"
    }
  ],
