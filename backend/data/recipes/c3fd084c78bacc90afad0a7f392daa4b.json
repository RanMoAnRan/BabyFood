  "title": "绿番茄蛋糕",
  "min_age_month": 12,
  "tags": [
    "Dessert",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 75,
  "cover_image": "images/b5f083123e7cc5f1f31ecb1dcb41cb9c.webp",
  "nutrition_tip": "这个绿色番茄蛋糕食谱的特色是核桃、葡萄干、切碎的绿色番茄……",
  "ingredients": [
    {
      "name": "4 杯切碎的绿色西红柿",
      "amount": ""
    },
    {
      "name": "1 汤匙盐",
      "amount": ""
    },
    {
      "name": "2 杯白糖",
      "amount": ""
    },
    {
      "name": "0.5 杯黄油",
      "amount": ""
    },
    {
      "name": "2 个鸡蛋",
      "amount": ""
    },
    {
      "name": "2 杯通用面粉",
      "amount": ""
    },
    {
      "name": "1 茶匙肉桂粉",
      "amount": ""
    },
    {
      "name": "1 茶匙肉豆蔻粉",
      "amount": ""
    },
    {
      "name": "1 茶匙小苏打",
      "amount": ""
    },
    {
      "name": "0.25 茶匙盐",
      "amount": ""
    },
    {
      "name": "0.5 杯葡萄干",
      "amount": ""
    },
    {
      "name": "0.5 杯核桃碎",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 350 华氏度（175 摄氏度）。在 9x13 英寸的烤盘上涂上油脂并撒上面粉。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将切碎的西红柿放入碗中；撒上1汤匙盐。静置 10 分钟。转移到滤锅中；用冷水冲洗。流走。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "同时，将糖和黄油放入一个大碗中，用电动搅拌机搅拌至松软；加入鸡蛋，一次一个，每次添加后充分搅拌直至呈奶油状。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将面粉、肉桂、肉豆蔻、小苏打和 ¼ 茶匙盐放入碗中；拌入葡萄干和核桃。将面粉混合物搅拌到鸡蛋混合物中，直至充分混合。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将沥干的番茄放入面糊中搅拌直至充分混合。将面糊转移到准备好的烤盘中。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "在预热的烤箱中烘烤 40 到 45 分钟，直到插入中心的牙签拔出来时是干净的。"
    }
  ],
