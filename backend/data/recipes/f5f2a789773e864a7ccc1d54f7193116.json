{
  "id": "f5f2a789773e864a7ccc1d54f7193116",
  "title": "基本饼干",
  "min_age_month": 12,
  "tags": [
    "Breakfast",
    "Bread",
    "American",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 25,
  "cover_image": "images/df2b0b6b915616eb7f1b825cb715d948.webp",
  "nutrition_tip": "这个饼干食谱很容易从头开始制作美味的自制饼干......",
  "ingredients": [
    {
      "name": "2 杯通用面粉",
      "amount": ""
    },
    {
      "name": "1 汤匙发酵粉",
      "amount": ""
    },
    {
      "name": "0.5 茶匙盐",
      "amount": ""
    },
    {
      "name": "0.5 杯起酥油",
      "amount": ""
    },
    {
      "name": "0.75 杯冷牛奶",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料并将烤箱预热至 450 华氏度（230 摄氏度）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将面粉、泡打粉和盐一起过筛到一个大碗中；用叉子或糕点搅拌机切入起酥油，直到混合物看起来像粗面包屑。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将牛奶倒入面粉混合物中，同时用叉子搅拌。加入牛奶搅拌，直至面团变软、湿润并从碗的侧面拉开。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将面团翻到撒有少许面粉的表面上，短暂揉捏面团 5 到 7 次。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将面团擀成 1/2 英寸厚的薄片，然后用撒了面粉的饼干切刀切出饼干。将未使用的面团压在一起并重复滚动和切割过程。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "将饼干放在未抹油的烤盘上，然后在预热的烤箱中烘烤至金黄色，大约 10 分钟。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "享受吧！"
    }
  ],
