  "nutrition_tip": "这款混合烘烤南瓜馅饼甜点具有您喜欢的所有秋季风味。它&…",
  "ingredients": [
    {
      "name": "烹饪喷雾",
      "amount": ""
    },
    {
      "name": "0.5 杯白糖",
      "amount": ""
    },
    {
      "name": "2 个大鸡蛋，打散",
      "amount": ""
    },
    {
      "name": "1 罐（15 盎司）南瓜泥",
      "amount": ""
    },
    {
      "name": "0.75 杯淡奶",
      "amount": ""
    },
    {
      "name": "1 茶匙橙子提取物",
      "amount": ""
    },
    {
      "name": "1 茶匙肉桂粉",
      "amount": ""
    },
    {
      "name": "0.5 茶匙姜粉",
      "amount": ""
    },
    {
      "name": "0.25 茶匙丁香粉",
      "amount": ""
    },
    {
      "name": "0.25 茶匙盐",
      "amount": ""
    },
    {
      "name": "1 包（9 盎司）黄色蛋糕粉（例如 Jiffy® 金黄色蛋糕粉）",
      "amount": ""
    },
    {
      "name": "0.25 杯无盐黄油，融化",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。将烤箱预热至 350 华氏度（175 摄氏度）。在 8 英寸方形烤盘上喷洒烹饪喷雾。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将糖和鸡蛋放入碗中；搅拌至松软。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "加入南瓜泥、淡奶、橙汁、肉桂、生姜、丁香和盐；混合直至充分混合。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将南瓜混合物倒入准备好的烤盘中。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将蛋糕混合物轻轻撒在南瓜混合物上，直至完全覆盖。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "慢慢地将融化的黄油淋在蛋糕粉上。不要搅拌。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "在预热的烤箱中烘烤 50 分钟至 1 小时，直至南瓜混合物凝固且顶部呈金黄色。趁热食用前先静置一会儿。"
    }
  ],
