  "nutrition_tip": "龙舌兰日出是一种引人注目的双色调鸡尾酒，通过添加石榴糖浆制成......",
  "ingredients": [
    {
      "name": "2.5 杯冰，分开",
      "amount": ""
    },
    {
      "name": "4 液体盎司橙汁",
      "amount": ""
    },
    {
      "name": "2 液量盎司龙舌兰酒",
      "amount": ""
    },
    {
      "name": "0.75 液体盎司石榴糖浆",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在高球杯中倒入 1 1/2 杯冰块并放在一边。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将橙汁和龙舌兰酒放入鸡尾酒调酒器中混合；添加剩余的 1 杯冰。盖上盖子并摇动，直到摇酒器的外部结霜。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "滤入准备好的高球杯中。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "慢慢倒入石榴糖浆并静置。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "饮用前装饰并搅拌。"
    }
  ],
