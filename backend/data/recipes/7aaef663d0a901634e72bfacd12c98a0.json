  "title": "巧克力片苹果蛋糕",
  "min_age_month": 12,
  "tags": [
    "Dessert",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 90,
  "cover_image": "images/dceb16edfd50f77373005d14e8898d37.webp",
  "nutrition_tip": "这个巧克力片苹果蛋糕食谱采用新鲜苹果丁，增加水分……",
  "ingredients": [
    {
      "name": "2 杯白糖",
      "amount": ""
    },
    {
      "name": "1 杯黄油，软化",
      "amount": ""
    },
    {
      "name": "3 个大鸡蛋",
      "amount": ""
    },
    {
      "name": "0.5 杯水",
      "amount": ""
    },
    {
      "name": "1 汤匙香草精",
      "amount": ""
    },
    {
      "name": "2.5 杯通用面粉",
      "amount": ""
    },
    {
      "name": "2 汤匙不加糖可可粉",
      "amount": ""
    },
    {
      "name": "1 茶匙小苏打",
      "amount": ""
    },
    {
      "name": "1 茶匙肉桂粉",
      "amount": ""
    },
    {
      "name": "1 茶匙肉豆蔻粉",
      "amount": ""
    },
    {
      "name": "2 杯苹果 - 去皮、去核并切碎",
      "amount": ""
    },
    {
      "name": "1 杯半甜巧克力片",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 325 华氏度（165 摄氏度）。在 9 或 10 英寸的管盘（例如 Bundt）上涂上油脂并撒上面粉。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将糖和黄油放入碗中，用电动搅拌机搅拌至松软；打入鸡蛋，然后打入水和香草精。将面粉、可可粉、小苏打、肉桂和肉豆蔻放入另一个碗中，搅拌均匀；加入糖混合物中搅拌均匀。加入苹果和巧克力片搅拌直至均匀分布。将面糊倒入准备好的平底锅中。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在预热的烤箱中烘烤约 1 小时 15 分钟，直至插入靠近中心的牙签拔出来时是干净的。放在金属架上冷却。"
    }
  ],
