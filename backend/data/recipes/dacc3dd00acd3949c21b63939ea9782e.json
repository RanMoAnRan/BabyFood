{
  "id": "dacc3dd00acd3949c21b63939ea9782e",
  "title": "蛋酒芝士蛋糕",
  "min_age_month": 12,
  "tags": [
    "Dessert",
    "American",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 85,
  "cover_image": "images/3e27652ec861d04e8bde66bb17d45e6f.webp",
  "nutrition_tip": "这个蛋酒芝士蛋糕，里面有颓废的奶油芝士和蛋酒馅料......",
  "ingredients": [
    {
      "name": "1 杯全麦饼干屑",
      "amount": ""
    },
    {
      "name": "3 汤匙融化的黄油",
      "amount": ""
    },
    {
      "name": "2汤匙白糖",
      "amount": ""
    },
    {
      "name": "3 包（8 盎司）奶油干酪，软化",
      "amount": ""
    },
    {
      "name": "1 杯白糖",
      "amount": ""
    },
    {
      "name": "0.75 杯蛋酒",
      "amount": ""
    },
    {
      "name": "3 汤匙通用面粉",
      "amount": ""
    },
    {
      "name": "2 个鸡蛋",
      "amount": ""
    },
    {
      "name": "2 汤匙朗姆酒",
      "amount": ""
    },
    {
      "name": "1 撮 肉豆蔻粉",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 325 华氏度（165 摄氏度）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "制作面包皮：将全麦饼干屑、融化的黄油和糖放入一个中等大小的碗中，直至充分混合。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将全麦混合物压入 9 英寸弹簧盘的底部。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "放入预热好的烤箱烤10分钟；将锅转移到金属架上，让外壳冷却。将烤箱温度提高到 425 华氏度（220 摄氏度）。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "当外皮冷却时，制作馅料：将奶油干酪、糖、蛋酒和面粉放入食品加工机中混合；过程直至顺利。加入鸡蛋、朗姆酒和肉豆蔻。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "将蛋酒混合物倒入冷却的外壳中。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "在预热好的烤箱中烘烤10分钟。将热量降低至 250 华氏度（120 摄氏度）并继续烘烤，直到边缘膨化且表面坚硬（除了中心的一个小点，当轻轻摇动平底锅时，该点会摇晃），大约需要 45 分钟。松开弹簧盘的两侧；让芝士蛋糕冷却，然后完全去除边缘。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "享受吧！"
    }
  ],
