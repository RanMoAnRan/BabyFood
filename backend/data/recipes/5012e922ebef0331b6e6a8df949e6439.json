  "nutrition_tip": "美味可口的蘑菇酱，由新鲜蘑菇、青葱、牛肉干制成……",
  "ingredients": [
    {
      "name": "0.25 杯黄油",
      "amount": ""
    },
    {
      "name": "2 杯新鲜切片蘑菇",
      "amount": ""
    },
    {
      "name": "1 汤匙黄油",
      "amount": ""
    },
    {
      "name": "1 汤匙青葱，切碎",
      "amount": ""
    },
    {
      "name": "0.5 杯切碎的蘑菇",
      "amount": ""
    },
    {
      "name": "0.25 杯红酒",
      "amount": ""
    },
    {
      "name": "0.5 茶匙干百里香",
      "amount": ""
    },
    {
      "name": "1 片月桂叶",
      "amount": ""
    },
    {
      "name": "2 杯牛肉汤",
      "amount": ""
    },
    {
      "name": "1 汤匙葛根粉",
      "amount": ""
    },
    {
      "name": "加盐调味",
      "amount": ""
    },
    {
      "name": "现磨黑胡椒",
