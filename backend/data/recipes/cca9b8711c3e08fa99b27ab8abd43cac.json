  "id": "cca9b8711c3e08fa99b27ab8abd43cac",
  "title": "七叶树球",
  "min_age_month": 12,
  "tags": [
    "Dessert",
    "U.S.",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 85,
  "cover_image": "images/b324d3c411c47c74385611214902aa84.webp",
  "nutrition_tip": "七叶树球是美味的巧克力球，加甜花生酱。…",
  "ingredients": [
    {
      "name": "4 杯过筛的糖果糖",
      "amount": ""
    },
    {
      "name": "1.5 杯奶油花生酱",
      "amount": ""
    },
    {
      "name": "0.5 杯无盐黄油，软化",
      "amount": ""
    },
    {
      "name": "1 茶匙香草精",
      "amount": ""
    },
    {
      "name": "6 盎司半甜巧克力片",
      "amount": ""
    },
    {
      "name": "2 汤匙起酥油",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。在烤盘上铺上蜡纸；放在一边。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "联合糖果厂的糖、花生酱、黄油和香草精放入一个大碗中；用手搅拌成光滑硬面团。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "每个球使用 2 茶匙面团塑造成球状。放在准备好的烤盘上并冷藏，直到准备好涂上巧克力。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将巧克力片和起酥油放入金属碗中，放在一锅沸水中。偶尔搅拌直至融化且光滑。从火上移开。从冰箱中取出冷冻的花生酱球。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将木牙签插入球中，然后浸入融化的巧克力中直至涂上涂层。返回烤盘，巧克力面朝下，然后取出牙签。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "重复步骤 5 以涂覆剩余的球。将涂有涂层的球冷藏约 30 分钟直至凝固。"
    }
  ],
