{
  "id": "15c31affe2d376adf55634228bebe60e",
  "title": "黑豆玉米饼",
  "min_age_month": 12,
  "tags": [],
  "difficulty": 1,
  "time_cost": 0,
  "cover_image": "images/1a70afe2d98998fb4bd530b362e41c6e.webp",
  "nutrition_tip": "一周中的任何一个晚上都可以享用玉米饼！这个油炸玉米粉饼食谱可以提供......",
  "ingredients": [],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "使用小孔过滤器，排出莎莎酱中的液体；丢弃液体。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将剩余的番茄混合物转移到一个中等大小的碗中。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "加入黑豆、奶酪和香菜直至混合。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将黑豆混合物均匀地分布在每个玉米饼的一半上（每个约 1/2 杯）。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将玉米饼对折。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "用中高温加热大煎锅或煎锅。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "刷上油。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "将填满的玉米饼放在煎锅上。"
    },
    {
      "step_index": 9,
      "img": "",
      "text": "烹饪，小心地翻转一次，直到玉米饼呈金黄色、酥脆且奶酪馅料融化，大约需要 5 分钟。"
    },
    {
      "step_index": 10,
      "img": "",
      "text": "将玉米饼切成楔形。"
    }
  ],
