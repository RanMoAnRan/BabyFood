{
  "id": "a0f328896a97c6a007f4753fa27553fe",
  "title": "早餐卷饼",
  "min_age_month": 12,
  "tags": [],
  "difficulty": 1,
  "time_cost": 0,
  "cover_image": "images/0ef7118c2267f9b92769def9c8649c56.webp",
  "nutrition_tip": "在开始新的一天时带上这份早餐卷饼。",
  "ingredients": [],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将鸡蛋、牛奶和调味料放入碗中混合。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在煎锅中用中高火加热油（电煎锅中为 350 度）。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "加入鸡蛋，煮至变硬。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将玉米饼放在煎锅上加热，或用箔纸包裹并在烤箱中加热。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "在另一个平底锅中加热炸豆泥。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "在每个玉米饼上铺上 1/4 的炸豆泥、鸡蛋、奶酪和番茄。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "将卷饼卷起来，切成两半，然后享用吧！"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "在 2 小时内将剩菜冷藏。"
    }
  ],
  "warnings": [],
