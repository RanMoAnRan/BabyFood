{
  "id": "209acb5f8da1a3177ce8cd333c316b4e",
  "title": "最好的焦糖苹果",
  "min_age_month": 12,
  "tags": [
    "Dessert",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 135,
  "cover_image": "images/bb52c6670bd1755fb09f4a4625f2c33b.webp",
  "nutrition_tip": "最好的焦糖苹果配方会在酸苹果上涂上浓郁的焦糖。洒…",
  "ingredients": [
    {
      "name": "8 个大酸苹果",
      "amount": ""
    },
    {
      "name": "8 根木柄筷子",
      "amount": ""
    },
    {
      "name": "2 杯包装红糖",
      "amount": ""
    },
    {
      "name": "1 罐（14 盎司）甜炼乳",
      "amount": ""
    },
    {
      "name": "1 杯淡玉米糖浆",
      "amount": ""
    },
    {
      "name": "1 杯黄油",
      "amount": ""
    },
    {
      "name": "2 茶匙香草精",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将一大锅水烧开。用漏勺将苹果浸入水中几秒钟，以除去皮上的蜡；用纸巾擦干。让其冷却。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将木棍插入每个苹果的底部核心。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在烤盘上铺上羊皮纸。将红糖、甜炼乳、玉米糖浆和黄油放入中型平底锅中，用中高温搅拌。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "煮沸，不断搅拌；将热量降低至中等。煮 25 至 30 分钟，直至糖果温度计读数为 248 华氏度（120 摄氏度），不断搅拌以防止燃烧。将一茶匙焦糖放入一杯冷水中，应形成一个坚硬的球。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "远离火源；加入香草精搅拌。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "快速操作，将每个苹果浸入焦糖中，以完全覆盖苹果和大约 1/2 英寸的手柄。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "趁热在苹果上撒上所需的配料。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "在准备好的烤盘上冷却约1小时。请小心，焦糖非常热。"
    }
  ],
