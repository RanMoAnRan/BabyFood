  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将烤箱预热至 375 华氏度（190 摄氏度）。在 9 英寸方形烤盘上涂上少许油脂。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将面粉、白糖、红糖、泡打粉、小苏打、肉桂、丁香、生姜、肉豆蔻和盐一起过筛到碗中。将南瓜泥、菜籽油和香草精加入面粉混合物中，搅拌直至形成浓稠的面糊。将面糊倒入准备好的烤盘中。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在预热的烤箱中烘烤 20 分钟，直到插入中心的牙签拔出来时是干净的。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "从烤箱中取出并完全冷却，然后切成 1 1/2 英寸的方块。"
    }
  ],
