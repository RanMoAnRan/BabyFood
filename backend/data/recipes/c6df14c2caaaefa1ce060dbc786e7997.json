  "nutrition_tip": "这个桃子烤鸡食谱结合了桃子和兄弟的甜味......",
  "ingredients": [
    {
      "name": "8 块去皮去骨鸡胸肉",
      "amount": ""
    },
    {
      "name": "1 杯红糖",
      "amount": ""
    },
    {
      "name": "4 个新鲜桃子 - 去皮、去核、切片",
      "amount": ""
    },
    {
      "name": "2 汤匙新鲜柠檬汁",
      "amount": ""
    },
    {
      "name": "0.125 茶匙姜粉",
      "amount": ""
    },
    {
      "name": "0.125 茶匙丁香粉",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 350 华氏度（175 摄氏度）。在 9x13 英寸的烤盘上涂上少许油脂。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将鸡肉放入准备好的烤盘中；撒上 ½ 杯红糖。将桃片放在鸡肉上；撒上剩余的 ½ 杯红糖、柠檬汁、生姜和丁香。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在预热的烤箱中烘烤，经常涂上果汁，直到鸡肉煮熟且果汁清澈，大约需要 30 分钟。"
    }
  ],
