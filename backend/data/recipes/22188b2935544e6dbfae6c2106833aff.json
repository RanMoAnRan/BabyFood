  "nutrition_tip": "这个蔓越莓酱配方结合了新鲜蔓越莓、糖和橙汁……",
  "ingredients": [
    {
      "name": "1 杯白糖",
      "amount": ""
    },
    {
      "name": "1 杯橙汁",
      "amount": ""
    },
    {
      "name": "12 盎司蔓越莓",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "在中型平底锅中用中火加热糖和果汁，直至糖溶解。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "添加蔓越莓；煮8到10分钟，直到它们开始爆裂并且酱汁开始变稠。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "从火上移开并将酱汁转移到碗中；冷却时它会变稠。"
    }
  ],
