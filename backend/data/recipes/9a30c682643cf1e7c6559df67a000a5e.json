{
  "id": "9a30c682643cf1e7c6559df67a000a5e",
  "title": "简易羊乳酪番茄意大利面",
  "min_age_month": 12,
  "tags": [
    "Dinner",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 20,
  "cover_image": "images/9023c8a8e9dde8ff8910080194cf439f.webp",
  "nutrition_tip": "这道羊乳酪番茄意大利面很容易用任何短意大利面、樱桃番茄制作......",
  "ingredients": [
    {
      "name": "1 包（12 盎司）通心粉",
      "amount": ""
    },
    {
      "name": "0.33333334326744 杯特级初榨橄榄油",
      "amount": ""
    },
    {
      "name": "16 盎司 樱桃番茄，减半",
      "amount": ""
    },
    {
      "name": "盐和现磨黑胡椒粉适量",
      "amount": ""
    },
    {
      "name": "2 杯碎羊奶酪",
      "amount": ""
    },
    {
      "name": "3 汤匙切碎的新鲜罗勒",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将一大锅淡盐水煮沸。加入通心粉，煮约 11 分钟，不时搅拌，直至口感变软且坚硬。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "同时，在平底锅中用中高温加热橄榄油。加入西红柿和盐调味。轻轻煮5到10分钟，偶尔搅拌，直到西红柿变软并释放出汁液。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将意大利面沥干，立即加入西红柿锅中。将热量降至最低并搅拌均匀。加入羊奶酪和罗勒，搅拌均匀。用盐和胡椒调味。立即上菜。"
    }
  ],
