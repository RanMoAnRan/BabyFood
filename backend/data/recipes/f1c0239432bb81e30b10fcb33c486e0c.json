  "title": "秋季阳光鸡尾酒",
  "min_age_month": 12,
  "tags": [
    "Drink",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 10,
  "cover_image": "images/37b2cd84b3bbc024d41304e10bf56e64.webp",
  "nutrition_tip": "这款金色的秋日阳光鸡尾酒配方是用枫糖浆、Grand Mar 制成的……",
  "ingredients": [
    {
      "name": "6 块冰块",
      "amount": ""
    },
    {
      "name": "2 液量盎司波本威士忌",
      "amount": ""
    },
    {
      "name": "1 液体盎司枫糖浆",
      "amount": ""
    },
    {
      "name": "1 液量盎司白兰地橙利口酒（例如 Grand Marnier®）",
      "amount": ""
    },
    {
      "name": "1 个小柑橘，榨汁并去皮，切成 1x1/4 英寸的条",
      "amount": ""
    },
    {
      "name": "0.5 个柠檬，榨汁",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将冰块放入鸡尾酒调酒器中；添加波本威士忌、枫糖浆、橙子利口酒、柑橘汁和柠檬汁。盖上盖子并摇动，直至摇酒器外部结霜（约 15 秒）。滤入冰镇的马提尼杯中。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在鸡尾酒上点燃火柴或打火机；在火焰附近挤压小柑橘果皮条以点燃果皮油。在玻璃边缘擦去皮；将果皮放入鸡尾酒中。"
    }
  ],
