  "title": "草莓酥饼",
  "min_age_month": 12,
  "tags": [
    "Dessert",
    "American",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 60,
  "cover_image": "images/7ef37220e6d0510641096860a25441a3.webp",
  "nutrition_tip": "这款草莓酥饼的特色是饼干式酥饼，上面分层有甜……",
  "ingredients": [
    {
      "name": "3 品脱新鲜草莓",
      "amount": ""
    },
    {
      "name": "0.5 杯白糖",
      "amount": ""
    },
    {
      "name": "2.25 杯通用面粉",
      "amount": ""
    },
    {
      "name": "2 汤匙白糖",
      "amount": ""
    },
    {
      "name": "4 茶匙泡打粉",
      "amount": ""
    },
    {
      "name": "0.25 茶匙盐",
      "amount": ""
    },
    {
      "name": "0.33333334326744 罩杯缩短",
      "amount": ""
    },
    {
      "name": "1 个鸡蛋",
      "amount": ""
    },
    {
      "name": "3/4 杯半杯",
      "amount": ""
    },
    {
      "name": "2 茶匙香草精，分开",
      "amount": ""
    },
    {
      "name": "2 杯鲜奶油",
      "amount": ""
    },
    {
      "name": "1/4 杯糖粉",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将烤箱预热至 425 华氏度（220 摄氏度）。在 8 英寸蛋糕盘上涂上黄油，并轻轻撒上面粉。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将草莓切片并与 1/3 杯白糖拌匀。放在一边。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将面粉、1/4 杯白糖、泡打粉和盐放入一个中等大小的碗中；用糕点搅拌机或两把刀切黄油，直到混合物看起来像粗面包屑。在混合物的中心挖一个井；加入打散的鸡蛋、半个鸡蛋和一茶匙香草精。搅拌混合物直至完全混合且没有干点残留，小心不要过度混合。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将面糊均匀地舀入准备好的蛋糕盘中。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "放入预热好的烤箱中烘烤约18分钟，直至用牙签插入蛋糕，取出时干净且顶部呈金黄色。在蛋糕盘中部分冷却约 10 分钟。将蛋糕翻转到干净的工作表面上。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "同时，用电动搅拌机中高速搅拌浓奶油、糖粉和剩余的 1 茶匙香草精，直至形成软峰，大约需要 3 分钟。放在一边。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "将部分冷却的蛋糕水平切成两半，制作两层；将顶层放在一边。将保留的草莓放入放在小碗上的漏勺中沥干，保留汁液。将草莓汁均匀地刷在底部蛋糕层上。将 1/2 沥干的草莓均匀地放在蛋糕的底层上。"
    },
    {
      "step_index": 9,
      "img": "",
      "text": "将 1/2 生奶油均匀涂抹在草莓上；将顶部蛋糕层放在生奶油上。上面放上剩余的草莓和生奶油。"
    },
    {
      "step_index": 10,
      "img": "",
      "text": "享受吧！"
    }
  ],
