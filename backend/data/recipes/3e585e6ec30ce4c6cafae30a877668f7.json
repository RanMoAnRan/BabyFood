  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将烤架预热至高温。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在一个小碗中，将大蒜粉、洋葱粉、辣椒粉、柠檬胡椒和海盐搅拌在一起。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将调味料撒在鱼上。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "在小平底锅中，用中火将黄油、大蒜和欧芹融化。黄油融化后从火上移开，放在一边。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "在烤架上涂抹少许油。将鱼烤 7 分钟，然后翻转并淋上黄油。继续烹饪 7 分钟，或直至用叉子轻松剥落。食用前淋上橄榄油。"
    }
  ],
