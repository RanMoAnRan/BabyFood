  "nutrition_tip": "Sloppy Joes 很容易用瘦碎牛肉、基本食品配料和……制作。",
  "ingredients": [
    {
      "name": "1 磅瘦碎牛肉",
      "amount": ""
    },
    {
      "name": "0.25 杯切碎的洋葱",
      "amount": ""
    },
    {
      "name": "0.25 杯切碎的青椒",
      "amount": ""
    },
    {
      "name": "0.75 杯番茄酱，或适量",
      "amount": ""
    },
    {
      "name": "1 汤匙红糖，或适量",
      "amount": ""
    },
    {
      "name": "1 茶匙黄芥末，或适量",
      "amount": ""
    },
    {
      "name": "0.5 茶匙大蒜粉",
      "amount": ""
    },
    {
      "name": "盐和黑胡椒粉适量",
      "amount": ""
    },
    {
      "name": "6 个汉堡面包，分割",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "用中火加热一个大煎锅。在热煎锅中煮并搅拌瘦碎牛肉，直到一些脂肪开始呈现，持续 3 到 4 分钟。加入洋葱和彩椒；继续煮 3 到 5 分钟，直到蔬菜变软，牛肉煮熟。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "加入番茄酱、红糖、芥末和蒜粉；用盐和胡椒调味。将火调至小火，煮 20 至 30 分钟。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将肉混合物均匀地分配到汉堡包中。"
    }
  ],
