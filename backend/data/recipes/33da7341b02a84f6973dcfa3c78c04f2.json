{
  "id": "33da7341b02a84f6973dcfa3c78c04f2",
  "title": "桃子烤薄饼",
  "min_age_month": 12,
  "tags": [
    "Breakfast",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 35,
  "cover_image": "images/71ec492379f4bf43a692d2df3771778a.webp",
  "nutrition_tip": "如果你早餐喜欢桃子，这个烤煎饼的食谱，上面放着……",
  "ingredients": [
    {
      "name": "1 汤匙黄油",
      "amount": ""
    },
    {
      "name": "2 个大桃子，去皮并切成 1/4 英寸的片",
      "amount": ""
    },
    {
      "name": "1汤匙红糖",
      "amount": ""
    },
    {
      "name": "1 茶匙肉桂粉",
      "amount": ""
    },
    {
      "name": "3 个鸡蛋",
      "amount": ""
    },
    {
      "name": "0.5 杯牛奶",
      "amount": ""
    },
    {
      "name": "0.5 杯通用面粉",
      "amount": ""
    },
    {
      "name": "1 滴香草精",
      "amount": ""
    },
    {
      "name": "1 撮盐",
      "amount": ""
    },
    {
      "name": "1 撮 肉豆蔻粉",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 425 华氏度（220 摄氏度）。将黄油放入铸铁煎锅中；将煎锅放入烤箱直至融化。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将桃子、红糖和肉桂轻轻放入碗中，直至均匀涂上。放在一边。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将鸡蛋、牛奶、面粉、香草精、盐和肉豆蔻放入一个中等大小的碗中，搅拌均匀，但稍微结块。将面糊倒入热锅中；将桃子放在上面。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在预热的烤箱中烘烤约 20 分钟，直至中心凝固。"
    }
  ],
