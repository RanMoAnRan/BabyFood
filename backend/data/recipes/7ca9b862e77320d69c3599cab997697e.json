  "id": "7ca9b862e77320d69c3599cab997697e",
  "title": "花生酱杯饼干",
  "min_age_month": 12,
  "tags": [
    "Dessert",
    "American",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 35,
  "cover_image": "images/e7be858ef0927babdfdfc25454847124.webp",
  "nutrition_tip": "这些可爱的花生酱杯饼干很容易在迷你松饼锅中制作......",
  "ingredients": [
    {
      "name": "1.75 杯通用面粉",
      "amount": ""
    },
    {
      "name": "0.5 茶匙盐",
      "amount": ""
    },
    {
      "name": "1 茶匙小苏打",
      "amount": ""
    },
    {
      "name": "0.5 杯黄油，软化",
      "amount": ""
    },
    {
      "name": "0.5 杯白糖",
      "amount": ""
    },
    {
      "name": "0.5 杯花生酱",
      "amount": ""
    },
    {
      "name": "0.5 杯包装红糖",
      "amount": ""
    },
    {
      "name": "1 个鸡蛋，打散",
      "amount": ""
    },
    {
      "name": "1 茶匙香草精",
      "amount": ""
    },
    {
      "name": "2 汤匙牛奶",
      "amount": ""
    },
    {
      "name": "40 个微型巧克力花生酱杯，未包装",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 375 华氏度（190 摄氏度）。将面粉、盐和小苏打一起筛入碗中；放在一边。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在另一个碗中将黄油、糖、花生酱和红糖一起搅打至蓬松。加入鸡蛋、香草精和牛奶。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "加入面粉混合物；搅拌均匀。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "分成 40 个球，并将每个球放入未抹油的迷你松饼盘中。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "在预热好的烤箱中烘烤8分钟。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "从烤箱中取出，立即将一个迷你花生酱杯压入每个球中。让饼干冷却，然后小心地将它们从锅中取出。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "享受吧！"
    }
  ],
