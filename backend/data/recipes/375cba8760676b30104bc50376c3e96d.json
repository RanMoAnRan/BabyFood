  "difficulty": 1,
  "time_cost": 60,
  "cover_image": "images/4e2f25a074f7f84555bc74fa8a093288.webp",
  "nutrition_tip": "流行的菲律宾街头小吃 Kwek Kwek 是亮橙色的面糊和深焦…",
  "ingredients": [
    {
      "name": "12 个鹌鹑蛋",
      "amount": ""
    },
    {
      "name": "0.25 杯米醋",
      "amount": ""
    },
    {
      "name": "0.25 杯番茄酱",
      "amount": ""
    },
    {
      "name": "0.25 杯红糖",
      "amount": ""
    },
    {
      "name": "2茶匙酱油",
      "amount": ""
    },
    {
      "name": "0.5 杯水",
      "amount": ""
    },
    {
      "name": "1 滴黄色食用色素",
      "amount": ""
    },
    {
      "name": "1 滴红色食用色素",
      "amount": ""
    },
    {
      "name": "1 杯通用面粉",
      "amount": ""
    },
    {
      "name": "盐和现磨黑胡椒粉适量",
      "amount": ""
    },
    {
      "name": "油炸用油",
      "amount": ""
    },
    {
      "name": "0.25 杯玉米淀粉",
      "amount": ""
    },
    {
      "name": "竹串",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将鸡蛋放入平底锅中，盖上水。煮沸，将火调至中火，盖上锅盖，煮 4 分钟。从火上移开，盖上盖子静置 2 分钟。将鸡蛋用冷水冲洗干净，冷却至室温；果皮。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将米醋、番茄酱、红糖和酱油放入平底锅中混合。用中火煮约 5 分钟，直至糖溶解。让其冷却。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在水中添加红色和黄色食用色素来制备面糊，以获得深橙色。将面粉、盐和胡椒粉放入碗中；倒入橙水并搅拌直至没有结块。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将锅中的油加热至 375 华氏度（190 摄氏度）。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将鸡蛋轻轻地放入玉米淀粉中滚动，以覆盖并抖落多余的玉米淀粉。浸入橙色面糊中，使它们完全覆盖。用竹签将鸡蛋戳破，轻轻放入热油中。炸至面糊酥脆，每面约 2 分钟。用漏勺取出鸡蛋并用纸巾沥干。"
    }
  ],
