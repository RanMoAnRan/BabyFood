  "nutrition_tip": "盒子里的东西变得更美味了！轻松升级（包括...",
  "ingredients": [
    {
      "name": "1 茶匙黄油，或根据需要",
      "amount": ""
    },
    {
      "name": "2 汤匙橄榄油",
      "amount": ""
    },
    {
      "name": "0.25 杯 黄洋葱丁",
      "amount": ""
    },
    {
      "name": "0.25 杯切碎的芹菜",
      "amount": ""
    },
    {
      "name": "0.25 杯葱花",
      "amount": ""
    },
    {
      "name": "1 个中等大小的梨，去核并切丁",
      "amount": ""
    },
    {
      "name": "0.25 茶匙蒜末",
      "amount": ""
    },
    {
      "name": "2 盒（6 盎司）干面包馅料混合物",
      "amount": ""
    },
    {
      "name": "0.25 杯切碎的新鲜欧芹",
      "amount": ""
    },
    {
      "name": "1 罐（32 盎司）鸡汤",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。将烤箱预热至 350 华氏度（175 摄氏度）。在 9x13 英寸的烤盘上涂黄油。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在煎锅中用中火加热橄榄油。加入洋葱、芹菜、葱、梨和大蒜；煮约 10 分钟，搅拌直至蔬菜变软。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将馅料混合物放入一个大搅拌碗中。拌入煮熟的蔬菜和欧芹。加入鸡汤，一次 1 杯，搅拌直至肉汤被馅料吸收，馅料达到所需的稠度。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "用勺子将馅料放入准备好的锅中。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "放入预热好的烤箱中烘烤约30分钟，直至表面呈金黄色。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "上菜并享用！"
    }
  ],
