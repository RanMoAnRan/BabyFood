{
  "id": "04ace134fd2040781f8b94aa84c08088",
  "title": "香蕉奶油派",
  "min_age_month": 8,
  "tags": [
    "Dessert",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 220,
  "cover_image": "images/7d6281168d805fcbe985163601b81abd.webp",
  "nutrition_tip": "这个美味的香蕉奶油派是用很多香蕉和浓郁的奶油自制的……",
  "ingredients": [
    {
      "name": "0.75 杯白糖",
      "amount": ""
    },
    {
      "name": "0.33333334326744 杯通用面粉",
      "amount": ""
    },
    {
      "name": "0.25 茶匙盐",
      "amount": ""
    },
    {
      "name": "2 杯牛奶",
      "amount": ""
    },
    {
      "name": "3 个蛋黄，打散",
      "amount": ""
    },
    {
      "name": "2 汤匙黄油",
      "amount": ""
    },
    {
      "name": "1.25 茶匙香草精",
      "amount": ""
    },
    {
      "name": "1 个（9 英寸）烤糕点壳，冷却",
      "amount": ""
    },
    {
      "name": "4 根香蕉，切片",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。将烤箱预热至 350 华氏度（175 摄氏度）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将糖、面粉和盐放入平底锅中混合。逐渐加入牛奶搅拌。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "用中火煮，不断搅拌，直到混合物沸腾并变稠。继续煮并搅拌 2 分钟，然后离火。将蛋黄放入一个中等大小的碗中；加入少量热牛奶混合物搅拌至光滑，然后将蛋黄混合物逐渐搅拌到平底锅中。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "用中低火煮，不断搅拌，直到混合物覆盖在勺子背面，大约再煮 2 分钟。从火上移开，加入黄油和香草精搅拌。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "用切片香蕉填充糕点壳；将布丁混合物倒在上面盖住。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "在预热的烤箱中烘烤 12 至 15 分钟，直至馅料凝固。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "让馅饼在金属架上完全冷却，然后在食用前将馅饼放入冰箱中冷却至少 1 小时。"
    }
  ],
