  "nutrition_tip": "这款西班牙咖啡鸡尾酒添加了超标朗姆酒、三秒咖啡和咖啡……",
  "ingredients": [
    {
      "name": "1.5 茶匙超细糖",
      "amount": ""
    },
    {
      "name": "1 液量盎司 151 度朗姆酒",
      "amount": ""
    },
    {
      "name": "0.75 液量盎司三秒（例如 Bols®）",
      "amount": ""
    },
    {
      "name": "2.5 液量盎司咖啡味利口酒（例如 Kahlua®）",
      "amount": ""
    },
    {
      "name": "0.5 杯现煮咖啡",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将糖倒入浅盘中。将酒杯或爱尔兰咖啡杯的边缘打湿，然后浸入糖中。添加朗姆酒和三秒。使用长火柴或打火机小心地点燃混合物。慢慢转动玻璃杯，直到糖开始焦糖化。倒入咖啡利口酒以熄灭火焰。上面放上热咖啡。"
    }
