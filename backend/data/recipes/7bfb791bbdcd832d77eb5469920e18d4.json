  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在大汤锅中用中火加热油。加入洋葱、胡萝卜和芹菜；煮并搅拌 3 至 5 分钟，直至洋葱变软。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "加入大蒜、月桂叶、牛至和罗勒；煮2分钟。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "拌入扁豆，加水和西红柿。煮沸。调小火，煮约 40 分钟，直至扁豆变软。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "准备食用时，拌入菠菜，煮至其枯萎。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "拌入醋，加盐和胡椒调味；品尝并根据需要进行调整。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "趁热享用吧！"
    }
  ],
