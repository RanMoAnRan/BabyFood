{
  "id": "d3b52b51b5be0814d3d19c257571985d",
  "title": "香蕉浆果松饼",
  "min_age_month": 12,
  "tags": [],
  "difficulty": 1,
  "time_cost": 0,
  "cover_image": "images/7f40af555c8ff9cf3a1dc4114e2dcd2b.webp",
  "nutrition_tip": "为这些湿润的松饼提供果味和全麦的美味......",
  "ingredients": [],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 350 °F。在 12 杯松饼盘上喷洒不粘烹饪喷雾。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在一个中等大小的碗中，将苹果酱、糖、干鸡蛋混合物、香蕉和水混合。搅拌均匀。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在一个大碗中混合面粉、燕麦、泡打粉、小苏打和盐。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将苹果酱混合物与干原料一起放入碗中；搅拌直至面糊湿润。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "轻轻地将浆果添加到混合物中。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "将每个松饼杯装满约 3/4 面糊。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "烘烤 25-30 分钟直至呈浅棕色。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "冷却 10 分钟，然后从锅中取出。"
    }
  ],
