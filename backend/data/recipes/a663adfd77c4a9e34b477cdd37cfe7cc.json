  "title": "炒饭",
  "min_age_month": 12,
  "tags": [],
  "difficulty": 1,
  "time_cost": 0,
  "cover_image": "images/0276922cbd2ef077bd06ae9bc4238dee.webp",
  "nutrition_tip": "用这个简单的炒饭食谱让冷冻蔬菜味道鲜美。尝试配对...",
  "ingredients": [],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "在平底锅（或炒锅）中用中火加热油。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将蔬菜放入煎锅中，煮至变软，偶尔搅拌。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将米饭、酱油、大蒜粉和洋葱粉加入蔬菜中，搅拌均匀。煮至米饭完全重新加热。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将米饭混合物推到锅的两侧，在中心打一个洞。将鸡蛋倒入煎锅中心并炒，继续搅拌直至几乎熟透。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将鸡蛋与米饭混合物混合。继续搅拌混合物直至鸡蛋完全煮熟。"
    }
  ],
