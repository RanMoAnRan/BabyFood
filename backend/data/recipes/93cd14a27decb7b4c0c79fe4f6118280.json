  "cover_image": "images/edc5200afde1d60eb9c24244e0f28565.webp",
  "nutrition_tip": "Libby 的淡奶南瓜派是经典的、不会失败的节日甜点……",
  "ingredients": [
    {
      "name": "1 个（9 英寸）未烘烤的深盘馅饼皮",
      "amount": ""
    },
    {
      "name": "0.75 杯白糖",
      "amount": ""
    },
    {
      "name": "1 茶匙肉桂粉",
      "amount": ""
    },
    {
      "name": "0.5 茶匙盐",
      "amount": ""
    },
    {
      "name": "0.5 茶匙姜末",
      "amount": ""
    },
    {
      "name": "0.25 茶匙丁香粉",
      "amount": ""
    },
    {
      "name": "2 个大鸡蛋",
      "amount": ""
    },
    {
      "name": "1 罐（15 盎司）LIBBY'S® 100% 纯南瓜",
      "amount": ""
    },
    {
      "name": "1 罐（12 液量盎司）NESTLE® CARNATION® 淡奶",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集原料。将烤箱预热至 425 华氏度（220 摄氏度）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将糖、肉桂、盐、姜和丁香放入小碗中。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在大碗中轻轻搅打鸡蛋。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "拌入南瓜和糖香料混合物。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "逐渐加入淡奶搅拌。倒入饼皮中。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "在预热好的烤箱中烘烤15分钟。将温度降至 350 华氏度（175 摄氏度），然后继续烘烤 40 到 50 分钟，直到插入靠近中心的刀出来时干净为止。从烤箱中取出并放在金属架上冷却至室温。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "立即供应冷却的馅饼或冷藏直至准备好供应。 （不要冷冻，因为这会导致外皮与馅料分离。）"
    }
  ],
