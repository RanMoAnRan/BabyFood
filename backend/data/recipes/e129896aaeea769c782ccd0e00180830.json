  "title": "我最好的蛤蜊浓汤",
  "min_age_month": 8,
  "tags": [
    "Soup",
    "New England",
    "American",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 45,
  "cover_image": "images/648a0921f05b9a784082a974220eaa55.webp",
  "nutrition_tip": "这道奶油蛤蜊浓汤里有美味的蛤蜊、土豆和胡萝卜……",
  "ingredients": [
    {
      "name": "2 杯土豆块",
      "amount": ""
    },
    {
      "name": "1 杯胡萝卜丁",
      "amount": ""
    },
    {
      "name": "1 杯芹菜丁",
      "amount": ""
    },
    {
      "name": "1 杯洋葱末",
      "amount": ""
    },
    {
      "name": "3 罐（6.5 盎司）蛤蜊碎，沥干，保留汁液",
      "amount": ""
    },
    {
      "name": "水覆盖",
      "amount": ""
    },
    {
      "name": "0.75 杯黄油",
      "amount": ""
    },
    {
      "name": "0.75 杯通用面粉",
      "amount": ""
    },
    {
      "name": "1 夸脱半奶油",
      "amount": ""
    },
    {
      "name": "2 汤匙红酒醋",
      "amount": ""
    },
    {
      "name": "1.5 茶匙盐",
      "amount": ""
    },
    {
      "name": "黑胡椒粉适量",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将土豆、胡萝卜、芹菜和洋葱放入大煎锅中；倒入蛤蜊汁，加足够的水覆盖。用中低火煮并搅拌直至蔬菜变软。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "同时，在一个大而重的平底锅中用中火融化黄油。加入面粉搅拌至光滑。加入奶油并不断搅拌直至浓稠光滑。将蔬菜混合物与果汁一起搅拌，直至完全加热。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在食用前搅拌蛤蜊，以免煮过头。当蛤蜊加热透后，加入醋搅拌，并用盐和胡椒调味。"
    }
  ],
