{
  "id": "8f94cbff64dcc8f3faa716eb11654e45",
  "title": "印度扁豆和面食",
  "min_age_month": 12,
  "tags": [],
  "difficulty": 1,
  "time_cost": 0,
  "cover_image": "images/7df7fdfb4b2f2545fa112b98ebb220d2.webp",
  "nutrition_tip": "犒赏自己和家人，享用这道用印度调味的美味面食......",
  "ingredients": [],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "在大煎锅中用中火加热油。加入洋葱和大蒜，煮 3 至 4 分钟。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "如果需要，加入水、番茄丁和果汁、扁豆、小茴香、姜黄和红辣椒片搅拌。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "煮沸。盖上盖子并将热量降至最低。煮25分钟。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "加入意大利面，不盖锅盖煮至意大利面变软，大约需要 10 分钟。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "撒上香菜，趁热食用。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "在 2 小时内将剩菜冷藏。"
    }
  ],
