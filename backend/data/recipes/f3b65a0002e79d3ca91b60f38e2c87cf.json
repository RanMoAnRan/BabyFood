  "title": "我奶奶的水果蛋糕饼干",
  "min_age_month": 12,
  "tags": [
    "Dessert",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 60,
  "cover_image": "images/a9af249207890d62a675fe622cf3b7f6.webp",
  "nutrition_tip": "这些水果蛋糕饼干有很多坚果、枣子、蜜饯菠萝和樱桃……",
  "ingredients": [
    {
      "name": "3 杯通用面粉",
      "amount": ""
    },
    {
      "name": "1 茶匙肉桂粉",
      "amount": ""
    },
    {
      "name": "0.5 茶匙小苏打",
      "amount": ""
    },
    {
      "name": "1 杯黄油，室温",
      "amount": ""
    },
    {
      "name": "1 杯红糖，包装",
      "amount": ""
    },
    {
      "name": "3 个鸡蛋",
      "amount": ""
    },
    {
      "name": "0.5 杯牛奶",
      "amount": ""
    },
    {
      "name": "2 汤匙香草味奶油雪利酒",
      "amount": ""
    },
    {
      "name": "7 杯切碎的混合坚果",
      "amount": ""
    },
    {
      "name": "1 磅蜜饯菠萝，粗切碎",
      "amount": ""
    },
    {
      "name": "1 磅红色和绿色蜜饯樱桃，切碎",
      "amount": ""
    },
    {
      "name": "2 杯去核切碎的枣子",
      "amount": ""
    },
    {
      "name": "2 杯葡萄干碎",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。将烤箱预热至 300 华氏度（150 摄氏度）。在几张烤盘上涂上油脂。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将面粉、肉桂和小苏打筛入一个大碗中；放在一边。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将黄油和糖放入一个单独的大碗中，用电动搅拌机搅拌至蓬松，大约需要 5 分钟。一次加入一个鸡蛋，每次加入后搅拌均匀。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "分批添加面粉混合物，与约 2 汤匙牛奶交替添加，每次添加后短暂搅拌面糊，直至混合物变软。加入雪利酒，然后加入坚果、菠萝、樱桃、枣子和葡萄干，直至完全混合。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将一勺面团放在准备好的烤盘上，间隔 2 英寸。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "在预热的烤箱中烘烤约 20 至 30 分钟，直至饼干凝固且底部呈浅棕色。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "在烤盘上短暂冷却，然后移至金属架上完全冷却。"
    }
  ],
