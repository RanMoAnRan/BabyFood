  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 325 华氏度（165 摄氏度）。在 10 英寸的平底锅上涂上油脂并撒上面粉。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将面粉、泡打粉、肉桂、丁香、肉豆蔻和盐一起过筛到碗中。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将糖和起酥油放入一个大碗中，用电动搅拌机搅打至松软。加入鸡蛋，一次一个，每次加入后搅拌均匀。将面粉混合物与土豆泥和牛奶交替混合。拌入核桃和葡萄干。将面糊倒入准备好的平底锅中。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在预热的烤箱中烘烤 1 1/2 至 2 小时，直至插入中心的牙签拔出时是干净的。"
    }
  ],
