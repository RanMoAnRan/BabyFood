  "nutrition_tip": "炒青椒和甜红洋葱的完美组合很美味……",
  "ingredients": [
    {
      "name": "2 个红甜椒，切条",
      "amount": ""
    },
    {
      "name": "2 个红洋葱，切成条",
      "amount": ""
    },
    {
      "name": "1 汤匙橄榄油",
      "amount": ""
    },
    {
      "name": "1 茶匙黄油",
      "amount": ""
    },
    {
      "name": "0.25 杯红酒",
      "amount": ""
    },
    {
      "name": "1 撮盐",
      "amount": ""
    },
    {
      "name": "1 撮黑胡椒粉",
      "amount": ""
    },
    {
      "name": "1 撮干罗勒",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将甜椒、洋葱、油和黄油放入热锅中，中火加热；炒2分钟。将火调至中低，继续烹饪，偶尔搅拌，直到洋葱和辣椒变软。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将红酒拌入蔬菜中，煮 15 至 25 分钟，直至酒蒸发。用盐、胡椒和罗勒调味。趁热食用。"
    }
  ],
