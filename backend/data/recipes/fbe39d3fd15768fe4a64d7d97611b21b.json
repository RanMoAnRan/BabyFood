  "nutrition_tip": "在这个披萨上，奶油芝士底取代了番茄酱，上面撒上培根和果酱……",
  "ingredients": [
    {
      "name": "8片培根，切成1英寸的块",
      "amount": ""
    },
    {
      "name": "0.75 杯切碎的洋葱",
      "amount": ""
    },
    {
      "name": "2 瓣大蒜，切碎",
      "amount": ""
    },
    {
      "name": "0.5 茶匙孜然粉",
      "amount": ""
    },
    {
      "name": "0.5 茶匙干牛至",
      "amount": ""
    },
    {
      "name": "0.5 茶匙黑胡椒粉",
      "amount": ""
    },
    {
      "name": "1 包（8 盎司）低脂奶油干酪，切成方块",
      "amount": ""
    },
    {
      "name": "0.25 杯酸奶油",
      "amount": ""
    },
    {
      "name": "1 个准备好的 16 英寸披萨面团",
      "amount": ""
    },
    {
      "name": "1 杯马苏里拉奶酪丝，或更多适量",
      "amount": ""
    },
    {
      "name": "0.5 杯切碎的低脂切达干酪",
      "amount": ""
    },
    {
      "name": "4 个墨西哥辣椒，切成细环",
      "amount": ""
    },
    {
      "name": "1 汤匙干欧芹片",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 400 华氏度（200 摄氏度）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将培根放入大煎锅中，用中高火煮，偶尔翻动，直至均匀变成棕色，大约 10 分钟。用漏勺取出培根，用纸巾吸干水分，将滴下的培根保留在锅中。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将洋葱放入培根汁中炒至半透明，持续 5 至 7 分钟。加入大蒜；继续炒2至3分钟，直至大蒜呈金黄色。用小茴香、牛至和黑胡椒给洋葱混合物调味。将奶油干酪和酸奶油搅拌到洋葱混合物中，直至光滑且可涂抹。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将奶油芝士混合物均匀地涂在披萨面团上；上面放上马苏里拉奶酪和切达奶酪。将培根和墨西哥辣椒圈放在奶酪层上。在整个披萨上撒上欧芹。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "在预热的烤箱中烘烤约 30 分钟，直至外皮坚硬酥脆，奶酪变成棕色并起泡。"
    }
  ],
