{
  "id": "63489e1dc95a588785e272c55a543f5d",
  "title": "自制饼干",
  "min_age_month": 12,
  "tags": [],
  "difficulty": 1,
  "time_cost": 0,
  "cover_image": "images/ba37642447a25ad6a814ca956bd62ff5.webp",
  "nutrition_tip": "在 30 分钟内从头开始制作这些饼干。",
  "ingredients": [],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 450 °F。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在一个中等大小的碗中，混合面粉、泡打粉、小苏打、盐和糖。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在一个小碗中，将酪乳和油搅拌在一起。倒在面粉混合物上，搅拌直至充分混合。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在撒了少许面粉的表面上，轻轻揉捏面团 10-12 次。将面团擀成或拍打至 3/4 英寸厚。用 2 英寸圆形饼干或饼干切刀切割，在切割之间将饼干切刀浸入面粉中。将饼干转移到未抹油的烤盘上。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "烘烤 12 分钟或直至金黄色。趁热食用。"
    }
  ],
  "warnings": [],
