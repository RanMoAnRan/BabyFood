  "id": "5966997f6095f388afae2d6c4cfe756c",
  "title": "香肠玉米面包",
  "min_age_month": 8,
  "tags": [
    "Dinner",
    "Side Dish",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 65,
  "cover_image": "images/005446de043ef84a8df2bd9872da6a2d.webp",
  "nutrition_tip": "玉米面包香肠馅是感恩节大餐的必备品！你一定会喜欢……",
  "ingredients": [
    {
      "name": "1 磅碎猪肉香肠",
      "amount": ""
    },
    {
      "name": "2 杯芹菜丁",
      "amount": ""
    },
    {
      "name": "2 个大洋葱，切碎",
      "amount": ""
    },
    {
      "name": "5 杯碎玉米面包",
      "amount": ""
    },
    {
      "name": "5 杯调味面包屑",
      "amount": ""
    },
    {
      "name": "2.75 杯鸡汤",
      "amount": ""
    },
    {
      "name": "1.5 茶匙家禽调味料",
      "amount": ""
    },
    {
      "name": "1 茶匙干鼠尾草，压碎",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 325 华氏度（165 摄氏度）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将香肠、芹菜和洋葱放入一个大的深煎锅中，用中火加热。煮 7 到 10 分钟，经常搅拌，并用勺子将香肠打碎，直至香肠均匀变成棕色且易碎，蔬菜呈半透明。从火上移开并沥干。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将香肠混合物转移到一个大碗中。加入碎玉米面包、面包屑、鸡汤、家禽调味料和鼠尾草。混合直至充分混合，然后转移到 9x13 英寸的烤盘中。用箔纸覆盖。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在预热的烤箱中烘烤约 45 分钟，直至馅料凝固并煮熟。"
    }
  ],
