{
  "id": "7f82802f06fe48e8742eeb3176b05cb0",
  "title": "培根卷墨西哥辣椒爆米花",
  "min_age_month": 12,
  "tags": [
    "Appetizer",
    "American",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 40,
  "cover_image": "images/e396aaf86633c4ec5a5e61ae36b9eaf2.webp",
  "nutrition_tip": "这些墨西哥胡椒爆米花充满了奶油奶酪和切达奶酪的混合物......",
  "ingredients": [
    {
      "name": "0.5 杯奶油奶酪",
      "amount": ""
    },
    {
      "name": "0.5 杯切达干酪丝",
      "amount": ""
    },
    {
      "name": "12 个墨西哥辣椒，纵向切成两半，去籽和去膜",
      "amount": ""
    },
    {
      "name": "12 片培根",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集原料。将烤箱预热至 400 华氏度（200 摄氏度）。在烤盘上铺上铝箔。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将奶油干酪和切达干酪在碗中混合直至均匀混合。将奶酪混合物填入每个墨西哥辣椒中。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将两半放回一起，并用一片培根包裹每个酿辣椒。将培根包裹的墨西哥辣椒放在准备好的烤盘上。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在预热的烤箱中烘烤 25 至 35 分钟，直至培根酥脆。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将爆米花与您最喜欢的蘸酱一起享用。享受！"
    }
  ],
