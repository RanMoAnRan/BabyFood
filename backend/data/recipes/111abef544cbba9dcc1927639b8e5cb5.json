{
  "id": "111abef544cbba9dcc1927639b8e5cb5",
  "title": "草莓酱",
  "min_age_month": 12,
  "tags": [
    "Jam / Jelly",
    "American",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 40,
  "cover_image": "images/fc2bdc58989d7f82f1462f9eefbbc608.webp",
  "nutrition_tip": "这种草莓酱配方很容易制作，无需果胶。充满果香……",
  "ingredients": [
    {
      "name": "2 磅新鲜草莓，去壳",
      "amount": ""
    },
    {
      "name": "4 杯白糖",
      "amount": ""
    },
    {
      "name": "0.25 杯柠檬汁",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在一个大碗中分批压碎草莓，直到获得 4 杯草莓泥。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将捣碎的草莓、糖和柠檬汁放入厚底锅中混合；小火搅拌直至糖溶解。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将热量调高，使混合物充分沸腾。继续煮沸，经常搅拌，直到混合物达到 220 华氏度（105 摄氏度）。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "10 到 15 分钟后，将一小勺果酱滴到冷冻盘上，检查熟度。静置 1 至 2 分钟；如果果酱出现胶状，则说明已准备就绪。如果果酱显得稀薄且流淌，请继续烹饪。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "将果酱转移到热的无菌罐中，填充至顶部 1/4 英寸以内。顶部盖上盖子并拧紧螺丝环。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "将一个架子放在一个大汤锅的底部，并在其中装满一半的水。煮沸并使用支架将罐子放入沸水中，间隔 2 英寸。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "倒入更多沸水，盖住罐子至少 1 英寸。煮沸，盖上锅盖，煮 10 分钟。"
    },
    {
      "step_index": 9,
      "img": "",
      "text": "将罐子从汤锅中取出，间隔几英寸静置 12 到 24 小时。存放在阴凉、黑暗的地方。"
    },
    {
      "step_index": 10,
      "img": "",
      "text": "上菜并享用！"
    }
  ],
