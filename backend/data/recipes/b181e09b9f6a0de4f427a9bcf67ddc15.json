  "title": "奶油玉米与众不同",
  "min_age_month": 12,
  "tags": [
    "Dinner",
    "Side Dish",
    "American",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 15,
  "cover_image": "images/6f7e6fad484c0b3aa1b00fd7ad78f89f.webp",
  "nutrition_tip": "从头开始制作的奶油玉米胜过任何罐装品种！浓郁的奶油酱...",
  "ingredients": [
    {
      "name": "2 包（10 盎司）冷冻玉米粒，解冻",
      "amount": ""
    },
    {
      "name": "1 杯浓奶油",
      "amount": ""
    },
    {
      "name": "1 茶匙盐，或适量",
      "amount": ""
    },
    {
      "name": "2 汤匙砂糖",
      "amount": ""
    },
    {
      "name": "0.25 茶匙现磨黑胡椒，或适量",
      "amount": ""
    },
    {
      "name": "2 汤匙黄油",
      "amount": ""
    },
    {
      "name": "0.5 杯全脂牛奶",
      "amount": ""
    },
    {
      "name": "2 汤匙通用面粉",
      "amount": ""
    },
    {
      "name": "0.25 杯新鲜磨碎的帕尔马干酪，或更多品尝",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将玉米、浓奶油、糖、黄油、盐和黑胡椒放入煎锅中，用中火加热。煮 3 到 5 分钟，偶尔搅拌，直至黄油融化。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "同时，将牛奶和面粉放入小碗中搅拌直至光滑。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "加入牛奶混合物搅拌；煮约 4 分钟，不断搅拌，直至变稠且玉米被加热透。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "从火上移开，加入帕尔马干酪搅拌直至融化。趁热食用。"
    }
  ],
