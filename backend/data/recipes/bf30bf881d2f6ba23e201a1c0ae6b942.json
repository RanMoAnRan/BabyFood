{
  "id": "bf30bf881d2f6ba23e201a1c0ae6b942",
  "title": "浓郁的脆蔬菜和意大利面沙拉",
  "min_age_month": 12,
  "tags": [],
  "difficulty": 1,
  "time_cost": 0,
  "cover_image": "images/ceaf3c4ee7012778d72b5fbec30de944.webp",
  "nutrition_tip": "使用您最喜欢的面食和蔬菜使这款沙拉成为全家人的最爱。做一个…",
  "ingredients": [],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "清洗双手和工作区域。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "根据包装说明煮意大利面，但不要在煮水中加盐。沥干，用冷水冲洗，然后再次沥干。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "同时，在一个小平底锅中，将醋、糖、盐、蒜粉和黑胡椒混合。搅拌并用中火加热直至糖溶解，但不要沸腾。让其冷却。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "冲洗、沥干并切碎剩余成分。合并在一个浅容器中，例如 8x8 英寸的平底锅。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "加入煮熟的意大利面和醋混合物。轻轻混合。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "盖上盖子并冷藏过夜，让味道混合。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "使用漏勺冷食。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "在 2 小时内盖上剩菜并冷藏。"
    }
  ],
