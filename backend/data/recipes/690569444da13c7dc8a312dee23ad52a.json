{
  "id": "690569444da13c7dc8a312dee23ad52a",
  "title": "比斯科蒂",
  "min_age_month": 8,
  "tags": [
    "Dessert",
    "Italian"
  ],
  "difficulty": 1,
  "time_cost": 70,
  "cover_image": "images/8e847bd7e9efba0232676958ed297560.webp",
  "nutrition_tip": "Biscotti 是两次烘烤的意大利饼干，非常轻、脆，而且……",
  "ingredients": [
    {
      "name": "1 杯白糖",
      "amount": ""
    },
    {
      "name": "0.5 杯植物油",
      "amount": ""
    },
    {
      "name": "3 个鸡蛋",
      "amount": ""
    },
    {
      "name": "1 汤匙茴香提取物，或 3 滴茴香油",
      "amount": ""
    },
    {
      "name": "3.25 杯通用面粉",
      "amount": ""
    },
    {
      "name": "1 汤匙发酵粉",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将烤箱预热至 375 华氏度（190 摄氏度）。在两张饼干片上涂上油脂或用羊皮纸铺成一行。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在一个中等大小的碗中将糖、油、鸡蛋和茴香提取物一起搅拌直至充分混合。将面粉和泡打粉放入另一个碗中；拌入鸡蛋混合物中，形成浓稠的面团。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将面团分成两等份。将每块切成饼干片长度的原木。将一根原木放在每张准备好的纸上；并将面团压至 1/2 英寸厚。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "在预热的烤箱中烘烤 25 至 30 分钟，直至呈金黄色。将原木转移到线架上；静置约 15 分钟，直到冷却到可以处理为止。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "将每根原木横向切成大约十八片 1/2 英寸厚的切片。将切片切面朝上放回饼干片上。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "烘烤至轻烤并呈金黄色，每面烘烤 6 至 10 分钟。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "上菜并享用！"
    }
  ],
