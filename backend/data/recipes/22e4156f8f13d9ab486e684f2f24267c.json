  "nutrition_tip": "法式加拿大tourtière 是一种双层肉馅饼，配以美味的猪肉、牛肉、...",
  "ingredients": [
    {
      "name": "1 磅瘦猪肉末",
      "amount": ""
    },
    {
      "name": "0.5 磅瘦碎牛肉",
      "amount": ""
    },
    {
      "name": "1 个洋葱，切丁",
      "amount": ""
    },
    {
      "name": "1 瓣大蒜，切碎",
      "amount": ""
    },
    {
      "name": "0.5 杯水",
      "amount": ""
    },
    {
      "name": "1.5 茶匙盐",
      "amount": ""
    },
    {
      "name": "0.5 茶匙干百里香，压碎",
      "amount": ""
    },
    {
      "name": "0.25 茶匙鼠尾草粉",
      "amount": ""
    },
    {
      "name": "0.25 茶匙黑胡椒粉",
      "amount": ""
    },
    {
      "name": "0.125 茶匙丁香粉",
      "amount": ""
    },
    {
      "name": "1 包（14.1 盎司）双皮馅饼，解冻",
