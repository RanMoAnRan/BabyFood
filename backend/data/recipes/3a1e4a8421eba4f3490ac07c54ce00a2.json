{
  "id": "3a1e4a8421eba4f3490ac07c54ce00a2",
  "title": "芝士鸡肉和西兰花砂锅",
  "min_age_month": 8,
  "tags": [
    "Dinner",
    "American",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 50,
  "cover_image": "images/ab429ea7d232c5e7d99c6e5a9a95a87b.webp",
  "nutrition_tip": "这个俗气的鸡肉西兰花砂锅一定会满足你的胃口……",
  "ingredients": [
    {
      "name": "1 茶匙无盐黄油，或根据需要",
      "amount": ""
    },
    {
      "name": "2 个去皮去骨鸡胸肉，切块",
      "amount": ""
    },
    {
      "name": "3 杯切碎的西兰花",
      "amount": ""
    },
    {
      "name": "2 罐（10.5 盎司）浓缩奶油鸡汤",
      "amount": ""
    },
    {
      "name": "1 杯切达干酪丝",
      "amount": ""
    },
    {
      "name": "1 杯帕尔马干酪丝，分开",
      "amount": ""
    },
    {
      "name": "0.5 杯马苏里拉奶酪丝",
      "amount": ""
    },
    {
      "name": "0.5 杯酸奶油",
      "amount": ""
    },
    {
      "name": "1 撮 黑胡椒粉 适量",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集原料，将烤箱预热至 350 华氏度（175 摄氏度），并在 9x13 英寸盘子的底部和侧面涂上黄油。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将一锅水烧开。加入鸡肉，继续煮 5 到 10 分钟，直到不再呈粉红色。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "同时，将西兰花、奶油鸡汤、切达奶酪、1/2 杯帕尔玛奶酪、马苏里拉奶酪、酸奶油和胡椒粉放入一个大碗中。搅拌均匀。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将鸡肉沥干并加入西兰花混合物中。搅拌均匀。倒入准备好的烤盘中并均匀铺开。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "在预热好的烤箱中烘烤20分钟。将剩余的帕尔马干酪放在上面，继续烘烤 3 至 5 分钟，直至奶酪融化。"
    }
  ],
