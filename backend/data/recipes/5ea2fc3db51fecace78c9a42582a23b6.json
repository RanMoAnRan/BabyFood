  "title": "南瓜甜点",
  "min_age_month": 6,
  "tags": [
    "Dessert",
    "American",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 55,
  "cover_image": "images/104fccfb67c64be113da9859ba63ad76.webp",
  "nutrition_tip": "南瓜甜点有多种形式，但这款最美味！蛋糕米…",
  "ingredients": [
    {
      "name": "1 包（15.25 盎司）黄色蛋糕粉",
      "amount": ""
    },
    {
      "name": "0.333 杯无盐黄油，融化",
      "amount": ""
    },
    {
      "name": "1 个大鸡蛋",
      "amount": ""
    },
    {
      "name": "1 罐（29 盎司）南瓜泥",
      "amount": ""
    },
    {
      "name": "3 个大鸡蛋",
      "amount": ""
    },
    {
      "name": "0.667 杯牛奶",
      "amount": ""
    },
    {
      "name": "0.5 杯红糖",
      "amount": ""
    },
    {
      "name": "2 汤匙南瓜派香料",
      "amount": ""
    },
    {
      "name": "0.5 杯白糖",
      "amount": ""
    },
    {
      "name": "0.25 杯冷无盐黄油，立方体",
      "amount": ""
    },
    {
      "name": "0.75 杯核桃碎",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将烤箱预热至 350 华氏度（175 摄氏度）。在 9x13 英寸的烤盘上涂上少许油脂。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "制作饼皮：将 1 杯蛋糕混合物转移到一个小碗中；留出备用。将剩余的蛋糕粉放入一个中等大小的碗中，加入融化的黄油和鸡蛋；混合直至充分混合。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将混合物铺入准备好的烤盘底部。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "制作馅料：将南瓜泥、鸡蛋、牛奶、红糖和南瓜派香料混合在一个大碗中；搅拌均匀，倒在饼皮上。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "制作配料：在预留的蛋糕粉中加入白糖和黄油块；使用糕点搅拌机搅拌直至混合物类似于粗面包屑。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "撒在南瓜馅上，然后将切碎的核桃撒在上面。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "在预热的烤箱中烘烤 45 至 50 分钟，直至顶部呈金黄色。"
    }
  ],
