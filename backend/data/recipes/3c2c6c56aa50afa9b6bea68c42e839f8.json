  "id": "3c2c6c56aa50afa9b6bea68c42e839f8",
  "title": "蔓越莓坚果面包",
  "min_age_month": 12,
  "tags": [
    "Bread",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 60,
  "cover_image": "images/ed642536665f03ba4a122a996a7da955.webp",
  "nutrition_tip": "这款蔓越莓坚果面包湿润且易于制作，用新鲜蔓越莓、核桃......",
  "ingredients": [
    {
      "name": "2 杯通用面粉",
      "amount": ""
    },
    {
      "name": "0.75 杯白糖",
      "amount": ""
    },
    {
      "name": "1.5 茶匙泡打粉",
      "amount": ""
    },
    {
      "name": "0.75 茶匙盐",
      "amount": ""
    },
    {
      "name": "0.5 茶匙小苏打",
      "amount": ""
    },
    {
      "name": "1 杯切碎的蔓越莓",
      "amount": ""
    },
    {
      "name": "0.5 杯核桃碎",
      "amount": ""
    },
    {
      "name": "0.75 杯橙汁",
      "amount": ""
    },
    {
      "name": "1 个大鸡蛋",
      "amount": ""
    },
    {
      "name": "2 汤匙植物油",
      "amount": ""
    },
    {
      "name": "1 汤匙 橙皮碎",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集原料。将烤箱预热至 350 华氏度（175 摄氏度）。在 9x5 英寸的面包盘上涂抹油脂。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将面粉、糖、泡打粉、盐和小苏打放入一个大碗中。加入蔓越莓和核桃；搅拌直至充分涂覆。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将橙汁、鸡蛋、油和果皮放入一个中等大小的碗中混合直至混合。倒入面粉混合物；搅拌直至混合。将面糊舀入准备好的面包盘中。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在预热的烤箱中烘烤约 50 分钟，直至将牙签插入面包中心，拔出时是干净的。在锅中短暂冷却，然后移至金属架上完全冷却。"
    }
  ],
