  ],
  "difficulty": 1,
  "time_cost": 125,
  "cover_image": "images/f5098f5a5b867b34a47fed24f589f5b0.webp",
  "nutrition_tip": "这些提前做好的土豆泥由于添加了……而变得美味可口。",
  "ingredients": [
    {
      "name": "5 磅育空黄金土豆，切块",
      "amount": ""
    },
    {
      "name": "8 盎司酸奶油",
      "amount": ""
    },
    {
      "name": "2 包（3 盎司）奶油奶酪",
      "amount": ""
    },
    {
      "name": "0.5 杯牛奶",
      "amount": ""
    },
    {
      "name": "2 茶匙洋葱盐",
      "amount": ""
    },
    {
      "name": "黑胡椒粉适量",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将土豆放入一大锅淡盐水中。煮沸并煮至变软，约15分钟；流走。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将土豆放入一个大碗中并捣碎。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "加入酸奶油、奶油干酪、牛奶、洋葱盐和胡椒粉，搅拌均匀。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "转移到一个大砂锅中。让土豆完全冷却 15 到 20 分钟。用铝箔盖住并冷藏最多 2 天。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "准备烘烤时，将砂锅从冰箱中取出，放在柜台上 30 分钟。将烤箱预热至 325 华氏度（165 摄氏度）。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "盖上盖子，在预热好的烤箱中烘烤 50 分钟。"
    }
  ],
