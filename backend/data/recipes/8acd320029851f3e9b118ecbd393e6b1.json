  "nutrition_tip": "这个大批量菠萝西葫芦松饼食谱，用碎菠萝和……制成",
  "ingredients": [
    {
      "name": "4.5 杯通用面粉",
      "amount": ""
    },
    {
      "name": "2.5 杯白糖",
      "amount": ""
    },
    {
      "name": "1 汤匙泡打粉",
      "amount": ""
    },
    {
      "name": "1 汤匙小苏打",
      "amount": ""
    },
    {
      "name": "1 汤匙肉桂粉",
      "amount": ""
    },
    {
      "name": "1.5 茶匙盐",
      "amount": ""
    },
    {
      "name": "2 杯植物油",
      "amount": ""
    },
    {
      "name": "6 个鸡蛋",
      "amount": ""
    },
    {
      "name": "3 杯西葫芦丝",
      "amount": ""
    },
    {
      "name": "1罐（20盎司）菠萝碎，沥干",
      "amount": ""
