  "nutrition_tip": "给（这些）豌豆一个机会！尝试使用其他类型的奶酪来改变这个食谱……",
  "ingredients": [],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "在中型煎锅中用中火加热人造黄油或黄油（电煎锅中为 300 华氏度）。加入豌豆，煮 2 至 3 分钟或直至豌豆加热透。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "加入柠檬汁和胡椒粉，搅拌均匀。撒上帕尔马干酪，趁热享用。"
    }
  ],
