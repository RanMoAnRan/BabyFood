  "title": "炒菜花饭",
  "min_age_month": 12,
  "tags": [],
  "difficulty": 1,
  "time_cost": 0,
  "cover_image": "images/c79ae520d78a239783d0c6b912339dc1.webp",
  "nutrition_tip": "只需一些简单的原料，花椰菜就可以制成米饭替代品......",
  "ingredients": [],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "用肥皂和水洗手。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在大煎锅或平底锅中用中火加热油。加入洋葱，煮 3 至 5 分钟直至变软。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "加入大蒜、花椰菜、盐和胡椒。搅拌 3 至 5 分钟，直至花椰菜变软。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "拌入柠檬汁，如果需要的话，撒上欧芹。趁热食用。"
    }
  ],
