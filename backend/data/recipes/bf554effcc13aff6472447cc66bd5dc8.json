  "id": "bf554effcc13aff6472447cc66bd5dc8",
  "title": "巧克力樱桃饼干",
  "min_age_month": 12,
  "tags": [
    "Dessert",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 30,
  "cover_image": "images/bc6cd177fc543ececeb3bcdd5421a301.webp",
  "nutrition_tip": "巧克力樱桃饼干，带有浓郁的巧克力樱桃釉。这些颓废的待遇……",
  "ingredients": [
    {
      "name": "1 杯白糖",
      "amount": ""
    },
    {
      "name": "0.5 杯黄油",
      "amount": ""
    },
    {
      "name": "1 个鸡蛋",
      "amount": ""
    },
    {
      "name": "1.5 茶匙香草精",
      "amount": ""
    },
    {
      "name": "1.5 杯通用面粉",
      "amount": ""
    },
    {
      "name": "0.5 杯不加糖可可粉",
      "amount": ""
    },
    {
      "name": "0.25 茶匙盐",
      "amount": ""
    },
    {
      "name": "0.25 茶匙小苏打",
      "amount": ""
    },
    {
      "name": "0.25 茶匙泡打粉",
      "amount": ""
    },
    {
      "name": "1 罐（10 盎司）黑樱桃",
      "amount": ""
    },
    {
      "name": "0.5 杯甜炼乳",
      "amount": ""
    },
    {
      "name": "1 杯半甜巧克力片",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 350 华氏度（180 摄氏度）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将糖和黄油放入一个大碗中，用电动搅拌机搅拌直至松软。加入鸡蛋和香草精；打得好。加入面粉、可可粉、盐、小苏打和泡打粉，搅拌至光滑。将面团擀成核桃大小的球，并以 2 英寸间隔放在未抹油的饼干片上。用拇指在每个饼干的中心压出一个凹痕。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "沥干樱桃并保留果汁。在每个饼干球的凹口中放一颗樱桃。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将巧克力片和炼乳放入平底锅中，用小火混合；搅拌直至巧克力融化。加入 4 茶匙樱桃汁搅拌。在每个樱桃上淋上或舀出约 1 茶匙的巧克力樱桃混合物以覆盖。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "预热烤10分钟。在烤盘上短暂冷却，然后移至金属架上完全冷却。"
    }
  ],
