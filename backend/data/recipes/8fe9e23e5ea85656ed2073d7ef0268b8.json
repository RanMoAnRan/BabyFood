{
  "id": "8fe9e23e5ea85656ed2073d7ef0268b8",
  "title": "面团装饰食谱",
  "min_age_month": 12,
  "tags": [
    "Candy",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 75,
  "cover_image": "images/f9d5d6fdfb9904e607abf36b8131d21a.webp",
  "nutrition_tip": "用这个 3 成分食谱制作盐面团装饰品既简单又有趣。了解如何…",
  "ingredients": [
    {
      "name": "4 杯通用面粉",
      "amount": ""
    },
    {
      "name": "1 杯盐",
      "amount": ""
    },
    {
      "name": "1.5 杯温水",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料，并将烤箱预热至 325 华氏度（165 摄氏度）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将面粉和盐放入搅拌碗中搅拌直至充分混合。逐渐加入水搅拌，每次约 1/2 杯，直至形成面团。当用勺子搅拌太困难时，可以用手搅拌。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将面团转移到撒有面粉的工作台上，揉捏直至柔软柔韧。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "擀成1/8英寸的厚度；用饼干切刀切出想要的形状。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将面团形状转移到未抹油的饼干片上；用牙签在每个装饰品上打一个孔以便悬挂。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "在预热的烤箱中烘烤约 1 小时直至变硬，中途更换架子。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "从烤箱中取出并冷却至室温。根据需要用丙烯酸漆和工艺清漆进行装饰以保存。将一根绳子穿过每个孔。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "装饰并享受！"
    }
  ],
