  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在一个大的深煎锅中用中火融化黄油。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "加入洋葱和芹菜；煮约10分钟，搅拌直至变软。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "加入面包屑、盐、家禽调味料、胡椒、百里香和鼠尾草，搅拌均匀。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "拌入足够的鸡汤以湿润。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "从火上移开并冷却至室温。用勺子舀入可重新密封的大袋子中，冷藏最多 3 天。"
    }
  ],
