  "nutrition_tip": "这种提前做的馅料可以在感恩节前准备好并储存在……",
  "ingredients": [
    {
      "name": "1 杯黄油",
      "amount": ""
    },
    {
      "name": "2 杯切碎的洋葱",
      "amount": ""
    },
    {
      "name": "2 杯切碎的芹菜",
      "amount": ""
    },
    {
      "name": "16 杯干面包屑",
      "amount": ""
    },
    {
      "name": "1 汤匙盐",
      "amount": ""
    },
    {
      "name": "2 茶匙家禽调味料",
      "amount": ""
    },
    {
      "name": "0.5 茶匙黑胡椒粉",
      "amount": ""
    },
    {
      "name": "0.5 茶匙干百里香",
      "amount": ""
    },
    {
      "name": "0.5 茶匙干鼠尾草",
      "amount": ""
    },
    {
      "name": "2 杯鸡汤，或根据需要",
      "amount": ""
    }
