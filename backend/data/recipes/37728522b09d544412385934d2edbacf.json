  ],
  "difficulty": 1,
  "time_cost": 40,
  "cover_image": "images/643713cf41dd367c8d0deea454d10999.webp",
  "nutrition_tip": "这些燕麦葡萄干饼干烘烤后柔软耐嚼，边缘酥脆。整个…",
  "ingredients": [
    {
      "name": "0.75 杯黄油，软化",
      "amount": ""
    },
    {
      "name": "0.75 杯白糖",
      "amount": ""
    },
    {
      "name": "0.75 杯包装淡红糖",
      "amount": ""
    },
    {
      "name": "2 个大鸡蛋",
      "amount": ""
    },
    {
      "name": "1 茶匙香草精",
      "amount": ""
    },
    {
      "name": "1.25 杯通用面粉",
      "amount": ""
    },
    {
      "name": "1 茶匙小苏打",
      "amount": ""
    },
    {
      "name": "0.75 茶匙肉桂粉",
      "amount": ""
    },
    {
      "name": "0.5 茶匙盐",
      "amount": ""
    },
    {
      "name": "2.75 杯燕麦片",
      "amount": ""
    },
    {
      "name": "1 杯葡萄干",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。将烤箱预热至 375 华氏度（190 摄氏度）。在两张饼干片上铺上羊皮纸或硅胶衬垫。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将黄油、白糖和红糖放入一个大碗中，搅拌至光滑细腻。加入鸡蛋和香草精，搅拌至蓬松。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将面粉、小苏打、肉桂和盐搅拌在一起。逐渐搅入黄油混合物中。加入燕麦和葡萄干。将一茶匙面糊以 2 英寸间隔滴在准备好的饼干片上。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在预热的烤箱中烘烤 8 到 10 分钟，直至金黄色，中途更换架子。从烤箱中取出，放在饼干片上 1 到 2 分钟，然后将饼干转移到金属架上完全冷却。"
    }
  ],
