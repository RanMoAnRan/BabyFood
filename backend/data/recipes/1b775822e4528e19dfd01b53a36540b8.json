  "nutrition_tip": "这个蔓越莓蛋糕很容易做，里面有新鲜的酸蔓越莓，上面...",
  "ingredients": [
    {
      "name": "2 杯通用面粉",
      "amount": ""
    },
    {
      "name": "1 汤匙小苏打",
      "amount": ""
    },
    {
      "name": "1 茶匙盐",
      "amount": ""
    },
    {
      "name": "1 杯白糖",
      "amount": ""
    },
    {
      "name": "3 汤匙黄油，融化",
      "amount": ""
    },
    {
      "name": "2 个鸡蛋，打散",
      "amount": ""
    },
    {
      "name": "1 杯牛奶",
      "amount": ""
    },
    {
      "name": "3 杯新鲜蔓越莓",
      "amount": ""
    },
    {
      "name": "1 杯白糖",
      "amount": ""
    },
    {
      "name": "0.5 杯黄油",
      "amount": ""
    },
    {
      "name": "0.5 杯浓奶油",
      "amount": ""
    },
    {
      "name": "1 茶匙香草精",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。将烤箱预热至 350 华氏度（175 摄氏度）。在 9x13 英寸的烤盘上涂抹油脂。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "制作蔓越莓蛋糕：将面粉、小苏打和盐放入一个大碗中。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将 1 杯糖和 3 汤匙融化的黄油放在一个单独的大碗中搅拌；加入鸡蛋，搅拌至光滑。将面粉混合物和牛奶搅拌到鸡蛋混合物中，直至面糊充分混合。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "拌入蔓越莓直至完全混合；将面糊倒入准备好的烤盘中。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "在预热的烤箱中烘烤约 30 分钟，直至插入中心的牙签拔出时是干净的。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "制作香草酱：将 1 杯糖、1/2 杯黄油、浓奶油和香草精放入平底锅中，中低火加热；煮约 10 分钟，搅拌直至糖溶解。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "将辣酱倒在热蛋糕上。让蛋糕在烤盘中冷却 10 分钟，然后取出放在金属架上完全冷却。"
    }
  ],
