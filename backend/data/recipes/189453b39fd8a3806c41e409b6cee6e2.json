  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 375 华氏度（190 摄氏度）。在烤盘上铺上羊皮纸。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将烘焙混合物、水和奶酪放入一个大碗中；搅拌直至面团混合在一起。用小勺子将面团分到准备好的平底锅上。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在预热的烤箱中烘烤 10 至 12 分钟至金黄色。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "烘烤饼干时，将融化的黄油、大蒜粉、盐、洋葱粉和欧芹放入小碗中混合。刷上热饼干。"
    }
  ],
