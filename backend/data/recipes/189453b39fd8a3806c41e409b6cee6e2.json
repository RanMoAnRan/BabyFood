  "nutrition_tip": "这些切达湾饼干很容易在 25 分钟内制作出温暖的奶酪饼干……",
  "ingredients": [
    {
      "name": "4 杯烘焙混合物",
      "amount": ""
    },
    {
      "name": "1.3333333730698 杯水",
      "amount": ""
    },
    {
      "name": "3 盎司切达干酪，切丝",
      "amount": ""
    },
    {
      "name": "0.5 杯融化的黄油",
      "amount": ""
    },
    {
      "name": "1 茶匙大蒜粉",
      "amount": ""
    },
    {
      "name": "0.25 茶匙盐",
      "amount": ""
    },
    {
