      "name": "8 杯新鲜冷水，分开",
      "amount": ""
    },
    {
      "name": "3 汤匙蜂蜜",
      "amount": ""
    },
    {
      "name": "0.5 茶匙喜马拉雅粉红盐",
      "amount": ""
    },
    {
      "name": "0.75 茶匙钙镁粉",
      "amount": ""
    },
    {
      "name": "1 撮辣椒",
      "amount": ""
    },
    {
      "name": "0.75 杯鲜榨橙汁，滤过",
      "amount": ""
    },
    {
      "name": "2 个中等大小的柠檬，榨汁",
      "amount": ""
    },
    {
      "name": "2 个中等大小的酸橙，榨汁",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将 1 杯水倒入一个大锅中。加入蜂蜜、盐、钙镁粉和辣椒。将锅放在小火上，搅拌直至成分溶解。远离热源并使其恢复至室温。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将果汁添加到锅中的室温混合物中。倒入剩余的 7 杯水，搅拌直至充分混合。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "上菜并享用！"
    }
  ],
