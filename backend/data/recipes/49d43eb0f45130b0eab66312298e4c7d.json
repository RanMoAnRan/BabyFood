{
  "id": "49d43eb0f45130b0eab66312298e4c7d",
  "title": "七叶树",
  "min_age_month": 8,
  "tags": [
    "Dessert",
    "U.S.",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 50,
  "cover_image": "images/6900710dea6e7c35181fc0aeb838544a.webp",
  "nutrition_tip": "有人称七叶树为饼干，有人称其为糖果，但每个人都称其为del……",
  "ingredients": [
    {
      "name": "1.5 杯花生酱",
      "amount": ""
    },
    {
      "name": "1 杯黄油，软化",
      "amount": ""
    },
    {
      "name": "0.5 茶匙香草精",
      "amount": ""
    },
    {
      "name": "4 杯筛过的糖果糖，或根据需要更多",
      "amount": ""
    },
    {
      "name": "4 杯半甜巧克力片",
      "amount": ""
    },
    {
      "name": "牙签",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将花生酱、黄油和香草精放入一个大碗中，用电动搅拌机搅拌至松软。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "打入 4 杯过筛的糖果中加糖直至面团变硬、坚硬、干燥、无结块；根据需要添加更多过筛的糖。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将面团擀成大约六十个 1 英寸的球，然后放在衬有蜡的饼干片上。将牙签插入每个球的顶部，放入冰箱冷藏约 30 分钟直至变硬。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将巧克力片放入双锅中或放入碗中，碗放在一锅刚刚沸腾的水上。经常搅拌直至融化且光滑。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "拿着牙签，将冷冻花生酱球浸入融化的巧克力中，留下一小部分花生酱在顶部。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "回到饼干片上，取出并丢弃牙签，然后冷藏直至可以食用。享受！"
    }
  ],
