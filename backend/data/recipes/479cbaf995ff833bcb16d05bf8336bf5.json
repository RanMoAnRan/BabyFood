      "name": "4 块去皮去骨鸡胸肉",
      "amount": ""
    },
    {
      "name": "1 瓶（17.5 液体盎司）水牛城鸡翅酱，分装",
      "amount": ""
    },
    {
      "name": "0.5（1 盎司）包干牧场沙拉酱混合物",
      "amount": ""
    },
    {
      "name": "2 汤匙黄油",
      "amount": ""
    },
    {
      "name": "6 个三明治卷，纵向分割",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将鸡胸肉放入慢炖锅中；倒入 3/4 的鸡翅酱和牧场沙拉酱混合物。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "盖上锅盖，低火煮 6 至 7 小时。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "用两把叉子在炊具中切碎鸡肉。拌入黄油。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将鸡肉丝和酱汁堆放在三明治卷上。与剩余的水牛酱一起食用。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "上菜并享用！"
    }
  ],
