  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "用中高温加热一个大煎锅。加入碎牛肉；煮并搅拌 5 至 7 分钟，直至变成棕色且易碎。排干并丢弃油脂。将牛肉转移到慢炖锅中。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在同一个煎锅中煮培根，偶尔搅拌，直至均匀变成棕色，持续 7 到 10 分钟。排干并丢弃油脂。将培根转移到慢炖锅中；搅拌。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将番茄丁、番茄酱、洋葱、甜椒、牛肉高汤、辣酱、伍斯特酱和大蒜加入慢炖锅中；搅拌直至充分混合。加入辣椒粉、辣椒、牛至、盐、孜然、罗勒、辣椒粉和黑胡椒，直至完全混合。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "盖上慢炖锅；低火煮 5 小时。搅拌;继续煮2至3小时。"
    }
  ],
