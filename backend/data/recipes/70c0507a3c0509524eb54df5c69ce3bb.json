  "title": "牛肉和甜菜罗宋汤",
  "min_age_month": 8,
  "tags": [
    "Dinner",
    "Russian",
    "Eastern European"
  ],
  "difficulty": 1,
  "time_cost": 305,
  "cover_image": "images/8e8059e88113177fe3cdc852bfdf4d64.webp",
  "nutrition_tip": "这道牛肉罗宋汤是约翰厨师版本的俄罗斯和波兰汤，配以……",
  "ingredients": [
    {
      "name": "1 片（1 英寸厚）带骨牛小腿片",
      "amount": ""
    },
    {
      "name": "3 夸脱水",
      "amount": ""
    },
    {
      "name": "1 个洋葱，切碎",
      "amount": ""
    },
    {
      "name": "1 杯切碎的胡萝卜",
      "amount": ""
    },
    {
      "name": "0.5 杯切碎的芹菜",
      "amount": ""
    },
    {
      "name": "1 片月桂叶",
      "amount": ""
    },
    {
      "name": "3 杯去皮甜菜丁",
      "amount": ""
    },
    {
      "name": "2 杯切碎的卷心菜",
      "amount": ""
    },
    {
      "name": "0.25 杯白醋，或适量",
      "amount": ""
    },
    {
      "name": "盐和黑胡椒粉适量",
      "amount": ""
    },
    {
      "name": "1 杯酸奶油，用于装饰",
      "amount": ""
    },
    {
      "name": "2 汤匙切碎的新鲜莳萝，用于装饰",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将牛腿放入大汤锅中，用大火煮至焦黄，每面约 3 分钟。加入水、洋葱、胡萝卜、芹菜和月桂叶；用文火煮约4小时，直至肉变软并从骨头上脱落。过滤肉汤并丢弃固体。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将牛肉汤、甜菜和卷心菜放入同一锅中；煮约 30 分钟，偶尔搅拌，直至甜菜变软。将热量降至低；加入醋、盐和黑胡椒。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将汤盛入碗中，并饰以酸奶油和莳萝。"
    }
  ],
