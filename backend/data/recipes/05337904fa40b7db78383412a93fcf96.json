  "title": "纳奈莫酒吧",
  "min_age_month": 12,
  "tags": [
    "Dessert",
    "Canadian",
    "American",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 30,
  "cover_image": "images/b6454acc41a13ca4738977146e18964b.webp",
  "nutrition_tip": "这些纳奈莫酒吧有三层椰子全麦面包皮、厚厚的蛋奶冻和……",
  "ingredients": [
    {
      "name": "1 杯黄油，软化，分开",
      "amount": ""
    },
    {
      "name": "5 汤匙不加糖可可粉",
      "amount": ""
    },
    {
      "name": "0.25 杯白糖",
      "amount": ""
    },
    {
      "name": "1 个鸡蛋，打散",
      "amount": ""
    },
    {
      "name": "1.75 杯全麦饼干屑",
      "amount": ""
    },
    {
      "name": "1 杯椰子片",
      "amount": ""
    },
    {
      "name": "0.5 杯切碎的杏仁",
      "amount": ""
    },
    {
      "name": "3 汤匙浓奶油",
      "amount": ""
    },
    {
      "name": "2 汤匙 吉士粉",
      "amount": ""
    },
    {
      "name": "2 杯糖果糖",
      "amount": ""
    },
    {
      "name": "4 块（1 盎司）半甜烘焙巧克力块",
      "amount": ""
    },
    {
      "name": "2 茶匙黄油",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在双层蒸锅的顶部，混合 1/2 杯软化黄油、可可粉和糖。偶尔搅拌直至融化且光滑。加入鸡蛋，搅拌 2 至 3 分钟至浓稠。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "从火上移开，加入全麦饼干屑、椰子和杏仁。压入未抹油的 8x8 英寸平底锅底部。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "制作中间层，将剩余的 1/2 杯软化黄油、浓奶油和吉士粉搅拌至松软。混合在糖果中。加糖直至光滑。铺在锅的底层上。冷却定型。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "当第二层冷却时，将半甜巧克力和 2 茶匙黄油一起在微波炉或小火中融化。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "将融化的巧克力混合物涂在冷冻棒上。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "让巧克力凝固，然后切成方块。"
    }
  ],
