{
  "id": "edbf19d88f749a4739a340f2d893f7eb",
  "title": "薄荷冰镇酒",
  "min_age_month": 12,
  "tags": [
    "Drink",
    "Cocktail",
    "Southern"
  ],
  "difficulty": 1,
  "time_cost": 10,
  "cover_image": "images/cc15a22ed3b5d25f9f800ca3a4117174.webp",
  "nutrition_tip": "薄荷冰镇酒是用肯塔基波本威士忌制成的，用简单的糖浆加甜，然后……",
  "ingredients": [
    {
      "name": "2 杯水",
      "amount": ""
    },
    {
      "name": "2 杯白糖",
      "amount": ""
    },
    {
      "name": "0.5 杯切碎的新鲜薄荷叶",
      "amount": ""
    },
    {
      "name": "8 杯碎冰，或根据需要",
      "amount": ""
    },
    {
      "name": "32 液量盎司肯塔基波本威士忌",
      "amount": ""
    },
    {
      "name": "8 枝新鲜薄荷装饰用",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在准备上桌之前先制作简单的糖浆：将水、糖和切碎的薄荷放入小平底锅中，用高温煮沸。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "煮1到2分钟，偶尔搅拌，直到糖完全溶解。从火上移开并冷却。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将糖浆倒入过滤器中以除去薄荷叶。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "制作薄荷冰镇酒：在八个玻璃杯中倒入碎冰；将 4 盎司波本威士忌和 1/4 杯薄荷糖浆倒入每个杯子中​​。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "在每杯饮料上放一根薄荷枝。"
    }
  ],
