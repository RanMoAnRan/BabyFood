{
  "id": "b85860bc6da5ff1c43e2d19e8da95913",
  "title": "墨西哥婚礼饼干",
  "min_age_month": 12,
  "tags": [
    "Dessert",
    "Mexican"
  ],
  "difficulty": 1,
  "time_cost": 115,
  "cover_image": "images/73866d650c2d758834e168ac2898b217.webp",
  "nutrition_tip": "美味、坚果味的墨西哥婚礼饼干，一种卷制的传统美食……",
  "ingredients": [
    {
      "name": "1 杯无盐黄油，软化",
      "amount": ""
    },
    {
      "name": "0.5 杯白糖",
      "amount": ""
    },
    {
      "name": "2 茶匙香草精",
      "amount": ""
    },
    {
      "name": "2 茶匙水",
      "amount": ""
    },
    {
      "name": "2 杯通用面粉",
      "amount": ""
    },
    {
      "name": "1 杯切碎的杏仁",
      "amount": ""
    },
    {
      "name": "0.25 茶匙盐",
      "amount": ""
    },
    {
      "name": "0.5 杯糖粉，或根据需要更多",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将黄油和糖放入一个中等大小的碗中，用电动搅拌机搅拌至松软。加入香草和水。加入面粉、杏仁和盐；低速搅拌直至面团完全混合。盖上盖子并冷藏 1 至 3 小时。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将烤箱预热至 325 华氏度（165 摄氏度）。将冷藏好的面团搓成1英寸大小的球状。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将 2 英寸间隔放置在无衬里的饼干片上。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "在预热的烤箱中烘烤 15 至 20 分钟。从床单上取出饼干，然后转移到金属架上冷却 20 到 30 分钟。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "将糖粉放入一个浅碗中。将冷却后的饼干卷入糖粉中，裹上糖粉。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "转移到密封容器中并在室温下保存。"
    }
  ],
