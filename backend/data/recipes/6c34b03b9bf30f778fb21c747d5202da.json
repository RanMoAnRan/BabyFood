  ],
  "difficulty": 1,
  "time_cost": 200,
  "cover_image": "images/a7477f55bc8ac1bc2cc313f75f5d41a2.webp",
  "nutrition_tip": "有了这个火球南瓜派，享受传统的节日南瓜派与火焰......",
  "ingredients": [
    {
      "name": "1 个（9 英寸）未烘烤的深盘馅饼皮，室温",
      "amount": ""
    },
    {
      "name": "1 罐（15 盎司）南瓜派馅料",
      "amount": ""
    },
    {
      "name": "9 盎司淡奶",
      "amount": ""
    },
    {
      "name": "0.75 杯白糖",
      "amount": ""
    },
    {
      "name": "3 液量盎司肉桂威士忌（例如 Fireball®）",
      "amount": ""
    },
    {
      "name": "2 个大鸡蛋，轻轻打散",
      "amount": ""
    },
    {
      "name": "0.5 茶匙盐",
      "amount": ""
    },
    {
      "name": "0.5 茶匙姜粉",
      "amount": ""
    },
    {
      "name": "0.5 茶匙丁香粉",
      "amount": ""
    },
    {
      "name": "0.25 茶匙肉桂粉",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 400 华氏度（200 摄氏度）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "用叉子均匀地刺穿整个馅饼皮。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将饼皮放入预热好的烤箱中烘烤至金黄色，大约需要 12 分钟。从烤箱中取出；将烤箱温度提高至 425 华氏度（220 摄氏度）。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将南瓜派馅料、淡奶、糖、威士忌、鸡蛋、盐、姜、丁香和肉桂放入一个大碗中；用电动搅拌机搅拌直至完全混合。倒入预先烤好的馅饼皮中。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "返回预热烤箱并将馅饼烤 15 分钟。将烤箱温度降低至 350 华氏度（175 摄氏度）并继续烘烤，直至馅料凝固且不再晃动，并且插入中心的牙签取出时是干净的，大约需要 45 分钟。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "从烤箱中取出，冷却至室温，然后食用，大约需要 2 小时。"
    }
  ],
