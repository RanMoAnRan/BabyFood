  "title": "苹果香料转储蛋糕",
  "min_age_month": 12,
  "tags": [
    "Dessert",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 60,
  "cover_image": "images/21aa7fffa54e8eb80bc104e7437e2798.webp",
  "nutrition_tip": "这个苹果香料转储蛋糕食谱是用苹果派馅料、蛋糕粉、肉桂制成的……",
  "ingredients": [
    {
      "name": "2 罐（21 盎司）苹果派馅料",
      "amount": ""
    },
    {
      "name": "1汤匙白糖",
      "amount": ""
    },
    {
      "name": "1 茶匙肉桂粉",
      "amount": ""
    },
    {
      "name": "1 茶匙肉豆蔻粉",
      "amount": ""
    },
    {
      "name": "1 茶匙五香粉粉",
      "amount": ""
    },
    {
      "name": "1 包（18.25 盎司）香料蛋糕粉",
      "amount": ""
    },
    {
      "name": "0.75 杯黄油",
      "amount": ""
    },
    {
      "name": "1 杯切碎的山核桃",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 350 华氏度（175 摄氏度）"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将苹果派馅料倒入 9x13 英寸的烤盘中。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将糖、肉桂、肉豆蔻和五香粉放入一个小碗中，搅拌均匀；撒在馅饼馅上。盖上干蛋糕混合物的馅料；点上黄油，然后在上面撒上山核桃。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在预热的烤箱中烘烤 45 至 60 分钟，直至顶部变成棕色，侧面充满气泡。"
    }
  ],
