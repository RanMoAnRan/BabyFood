  "title": "苹果菠菜沙拉",
  "min_age_month": 12,
  "tags": [],
  "difficulty": 1,
  "time_cost": 0,
  "cover_image": "images/ef3502b37fe5313f32f31796ba45182c.webp",
  "nutrition_tip": "用这个简单、美味的沙拉为您的一天添加更多水果和蔬菜。",
  "ingredients": [],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "彻底清洗菠菜。拍干或在沙拉旋转器中旋转。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将菠菜撕成一口大小的碎片，放入一个大碗中。放在一边"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在一个小碗中混合油、醋、糖和盐。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将苹果、洋葱和干果加入油混合物中，搅拌均匀，裹上苹果。静置十分钟。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将原料混合在一大碗菠菜中即可食用。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "冷藏剩菜。"
    }
  ],
