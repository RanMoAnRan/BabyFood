{
  "id": "5b04876db81e300a3c0f32fa1750aacf",
  "title": "蝙蝠和蜘蛛网",
  "min_age_month": 12,
  "tags": [
    "Dinner",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 40,
  "cover_image": "images/aba03246aeac9aecbb14eaa1a77b7603.webp",
  "nutrition_tip": "这个节日蝙蝠和蜘蛛网食谱的特色是烤领结面食和牛肉面……",
  "ingredients": [
    {
      "name": "1 包（8 盎司）法法尔（领结）面食",
      "amount": ""
    },
    {
      "name": "1 磅碎牛肉",
      "amount": ""
    },
    {
      "name": "1 个小洋葱，切碎",
      "amount": ""
    },
    {
      "name": "1 罐（28 盎司）意大利面酱",
      "amount": ""
    },
    {
      "name": "8 盎司马苏里拉奶酪，切成 1/2 英寸的方块",
      "amount": ""
    },
    {
      "name": "0.25 杯磨碎的帕尔马干酪",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 400 华氏度（200 摄氏度）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将一大锅淡盐水煮沸。将领结意大利面煮沸，偶尔搅拌，直到咬起来又软又硬，大约需要 12 分钟。流走。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "用中高温加热一个大煎锅。加入碎牛肉和洋葱；煮并搅拌 5 至 7 分钟，直至变成棕色且易碎。排干并丢弃油脂。拌入意大利面酱；煮沸。将热量降至低；煨。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将煮熟的意大利面和 1/2 马苏里拉奶酪放入酱汁中搅拌均匀；转移到 2 夸脱的烤盘中。上面放上剩余的 ½ 马苏里拉奶酪和帕尔马干酪。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "在预热的烤箱中烘烤 15 至 20 分钟，直至呈浅棕色并起泡。"
    }
  ],
