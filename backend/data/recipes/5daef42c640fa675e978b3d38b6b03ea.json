{
  "id": "5daef42c640fa675e978b3d38b6b03ea",
  "title": "花生酱炒面",
  "min_age_month": 12,
  "tags": [],
  "difficulty": 1,
  "time_cost": 0,
  "cover_image": "images/1193eb98b2d47f93eda68a8a4a24930b.webp",
  "nutrition_tip": "在这个炒菜食谱中享受花生、辣椒和生姜的味道。",
  "ingredients": [],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将 4 杯水放入 2 至 3 夸脱的平底锅中煮沸。加入面条，盖上盖子，然后离火（不要添加调味包）。等一分钟，沥干面条，放在一边。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在一个小平底锅中，混合花生酱、酱油和 1/2 杯水。小火加热，搅拌直至光滑。从火上移开。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在大煎锅中用中高火加热油（电煎锅为 350 度）。加入鸡肉，煮约 3 至 5 分钟，直至切块时鸡肉不再呈粉红色。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "加入红辣椒、生姜和胡萝卜，煮 2 至 3 分钟。加入卷心菜，煮 3 至 4 分钟或直至卷心菜变脆。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "加入葱、煮熟的面条和花生酱。立即搅拌并食用。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "在 2 小时内将剩菜冷藏。"
    }
  ],
