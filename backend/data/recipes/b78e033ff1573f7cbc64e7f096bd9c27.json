  ],
  "difficulty": 1,
  "time_cost": 45,
  "cover_image": "images/28b947717224147bd9c78255d45b84ab.webp",
  "nutrition_tip": "这个简单的南瓜菠菜幼儿松饼食谱，用罐装南瓜、菠菜制成……",
  "ingredients": [
    {
      "name": "2 杯罐装南瓜",
      "amount": ""
    },
    {
      "name": "3 个大鸡蛋",
      "amount": ""
    },
    {
      "name": "0.5 杯橄榄油",
      "amount": ""
    },
    {
      "name": "0.25 杯枫糖浆",
      "amount": ""
    },
    {
      "name": "1 杯全麦面粉",
      "amount": ""
    },
    {
      "name": "1 杯燕麦片",
      "amount": ""
    },
    {
      "name": "1 茶匙泡打粉",
      "amount": ""
    },
    {
      "name": "1 茶匙小苏打",
      "amount": ""
    },
    {
      "name": "0.5 茶匙肉桂粉",
      "amount": ""
    },
    {
      "name": "0.5 茶匙肉豆蔻粉",
      "amount": ""
    },
    {
      "name": "0.5 杯冷冻菠菜，解冻并沥干",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 350 华氏度（175 摄氏度）。将两个 12 杯松饼罐垫上纸垫。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将南瓜泥、鸡蛋、油和枫糖浆放入碗中。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将面粉、燕麦、泡打粉、小苏打、肉桂粉和肉豆蔻粉放入碗中搅拌直至均匀混合；搅拌成南瓜混合物。加入菠菜搅拌直至均匀分散在面糊中。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将面糊分装到准备好的松饼杯中，每个杯装满⅔。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "在预热的烤箱中烘烤约 20 分钟，直至轻压时顶部弹回。在罐头中冷却 10 分钟，然后将松饼转移到金属架上完全冷却。"
    }
  ],
