  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 375 华氏度（190 摄氏度）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将面粉、红糖、泡打粉、肉桂粉和盐放入碗中搅拌；用两把刀或糕点搅拌机切黄油，直到混合物看起来像粗面包屑。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将半半和鸡蛋放在另一个碗中搅拌；拌入面粉混合物直至湿润。拌入梨。将大勺面团放在未抹油的烤盘上。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "放入预热好的烤箱中烘烤约15分钟至金黄色。食用前在金属架上稍微冷却。"
    }
  ],
