  "title": "番茄酱（正宗意大利番茄酱）",
  "min_age_month": 12,
  "tags": [
    "Dinner",
    "Italian",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 30,
  "cover_image": "images/f3303392b97c74771cb7de3660cd80bb.webp",
  "nutrition_tip": "一种简单的传统sugo，一种用特级初榨橄榄油调味的意大利番茄酱……",
  "ingredients": [
    {
      "name": "2 汤匙特级初榨橄榄油",
      "amount": ""
    },
    {
      "name": "1 个洋葱，切碎",
      "amount": ""
    },
    {
      "name": "4 瓣大蒜，减半",
      "amount": ""
    },
    {
      "name": "2 罐（14 盎司）passata（碎番茄）",
      "amount": ""
    },
    {
      "name": "0.25 杯新鲜罗勒，撕成两半",
      "amount": ""
    },
    {
      "name": "加盐调味",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在平底锅中用小火加热油。加入洋葱和大蒜。煮并搅拌直至变软且半透明，大约需要 5 分钟。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "添加帕萨塔、罗勒和盐。盖上盖子，用中火煮约 20 分钟，偶尔搅拌，直至番茄酱变稠。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "食用前去掉大蒜两半。"
    }
  ],
