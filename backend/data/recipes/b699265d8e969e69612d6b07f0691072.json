{
  "id": "b699265d8e969e69612d6b07f0691072",
  "title": "雪花饼干",
  "min_age_month": 12,
  "tags": [
    "Dessert",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 100,
  "cover_image": "images/34dc883d9deeec67577bd72057ad0fc8.webp",
  "nutrition_tip": "这些雪花饼干很容易用食品储藏室的订书钉制作；装饰愉快……",
  "ingredients": [
    {
      "name": "1.5 杯白糖",
      "amount": ""
    },
    {
      "name": "1 杯起酥油",
      "amount": ""
    },
    {
      "name": "3 个鸡蛋",
      "amount": ""
    },
    {
      "name": "1 茶匙香草精",
      "amount": ""
    },
    {
      "name": "3.75 杯通用面粉",
      "amount": ""
    },
    {
      "name": "1.5 茶匙盐",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "在一个大碗中用电动搅拌机将糖和起酥油搅拌至光滑。将一个鸡蛋打入黄油混合物中，然后加入剩余的鸡蛋和香草精。加入面粉和盐；搅拌直至面团刚刚混合。用保鲜膜包裹面团并冷藏至少 1 小时。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "准备烘烤时，将烤箱预热至 400 华氏度（200 摄氏度）。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在撒了少许面粉的表面上将面团擀成 1/8 英寸的厚度。用饼干切刀将面团切成所需的形状，然后将其放在未抹油的烤盘上，间隔 1 英寸。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在预热的烤箱中烘烤约 6 至 8 分钟，直至边缘呈金黄色。在烤盘上短暂冷却，然后移至金属架上完全冷却，然后再进行装饰。"
    }
  ],
