  "nutrition_tip": "这些适合儿童的肉饼松饼味道浓郁，口感优美……",
  "ingredients": [],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 350 °F。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将所有成分混合并搅拌均匀。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "用勺子舀出混合物，均匀地分入 12 个涂有油脂的松饼杯中。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "烘烤 1 小时，或直至肉饼中心温度达到 160 °F。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "稍微冷却后再从松饼杯中取出。"
    }
  ],
