  "nutrition_tip": "这个苹果黄油香料蛋糕食谱的特点是苹果黄油、酸奶油和整个……",
  "ingredients": [
    {
      "name": "1 杯包装红糖",
      "amount": ""
    },
    {
      "name": "0.5 杯切碎的山核桃",
      "amount": ""
    },
    {
      "name": "1 茶匙肉桂粉",
      "amount": ""
    },
    {
      "name": "0.5 茶匙肉豆蔻粉",
      "amount": ""
    },
    {
      "name": "2 杯通用面粉",
      "amount": ""
    },
    {
      "name": "1 茶匙泡打粉",
      "amount": ""
    },
    {
      "name": "1 茶匙小苏打",
      "amount": ""
    },
    {
      "name": "0.5 茶匙盐",
      "amount": ""
    },
    {
      "name": "1 杯白糖",
      "amount": ""
    },
    {
      "name": "0.5 杯黄油，室温",
      "amount": ""
    },
    {
      "name": "2 个鸡蛋，室温",
      "amount": ""
    },
    {
