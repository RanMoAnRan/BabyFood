  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 350 华氏度（175 摄氏度）。在 9x13 英寸的烤盘上涂抹油脂。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将红糖、山核桃、肉桂和肉豆蔻放入碗中。放在一边。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将面粉、泡打粉、小苏打和盐筛入碗中。放在一边。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将白糖和黄油放入碗中，用电动搅拌机搅拌至松软；一次打一个鸡蛋，每次添加后打匀。加入苹果酱、麸皮麦片和香草精，搅拌直至混合。加入面粉混合物，与酸奶油交替加入，每次添加后搅拌均匀。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将1/2面糊倒入准备好的烤盘中；撒上 ½ 红糖配料。盖上剩余的 1/2 面糊；撒上剩余的 ½ 配料。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "在预热的烤箱中烘烤约 40 分钟，直至插入中心的牙签拔出时是干净的。"
    }
  ],
