  "id": "e583f0ea50a347b021b1c847472a872c",
  "title": "薄荷假日饼干",
  "min_age_month": 12,
  "tags": [
    "Dessert",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 40,
  "cover_image": "images/2886c8a8a95c8ac8d765aedd17ffdd3d.webp",
  "nutrition_tip": "这些薄荷饼干在面团中添加了压碎的拐杖糖，并撒上......",
  "ingredients": [
    {
      "name": "1 杯黄油，软化",
      "amount": ""
    },
    {
      "name": "0.75 杯白糖",
      "amount": ""
    },
    {
      "name": "1 个鸡蛋，打散",
      "amount": ""
    },
    {
      "name": "3 杯通用面粉",
      "amount": ""
    },
    {
      "name": "0.25 茶匙盐",
      "amount": ""
    },
    {
      "name": "0.5 杯碎薄荷棒棒糖",
      "amount": ""
    },
    {
      "name": "0.75 杯糖果糖",
      "amount": ""
    },
    {
      "name": "5 茶匙温水",
      "amount": ""
    },
    {
      "name": "2 汤匙压碎的薄荷棒棒糖，或品尝",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 350 华氏度（175 摄氏度）。在烤盘上涂上少许油脂，或铺上羊皮纸。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将黄油和糖放入一个大碗中，用电动搅拌机搅拌直至松软。加入鸡蛋搅拌直至完全融合。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "加入面粉和盐，形成柔软的面团。折叠压碎的拐杖糖。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将面团擀成核桃大小的球，并以 1 英寸间隔放置在准备好的烤盘上。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "在预热的烤箱中烘烤 8 到 10 分钟，直至边缘呈金黄色。在烤盘上短暂冷却，然后移至金属架上完全冷却，再冷却 8 至 10 分钟。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "同时，制作糖霜：搅拌糖果制造商的糖衣。将糖和温水一起放入小碗中直至光滑。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "将饼干顶部浸入糖霜中，然后撒上压碎的拐杖糖。对剩余的饼干重复上述步骤。食用前让糖霜凝固，至少 5 分钟。"
    }
  ],
