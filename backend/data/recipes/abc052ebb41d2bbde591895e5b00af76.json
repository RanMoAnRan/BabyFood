      "amount": ""
    },
    {
      "name": "1 个青椒，切碎",
      "amount": ""
    },
    {
      "name": "4 瓣大蒜，切碎",
      "amount": ""
    },
    {
      "name": "0.25 杯勃艮第葡萄酒",
      "amount": ""
    },
    {
      "name": "0.25 杯切碎的新鲜罗勒",
      "amount": ""
    },
    {
      "name": "0.25 茶匙意大利调味料",
      "amount": ""
    },
    {
      "name": "2 茎芹菜",
      "amount": ""
    },
    {
