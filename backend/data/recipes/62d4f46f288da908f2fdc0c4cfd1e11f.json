  "nutrition_tip": "这个酸菜和香肠食谱很容易在慢炖锅中制作熟食店......",
  "ingredients": [
    {
      "name": "1 罐（20 盎司）酸菜罐头",
      "amount": ""
    },
    {
      "name": "0.25 杯红糖",
      "amount": ""
    },
    {
      "name": "1.5 磅多味香肠",
      "amount": ""
    },
    {
      "name": "1 个中等大小的洋葱，切片",
      "amount": ""
    },
    {
      "name": "0.5 杯水，或根据需要",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将酸菜和红糖放入一个中等大小的碗中混合。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将酸菜混合物倒入慢炖锅中；将香肠和洋葱放在上面。高火煮 2 小时。检查是否干燥，必要时加水。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将火调至小火，再煮 2 小时。"
    }
  ],
