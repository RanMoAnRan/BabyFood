  ],
  "difficulty": 1,
  "time_cost": 60,
  "cover_image": "images/3b37b0e841ec5b7627963b90c458cae3.webp",
  "nutrition_tip": "这款苹果蔓越莓脆片是用香甜多汁的烤苹果和酸果蔓制成的……",
  "ingredients": [
    {
      "name": "2 磅青苹果 - 去皮、去核并切成薄片",
      "amount": ""
    },
    {
      "name": "0.75 杯蔓越莓",
      "amount": ""
    },
    {
      "name": "0.25 杯白糖",
      "amount": ""
    },
    {
      "name": "1 汤匙肉桂粉",
      "amount": ""
    },
    {
      "name": "1 茶匙肉豆蔻粉",
      "amount": ""
    },
    {
      "name": "0.33333334326744 杯快煮燕麦",
      "amount": ""
    },
    {
      "name": "0.33333334326744 杯通用面粉",
      "amount": ""
    },
    {
      "name": "0.5 杯包装淡红糖",
      "amount": ""
    },
    {
      "name": "0.25 杯黄油，切成块",
      "amount": ""
    },
    {
      "name": "0.5 杯切碎的山核桃",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。将烤箱预热至 375 华氏度（190 摄氏度），在 8 英寸方形烤盘上涂抹黄油。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将苹果、蔓越莓、白糖、肉桂和肉豆蔻放入一个大碗中混合。将其均匀地放入准备好的烤盘中。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在同一个碗中，混合燕麦、面粉和红糖作为配料。加入黄油块，用叉子搅拌至易碎。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "拌入山核桃。将配料撒在烤盘中的苹果上。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "在预热的烤箱中烘烤 40 至 50 分钟，直至苹果变软且顶部呈金黄色。"
    }
  ],
