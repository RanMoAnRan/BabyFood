{
  "id": "5bade25e7148eb7e63a20dd3aa960d0a",
  "title": "挪威克鲁姆卡克",
  "min_age_month": 8,
  "tags": [
    "Dessert",
    "Norwegian"
  ],
  "difficulty": 1,
  "time_cost": 40,
  "cover_image": "images/3b3e44312fd06101fc7fb861b4fea661.webp",
  "nutrition_tip": "Krumkake 是一种挪威脆皮威化饼干，采用特殊设计制成……",
  "ingredients": [
    {
      "name": "1 杯白糖",
      "amount": ""
    },
    {
      "name": "0.5 杯无盐黄油",
      "amount": ""
    },
    {
      "name": "2 个大鸡蛋",
      "amount": ""
    },
    {
      "name": "1.5 杯通用面粉",
      "amount": ""
    },
    {
      "name": "1 杯牛奶",
      "amount": ""
    },
    {
      "name": "0.5 茶匙香草精",
      "amount": ""
    },
    {
      "name": "0.5 茶匙黄油调味料，可选",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "在一个大碗中搅拌糖和黄油直至混合；加入鸡蛋，一次一个，搅拌均匀。添加面粉、牛奶、香草和黄油调味料；加入面糊中搅拌至光滑。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "用中火加热克鲁姆卡克铁；在熨斗的两侧涂上黄油或烹饪喷雾。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将约一汤匙面糊舀到预热的熨斗的中心；轻轻合上，直到刚好压在一起。将一侧煎至金黄色，约 30 秒，然后翻转并煎另一侧。将克鲁姆卡克从熨斗中取出，然后用木勺柄快速卷成圆锥形。对剩余的面糊重复上述步骤。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将克鲁姆卡克放在金属架上完全冷却，然后存放在密封容器中。"
    }
  ],
