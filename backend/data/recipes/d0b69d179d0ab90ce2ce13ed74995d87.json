  "nutrition_tip": "巧克力软糖很容易在微波炉中制作，只需 3 种成分，然后选择......",
  "ingredients": [
    {
      "name": "3 杯半甜巧克力片",
      "amount": ""
    },
    {
      "name": "1 罐（14 盎司）甜炼乳",
      "amount": ""
    },
    {
      "name": "0.25 杯无盐黄油，切成块",
      "amount": ""
    },
    {
      "name": "1 杯碎核桃",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将巧克力片、炼乳和黄油放入可用于微波炉的大碗中。用微波炉中火加热 3 至 5 分钟，直至薯条融化，烹饪过程中搅拌一到两次。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "同时，在 8 英寸方形玻璃烤盘上涂上大量油脂。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "从微波炉中取出巧克力混合物，加入坚果搅拌。倒入准备好的盘子里。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "冷藏约 2 小时直至软糖凝固。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "切成 16 个方块。"
    }
  ],
