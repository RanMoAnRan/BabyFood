  ],
  "difficulty": 1,
  "time_cost": 25,
  "cover_image": "images/c00109cb4e3dd19d758e3c93bfd50a48.webp",
  "nutrition_tip": "涂有红糖和黄油釉的釉面胡萝卜是一种快速而简单的方法（……",
  "ingredients": [
    {
      "name": "2 磅胡萝卜，去皮并切成条",
      "amount": ""
    },
    {
      "name": "0.25 杯黄油",
      "amount": ""
    },
    {
      "name": "0.25 杯包装红糖",
      "amount": ""
    },
    {
      "name": "0.25 茶匙盐",
      "amount": ""
    },
    {
      "name": "0.125 茶匙白胡椒粉",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将胡萝卜放入大锅中；倒入足够的水至1英寸深度并煮沸。将火调至小火，盖上锅盖，小火煮 8 至 10 分钟，直至胡萝卜变软。沥干并转移到碗中。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在同一个平底锅中用小火融化黄油。加入红糖、盐和白胡椒直至溶解。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将胡萝卜放入锅中，搅拌直至裹上红糖混合物。煮并搅拌，直到胡萝卜被加热并完全涂上釉料，再煮 1 到 3 分钟。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "趁热享用吧！"
    }
  ],
