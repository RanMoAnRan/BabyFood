  "ingredients": [
    {
      "name": "6 杯烘焙混合物（例如 Bisquick ®）",
      "amount": ""
    },
    {
      "name": "2 磅切碎的超锐切达干酪",
      "amount": ""
    },
    {
      "name": "1 磅鼠尾草味猪肉香肠（例如 Neese's® Extra Sage Sausage），室温",
      "amount": ""
    },
    {
      "name": "1 磅热猪肉香肠（例如 Neese's® 热香肠），室温",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 300 华氏度（150 摄氏度）。给烤盘涂上油脂。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将烘焙混合物、奶酪、鼠尾草香肠和热香肠放入一个大碗中混合。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将混合物形成 1 1/2 英寸的球；放在准备好的烤盘上。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在预热的烤箱中烘烤 25 至 30 分钟，直至中心不再呈粉红色、外部不再呈棕色。"
    }
  ],
