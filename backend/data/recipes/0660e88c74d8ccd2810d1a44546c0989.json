  "nutrition_tip": "甜甜的素食毛茛南瓜汤，配姜配方，加入洋葱……",
  "ingredients": [
    {
      "name": "2 汤匙特级初榨橄榄油",
      "amount": ""
    },
    {
      "name": "1 个大黄洋葱，切碎",
      "amount": ""
    },
    {
      "name": "0.5 茶匙海盐，或适量",
      "amount": ""
    },
