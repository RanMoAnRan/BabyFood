{
  "id": "e4bf1c3c56fa0979918ca61b4cb9c5a4",
  "title": "以西结面包",
  "min_age_month": 12,
  "tags": [
    "Snack",
    "Bread",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 125,
  "cover_image": "images/d13c73b4de704b45b2f68a6da928e5f4.webp",
  "nutrition_tip": "以西结面包是用营养丰富的面粉制成的。你可以制作自己的以西结书……",
  "ingredients": [
    {
      "name": "4 杯温水（110 华氏度/45 摄氏度）",
      "amount": ""
    },
    {
      "name": "1 杯蜂蜜",
      "amount": ""
    },
    {
      "name": "0.5 杯橄榄油",
      "amount": ""
    },
    {
      "name": "2 包（0.25 盎司）活性干酵母",
      "amount": ""
    },
    {
      "name": "2.5 杯小麦浆果",
      "amount": ""
    },
    {
      "name": "1.5 杯斯佩尔特面粉",
      "amount": ""
    },
    {
      "name": "0.5 杯大麦",
      "amount": ""
    },
    {
      "name": "0.5 杯小米",
      "amount": ""
    },
    {
      "name": "0.25 杯干绿扁豆",
      "amount": ""
    },
    {
      "name": "2 汤匙干北方豆",
      "amount": ""
    },
    {
      "name": "2 汤匙干芸豆",
      "amount": ""
    },
    {
      "name": "2 汤匙干斑豆",
      "amount": ""
    },
    {
      "name": "2 汤匙盐，或适量",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在一个大碗中混合水、蜂蜜、橄榄油和酵母。静置 3 至 5 分钟。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "同时，将小麦浆果、斯佩耳特小麦面粉、大麦、小米、扁豆、大北豆、芸豆和斑豆搅拌在一起，直至充分混合。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在面粉磨机中研磨。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将新鲜磨碎的面粉混合物和盐添加到酵母混合物中；搅拌直至充分混合，大约需要 10 分钟。面团会松散。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "将面团倒入两个涂有油脂的 9x5 英寸面包盘中。放在温暖的地方发酵约 1 小时，直到面团到达锅的顶部。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "将烤箱预热至 350 华氏度（175 摄氏度）。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "在预热的烤箱中烘烤 45 至 50 分钟，直至面包呈金黄色。"
    }
  ],
