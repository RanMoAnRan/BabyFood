  "id": "44ed5e7618359074fbb435052425038b",
  "title": "意大利婚礼汤",
  "min_age_month": 8,
  "tags": [
    "Soup",
    "Italian",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 50,
  "cover_image": "images/8cd87104c2fb6c9a41872c9645fc4ef3.webp",
  "nutrition_tip": "这道意大利婚礼汤里有自制的肉丸、嫩米粒意大利面……",
  "ingredients": [
    {
      "name": "0.5 磅超瘦碎牛肉",
      "amount": ""
    },
    {
      "name": "1 个大鸡蛋，轻轻打散",
      "amount": ""
    },
    {
      "name": "2 汤匙干面包屑",
      "amount": ""
    },
    {
      "name": "1 汤匙磨碎的帕尔马干酪",
      "amount": ""
    },
    {
      "name": "0.5 茶匙干罗勒",
      "amount": ""
    },
    {
      "name": "0.5 茶匙洋葱粉",
      "amount": ""
    },
    {
      "name": "5.75 杯鸡汤",
      "amount": ""
    },
    {
      "name": "2 杯切成薄片的蜗牛",
      "amount": ""
    },
    {
      "name": "1 杯生米粒意大利面",
      "amount": ""
    },
    {
      "name": "0.33333334326744 杯切碎的胡萝卜",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将碎牛肉、鸡蛋、面包屑、帕尔马干酪、罗勒和洋葱粉放入碗中。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将牛肉混合物塑造成 3/4 英寸的球，放在衬有羊皮纸的托盘上。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在大锅中用中高火加热肉汤直至沸腾。加入蜗牛、米粒、胡萝卜和肉丸，再次煮沸。把火调至中火，慢火煮，经常搅拌以防止粘连，直到意大利面变软但咬起来很硬，大约需要 10 分钟。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "趁热享用吧！"
    }
  ],
