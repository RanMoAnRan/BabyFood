  "nutrition_tip": "这个快速简单的桃子天使食品蛋糕食谱是用盒装蛋糕混合物制成的......",
  "ingredients": [
    {
      "name": "1 包（18.25 盎司）天使食品蛋糕粉",
      "amount": ""
    },
    {
      "name": "1 罐（15 盎司）桃子丁",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 350 华氏度（175 摄氏度）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将蛋糕粉、桃子和果汁放入一个大碗中，直至充分混合。将面糊倒入未抹油的 10x4 英寸管盘中。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在预热的烤箱中烘烤 37 至 47 分钟，直至顶部呈深金黄色且裂纹感觉非常干燥且不粘。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在锅中冷却蛋糕，倒扣到金属架、空酒瓶或细颈玻璃瓶上，这样可以防止蛋糕下沉。"
    }
  ],
