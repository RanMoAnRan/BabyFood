  ],
  "difficulty": 1,
  "time_cost": 95,
  "cover_image": "images/013206957be5bb775d6bade8495f4fd3.webp",
  "nutrition_tip": "这个快速南瓜漩涡面包配方的特点是甜奶油奶酪丝带……",
  "ingredients": [
    {
      "name": "0.25 杯白糖",
      "amount": ""
    },
    {
      "name": "1 包（8 盎司）奶油干酪",
      "amount": ""
    },
    {
      "name": "1 个鸡蛋，打散",
      "amount": ""
    },
    {
      "name": "1.75 杯通用面粉",
      "amount": ""
    },
    {
      "name": "1 茶匙小苏打",
      "amount": ""
    },
    {
      "name": "1 茶匙肉桂粉",
      "amount": ""
    },
    {
      "name": "0.5 茶匙盐",
      "amount": ""
    },
    {
      "name": "0.25 茶匙肉豆蔻粉",
      "amount": ""
    },
    {
      "name": "1 杯南瓜泥",
      "amount": ""
    },
    {
      "name": "0.5 杯黄油，融化",
      "amount": ""
    },
    {
      "name": "0.33333298563957 杯水",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 350 华氏度（175 摄氏度）。在 9x5 英寸的面包盘上涂上油脂并撒上面粉。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在一个大碗中用电动搅拌机将 ¼ 杯糖、奶油干酪和 1 个鸡蛋搅拌至光滑细腻。放在一边。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将剩余的 1 ½ 杯糖、面粉、小苏打、肉桂、盐和肉豆蔻放入另一个碗中。将剩余的 1 个鸡蛋、南瓜、黄油和水混合在另一个碗中；加入面粉混合物搅拌直至湿润。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "预留2杯南瓜面糊。将剩余的面糊倒入准备好的平底锅中；将奶油奶酪混合物倒在上面。上面放上预留的2杯南瓜面糊；用刀将面糊切几次，以获得漩涡效果。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "在预热的烤箱中烘烤约 70 分钟，直至插入中心的牙签拔出时是干净的。在锅中冷却 10 分钟，然后从锅中取出，转移到金属架上完全冷却。"
    }
  ],
