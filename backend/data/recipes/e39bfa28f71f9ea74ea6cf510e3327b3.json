  "nutrition_tip": "这种 2 种成分的花生酱软糖很容易在微波炉中用奶油制作……",
  "ingredients": [
    {
      "name": "蜡纸",
      "amount": ""
    },
    {
      "name": "1 罐（18 盎司）花生酱",
      "amount": ""
    },
    {
      "name": "1 容器（12 盎司）鲜奶油奶酪糖霜",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在8英寸的方盘上铺上蜡纸；放在一边。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将花生酱和奶油干酪糖霜舀入微波炉安全的碗中；在微波炉中高火加热 30 秒。搅拌混合物并再次加热30秒；再次搅拌直至完全混合。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将混合物倒入准备好的烤盘中。冷藏约 1 小时直至冷却，然后切成一口大小的方块。"
    }
  ],
