  "nutrition_tip": "这些烤烧烤猪排可以用最少的原料快速轻松地准备......",
  "ingredients": [
    {
      "name": "1 个洋葱，切碎",
      "amount": ""
    },
    {
      "name": "1 杯番茄酱",
      "amount": ""
    },
    {
      "name": "2 汤匙白葡萄酒醋",
      "amount": ""
    },
    {
