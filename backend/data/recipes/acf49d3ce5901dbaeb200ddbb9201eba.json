      "amount": ""
    },
    {
      "name": "1 汤匙伍斯特酱",
      "amount": ""
    },
    {
      "name": "1 汤匙黄芥末",
      "amount": ""
    },
    {
      "name": "1 茶匙辣椒",
      "amount": ""
    },
    {
      "name": "6 块薄猪排",
      "amount": ""
    },
