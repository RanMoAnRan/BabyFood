{
  "id": "9b848312598e96e03bf0746f022b7ce4",
  "title": "酸菜烤猪排",
  "min_age_month": 12,
  "tags": [
    "Dinner",
    "German"
  ],
  "difficulty": 1,
  "time_cost": 60,
  "cover_image": "images/b739c1117d5afbc8fef262649d3ae65e.webp",
  "nutrition_tip": "丰盛的猪排和酸菜与苹果丁、洋葱片和……一起烘烤。",
  "ingredients": [
    {
      "name": "4 块猪排",
      "amount": ""
    },
    {
      "name": "盐和现磨黑胡椒粉适量",
      "amount": ""
    },
    {
      "name": "1 汤匙油，或根据需要",
      "amount": ""
    },
    {
      "name": "1 罐（20 盎司）酸菜，沥干",
      "amount": ""
    },
    {
      "name": "1 个苹果 - 去皮、去核、切块",
      "amount": ""
    },
    {
      "name": "1 个洋葱，切碎",
      "amount": ""
    },
    {
      "name": "0.25 杯红糖",
      "amount": ""
    },
    {
      "name": "0.5 汤匙香菜籽",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。将烤箱预热至 350 华氏度（175 摄氏度）。在 2 夸脱的砂锅盘上涂抹油脂。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在猪排两面抹上盐和胡椒粉。在煎锅中用中火加热油，将猪排两面煎至焦黄，每面煎 5 至 7 分钟。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将焦黄的猪排放入准备好的砂锅中。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将酸菜、苹果、洋葱、红糖和香菜籽放入碗中；用混合物覆盖猪排。用铝箔盖紧以保持水分。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将猪排放入预热好的烤箱中烘烤，直至中心不再呈粉红色，大约需要 45 分钟。插入中心的即时读数温度计读数应为 145 华氏度（63 摄氏度）。"
    }
  ],
