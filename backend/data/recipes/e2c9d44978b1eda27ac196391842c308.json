{
  "id": "e2c9d44978b1eda27ac196391842c308",
  "title": "复活节火腿",
  "min_age_month": 12,
  "tags": [
    "Dinner",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 75,
  "cover_image": "images/05e83f821d942f4953e265d690196765.webp",
  "nutrition_tip": "复活节火腿是许多人的传统，这个食谱以芥末和黄油为特色......",
  "ingredients": [
    {
      "name": "2 杯红糖",
      "amount": ""
    },
    {
      "name": "3 汤匙准备好的黄芥末，或根据需要",
      "amount": ""
    },
    {
      "name": "1 根（7 磅）去骨火腿",
      "amount": ""
    },
    {
      "name": "1罐（8盎司）菠萝圈汁，沥干并保留汁液",
      "amount": ""
    },
    {
      "name": "1 杯蜂蜜",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。将烤箱预热至 350 华氏度（175 摄氏度）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "通过以菱形图案进行 1/2 英寸深的对角切口来对火腿进行刻痕。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将红糖与足够的芥末混合，制成光滑、可倾倒的酱汁。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将火腿放入烤盘中。在上面淋上蜂蜜、保留的菠萝汁和红糖混合物。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将菠萝圈装饰性地放在火腿上，并用木牙签固定。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "在预热的烤箱中烘烤，每 15 分钟涂上锅汁，直到火腿上的菱形图案裂开，大约需要 1 到 1 ½ 小时。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "上菜并享用！"
    }
  ],
