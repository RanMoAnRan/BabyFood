{
  "id": "f58ac01492ee7832121e24cade08b943",
  "title": "自制脆皮调味炸薯条",
  "min_age_month": 12,
  "tags": [
    "Dinner",
    "Side Dish",
    "American",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 25,
  "cover_image": "images/2318873847b64b6b9c6a4a25e8fae567.webp",
  "nutrition_tip": "用丰富的自制面糊制成的调味薯条，并用大蒜和辣椒调味......",
  "ingredients": [
    {
      "name": "2.5 磅赤褐色土豆，去皮",
      "amount": ""
    },
    {
      "name": "1 杯煎炸植物油",
      "amount": ""
    },
    {
      "name": "1 杯通用面粉",
      "amount": ""
    },
    {
      "name": "1 茶匙蒜盐",
      "amount": ""
    },
    {
      "name": "1 茶匙洋葱盐",
      "amount": ""
    },
    {
      "name": "1 茶匙辣椒粉",
      "amount": ""
    },
    {
      "name": "1 茶匙盐",
      "amount": ""
    },
    {
      "name": "0.5 杯水，或根据需要",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将土豆切成薯条，放入一大碗冷水中，防止土豆变褐色。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在重平底锅或大煎锅中将油加热至 350 华氏度（175 摄氏度）。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "当油加热时，将面粉、蒜盐、洋葱盐、辣椒粉和盐筛入一个大碗中。逐渐加入足够的水，制成稍微浓稠的面糊，可以用勺子淋上。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "沥干薯条并拍干；一次浸入面糊中。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "小心地将薯条分批放入热油中，以防止它们结块。煎至各面金黄酥脆，约 7 至 10 分钟。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "将薯条放在铺有纸巾的盘子上沥干。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "趁热享用吧！"
    }
  ],
