{
  "id": "018b18475dd350e0ae3c3f1494abfb9a",
  "title": "土豆砂锅",
  "min_age_month": 8,
  "tags": [
    "Dinner",
    "Side Dish",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 85,
  "cover_image": "images/e690431c79c741801214e9f41d802d1f.webp",
  "nutrition_tip": "这个土豆砂锅有一层层奶油状、奶酪味的土豆煎饼……",
  "ingredients": [
    {
      "name": "1 包（30 盎司）冷冻土豆泥",
      "amount": ""
    },
    {
      "name": "2 杯切达干酪丝",
      "amount": ""
    },
    {
      "name": "1 罐（16 盎司）酸奶油",
      "amount": ""
    },
    {
      "name": "1 罐（10.5 盎司）浓缩奶油蘑菇汤",
      "amount": ""
    },
    {
      "name": "1 杯黄油，分开",
      "amount": ""
    },
    {
      "name": "1 个洋葱，切碎",
      "amount": ""
    },
    {
      "name": "3 杯碎玉米片",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集原料。将烤箱预热至 425 华氏度（220 摄氏度）。在 9x13 英寸的烤盘上涂上少许油脂。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将薯饼倒入准备好的盘子中；放在一边。将奶酪、酸奶油和浓缩汤放入一个大碗中；放在一边。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在大煎锅中用中火融化 1/2 杯黄油；用热黄油炒洋葱 5 分钟。添加到奶酪混合物中并混合直至混合。铺在盘子里的薯饼上。撒上玉米片。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "用中火在煎锅中融化剩余的 1/2 杯黄油，然后倒在玉米片上。在预热好的烤箱中烘烤1小时。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "享受吧！"
    }
  ],
