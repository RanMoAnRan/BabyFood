  "cover_image": "images/b4224509c8580796e5147b3ac5c92b33.webp",
  "nutrition_tip": "这个南瓜黄油曲奇食谱的特点是南瓜派香料、肉桂和切碎……",
  "ingredients": [
    {
      "name": "1 杯包装淡红糖",
      "amount": ""
    },
    {
      "name": "0.25 杯黄油，软化",
      "amount": ""
    },
    {
      "name": "0.5 杯快煮燕麦",
      "amount": ""
    },
    {
      "name": "0.5 杯南瓜黄油",
      "amount": ""
    },
    {
      "name": "1 个鸡蛋",
      "amount": ""
    },
    {
      "name": "1 杯通用面粉",
      "amount": ""
    },
    {
      "name": "0.5 茶匙小苏打",
      "amount": ""
    },
    {
      "name": "0.5 茶匙泡打粉",
      "amount": ""
    },
    {
      "name": "0.5 茶匙盐",
      "amount": ""
    },
    {
      "name": "0.5 茶匙南瓜派香料",
      "amount": ""
    },
    {
      "name": "0.5 茶匙肉桂粉",
      "amount": ""
    },
    {
      "name": "2 汤匙牛奶",
      "amount": ""
    },
    {
      "name": "0.5 杯切碎的山核桃",
      "amount": ""
    },
    {
      "name": "0.5 杯葡萄干",
      "amount": ""
    }
