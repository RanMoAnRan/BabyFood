  "nutrition_tip": "A small scoop of flour makes this the best French toast recipe! Thickening the b…",
  "ingredients": [
    {
      "name": "0.25 cup all-purpose flour",
      "amount": ""
    },
    {
      "name": "1 cup milk",
      "amount": ""
    },
    {
      "name": "3 eggs",
      "amount": ""
    },
    {
      "name": "1 tablespoon white sugar",
      "amount": ""
    },
    {
      "name": "1 teaspoon vanilla extract",
      "amount": ""
    },
    {
      "name": "0.5 teaspoon ground cinnamon",
      "amount": ""
    },
    {
      "name": "1 pinch salt",
      "amount": ""
    },
    {
      "name": "12 thick slices bread",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "Gather all ingredients."
    },
    {
      "step_index": 2,
      "img": "",
      "text": "Place flour into a large mixing bowl; slowly whisk in milk until smooth. Whisk in eggs, sugar, vanilla, cinnamon, and salt until well combined."
    },
    {
      "step_index": 3,
      "img": "",
      "text": "Heat a lightly oiled griddle or frying pan over medium heat. Meanwhile, soak bread slices in milk mixture until saturated."
    },
    {
      "step_index": 4,
      "img": "",
      "text": "Working in batches, cook bread on the preheated griddle or pan until golden brown on both sides, about 2 minutes per side."
    },
    {
      "step_index": 5,
      "img": "",
      "text": "Serve hot and enjoy."
    }
  ],
