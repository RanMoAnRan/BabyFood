  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将面粉放入一个大搅拌碗中；慢慢加入牛奶搅拌至光滑。加入鸡蛋、糖、香草精、肉桂和盐，搅拌均匀。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "用中火加热涂有少许油的煎锅或煎锅。同时，将面包片浸泡在牛奶混合物中直至饱和。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "分批工作，在预热的煎锅或平底锅上将面包煎至两面金黄色，每面约 2 分钟。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "趁热享用。"
    }
  ],
