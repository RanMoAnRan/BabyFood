  "nutrition_tip": "简单的冰箱莳萝泡菜，用适量的……完美调味。",
  "ingredients": [
    {
      "name": "3.5 杯水",
      "amount": ""
    },
    {
      "name": "1.25 杯白醋",
      "amount": ""
    },
    {
      "name": "1 汤匙白糖",
      "amount": ""
    },
    {
      "name": "1 汤匙海盐",
      "amount": ""
    },
    {
      "name": "4 杯黄瓜矛",
      "amount": ""
    },
    {
      "name": "2 瓣大蒜，整个",
      "amount": ""
    },
    {
      "name": "2 头新鲜莳萝",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将水、醋、糖和海盐放入平底锅中，用大火搅拌；煮沸。从火上移开并完全冷却。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将黄瓜矛、蒜瓣和新鲜莳萝放入一个大玻璃或塑料盖容器中。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将冷却的醋混合物倒在黄瓜、大蒜和莳萝上。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "盖上容器密封并冷藏至少 3 天。"
    }
  ],
