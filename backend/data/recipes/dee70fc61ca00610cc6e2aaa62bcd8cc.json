    "American"
  ],
  "difficulty": 1,
  "time_cost": 110,
  "cover_image": "images/7d13b4625bb9b857df9cff5ddbe19889.webp",
  "nutrition_tip": "这个简单的黑森林蛋糕，在Bundt平底锅中用蛋糕粉和樱桃馅饼制成......",
  "ingredients": [
    {
      "name": "1 包（18.25 盎司）魔鬼食品蛋糕粉布丁",
      "amount": ""
    },
    {
      "name": "1 罐（21 盎司）樱桃派馅料",
      "amount": ""
    },
    {
      "name": "1.5 杯半甜巧克力片",
      "amount": ""
    },
    {
      "name": "3 个鸡蛋",
      "amount": ""
    },
    {
      "name": "1 汤匙杏仁提取物",
      "amount": ""
    },
    {
      "name": ".5 杯半甜巧克力片",
      "amount": ""
    },
    {
      "name": "2 汤匙牛奶",
      "amount": ""
    },
    {
      "name": "1 汤匙无盐黄油",
      "amount": ""
    },
    {
      "name": "0.5 杯糖果糖",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 350 华氏度（175 摄氏度）。在 10 英寸的平底锅上涂上大量油脂并撒上面粉。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "制作蛋糕：在搅拌碗中搅拌蛋糕粉、馅饼馅料、巧克力片、鸡蛋和杏仁提取物，直至完全混合。将面糊倒入准备好的平底锅中。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在预热的烤箱中烘烤 55 到 60 分钟，直到插入中心附近的牙签拔出来时是干净的。在锅中冷却 15 分钟，然后倒扣到金属架上完全冷却，再冷却约 30 分钟。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "同时，制作釉料：在平底锅中用中高火加热巧克力片、牛奶和黄油，偶尔搅拌，直到巧克力融化并且混合物充分混合。加入糖果搅拌均匀。糖。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将釉料涂在冷却的蛋糕上。"
    }
  ],
