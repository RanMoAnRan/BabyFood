  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将一个大锅放在大火上；淋上油。在热油中烹煮并搅拌碎牛肉、洋葱和盐，直至牛肉易碎并变成褐色，并且释放的液体蒸发，大约需要 4 分钟。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将热量降低至中高。加入智利粉、大蒜、小茴香、辣椒粉、黑胡椒和肉桂。煮并搅拌 3 至 4 分钟，直至混合物开始变黑。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "倒入啤酒。加入水、番茄泥、可可粉、牛至和辣椒；搅拌均匀。煮沸；将火调至中低，煮 30 分钟。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "拌入豆子和波布拉诺胡椒。煮约30分钟，直至辣椒变软且味道混合；如果辣椒变得太稠，请加更多的水。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "上菜并享用！"
    }
  ],
