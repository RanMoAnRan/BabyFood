  "id": "41ba26cab17e65b1b25d0b3cda7efd19",
  "title": "妈妈的苹果油条",
  "min_age_month": 12,
  "tags": [
    "Brunch",
    "American",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 35,
  "cover_image": "images/1fbbf620b27cd009c089d1f2efb15a1a.webp",
  "nutrition_tip": "这些美味的苹果油条很容易用新鲜苹果在简单的蝙蝠中制作......",
  "ingredients": [
    {
      "name": "1 夸脱油炸用植物油",
      "amount": ""
    },
    {
      "name": "1.5 杯通用面粉",
      "amount": ""
    },
    {
      "name": "1 汤匙白糖",
      "amount": ""
    },
    {
      "name": "2 茶匙泡打粉",
      "amount": ""
    },
    {
      "name": "0.5 茶匙盐",
      "amount": ""
    },
    {
      "name": "0.66666668653488 杯牛奶",
      "amount": ""
    },
    {
      "name": "2 个大鸡蛋，打散",
      "amount": ""
    },
    {
      "name": "1 汤匙植物油",
      "amount": ""
    },
    {
      "name": "3 杯苹果 - 去皮、去核并切碎",
      "amount": ""
    },
    {
      "name": "1 杯肉桂糖",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集原料。将油炸锅或电煎锅中的油加热至 375 华氏度（190 摄氏度）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在一个大碗中将面粉、糖、泡打粉和盐搅拌在一起。倒入牛奶、鸡蛋、油；搅拌直至充分混合。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "加入苹果直至均匀分布。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "小批量工作，防止过度拥挤，将一勺面糊放入油炸锅中，在热油中炸至金黄色，大约需要 5 分钟。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "使用有槽勺将油条转移到铺有纸巾的盘子上。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "将热油条和肉桂糖放入碗中，直至裹好。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "享受吧！"
    }
  ],
