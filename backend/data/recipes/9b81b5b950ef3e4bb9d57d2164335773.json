{
  "id": "9b81b5b950ef3e4bb9d57d2164335773",
  "title": "简单的蛋糕棒棒糖",
  "min_age_month": 12,
  "tags": [
    "Dessert",
    "American",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 150,
  "cover_image": "images/1093d7c21671b1d56b74f49bd3473cbf.webp",
  "nutrition_tip": "这些棒棒糖蛋糕很容易用任何口味的蛋糕粉和糖霜制作，以达到完美的效果……",
  "ingredients": [
    {
      "name": "1 包（15.25 盎司）黄色蛋糕粉（例如 Betty Crocker®）",
      "amount": ""
    },
    {
      "name": "1 杯水",
      "amount": ""
    },
    {
      "name": "3 个大鸡蛋",
      "amount": ""
    },
    {
      "name": "0.5 杯植物油",
      "amount": ""
    },
    {
      "name": "1 个（16 盎司）容器准备好的巧克力糖霜",
      "amount": ""
    },
    {
      "name": "18 根棒棒糖棒",
      "amount": ""
    },
    {
      "name": "1 袋（14 盎司）巧克力糖融化",
      "amount": ""
    },
    {
      "name": "1 管（0.75 盎司）装饰糖霜",
      "amount": ""
    },
    {
      "name": "1 汤匙五彩糖果粒，或根据需要",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 350 华氏度（175 摄氏度）。在 9x13 英寸的烤盘上涂抹油脂。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "使用电动搅拌机在碗中低速搅拌蛋糕粉、水、油和鸡蛋 30 秒。将速度调至中速，再打 2 分钟。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将面糊倒入准备好的烤盘中。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在预热的烤箱中烘烤 28 到 33 分钟，直到插入中心的牙签拔出来时是干净的。从烤箱中取出并完全冷却至少 1 小时。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将冷却的蛋糕弄碎放入一个大碗中。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "将糖霜搅拌到碎蛋糕中，直到混合物变粘并开始聚集在一起，但不太光滑。冷藏至少 30 分钟直至冷却。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "将蛋糕混合物滚成十八个 1 1/2 英寸的球，然后放在烤盘上。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "将大约 1/4 杯融化的糖果放入微波炉专用的碗中。用微波炉加热约 20 秒直至融化。"
    },
    {
      "step_index": 9,
      "img": "",
      "text": "将一根棒棒糖棒推入每个蛋糕混合物球的一半。"
    },
    {
      "step_index": 10,
      "img": "",
      "text": "将球轻轻浸入融化的巧克力中，然后将其直立放置在一块聚苯乙烯泡沫塑料中。"
    },
    {
      "step_index": 11,
      "img": "",
      "text": "当巧克力涂层湿润时，用糖果粒装饰。重复制作剩余的蛋糕棒棒糖，根据需要融化更多的糖果。"
    },
    {
      "step_index": 12,
      "img": "",
      "text": "享受吧！"
    }
  ],
