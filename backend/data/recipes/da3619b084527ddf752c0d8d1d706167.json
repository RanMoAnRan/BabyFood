{
  "id": "da3619b084527ddf752c0d8d1d706167",
  "title": "早餐香肠砂锅",
  "min_age_month": 12,
  "tags": [
    "Breakfast",
    "Brunch",
    "American",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 590,
  "cover_image": "images/4d03ca4b0211caf1cf4a539bee52f08a.webp",
  "nutrition_tip": "这个香肠早餐砂锅配猪肉香肠、鸡蛋和奶酪很容易……",
  "ingredients": [
    {
      "name": "1 磅碎猪肉香肠",
      "amount": ""
    },
    {
      "name": "1 茶匙芥末粉",
      "amount": ""
    },
    {
      "name": "0.5 茶匙盐",
      "amount": ""
    },
    {
      "name": "4 个大鸡蛋",
      "amount": ""
    },
    {
      "name": "2 杯牛奶",
      "amount": ""
    },
    {
      "name": "6 片白面包，烘烤并切成方块",
      "amount": ""
    },
    {
      "name": "8 盎司淡味切达干酪，切丝",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将香肠弄碎放入中型煎锅中。用中火煮至均匀棕色；流走。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在一个中等大小的碗中，将芥末粉、盐、鸡蛋和牛奶混合在一起。加入香肠、面包块和奶酪，搅拌均匀。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "倒入涂有油脂的 9x13 英寸烤盘中。盖上盖子，放入冰箱冷藏 8 小时或过夜。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将烤箱预热至 350 华氏度（175 摄氏度）。盖上盖子，烘烤 45 至 60 分钟。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "揭开盖子，将温度降至 325 华氏度（165 摄氏度）。再烘烤 30 分钟，或直至凝固"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "趁热享用吧！"
    }
  ],
