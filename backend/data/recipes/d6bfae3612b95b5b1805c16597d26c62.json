      "amount": ""
    },
    {
      "name": "2 个西红柿，切碎",
      "amount": ""
    },
    {
      "name": "1 个牛油果 - 去皮、去核、切丁",
      "amount": ""
    },
    {
      "name": "0.5 个红洋葱，切成薄片",
      "amount": ""
    },
    {
      "name": "0.5 杯蔓越莓干",
      "amount": ""
    },
    {
      "name": "0.5 杯蓝纹奶酪碎",
      "amount": ""
    },
    {
      "name": "0.33333334326744 杯核桃油",
      "amount": ""
    },
    {
      "name": "2汤匙红树莓果酱（带籽）",
      "amount": ""
    },
    {
      "name": "2 汤匙红酒醋",
      "amount": ""
    },
    {
