{
  "id": "c40a421ff54b90622977c520aa007d32",
  "title": "烤土豆汤",
  "min_age_month": 8,
  "tags": [
    "Soup",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 40,
  "cover_image": "images/d825ed56831f0bf55620a0f705cc5958.webp",
  "nutrition_tip": "这种奶油烤土豆汤很容易用剩下的烤土豆和我做...",
  "ingredients": [
    {
      "name": "12 片培根",
      "amount": ""
    },
    {
      "name": "0.66666668653488 杯黄油或人造黄油",
      "amount": ""
    },
    {
      "name": "0.66666668653488 杯通用面粉",
      "amount": ""
    },
    {
      "name": "7 杯牛奶",
      "amount": ""
    },
    {
      "name": "4 个大烤土豆，去皮切块",
      "amount": ""
    },
    {
      "name": "4 个葱，切碎",
      "amount": ""
    },
    {
      "name": "1.25 杯切达干酪丝",
      "amount": ""
    },
    {
      "name": "1 杯酸奶油",
      "amount": ""
    },
    {
      "name": "1 茶匙盐",
      "amount": ""
    },
    {
      "name": "1 茶匙黑胡椒粉",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将培根放入大煎锅中，用中高火煮，偶尔翻转，直至均匀变成棕色，大约需要 8 到 10 分钟。将培根片放在纸巾上沥干水分；弄碎并放在一边。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "同时，在汤锅或荷兰烤箱中用中火融化黄油。逐渐加入面粉，搅拌直至充分混合。慢慢倒入牛奶，不断搅拌直至光滑变稠。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "加入土豆和洋葱，煮沸，经常搅拌。减少热量并煮 10 分钟。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "拌入碎培根、切达干酪、酸奶油、盐和胡椒。继续烹饪并搅拌直至奶酪融化。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "享受吧！"
    }
  ],
