{
  "id": "6d90bb71ee1fa1c0a99f60ab58d3aa25",
  "title": "培根和培根切达绿豆砂锅",
  "min_age_month": 8,
  "tags": [
    "Side Dish",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 40,
  "cover_image": "images/45727f43896f58aed57ac7e12e9c4e91.webp",
  "nutrition_tip": "这个绿豆砂锅配培根和切达干酪是完美的节日配菜......",
  "ingredients": [
    {
      "name": "4 罐（14.5 盎司）Del Monte® 青豆，任何款式，沥干",
      "amount": ""
    },
    {
      "name": "2 罐（10.5 盎司）Campbell's® 浓缩奶油蘑菇汤",
      "amount": ""
    },
    {
      "name": "2.6666667461395 杯 French's® 法式炸洋葱，分开",
      "amount": ""
    },
    {
      "name": "1 杯牛奶",
      "amount": ""
    },
    {
      "name": "0.5 杯切达干酪丝，分开",
      "amount": ""
    },
    {
      "name": "6 片煮熟的培根，分开",
      "amount": ""
    },
    {
      "name": "0.25 茶匙黑胡椒粉",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 350 华氏度（175 摄氏度）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将青豆、浓缩汤、牛奶和胡椒粉放入一个大碗中。添加 1 1/3 杯炸洋葱和 1/2 切达干酪。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将 5 片培根弄碎；添加到绿豆混合物中并混合直至充分混合。转移到 3 夸脱的烤盘中。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在预热的烤箱中烘烤约 25 分钟，直至变热并起泡。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "从烤箱中取出并搅拌。撒上剩余的切达干酪和洋葱。将剩下的培根片压碎在上面。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "返回烤箱，烘烤约 5 分钟，直到洋葱变成金黄色。"
    }
  ],
