{
  "id": "eda01310146a6178fbf7554ff96b8f69",
  "title": "圣诞花环",
  "min_age_month": 12,
  "tags": [
    "Dessert",
    "American",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 45,
  "cover_image": "images/a1178e3d398269efcfcefdebec811af5.webp",
  "nutrition_tip": "圣诞花环饼干用玉米片制成，并用肉桂糖装饰......",
  "ingredients": [
    {
      "name": "0.5 杯黄油",
      "amount": ""
    },
    {
      "name": "30 个大棉花糖",
      "amount": ""
    },
    {
      "name": "1.5 茶匙绿色食用色素",
      "amount": ""
    },
    {
      "name": "1 茶匙香草精",
      "amount": ""
    },
    {
      "name": "4 杯玉米片麦片",
      "amount": ""
    },
    {
      "name": "2 汤匙肉桂红热糖果",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在大平底锅中用小火融化黄油。加入棉花糖，不断搅拌直至融化。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "离火，拌入食用色素和香草精，然后拌入玉米片。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "放置一张或两张蜡纸。在煎锅中倒入 1 英寸的热水。将平底锅放入煎锅中，使饼干面团保持温暖。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "快速将一大汤匙饼干面团放在蜡纸上，然后用涂有少许油脂的手指将其形成花环形状。立即用红热的糖果装饰饼干。重复塑造和装饰剩余的饼干。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "让饼干冷却至室温，然后从蜡纸上取下，大约需要 15 分钟。存放在密封容器中。"
    }
  ],
  "warnings": [],
