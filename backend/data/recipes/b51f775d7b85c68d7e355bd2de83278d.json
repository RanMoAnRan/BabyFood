  "nutrition_tip": "这种慢炖锅辣椒配啤酒配方充满了花斑豆和芸豆，......",
  "ingredients": [
    {
      "name": "2 磅碎牛肉",
      "amount": ""
    },
    {
      "name": "1 个中等大小的洋葱，切丁",
      "amount": ""
    },
    {
      "name": "1 罐（29 盎司）番茄酱",
      "amount": ""
    },
    {
      "name": "1 罐（29 盎司）芸豆，不沥干",
      "amount": ""
    },
    {
      "name": "1罐（29盎司）斑豆罐头，不沥干",
      "amount": ""
    },
    {
      "name": "2 杯啤酒",
      "amount": ""
    },
    {
      "name": "1罐（14.5盎司）番茄丁",
      "amount": ""
    },
    {
      "name": "1 罐（4.5 盎司）切碎的青辣椒",
      "amount": ""
    },
    {
      "name": "2 汤匙辣椒粉",
      "amount": ""
    },
    {
      "name": "1 汤匙孜然粉",
      "amount": ""
    },
    {
      "name": "2 茶匙盐",
      "amount": ""
    },
    {
      "name": "2 茶匙黑胡椒粉",
      "amount": ""
    }
