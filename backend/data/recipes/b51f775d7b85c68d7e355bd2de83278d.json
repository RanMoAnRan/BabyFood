  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "在大煎锅中用中高火煮碎牛肉和洋葱，直到牛肉变成棕色且易碎，洋葱变成半透明，持续 7 到 10 分钟。排干并丢弃多余的油脂。将牛肉混合物转移到慢炖锅中。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将番茄酱、芸豆、斑豆、啤酒、番茄丁、青辣椒、辣椒粉、小茴香、盐和黑胡椒加入牛肉混合物中搅拌均匀。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "盖上慢炖锅。低火煮 8 至 10 小时，或高火煮 4 至 5 小时。"
    }
  ],
