  "id": "e2796f2a401324ef02303e7dbebbf575",
  "title": "最好的香肠馅",
  "min_age_month": 12,
  "tags": [
    "Dinner",
    "Side Dish",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 40,
  "cover_image": "images/1b9bacce237ecca938f978159c8ff81c.webp",
  "nutrition_tip": "感恩节最好的香肠馅料是新鲜的面包块和猪肉碎……",
  "ingredients": [
    {
      "name": "1 磅早餐香肠",
      "amount": ""
    },
    {
      "name": "0.75 杯融化的人造黄油，或根据需要",
      "amount": ""
    },
    {
      "name": "1.5 杯切碎的芹菜",
      "amount": ""
    },
    {
      "name": "0.75 杯切碎的洋葱",
      "amount": ""
    },
    {
      "name": "8 杯软面包块，分开",
      "amount": ""
    },
    {
      "name": "1 汤匙家禽调味料",
      "amount": ""
    },
    {
      "name": "0.25 茶匙黑胡椒粉",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在一个大的深煎锅中用中高火煮并搅拌香肠，直至均匀变成棕色，大约需要 10 分钟。用有槽勺将香肠从煎锅中取出，放在铺有纸巾的盘子上沥干。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将锅中的水滴倒入液体量杯中。根据需要添加1杯融化的黄油；倒回煎锅并用中火加热。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将芹菜和洋葱加入煎锅中；煮约 10 分钟，搅拌直至洋葱变软但未变成褐色。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "加入 1/3 面包块并搅拌至湿润。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "将面包和洋葱混合物转移到一个大碗中。加入香肠、剩余的面包块、家禽调味料和胡椒粉；搅拌直至充分混合，小心，因为它会很热。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "根据需要烘烤或用于填充火鸡。"
    }
  ],
