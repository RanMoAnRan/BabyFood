  "nutrition_tip": "这个简单的蔓越莓橙调味食谱混合了新鲜的蔓越莓，整个橙子......",
  "ingredients": [
    {
      "name": "1 个中号脐橙",
      "amount": ""
    },
    {
      "name": "1 包（12 盎司）新鲜蔓越莓",
      "amount": ""
    },
    {
      "name": "0.5 杯白糖",
      "amount": ""
    },
    {
      "name": "0.125 茶匙肉桂粉",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "磨碎 2 茶匙橙皮碎；放在一边。橙子去皮，切成小块。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将切片、果皮、蔓越莓、糖和肉桂放入食品加工机中；脉冲直至切碎。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "转移到碗中。盖上盖子并冷藏，直至味道混合，至少 2 小时，最多 3 天。"
    }
  ],
