  "cover_image": "images/0ce3ae33fe63c1c3377a49c65b2873e1.webp",
  "nutrition_tip": "这个烤桃子和奶油配方，配上红糖、肉桂和黄油……",
  "ingredients": [
    {
      "name": "8 茶匙红糖",
      "amount": ""
    },
    {
      "name": "2汤匙黄油，切成8块",
      "amount": ""
    },
    {
      "name": "1 撮肉桂粉，或更多适量",
      "amount": ""
    },
    {
      "name": "4 个熟桃子，切半，去核",
      "amount": ""
    },
    {
      "name": "4 勺香草冰淇淋",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 400 华氏度（200 摄氏度）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在 9x13 英寸的烤盘中制作 8 个红糖堆，每个堆 1 茶匙，间隔约 2 到 3 英寸。在每个土堆上涂上 1 块黄油，并撒上肉桂粉。将 1 个半桃子，切面朝下，放在每个红糖黄油堆上。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在预热的烤箱中烘烤 15 至 20 分钟，直至桃子变软。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在每个盘子上放 2 个温热的桃子；上面放上冰淇淋。"
    }
  ],
