  "nutrition_tip": "这些南瓜松饼湿润且充满温暖的香料，上面点缀着干……",
  "ingredients": [
    {
      "name": "2 杯通用面粉",
      "amount": ""
    },
    {
      "name": "0.75 杯红糖，包装",
      "amount": ""
    },
    {
      "name": "2 茶匙泡打粉",
      "amount": ""
    },
    {
      "name": "1 茶匙肉桂粉",
      "amount": ""
    },
    {
