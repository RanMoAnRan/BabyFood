{
  "id": "a9a4e4c138e0dbc5dd5c444315774771",
  "title": "南瓜饼",
  "min_age_month": 12,
  "tags": [
    "Dessert",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 60,
  "cover_image": "images/afc081ca66c3a620dd8e9f8535701214.webp",
  "nutrition_tip": "这个湿润的南瓜蛋糕有轻微的香料，非常湿润，并且在平底锅中烘烤......",
  "ingredients": [
    {
      "name": "2 杯通用面粉",
      "amount": ""
    },
    {
      "name": "3 茶匙泡打粉",
      "amount": ""
    },
    {
      "name": "2 茶匙小苏打",
      "amount": ""
    },
    {
      "name": "2 茶匙肉桂粉",
      "amount": ""
    },
    {
      "name": "0.25 茶匙盐",
      "amount": ""
    },
    {
      "name": "2 杯白糖",
      "amount": ""
    },
    {
      "name": "1.25 杯植物油",
      "amount": ""
    },
    {
      "name": "2 杯罐装南瓜",
      "amount": ""
    },
    {
      "name": "1 茶匙香草精",
      "amount": ""
    },
    {
      "name": "4 个鸡蛋",
      "amount": ""
    },
    {
      "name": "1 杯碎核桃",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 350 华氏度（175 摄氏度）。在 12x18 英寸的烤盘上涂上油脂并撒上面粉。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将面粉、泡打粉、小苏打、肉桂和盐一起过筛到一个大碗中；放在一边。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将糖和油放入一个大碗中，用电动搅拌机搅拌至光滑。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "加入南瓜和香草精，然后一次打一个鸡蛋。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "逐渐加入面粉混合物直至完全混合。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "拌入核桃；将面糊倒入准备好的平底锅中。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "在预热的烤箱中烘烤约 30 分钟，直至用牙签插入蛋糕中心，取出来时是干净的。让其冷却。"
    }
  ],
