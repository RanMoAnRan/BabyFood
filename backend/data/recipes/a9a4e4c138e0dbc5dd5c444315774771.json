  "title": "Pumpkin Cake",
  "min_age_month": 12,
  "tags": [
    "Dessert",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 60,
  "cover_image": "images/afc081ca66c3a620dd8e9f8535701214.webp",
  "nutrition_tip": "This moist pumpkin cake is lightly spiced, very moist, and baked in a sheet pan…",
  "ingredients": [
    {
      "name": "2 cups all-purpose flour",
      "amount": ""
    },
    {
      "name": "3 teaspoons baking powder",
      "amount": ""
    },
    {
      "name": "2 teaspoons baking soda",
      "amount": ""
    },
    {
      "name": "2 teaspoons ground cinnamon",
      "amount": ""
    },
    {
      "name": "0.25 teaspoon salt",
      "amount": ""
    },
    {
      "name": "2 cups white sugar",
      "amount": ""
    },
    {
      "name": "1.25 cups vegetable oil",
      "amount": ""
    },
    {
      "name": "2 cups canned pumpkin",
      "amount": ""
    },
    {
      "name": "1 teaspoon vanilla extract",
      "amount": ""
    },
    {
      "name": "4 eggs",
      "amount": ""
    },
    {
      "name": "1 cup chopped walnuts",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 12x18-inch sheet pan."
    },
    {
      "step_index": 2,
      "img": "",
      "text": "Sift flour, baking powder, baking soda, cinnamon, and salt together in a large bowl; set aside."
    },
    {
      "step_index": 3,
      "img": "",
      "text": "Beat sugar and oil together in a large bowl with an electric mixer until smooth."
    },
    {
      "step_index": 4,
      "img": "",
      "text": "Blend in pumpkin and vanilla, then beat in eggs one at a time."
    },
    {
      "step_index": 5,
      "img": "",
      "text": "Gradually beat in flour mixture until just combined."
    },
    {
      "step_index": 6,
      "img": "",
      "text": "Stir in walnuts; spread batter into the prepared sheet pan."
    },
    {
      "step_index": 7,
      "img": "",
      "text": "Bake in the preheated oven until a toothpick inserted into the center of the cake comes out clean, about 30 minutes. Allow to cool."
    }
  ],
