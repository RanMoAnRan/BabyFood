  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将一大锅盐水煮沸；加入土豆，煮约 15 分钟，直至变软但仍然坚硬。沥干并冷却。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将土豆、青豆、金枪鱼、洋葱、欧芹、橄榄和欧芹放入一个大碗中；冷藏2至4小时。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将蔬菜和油醋汁放入沙拉碗中；上面放上冷冻土豆混合物。用鸡蛋、西红柿、凤尾鱼和刺山柑装饰。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "享受吧！"
    }
