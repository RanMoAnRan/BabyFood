{
  "id": "01aa2a8ae9a5a221011d7c2fbe9ff878",
  "title": "烤水牛翅",
  "min_age_month": 12,
  "tags": [
    "Appetizer",
    "American",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 120,
  "cover_image": "images/b8e5f60594535ef3a61b01559ab6d86d.webp",
  "nutrition_tip": "这些辣烤水牛翅不用油炸，酥脆，超级容易制作……",
  "ingredients": [
    {
      "name": "烹饪喷雾",
      "amount": ""
    },
    {
      "name": "0.75 杯通用面粉",
      "amount": ""
    },
    {
      "name": "0.5 茶匙辣椒",
      "amount": ""
    },
    {
      "name": "0.5 茶匙大蒜粉",
      "amount": ""
    },
    {
      "name": "0.5 茶匙盐",
      "amount": ""
    },
    {
      "name": "20 个鸡翅",
      "amount": ""
    },
    {
      "name": "0.5 杯融化的黄油",
      "amount": ""
    },
    {
      "name": "0.5 杯辣椒酱（例如 Frank's RedHot®）",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "在烤盘上铺上铝箔，并用烹饪喷雾轻轻涂抹油脂。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将面粉、辣椒、大蒜粉和盐放入可重新密封的塑料袋中，摇匀。加入鸡翅，密封袋子，搅拌直至均匀地涂上面粉混合物。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将鸡翅转移到准备好的烤盘上并冷藏至少 1 小时。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将烤箱预热至 400 华氏度（200 摄氏度）。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "烤箱预热时，将融化的黄油和辣酱放入小碗中搅拌。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "将鸡翅浸入黄油混合物中，然后放回烤盘上。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "放入预热好的烤箱烤20分钟。翻转鸡翅，继续煮约 25 分钟，直至外部酥脆且中心不再呈粉红色。"
    }
  ],
