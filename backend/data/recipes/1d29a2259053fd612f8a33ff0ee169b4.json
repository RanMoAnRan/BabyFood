  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在大型重型荷兰烤箱中用中火加热 1 汤匙花生油。用卡真调味料给香肠和鸡块调味。将香肠炒至焦黄。用漏勺取出，放在一边。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "加入1汤匙花生油，将鸡块炒至两面微黄。用漏勺取出，放在一边。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在同一锅中，炒洋葱、甜椒、芹菜和大蒜，直至变软。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "拌入碎番茄，并用红辣椒、黑胡椒、盐、辣椒酱、伍斯特酱和菲莱粉调味。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "加入鸡肉和香肠。煮 10 分钟，偶尔搅拌。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "拌入米饭和鸡汤。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "煮沸，调小火，煮 20 至 25 分钟，或直至液体被吸收。"
    },
    {
      "step_index": 9,
      "img": "",
      "text": "上菜并享用！"
    }
  ],
