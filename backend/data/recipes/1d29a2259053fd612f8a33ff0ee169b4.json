  "nutrition_tip": "这个辛辣的什锦饭配鸡肉、安多维尔香肠、米饭和完美的阿莫……",
  "ingredients": [
    {
      "name": "2汤匙花生油，分开",
      "amount": ""
    },
    {
      "name": "1 汤匙 卡津调味料",
      "amount": ""
    },
    {
      "name": "10 盎司安多维尔香肠，切成圆形",
      "amount": ""
    },
    {
      "name": "1磅去骨去皮鸡胸肉，切成1英寸的块",
      "amount": ""
    },
    {
      "name": "1 个洋葱，切丁",
      "amount": ""
    },
    {
      "name": "1 个小青椒，切丁",
      "amount": ""
    },
    {
      "name": "2 茎芹菜，切丁",
      "amount": ""
    },
    {
      "name": "3 瓣大蒜，切碎",
      "amount": ""
    },
    {
      "name": "1 罐（16 盎司）意大利碎番茄",
      "amount": ""
    },
    {
      "name": "0.5 茶匙红辣椒片",
      "amount": ""
    },
    {
