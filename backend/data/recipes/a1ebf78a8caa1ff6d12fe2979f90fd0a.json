{
  "id": "a1ebf78a8caa1ff6d12fe2979f90fd0a",
  "title": "牧羊人馅饼",
  "min_age_month": 6,
  "tags": [
    "Dinner",
    "British",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 50,
  "cover_image": "images/55848ce9190d667529e26d5c675cb09a.webp",
  "nutrition_tip": "用丰富而丰盛的一层美味的碎牛肉制作这个牧羊人馅饼......",
  "ingredients": [
    {
      "name": "4 个大土豆，去皮切块",
      "amount": ""
    },
    {
      "name": "1 汤匙黄油",
      "amount": ""
    },
    {
      "name": "1 汤匙切碎的洋葱",
      "amount": ""
    },
    {
      "name": "0.25 杯切达干酪丝",
      "amount": ""
    },
    {
      "name": "盐和胡椒调味",
      "amount": ""
    },
    {
      "name": "5 根胡萝卜，切碎",
      "amount": ""
    },
    {
      "name": "1 汤匙植物油",
      "amount": ""
    },
    {
      "name": "1 个洋葱，切碎",
      "amount": ""
    },
    {
      "name": "1 磅瘦碎牛肉",
      "amount": ""
    },
    {
      "name": "2 汤匙通用面粉",
      "amount": ""
    },
    {
      "name": "1 汤匙番茄酱",
      "amount": ""
    },
    {
      "name": "0.75 杯牛肉汤",
      "amount": ""
    },
    {
      "name": "0.25 杯切达干酪丝",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将一大锅盐水煮沸。加入土豆，煮约 15 分钟，直至变软但仍然坚硬。沥干并捣碎。加入黄油、切碎的洋葱和 1/4 杯切碎的奶酪。加盐和胡椒调味；放在一边。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将一大锅盐水煮沸。加入胡萝卜，煮约 15 分钟，直至变软但仍坚硬。沥干，捣碎并放在一边。将烤箱预热至 375 华氏度（190 摄氏度）"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在大煎锅中加热油。加入洋葱，煮至透明。加入碎牛肉，煮至焦黄。倒掉多余的脂肪，然后加入面粉，煮1分钟。加入番茄酱和牛肉汤。煮沸，调小火，煮 5 分钟。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将碎牛肉均匀地铺在 2 夸脱砂锅菜的底部。接下来，铺上一层胡萝卜泥。上面放上土豆泥混合物，撒上剩余的奶酪丝。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "在预热的烤箱中烘烤 20 分钟，或直至金黄色。趁热享用吧！"
    }
  ],
