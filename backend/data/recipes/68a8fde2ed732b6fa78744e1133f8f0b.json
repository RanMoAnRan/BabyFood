  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将苹果、葡萄干、红糖、水、肉桂、肉豆蔻和丁香放入慢炖锅中混合；搅拌均匀。盖上慢炖锅。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "用低火煮约 8 小时，或用高火煮约 4 小时，直到苹果和葡萄干变软。在苹果上浇上烹饪液即可食用。"
    }
