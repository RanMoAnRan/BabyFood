  "title": "自制鸡肉和饺子",
  "min_age_month": 12,
  "tags": [],
  "difficulty": 1,
  "time_cost": 0,
  "cover_image": "images/0fb740bc279ff94e849c76905d0c5bb7.webp",
  "nutrition_tip": "通过预煮，在不到 35 分钟的时间内制作出美味的家常舒适食物......",
  "ingredients": [],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "在一个大锅中，将鸡汤、水、洋葱、蔬菜、鸡肉和百里香混合。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "盖上盖子并用中高温煮沸。减少热量并煮 15 分钟。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将烘焙混合物放入一个小碗中。取出2汤匙，放入锅中搅拌至浓稠。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将牛奶和鸡蛋加入剩余的烘焙混合物中，并用叉子搅拌混合。将圆形汤匙面团放入热鸡肉混合物中。不盖盖子，用小火煮 5 分钟。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "盖上盖子再煮 5 分钟。趁热食用。"
    }
  ],
