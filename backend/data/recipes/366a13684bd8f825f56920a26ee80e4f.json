  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将火鸡碎、调味面包屑、洋葱、蛋白、欧芹、大蒜、盐和胡椒粉放入一个大碗中混合。"
    },
    {
