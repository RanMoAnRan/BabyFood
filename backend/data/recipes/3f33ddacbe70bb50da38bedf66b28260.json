  "id": "3f33ddacbe70bb50da38bedf66b28260",
  "title": "Biscochitos 传统饼干",
  "min_age_month": 12,
  "tags": [
    "Dessert",
    "Southwestern",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 30,
  "cover_image": "images/44576bd96f8f29870b75271a234cb0cc.webp",
  "nutrition_tip": "Biscochitos 是一种经典的新墨西哥圣诞饼干。这些美味的茴香酱……",
  "ingredients": [
    {
      "name": "6 杯通用面粉",
      "amount": ""
    },
    {
      "name": "1 汤匙发酵粉",
      "amount": ""
    },
    {
      "name": "0.25 茶匙盐",
      "amount": ""
    },
    {
      "name": "2 杯猪油，软化",
      "amount": ""
    },
    {
      "name": "1.5 杯白糖",
      "amount": ""
    },
    {
      "name": "2 茶匙茴香籽",
      "amount": ""
    },
    {
      "name": "2 个鸡蛋",
      "amount": ""
    },
    {
      "name": "0.25 杯白兰地",
      "amount": ""
    },
    {
      "name": "0.25 杯白糖",
      "amount": ""
    },
    {
      "name": "1 汤匙肉桂粉",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 350 华氏度（175 摄氏度）。将面粉、泡打粉和盐筛入碗中；放在一边。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将猪油和 1 ½ 杯糖放入一个大碗中，用电动搅拌机搅拌至光滑。加入茴香籽，搅拌直至蓬松。加入鸡蛋，一次一个。添加白兰地；加入面粉混合物搅拌形成面团。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "用撒了面粉的擀面杖将面团擀成 1/4 或 1/2 英寸的厚度。用百合花饼干切刀或其他简单的形状切面团。将饼干放在未抹油的烤盘上。将 1/4 杯糖和肉桂粉放入小碗中混合；撒在饼干上。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在预热的烤箱中烘烤约 10 分钟，直至边缘呈金黄色。"
    }
  ],
