  "title": "花生炖菜",
  "min_age_month": 8,
  "tags": [],
  "difficulty": 1,
  "time_cost": 0,
  "cover_image": "images/e7d230e4e954185e911dd8cb908b6c67.webp",
  "nutrition_tip": "这道奶油花生炖菜可以让你在寒冷的秋天或冬天感到温暖。",
  "ingredients": [],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将前 9 种原料放入汤锅中混合。煮沸，然后调至中低火，盖上锅盖，煮10分钟。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "加入花生酱和牛奶。返回文火慢炖，不盖盖子煮 5 分钟。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "拌入菠菜，煮 2 至 3 分钟直至枯萎。从火上移开。如果需要的话，在上面放上花生和葱。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在 2 小时内将剩菜冷藏。"
    }
  ],
