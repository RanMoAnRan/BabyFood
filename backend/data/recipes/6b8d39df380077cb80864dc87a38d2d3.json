  "title": "山核桃桑迪斯",
  "min_age_month": 12,
  "tags": [
    "Dessert",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 25,
  "cover_image": "images/f63fd94949ef45ab7ec13f0deeab64e5.webp",
  "nutrition_tip": "这些山核桃沙子里装满了切碎的山核桃，并在糖中滚成一团……",
  "ingredients": [
    {
      "name": "1 杯白糖",
      "amount": ""
    },
    {
      "name": "1 杯人造黄油，软化",
      "amount": ""
    },
    {
      "name": "1 杯植物油",
      "amount": ""
    },
    {
      "name": "1 杯糖果糖，过筛",
      "amount": ""
    },
    {
      "name": "2 个鸡蛋",
      "amount": ""
    },
    {
      "name": "1 茶匙香草精",
      "amount": ""
    },
    {
      "name": "4 杯通用面粉",
      "amount": ""
    },
    {
      "name": "1 茶匙小苏打",
      "amount": ""
    },
    {
      "name": "1 茶匙塔塔粉",
      "amount": ""
    },
    {
      "name": "1 茶匙盐",
      "amount": ""
    },
    {
      "name": "2 杯切碎的山核桃",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将烤箱预热至 375 华氏度（190 摄氏度）。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "搅拌 1 杯白糖、黄油、油和糖果。将糖放入一个大碗中，用电动搅拌机搅拌至光滑。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "添加鸡蛋，一次一个，每次添加后搅拌均匀。加入香草精。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将面粉、小苏打、塔塔粉和盐放入一个中等大小的碗中；搅拌至鸡蛋混合物中，直至面团混合在一起。拌入山核桃。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "将剩余的 1/2 杯白糖放入一个小浅碗中。将面团搓成1英寸大小的球状，稍微压扁；滚上糖，均匀裹上糖。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "将饼干放在未抹油的饼干片上，间隔 2 英寸。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "在预热的烤箱中烘烤 10 到 12 分钟，直至边缘呈金黄色。将饼干移至金属架上使其完全冷却。"
    }
  ],
