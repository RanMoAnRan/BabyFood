{
  "id": "919305218644e7db5e60c413af61abf1",
  "title": "快速烤宽面条",
  "min_age_month": 12,
  "tags": [],
  "difficulty": 1,
  "time_cost": 0,
  "cover_image": "images/90bf345ab2b69f051af9aa9f2c603999.webp",
  "nutrition_tip": "这款芝士丰盛的烤宽面条只需一锅，45 分钟内即可做好。",
  "ingredients": [],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "用肥皂和水洗手。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "准备前用流水冲洗或擦洗新鲜蔬菜。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在 10 英寸煎锅或大平底锅中，用中高温（电煎锅中为 350 华氏度）煮碎牛肉，直至其不再呈粉红色。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "沥干脂肪。加入洋葱，煮至变软。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "加入大蒜、1 杯意大利面酱和香草。将混合物搅拌并均匀地铺入煎锅中。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "将热量调低（电煎锅中温度为 200 华氏度），将干酪铺在混合物上，撒上一半马苏里拉奶酪。上面放 4 根面条，折断剩下的 2 根以填补空缺。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "将剩余的意大利面酱均匀地倒在面条上；轻轻地按下面条以使其湿润。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "盖上锅盖，煮 15 至 20 分钟，直至面条变软。在上面放上剩余的马苏里拉奶酪和帕尔马干酪，盖上锅盖，再煮 2 分钟或直至奶酪融化。"
    },
    {
      "step_index": 9,
      "img": "",
      "text": "上菜前盖上盖子静置 5 到 10 分钟。"
    },
    {
      "step_index": 10,
      "img": "",
      "text": "在 2 小时内将剩菜冷藏。"
    }
  ],
