  "nutrition_tip": "约翰主厨的这道吉尼斯炖牛肉是一道令人心旷神怡的爱尔兰菜，味道浓郁，…",
  "ingredients": [
    {
      "name": "4片培根，切成小块",
      "amount": ""
    },
    {
      "name": "2.5 磅无骨牛肉夹头，切成 2 英寸的块",
      "amount": ""
    },
    {
      "name": "1.5 茶匙盐，分次或更多调味",
      "amount": ""
    },
    {
      "name": "现磨黑胡椒粉",
      "amount": ""
    },
    {
      "name": "2 onions, coarsely chopped",
      "amount": ""
    },
    {
      "name": "4 瓣大蒜，切碎",
      "amount": ""
    },
    {
      "name": "1 罐（14.9 盎司）黑啤酒（例如 Guinness®）",
      "amount": ""
    },
    {
      "name": "0.25 杯番茄酱",
      "amount": ""
    },
    {
      "name": "3 根胡萝卜，切成 1 英寸的块",
      "amount": ""
    },
    {
      "name": "2 茎芹菜，切成 1 英寸的块",
      "amount": ""
    },
    {
      "name": "4 枝新鲜百里香",
      "amount": ""
    },
    {
      "name": "1 茶匙白糖",
      "amount": ""
    },
    {
      "name": "0.5 茶匙现磨黑胡椒，或适量",
      "amount": ""
    },
    {
      "name": "2.5 杯鸡汤，或根据需要覆盖",
      "amount": ""
    },
    {
      "name": "4 cups mashed potatoes",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在重煎锅中用中高火烹煮并搅拌培根，直至培根变成棕色且酥脆，持续 3 到 4 分钟。关掉火，将培根放入一个大炖锅中，将培根脂肪保留在煎锅中。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "用 1 茶匙盐和黑胡椒充分调味牛肉块。将煎锅中的火调至最高，将牛肉片放入热油中煎至两面焦黄，大约需要 5 分钟。将牛肉和培根一起放入炖锅中，将脂肪留在煎锅中。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将热量调至中火；将洋葱放入煎锅中剩余的脂肪中煮5至8分钟，直至呈浅棕色；用一大撮盐调味。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将大蒜和洋葱一起煮至变软，大约需要 1 分钟。将啤酒倒入煎锅中，用木勺搅拌，刮起任何棕色食物残渣并将其溶解到液体中。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "将煎锅中的烹饪液倒入炖锅中。加入番茄酱、胡萝卜、芹菜、百里香枝、糖、1/2 茶匙黑胡椒和足够的鸡汤搅拌。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "将炖菜小火慢炖，搅拌混合；将热量调低并盖上锅盖。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "小火煮至牛肉叉软，大约需要 2 小时。"
    },
    {
      "step_index": 9,
      "img": "",
      "text": "偶尔搅拌炖菜，如果需要的话，撇去脂肪或泡沫。"
    },
    {
      "step_index": 10,
      "img": "",
      "text": "取下盖子并将热量升至中高。将炖菜煮至低沸，煮 15 至 20 分钟，直至炖菜稍微变稠。取出并丢弃百里香小枝，并根据口味调整盐和胡椒粉。"
    },
    {
      "step_index": 11,
      "img": "",
      "text": "将土豆泥排成一圈，放入碗中；用勺子舀入土豆的中心。"
    }
  ],
