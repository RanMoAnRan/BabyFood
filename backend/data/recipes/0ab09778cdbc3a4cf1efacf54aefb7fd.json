  "nutrition_tip": "这道令人安慰的柠檬鸡肉米粒汤里充满了嫩鸡肉块……",
  "ingredients": [
    {
      "name": "8 盎司米粒意大利面",
      "amount": ""
    },
    {
      "name": "1 茶匙橄榄油",
      "amount": ""
    },
    {
      "name": "3 个中等大小的胡萝卜，切碎，或更多适量",
      "amount": ""
    },
    {
      "name": "3根芹菜排骨，切碎",
      "amount": ""
    },
    {
      "name": "1 个中等大小的洋葱，切碎",
      "amount": ""
    },
    {
      "name": "2 瓣大蒜，切碎",
      "amount": ""
    },
    {
      "name": "0.5 茶匙干百里香",
      "amount": ""
    },
    {
      "name": "0.5 茶匙干牛至",
      "amount": ""
    },
    {
      "name": "盐和黑胡椒粉适量",
      "amount": ""
    },
    {
      "name": "1 片月桂叶",
      "amount": ""
    },
    {
      "name": "3 盒（32 盎司）脱脂低钠鸡汤",
      "amount": ""
    },
    {
      "name": "0.5 杯新鲜柠檬汁",
      "amount": ""
    },
    {
      "name": "1 个柠檬，去皮",
      "amount": ""
    },
    {
      "name": "8 盎司煮熟的鸡胸肉，切碎",
      "amount": ""
    },
    {
      "name": "1 包（8 盎司）小菠菜叶",
      "amount": ""
    },
    {
      "name": "1 个柠檬，切片用于装饰",
