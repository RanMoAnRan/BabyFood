  "nutrition_tip": "将调味猪排快速炒熟，然后在浓郁的汤汁中慢火慢炖……",
  "ingredients": [
    {
      "name": "4 块猪排",
      "amount": ""
    },
    {
      "name": "盐和胡椒调味",
      "amount": ""
    },
    {
      "name": "0.25 杯通用面粉",
      "amount": ""
    },
    {
      "name": "2 汤匙植物油",
      "amount": ""
    },
    {
