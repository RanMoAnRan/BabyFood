  "nutrition_tip": "这道奶酪鸡肉烤宽面条配菠菜使用奶油白酱，这是…",
  "ingredients": [
    {
      "name": "9 份烤宽面条",
      "amount": ""
    },
    {
      "name": "0.5 杯黄油",
      "amount": ""
    },
    {
      "name": "1 个洋葱，切碎",
      "amount": ""
    },
    {
      "name": "1 瓣大蒜，切碎",
      "amount": ""
    },
    {
      "name": "0.5 杯通用面粉",
      "amount": ""
    },
    {
      "name": "2 杯鸡汤",
      "amount": ""
    },
    {
      "name": "1.5 杯牛奶",
      "amount": ""
    },
    {
      "name": "1 茶匙盐",
      "amount": ""
    },
    {
      "name": "4 杯马苏里拉奶酪丝，分开",
      "amount": ""
    },
    {
      "name": "1 杯磨碎的帕尔马干酪，分开",
      "amount": ""
    },
    {
      "name": "1 茶匙干罗勒",
      "amount": ""
    },
    {
      "name": "1 茶匙干牛至",
      "amount": ""
    },
    {
      "name": "0.5 茶匙黑胡椒粉",
      "amount": ""
    },
    {
      "name": "2 杯意大利乳清干酪",
      "amount": ""
    },
    {
      "name": "2 杯切块的熟鸡肉",
      "amount": ""
    },
    {
      "name": "2 包（10 盎司）冷冻切碎菠菜，解冻并沥干",
      "amount": ""
    },
    {
      "name": "1 汤匙切碎的新鲜欧芹",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料并将烤箱预热至 350 华氏度（175 摄氏度）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将一大锅淡盐水煮沸。加入千层面，煮 8 至 10 分钟或直至有嚼劲；沥干并用冷水冲洗。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "同时，在大平底锅中用中火融化黄油；拌入洋葱和大蒜。加入面粉搅拌约 2 分钟，直至呈浅棕色且洋葱变软。加入鸡汤、牛奶、盐；煮，持续搅拌 1 分钟。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "加入 2 杯马苏里拉奶酪和 1/4 杯帕尔玛干酪，搅拌均匀。用罗勒、牛至和黑胡椒调味；从火上移开并放在一边。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将 1/3 的酱汁混合物涂在 9x13 英寸烤盘的底部。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "铺上 3 条烤宽面条、意大利乳清干酪和鸡肉。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "将 3 条烤宽面条放在鸡肉上，并铺上 1/3 的酱汁混合物、菠菜、剩余的 2 杯马苏里拉奶酪和 1/2 杯帕尔马干酪。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "将剩余的面条放在奶酪上，并将剩余的酱汁均匀地涂在面条上。撒上欧芹和剩余的 1/4 杯帕尔马干酪。"
    },
    {
      "step_index": 9,
      "img": "",
      "text": "在预热的烤箱中烘烤 35 至 40 分钟。"
    },
    {
      "step_index": 10,
      "img": "",
      "text": "上菜并享用！"
    }
  ],
