  "title": "火边的苹果",
  "min_age_month": 12,
  "tags": [
    "Dessert",
    "American",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 10,
  "cover_image": "images/740eff1753a3f22fd91b8b349b81c3ca.webp",
  "nutrition_tip": "这个食谱将肉桂和红糖塞进酸苹果中，用箔纸包裹，......",
  "ingredients": [
    {
      "name": "1汤匙红糖",
      "amount": ""
    },
    {
      "name": "0.25 茶匙肉桂粉",
      "amount": ""
    },
    {
      "name": "1 个青苹果，去核",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "生起篝火或预热户外木炭烤架；让火燃烧直至形成煤层。将煤耙入火一侧的平床上。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "同时，将红糖和肉桂放入小碗中混合；用勺子舀入苹果核。用一大块重型铝箔包裹苹果，将多余的铝箔扭成尾巴作为手柄。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将铝箔包裹的苹果放入煤中；煮5至10分钟直至变软。将苹果从煤中取出；小心地打开包装，以免被热糖烫伤。"
    }
  ],
