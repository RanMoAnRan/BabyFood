  "cover_image": "images/5dbad5b43316696579802780dea0118d.webp",
  "nutrition_tip": "这个鸡蛋砂锅做起来超级简单，而且很好吃。打好的鸡蛋是用烤的…",
  "ingredients": [
    {
      "name": "6 个鸡蛋，搅拌",
      "amount": ""
    },
    {
      "name": "1 杯切达干酪丝",
      "amount": ""
    },
    {
      "name": "6 片培根，切丁",
      "amount": ""
    },
    {
      "name": "2 片面包，切块",
      "amount": ""
    },
    {
      "name": "0.33 红甜椒，切丁",
      "amount": ""
    },
    {
      "name": "2 个葱，切碎",
      "amount": ""
    },
    {
      "name": "3 汤匙牛奶",
      "amount": ""
    },
    {
      "name": "0.5 茶匙蒜末，或适量",
      "amount": ""
    },
    {
      "name": "盐和黑胡椒粉适量",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将烤箱预热至 350 华氏度（175 摄氏度）。在 9x13 英寸的烤盘上涂抹油脂。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将鸡蛋、奶酪、培根、面包、红灯笼椒、葱、牛奶、大蒜、盐和黑胡椒一起放入碗中，直至充分混合；倒入准备好的烤盘中。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在预热的烤箱中烘烤约 20 至 25 分钟，直至鸡蛋凝固。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "享受吧！"
    }
  ],
