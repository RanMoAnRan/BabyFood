{
  "id": "92f7bb49cba3ea416a9455b0e7b3f438",
  "title": "老式椰子奶油派",
  "min_age_month": 12,
  "tags": [
    "Dessert",
    "American",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 270,
  "cover_image": "images/a81fa78f1d25635cbe9334bdb36c3348.webp",
  "nutrition_tip": "这个椰子奶油派是用自制的椰子蛋奶冻馅料制成的……",
  "ingredients": [
    {
      "name": "1 杯甜椰子片",
      "amount": ""
    },
    {
      "name": "3 杯对半",
      "amount": ""
    },
    {
      "name": "0.75 杯白糖",
      "amount": ""
    },
    {
      "name": "0.5 杯通用面粉",
      "amount": ""
    },
    {
      "name": "2 个大鸡蛋，打散",
      "amount": ""
    },
    {
      "name": "0.25 茶匙盐",
      "amount": ""
    },
    {
      "name": "1 茶匙香草精",
      "amount": ""
    },
    {
      "name": "1 个（9 英寸）馅饼壳，烘烤",
      "amount": ""
    },
    {
      "name": "1 杯冷冻搅打配料，解冻",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将烤箱预热至 350 华氏度（175 摄氏度）。将椰子铺在烤盘上。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在预热的烤箱中烘烤椰子，偶尔搅拌，直至呈金黄色，大约需要 5 分钟。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将各半、糖、面粉、鸡蛋和盐放入一个中锅中。用小火煮沸，不断搅拌，直到混合物变稠并覆盖在木勺的背面，大约需要 15 分钟。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将锅从火上移开，加入 3/4 杯烤椰子和香草精搅拌；保留剩余的烤椰子来装饰馅饼。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "将蛋奶冻倒入馅饼壳中，冷藏至凝固，大约需要 4 小时。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "上面放上搅打过的配料和保留的烤椰子。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "享受吧！"
    }
  ],
