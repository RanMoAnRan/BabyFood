{
  "id": "3315eaf4d62f40f969b8ad3bbf844e19",
  "title": "巧克力片山核桃派",
  "min_age_month": 12,
  "tags": [
    "Dessert",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 60,
  "cover_image": "images/ec0876fa9074ed42f1b3c178499eeda5.webp",
  "nutrition_tip": "这款巧克力片山核桃派定义了更高层次的美味！一个甜蜜的。粘糊糊的，…",
  "ingredients": [
    {
      "name": "3 个大鸡蛋",
      "amount": ""
    },
    {
      "name": "1.25 杯白糖，或更多适量",
      "amount": ""
    },
    {
      "name": "0.5 杯通用面粉",
      "amount": ""
    },
    {
      "name": "0.5 杯玉米糖浆",
      "amount": ""
    },
    {
      "name": "6 汤匙无盐黄油，融化",
      "amount": ""
    },
    {
      "name": "0.5 茶匙盐",
      "amount": ""
    },
    {
      "name": "0.5 茶匙柠檬汁",
      "amount": ""
    },
    {
      "name": "1.5 杯半甜巧克力片",
      "amount": ""
    },
    {
      "name": "1.5 杯山核桃碎",
      "amount": ""
    },
    {
      "name": "1 个（9 英寸）未烘烤的馅饼壳",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集原料并将烤箱预热至 350 华氏度（175 摄氏度）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将鸡蛋放入一个大搅拌碗中，用电动搅拌机搅拌至松软。加入糖、面粉、玉米糖浆、融化的黄油、盐和柠檬汁；混合直至完全混合。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "加入巧克力片和山核桃，然后将混合物倒入馅饼壳中。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在预热的烤箱中烘烤 45 至 60 分钟，直至外皮呈金黄色且馅料凝固。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "从烤箱中取出，冷却并凝固后再食用。"
    }
  ],
