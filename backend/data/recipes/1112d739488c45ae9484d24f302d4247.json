  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在大锅中用中高温加热油。在热油中炒洋葱、大蒜和月桂叶，直至洋葱半透明，大约需要 5 分钟。加入水、豌豆、大麦和盐；煮沸。将火调小，煮 2 小时，偶尔搅拌。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "添加土豆、胡萝卜、芹菜、欧芹、罗勒、百里香和胡椒。煮约 1 小时，直至豌豆和蔬菜变软。"
    }
  ],
