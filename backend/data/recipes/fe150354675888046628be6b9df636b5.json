  "title": "巧克力蛋糕粉饼干",
  "min_age_month": 12,
  "tags": [
    "Dessert",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 25,
  "cover_image": "images/e862bbe5cf4fb34ae005bcacf4f87fbe.webp",
  "nutrition_tip": "这些巧克力蛋糕混合饼干只需 4 种原料即可快速轻松制作……",
  "ingredients": [
    {
      "name": "1 包（18.25 盎司）巧克力蛋糕粉",
      "amount": ""
    },
    {
      "name": "0.5 杯黄油，软化",
      "amount": ""
    },
    {
      "name": "2 个鸡蛋",
      "amount": ""
    },
    {
      "name": "1 杯半甜巧克力片",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 350 华氏度（175 摄氏度）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在一个大碗中搅拌蛋糕粉、黄油和鸡蛋，直至光滑且充分混合。加入巧克力片直至混合。一勺一勺地倒在未抹油的烤盘上。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在预热的烤箱中烘烤 8 到 10 分钟，直至边缘凝固。将饼干放在烤盘上冷却 5 分钟，然后移至金属架上完全冷却。"
    }
  ],
