{
  "id": "3e1a87fbeac120e197f2d73f0a2332a2",
  "title": "巧克力片南瓜面包",
  "min_age_month": 6,
  "tags": [
    "Bread",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 80,
  "cover_image": "images/5b17885c4982ef020fc76a9661da2af3.webp",
  "nutrition_tip": "这个南瓜巧克力片面包里装满了甜甜的迷你巧克力片和……",
  "ingredients": [
    {
      "name": "3 杯白糖",
      "amount": ""
    },
    {
      "name": "1 罐（15 盎司）南瓜泥",
      "amount": ""
    },
    {
      "name": "4 个大鸡蛋",
      "amount": ""
    },
    {
      "name": "1 杯植物油",
      "amount": ""
    },
    {
      "name": "0.66666668653488 杯水",
      "amount": ""
    },
    {
      "name": "3.5 杯通用面粉",
      "amount": ""
    },
    {
      "name": "1 汤匙肉桂粉，或适量",
      "amount": ""
    },
    {
      "name": "1 汤匙 肉豆蔻粉，或适量",
      "amount": ""
    },
    {
      "name": "2 茶匙小苏打",
      "amount": ""
    },
    {
      "name": "1.5 茶匙盐",
      "amount": ""
    },
    {
      "name": "1 杯微型半甜巧克力片",
      "amount": ""
    },
    {
      "name": "0.5 杯核桃碎",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。将烤箱预热至 350 华氏度（175 摄氏度）。在三个 9x5 英寸的面包盘或三个空的 16 盎司咖啡罐上涂抹油脂并撒上面粉。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将糖、南瓜、鸡蛋、油和水放入一个大碗中。用电动搅拌机搅拌至光滑。加入面粉、肉桂、肉豆蔻、小苏打和盐。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "拌入巧克力片和坚果。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将面糊均匀地分在准备好的平底锅之间，每个平底锅填满 1/2 到 3/4。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "在预热的烤箱中烘烤，直到插入中心的刀干净地出来，大约需要 1 小时。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "将平底锅放在金属架上冷却，然后取出切片并食用。享受！"
    }
  ],
