  "nutrition_tip": "这些披萨纸杯蛋糕与迷你披萨类似，但呈纸杯蛋糕形式。他们是……",
  "ingredients": [
    {
      "name": "烹饪喷雾",
      "amount": ""
    },
    {
      "name": "8 个中等大小的樱桃番茄",
      "amount": ""
    },
    {
      "name": "1 罐（11 盎司）冷藏披萨皮",
      "amount": ""
    },
    {
      "name": "8 茶匙马苏里拉奶酪丝",
      "amount": ""
    },
    {
      "name": "0.5 杯披萨酱（例如 Classico®）",
      "amount": ""
    },
    {
      "name": "8 茶匙切碎的红洋葱",
      "amount": ""
    },
    {
      "name": "0.5 杯马苏里拉奶酪丝",
      "amount": ""
    },
    {
      "name": "8 片意大利辣香肠，切成四份",
      "amount": ""
    },
    {
      "name": "意大利调味料",
      "amount": ""
    },
    {
      "name": "红辣椒片适量",
      "amount": ""
    },
    {
      "name": "蒜盐 适量",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集原料。将烤箱预热至 400 华氏度（200 摄氏度）。用烹饪喷雾润滑 8 杯松饼罐。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将樱桃番茄切碎并沥干液体；放在一边。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在撒了面粉的工作台上展开披萨皮，然后薄薄地擀成一个大矩形。使用 4 英寸圆形饼干或饼干切割机，在面团中切出 8 个圆形。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将面团圈放入准备好的松饼杯中，将面团压入每个杯子的底部和两侧。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将 1 茶匙马苏里拉奶酪放入每个杯子中​​。上面放一汤匙披萨酱。然后加入西红柿和红洋葱。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "在每个杯子中​​加入 1 汤匙马苏里拉奶酪，并在上面放上意大利辣香肠。撒上意大利调味料、红辣椒片和蒜盐。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "在预热的烤箱中烘烤 14 至 15 分钟，直至奶酪起泡并融化。从烤箱中取出并在罐中冷却约 5 分钟。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "将披萨从罐中取出并趁热享用。"
    }
  ],
