{
  "id": "154936cffbb21565612fb0994b0ad743",
  "title": "烤尤卡",
  "min_age_month": 12,
  "tags": [],
  "difficulty": 1,
  "time_cost": 0,
  "cover_image": "images/72d0c62e6cdb1cf011f25005b40553a4.webp",
  "nutrition_tip": "酥脆可口！使用烹饪喷雾来减少脂肪。",
  "ingredients": [],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "在水壶中，将尤卡与足够的冷水混合，以覆盖尤卡 1 英寸。将水烧开，然后将尤卡慢慢煮 20 至 30 分钟，或直至其变软。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将烤箱预热至 350°F。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "用有槽勺将尤卡转移到切板上，让其冷却，然后将其纵向切成 3/4 英寸宽的楔形，丢弃薄木芯。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "用烹饪喷雾轻轻喷洒饼干片。将尤卡楔形单层铺在饼干片上，并在楔形上喷上烹饪喷雾。盖上箔纸并烘烤 8 分钟。揭开盖子并返回烤箱再烘烤 7 分钟。"
    }
  ],
