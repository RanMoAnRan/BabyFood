  "cover_image": "images/e30dbd0339f810ef15e36e5d5775a8b5.webp",
  "nutrition_tip": "石锅拌饭是一道美味的韩国米饭，由温热的白米饭配上嫩白的米饭…",
  "ingredients": [
    {
      "name": "1 根英国黄瓜，切成火柴棍",
      "amount": ""
    },
    {
      "name": "0.25 杯 gochujang（韩国辣椒酱）",
      "amount": ""
    },
    {
      "name": "1束新鲜菠菜，切成细条",
      "amount": ""
    },
    {
      "name": "1汤匙酱油",
      "amount": ""
    },
    {
      "name": "2 茶匙橄榄油，分开",
      "amount": ""
    },
    {
      "name": "2 根胡萝卜，切成火柴棍",
      "amount": ""
    },
    {
      "name": "1 瓣大蒜，切碎",
      "amount": ""
    },
    {
      "name": "1 撮红辣椒片",
      "amount": ""
    },
    {
      "name": "1 磅薄切牛肉顶圆牛排",
      "amount": ""
    },
    {
      "name": "4 个大鸡蛋",
      "amount": ""
    },
    {
      "name": "4 杯煮熟的白米饭",
      "amount": ""
    },
    {
      "name": "4 茶匙烤芝麻油，分开",
      "amount": ""
    },
    {
      "name": "1 茶匙芝麻",
      "amount": ""
    },
    {
      "name": "2 茶匙 gochujang（韩国辣椒酱），分开",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将黄瓜片和辣椒酱放入碗中搅拌；放在一边。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将约 2 杯水放入一个大的不粘锅中煮沸，加入菠菜；煮2至3分钟，直至呈亮绿色并枯萎。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将菠菜沥干并尽可能挤出水分；将菠菜放入碗中，拌入酱油。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在一个大的不粘锅中加热 1 茶匙橄榄油；煮并搅拌胡萝卜直至变软，大约需要 3 分钟。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "拌入大蒜，煮至香味四溢，大约1分钟。加入黄瓜混合物搅拌；撒上红辣椒片。将胡萝卜混合物放在碗中备用。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "将牛肉放入干净的不粘锅中，中火加热，每面约 5 分钟；放在一边。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "在另一个不粘锅中用中低火加热剩余的 1 茶匙橄榄油。仅将鸡蛋一侧煎 2 至 4 分钟，直至蛋黄变稀，但蛋白变硬。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "将煮熟的米饭分成4个大碗；上面放上菠菜混合物、几片牛肉和黄瓜混合物。每份上放 1 个鸡蛋。在每个碗中淋上 1 茶匙芝麻油，撒上少许芝麻，如果需要，还可撒上少量辣椒酱。"
    }
  ],
