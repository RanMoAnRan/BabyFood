  "nutrition_tip": "这个简单正宗的路易斯安那红豆和大米食谱采用卡真调味料......",
  "ingredients": [
    {
      "name": "1 磅干芸豆",
      "amount": ""
    },
    {
      "name": "0.25 杯橄榄油",
      "amount": ""
    },
    {
      "name": "1 个大洋葱，切碎",
      "amount": ""
    },
    {
      "name": "1 个青椒，切碎",
      "amount": ""
    },
    {
      "name": "2 茎芹菜，切碎",
      "amount": ""
    },
    {
      "name": "2 汤匙 蒜末",
      "amount": ""
    },
    {
      "name": "6 杯水",
      "amount": ""
    },
    {
      "name": "2 片月桂叶",
      "amount": ""
    },
    {
      "name": "1 汤匙干欧芹",
      "amount": ""
    },
    {
      "name": "1 茶匙干百里香",
      "amount": ""
    },
    {
      "name": "1 茶匙卡津调味料",
      "amount": ""
    },
    {
      "name": "0.5 茶匙辣椒",
      "amount": ""
    },
    {
