  "cover_image": "images/8568b66cfe094e520bac0a4fa4e9f07d.webp",
  "nutrition_tip": "Rugelach 是新月形的糕点，很容易在家用片状 D 制作……",
  "ingredients": [
    {
      "name": "2 杯通用面粉",
      "amount": ""
    },
    {
      "name": "1 杯无盐黄油",
      "amount": ""
    },
    {
      "name": "1 包（8 盎司）奶油干酪",
      "amount": ""
    },
    {
      "name": "0.33333334326744 杯酸奶油",
      "amount": ""
    },
    {
      "name": "0.25 茶匙盐",
      "amount": ""
    },
    {
      "name": "1 杯切碎的核桃",
      "amount": ""
    },
    {
      "name": "0.5 杯葡萄干",
      "amount": ""
    },
    {
      "name": "0.5 杯白糖",
      "amount": ""
    },
    {
      "name": "1 汤匙肉桂粉",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将黄油、奶油干酪、酸奶油、面粉和盐放入食品加工机中；脉冲直至易碎。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将易碎的面团混合物成型并压成四个相等的圆盘。将每个糕点盘包裹起来；在冰箱中冷藏 1 小时或最多 2 天。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将核桃、葡萄干、糖和肉桂放入碗中。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将每个糕点盘卷成 9 英寸的圆形，保持其他盘冷藏，直到准备卷起。撒上核桃葡萄干混合物；轻轻压入面团中。用厨师刀或披萨刀将每个圆形切成 12 个楔形。将楔子从宽向窄滚动，最终您的点将位于饼干的外侧。放在未抹油的烤盘上，烘烤前将地毯冷却 20 分钟。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将烤箱预热至 350 华氏度（180 摄氏度）。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "地毯冷却后，放入已预热的烤箱中央架上烘烤，直至呈浅金黄色，约 22 至 25 分钟；放在金属架上冷却。"
    }
  ],
