{
  "id": "14ba05546879ed91c1cf0e2041f5408c",
  "title": "花生酱饼干",
  "min_age_month": 12,
  "tags": [
    "Dessert",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 30,
  "cover_image": "images/adffe978c1461e2d9d5352d9957ae0b3.webp",
  "nutrition_tip": "Nutella 饼干由巧克力榛子酱、可可粉、巧克力酱制成……",
  "ingredients": [
    {
      "name": "2.5 杯通用面粉",
      "amount": ""
    },
    {
      "name": "0.25 杯不加糖可可粉",
      "amount": ""
    },
    {
      "name": "1 茶匙小苏打",
      "amount": ""
    },
    {
      "name": "1 茶匙盐",
      "amount": ""
    },
    {
      "name": "1 杯黄油，室温",
      "amount": ""
    },
    {
      "name": "0.75 杯红糖",
      "amount": ""
    },
    {
      "name": "0.75 杯白糖",
      "amount": ""
    },
    {
      "name": "2 个大鸡蛋",
      "amount": ""
    },
    {
      "name": "2 汤匙香草精",
      "amount": ""
    },
    {
      "name": "0.5 杯巧克力榛子酱，例如 Nutella®",
      "amount": ""
    },
    {
      "name": "0.5 杯切碎的烤榛子",
      "amount": ""
    },
    {
      "name": "1 杯巧克力片",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 350 华氏度（175 摄氏度）。在烤盘上铺上羊皮纸。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将面粉、可可粉、小苏打和盐放入碗中。用搅拌器混合以打碎任何结块。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在一个大碗中用电动搅拌机将黄油、红糖和白糖搅打至光滑。一次打入一个鸡蛋，直至完全融合。加入香草和巧克力榛子酱混合。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "慢慢加入面粉混合物并搅拌直至混合。拌入切碎的榛子和巧克力片。用汤匙或饼干勺将面团放在准备好的烤盘上。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "在预热的烤箱中烘烤约 10 至 12 分钟，直至边缘看起来干燥且饼干散发出香味。在转移到金属架上之前，先在烤盘上短暂冷却。"
    }
  ],
