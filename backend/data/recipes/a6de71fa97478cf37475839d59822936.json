{
  "id": "a6de71fa97478cf37475839d59822936",
  "title": "草莓大黄派",
  "min_age_month": 12,
  "tags": [
    "Dessert",
    "Pie",
    "American",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 85,
  "cover_image": "images/aa00f6f678499e67e70cfef6ba97defd.webp",
  "nutrition_tip": "这个草莓大黄派有红宝石色的馅料和美味的甜馅饼……",
  "ingredients": [
    {
      "name": "1 杯白糖",
      "amount": ""
    },
    {
      "name": "0.5 杯通用面粉",
      "amount": ""
    },
    {
      "name": "1 磅大黄，切成 1/4 英寸的片",
      "amount": ""
    },
    {
      "name": "2 品脱草莓，去壳并切成四等分",
      "amount": ""
    },
    {
      "name": "1 包（14.1 盎司）糕点，用于双层 9 英寸馅饼",
      "amount": ""
    },
    {
      "name": "2 汤匙黄油",
      "amount": ""
    },
    {
      "name": "1 个大蛋黄",
      "amount": ""
    },
    {
      "name": "2 汤匙白糖",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 400 华氏度（200 摄氏度）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将面粉和糖放入一个大碗中混合。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "加入草莓和切碎的大黄。加入糖和面粉，静置 30 分钟。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将馅料倒入准备好的馅饼皮中。在上面涂上黄油，然后盖上面包皮。用水密封顶部和底部外壳的边缘。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "用糕点刷在馅饼上刷蛋黄。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "撒上糖。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "在顶部外壳上切几条缝，让蒸汽逸出。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "在预热的烤箱中烘烤约 35 至 40 分钟，直至起泡并呈棕色。架上放凉的馅饼。"
    },
    {
      "step_index": 9,
      "img": "",
      "text": "享受吧！"
    }
  ],
