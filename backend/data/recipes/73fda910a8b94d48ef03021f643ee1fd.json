  "nutrition_tip": "这种酮巧克力慕斯很容易制作。不需要打发奶油，只需...",
  "ingredients": [
    {
      "name": "3 盎司奶油干酪，软化",
      "amount": ""
    },
    {
      "name": "0.5 杯浓奶油",
      "amount": ""
    },
    {
      "name": "1 茶匙香草精",
      "amount": ""
    },
    {
      "name": "0.25 杯粉状零热量甜味剂（例如 Swerve®）",
      "amount": ""
    },
    {
      "name": "2 汤匙可可粉",
      "amount": ""
    },
    {
      "name": "1 撮盐",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "在一个大碗中用电动搅拌机搅拌奶油干酪，直至松软。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将搅拌机调至低速，慢慢加入浓奶油和香草精。加入甜味剂、可可粉和盐，直至充分混合。将搅拌机调高，再搅拌 1 至 2 分钟，直至变得轻盈蓬松。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "立即食用，或冷藏稍后食用。"
    }
  ],
