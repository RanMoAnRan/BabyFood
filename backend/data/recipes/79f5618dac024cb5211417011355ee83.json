  "title": "简易烤宽面条",
  "min_age_month": 12,
  "tags": [
    "Dinner",
    "Italian Inspired",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 90,
  "cover_image": "images/1cea353e52dd28be3318818310b2ee00.webp",
  "nutrition_tip": "这个简单的烤宽面条食谱是用瘦碎牛肉、三种奶酪、……",
  "ingredients": [
    {
      "name": "1 磅瘦碎牛肉",
      "amount": ""
    },
    {
      "name": "1 罐（32 盎司）意大利面酱",
      "amount": ""
    },
    {
      "name": "32 盎司干酪",
      "amount": ""
    },
    {
      "name": "3 杯马苏里拉奶酪丝，分开",
      "amount": ""
    },
    {
      "name": "2 个鸡蛋",
      "amount": ""
    },
    {
      "name": "0.5 杯磨碎的帕尔马干酪",
      "amount": ""
    },
    {
      "name": "2 茶匙干欧芹",
      "amount": ""
    },
    {
      "name": "加盐调味",
      "amount": ""
    },
    {
      "name": "黑胡椒粉适量",
      "amount": ""
    },
    {
      "name": "9 份烤宽面条",
      "amount": ""
    },
    {
      "name": "0.5 杯水",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料并将烤箱预热至 350 华氏度（175 摄氏度）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "用中高温加热一个大煎锅。在热煎锅中煮碎牛肉并搅拌 8 至 10 分钟，直至变成棕色且易碎。排干并丢弃油脂。拌入意大利面酱，煮 5 分钟。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将干酪、2 杯马苏里拉干酪、鸡蛋、1/2 磨碎的帕尔马干酪、干欧芹、盐和胡椒放入一个大碗中。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在 9x13 英寸的烤盘中涂抹 3/4 杯酱汁。盖上 3 条未煮过的烤宽面条、1 3/4 杯奶酪混合物和 1/4 杯酱汁；再次重复图层。上面放上剩下的 3 条面条、酱汁、马苏里拉奶酪和帕尔马干酪。沿盘子边缘倒入 1/2 杯水。用铝箔盖紧。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "在预热的烤箱中烘烤45分钟。揭开盖子，再烘烤 10 分钟。食用前静置 10 分钟。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "上菜并享用！"
    }
  ],
