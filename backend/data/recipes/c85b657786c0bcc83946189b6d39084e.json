{
  "id": "c85b657786c0bcc83946189b6d39084e",
  "title": "豪华火腿砂锅",
  "min_age_month": 8,
  "tags": [
    "Dinner",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 60,
  "cover_image": "images/12067cf2149444567edb2a1f2c88ea1e.webp",
  "nutrition_tip": "这道火腿砂锅菜的特色是用令人舒适的奶油酱烘烤的肘部通心粉......",
  "ingredients": [
    {
      "name": "3 杯肘形通心粉",
      "amount": ""
    },
    {
      "name": "烹饪喷雾",
      "amount": ""
    },
    {
      "name": "1 汤匙黄油",
      "amount": ""
    },
    {
      "name": "1 杯火腿块",
      "amount": ""
    },
    {
      "name": "1 杯切碎的洋葱",
      "amount": ""
    },
    {
      "name": "1 汤匙 蒜末",
      "amount": ""
    },
    {
      "name": "2 杯切达干酪丝",
      "amount": ""
    },
    {
      "name": "1 罐（10.75 盎司）芹菜浓缩奶油汤",
      "amount": ""
    },
    {
      "name": "1 杯冷冻豌豆",
      "amount": ""
    },
    {
      "name": "1 杯牛奶",
      "amount": ""
    },
    {
      "name": "0.5 杯酸奶油",
      "amount": ""
    },
    {
      "name": "0.5 茶匙洋葱粉",
      "amount": ""
    },
    {
      "name": "0.5 茶匙大蒜粉",
      "amount": ""
    },
    {
      "name": "1 罐（6 盎司）炸洋葱，压碎",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将一大锅盐水煮沸。将通心粉放入沸水中，不盖盖子，煮约 8 分钟，偶尔搅拌，直至变软且咬起来坚硬；流走。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将烤箱预热至 350 华氏度（175 摄氏度）。在 9x13 英寸的烤盘上涂上烹饪喷雾。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在大煎锅中用中高火融化黄油。在热黄油中煮火腿和洋葱并搅拌，直至洋葱变软，大约需要 5 分钟。加入大蒜，再煮约2分钟；将煎锅从火上移开。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将通心粉、切达干酪、浓缩汤、豌豆、牛奶、酸奶油、洋葱粉和大蒜粉加入煎锅中的火腿混合物中；混合直至充分混合。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "将混合物转移到准备好的烤盘中。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "在预热的烤箱中烘烤约 25 分钟，直至奶酪融化。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "将炸洋葱撒在砂锅上，继续烘烤至金黄色，大约再烤 5 分钟。"
    }
  ],
