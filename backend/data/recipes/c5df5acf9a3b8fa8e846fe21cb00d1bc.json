  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将香草威化饼、坚果、3/4 杯糖果混合在一起；糖和可可放入一个大碗中。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "加入朗姆酒和玉米糖浆，直至充分混合。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将面团搓成1英寸的球状；滚进糖果店里糖衣。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将朗姆酒球存放在密封容器中 2 到 3 天以产生风味。将它们再次放入糖果机中滚动。食用前加糖。"
    }
