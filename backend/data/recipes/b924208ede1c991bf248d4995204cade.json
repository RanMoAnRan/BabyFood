  "cover_image": "images/b57e0d2f1a23ddb9aebdff87ca2a35e8.webp",
  "nutrition_tip": "这个南瓜片松饼食谱里装满了巧克力片和南瓜，适合......",
  "ingredients": [
    {
      "name": "4 个鸡蛋",
      "amount": ""
    },
    {
      "name": "2 杯白糖",
      "amount": ""
    },
    {
      "name": "1 罐（15 盎司）南瓜",
      "amount": ""
    },
    {
      "name": "1.5 杯植物油",
      "amount": ""
    },
    {
      "name": "3 杯通用面粉",
      "amount": ""
    },
    {
      "name": "2 茶匙小苏打",
      "amount": ""
    },
    {
      "name": "2 茶匙泡打粉",
      "amount": ""
    },
    {
      "name": "1 茶匙肉桂粉",
      "amount": ""
    },
    {
      "name": "1 茶匙盐",
      "amount": ""
    },
    {
      "name": "2 杯半甜巧克力片",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 400 华氏度（200 摄氏度）。在两个 12 杯松饼罐上涂上油脂，或在杯子上铺上纸垫。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将鸡蛋打入碗中：加入糖、南瓜和油。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将面粉、小苏打、发酵粉、肉桂和盐放入碗中搅拌；搅拌成南瓜混合物。拌入巧克力片。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将面糊分装到准备好的松饼杯中，将每个杯填满。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "在预热的烤箱中烘烤 15 到 20 分钟，直至插入中心的牙签取出时是干净的。在罐头中冷却 5 分钟，然后将松饼转移到金属架上完全冷却。"
    }
  ],
