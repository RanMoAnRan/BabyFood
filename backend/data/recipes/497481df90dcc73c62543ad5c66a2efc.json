  "cover_image": "images/5f117d0b93319fcfe91716b5624d9f7c.webp",
  "nutrition_tip": "这种菠菜洋蓟酱味道鲜美，奶酪味十足，奶油味十足，而且很容易制作！服务…",
  "ingredients": [
    {
      "name": "1 包（8 盎司）奶油干酪，软化",
      "amount": ""
    },
    {
      "name": "0.25 杯蛋黄酱",
      "amount": ""
    },
    {
      "name": "0.25 杯磨碎的帕尔马干酪",
      "amount": ""
    },
    {
      "name": "0.25 杯磨碎的罗马诺奶酪",
      "amount": ""
    },
    {
      "name": "1 瓣大蒜，去皮并切碎",
      "amount": ""
    },
    {
      "name": "0.5 茶匙干罗勒",
      "amount": ""
    },
    {
      "name": "0.25 茶匙蒜盐",
      "amount": ""
    },
    {
      "name": "盐和胡椒调味",
      "amount": ""
    },
    {
      "name": "1罐（14盎司）朝鲜蓟心，沥干并切碎",
      "amount": ""
    },
    {
      "name": "0.5 杯冷冻切碎菠菜，解冻并沥干",
      "amount": ""
    },
    {
      "name": "0.25 杯马苏里拉奶酪丝",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。将烤箱预热至 350 华氏度（175 摄氏度）。在一个小烤盘上涂上少许油脂。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将奶油芝士、蛋黄酱、帕尔玛芝士、罗马芝士、大蒜、罗勒、蒜盐、盐和胡椒粉放入一个中等大小的碗中混合。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "轻轻拌入朝鲜蓟心和菠菜。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将混合物转移到准备好的烤盘中；上面放上马苏里拉奶酪。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "在预热的烤箱中烘烤约 25 分钟，直至起泡并呈浅棕色。"
    }
  ],
