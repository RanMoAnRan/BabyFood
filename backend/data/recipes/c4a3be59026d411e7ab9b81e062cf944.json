{
  "id": "c4a3be59026d411e7ab9b81e062cf944",
  "title": "简易烤猪排",
  "min_age_month": 8,
  "tags": [
    "Dinner",
    "American",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 110,
  "cover_image": "images/1bdeb2185ce78c9589570c1822dfe655.webp",
  "nutrition_tip": "这些简单的烤猪排变得多汁又嫩——而且它们很快就可以...",
  "ingredients": [
    {
      "name": "6块厚切猪排",
      "amount": ""
    },
    {
      "name": "1 茶匙大蒜粉",
      "amount": ""
    },
    {
      "name": "1 茶匙调味盐",
      "amount": ""
    },
    {
      "name": "2 个鸡蛋，打散",
      "amount": ""
    },
    {
      "name": "0.25 杯通用面粉",
      "amount": ""
    },
    {
      "name": "2 杯意式调味面包屑",
      "amount": ""
    },
    {
      "name": "4 汤匙橄榄油",
      "amount": ""
    },
    {
      "name": "1 罐（10.5 盎司）浓缩奶油蘑菇汤",
      "amount": ""
    },
    {
      "name": "0.5 杯牛奶",
      "amount": ""
    },
    {
      "name": "0.33333334326744 杯白葡萄酒",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将烤箱预热至 350 华氏度（175 摄氏度）。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "用蒜粉和调味盐给猪排调味。将打好的鸡蛋放入一个小碗中。将猪排轻轻裹上面粉；浸入打散的鸡蛋中，然后压入面包屑，使两面都沾上面包糠。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在中型煎锅中用中高温加热油。加入面包屑猪排，煮至金黄色，每面约 5 分钟；转移到 9x13 英寸的烤盘中并盖上箔纸。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "放入预热好的烤箱烤1小时。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "同时，将浓缩汤、牛奶和白葡萄酒放入一个中等大小的碗中，直至充分混合。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "将汤混合物倒在猪排上。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "更换箔纸，继续烘烤 30 分钟。"
    },
    {
      "step_index": 9,
      "img": "",
      "text": "趁热享用吧！"
    }
  ],
