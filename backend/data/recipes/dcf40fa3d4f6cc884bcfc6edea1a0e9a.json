{
  "id": "dcf40fa3d4f6cc884bcfc6edea1a0e9a",
  "title": "草莓芒果羊乳酪吐司",
  "min_age_month": 12,
  "tags": [],
  "difficulty": 1,
  "time_cost": 0,
  "cover_image": "images/9e834feaf2b0fc696eb94093783b7885.webp",
  "nutrition_tip": "草莓丁、芒果和脱脂羊奶酪提供了完美的平衡……",
  "ingredients": [],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "芒果去皮去核。 3/4 芒果、3/4 草莓切丁；放入装有羊奶酪的大碗中。将剩余的水果、1/4 杯罗勒、醋和油放入搅拌机中搅拌。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将混合好的油醋汁倒在水果羊乳酪混合物上，轻轻搅拌。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "切碎剩余的罗勒叶。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "烤面包片并将每片对角切开。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "在吐司上撒上水果羊乳酪混合物和切碎的罗勒。"
    }
  ],
