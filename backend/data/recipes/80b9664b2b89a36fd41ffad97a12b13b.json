  "cover_image": "images/e16c4fd497884089d524d4c32c1dc825.webp",
  "nutrition_tip": "这款胡桃南瓜通心粉和奶酪配上嫩意大利面、浓郁的奶酪酱和米……",
  "ingredients": [
    {
      "name": "1 包（16 盎司）罗蒂尼面食",
      "amount": ""
    },
    {
      "name": "2 汤匙黄油",
      "amount": ""
    },
    {
      "name": "2 汤匙通用面粉",
      "amount": ""
    },
    {
      "name": "1 茶匙大蒜粉",
      "amount": ""
    },
    {
      "name": "1 茶匙洋葱粉",
      "amount": ""
    },
    {
      "name": "0.5 茶匙干芥末",
      "amount": ""
    },
    {
      "name": "1/8 茶匙肉豆蔻粉",
      "amount": ""
    },
    {
      "name": "2 杯牛奶",
      "amount": ""
    },
    {
      "name": "3 杯胡桃南瓜块，煮熟并捣碎",
      "amount": ""
    },
    {
      "name": "6 盎司切达白切达干酪丝",
      "amount": ""
    },
    {
      "name": "6 盎司切达干酪丝",
      "amount": ""
    },
    {
      "name": "盐和胡椒调味",
      "amount": ""
    },
    {
      "name": "0.25 杯调味干面包屑，或根据需要",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集原料并将烤箱预热至 400 华氏度（200 摄氏度）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将一大锅淡盐水煮沸。将意大利面放入沸水中煮至软而硬，约 8 分钟；将意大利面沥干并放回锅中。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "同时，在大平底锅中用中火融化黄油。加入面粉、大蒜粉、洋葱粉、干芥末和肉豆蔻粉，搅拌；煮1分钟。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将牛奶逐渐搅拌到面粉混合物中，煮约 5 分钟，直至起泡并变稠至浓奶油的稠度。从火上移开。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将南瓜、白切达干酪和切达干酪搅拌到牛奶混合物中，直至奶酪融化。用盐和胡椒调味。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "将芝士酱加入面食中，搅拌均匀；将混合物转移到 9x13 英寸的烤盘中。上面撒上调味面包屑。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "在预热的烤箱中烘烤约 20 分钟，直至配料呈金黄色且酱汁冒泡。"
    }
  ],
