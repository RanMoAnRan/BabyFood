  "id": "69e2eac033ff06c0f114348bd107f45e",
  "title": "金色甜玉米面包",
  "min_age_month": 12,
  "tags": [
    "Bread",
    "American",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 30,
  "cover_image": "images/333ad6f36c196cb309ed1c8f726a6afc.webp",
  "nutrition_tip": "这种从头开始制作的玉米面包食谱是家庭的最爱，可以补充……",
  "ingredients": [
    {
      "name": "1 杯通用面粉",
      "amount": ""
    },
    {
      "name": "1 杯黄玉米粉",
      "amount": ""
    },
    {
      "name": "0.66666668653488 杯 白糖",
      "amount": ""
    },
    {
      "name": "3.5 茶匙泡打粉",
      "amount": ""
    },
    {
      "name": "1 茶匙盐",
      "amount": ""
    },
    {
      "name": "1 杯牛奶",
      "amount": ""
    },
    {
      "name": "0.33333334326744 杯植物油",
      "amount": ""
    },
    {
      "name": "1 个大鸡蛋",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将烤箱预热至 400 华氏度（200 摄氏度）。在9英寸的圆形蛋糕盘上涂上油脂。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将面粉、玉米粉、糖、泡打粉和盐放入一个大碗中搅拌。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "加入牛奶、植物油、鸡蛋；搅拌直至充分混合。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将面糊倒入准备好的平底锅中。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "在预热的烤箱中烘烤 20 到 25 分钟，直到插入烤盘中心的牙签拔出来时是干净的。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "切片并享用！"
    }
  ],
