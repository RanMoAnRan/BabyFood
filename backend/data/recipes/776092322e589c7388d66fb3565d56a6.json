  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将碎牛肉、3 汤匙番茄酱、鸡蛋、洋葱汤粉和牛排调味料放入碗中。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将混合物轻轻拍入慢炖锅中；将剩余的 3 汤匙番茄酱涂在上面。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "盖上慢炖锅。低火煮 6 至 8 小时，或高火煮 4 小时。"
