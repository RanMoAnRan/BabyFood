{
  "id": "057e7e4322d377d11b9e65d93c3f8957",
  "title": "照烧鸡肉和卷心菜",
  "min_age_month": 12,
  "tags": [],
  "difficulty": 1,
  "time_cost": 0,
  "cover_image": "images/25d6afae87b0c4ee3f09db3c5822bb65.webp",
  "nutrition_tip": "通过这顿美味佳肴引入新口味。",
  "ingredients": [],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "用肥皂和水洗手至少 20 秒。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "准备腌料：在一个小碗中，将酱油、植物油、胡椒粉、蒜粉和姜混合。搅拌直至光滑。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将一半腌料混合物倒入 9” x 13” 玻璃或陶瓷烤盘的底部。将另一半腌料混合物冷藏在 40 °F 或更低的温度下，以便在步骤 9 中使用（称为“保留的腌料”）。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将鸡肉放入烤盘中。覆盖。在 40°F 或更低的冰箱中腌制 2 小时。将鸡肉翻过来腌制另一面。覆盖。在冰箱里再腌制2小时。接触未煮熟的鸡肉后要洗手（参见厨师提示）。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将烤箱预热至 400 °F。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "将切碎的卷心菜铺在干净的 9” x 13” 烤盘底部。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "将鸡肉从腌料中取出。丢弃所有剩余的腌料（参见厨师提示）。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "将鸡肉放在卷心菜上。接触未煮熟的鸡肉后要洗手。"
    },
    {
      "step_index": 9,
      "img": "",
      "text": "将保留的腌料倒在鸡肉上。"
    },
    {
      "step_index": 10,
      "img": "",
      "text": "烘烤 25 分钟。将鸡肉加热至 165 °F 或更高的内部温度至少 15 秒。从烤箱中取出。"
    },
    {
      "step_index": 11,
      "img": "",
      "text": "将 1½ 只鸡大腿与 ¼ 杯煮熟的卷心菜一起食用。"
    }
  ],
  "warnings": [],
