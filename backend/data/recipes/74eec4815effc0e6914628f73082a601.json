  "id": "74eec4815effc0e6914628f73082a601",
  "title": "棉花糖红薯泥",
  "min_age_month": 6,
  "tags": [
    "Side Dish",
    "American",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 65,
  "cover_image": "images/8d13d59f49fae4ec6996f225213cd275.webp",
  "nutrition_tip": "红薯泥加红糖和温热的香料，上面放着腐烂的…",
  "ingredients": [
    {
      "name": "6 个中等大小的红薯，去皮并切成方块",
      "amount": ""
    },
    {
      "name": "0.33333334326744 杯红糖",
      "amount": ""
    },
    {
      "name": "0.25 茶匙五香粉粉",
      "amount": ""
    },
    {
      "name": "0.25 茶匙肉桂粉",
      "amount": ""
    },
    {
      "name": "0.5（10.5 盎司）包微型棉花糖",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将烤箱预热至 350 华氏度（175 摄氏度）。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将红薯放入大锅中，盖上水；煮沸。将火调至中低，煮约 20 分钟直至变软。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将土豆沥干并转移到烤盘上。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将红薯放入预热好的烤箱中烤至干，3至4分钟；转移到搅拌碗中。保持烤箱开启。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "用土豆捣碎器捣碎红薯，直到没有大块为止。加入红糖、五香粉和肉桂；继续捣碎，直到土豆调味均匀。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "将混合物倒入砂锅中，然后将棉花糖均匀地铺在上面。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "在烤箱中烘烤 10 到 15 分钟，直到棉花糖开始变成棕色。打开烤鸡并烤 1 分钟。"
    }
  ],
