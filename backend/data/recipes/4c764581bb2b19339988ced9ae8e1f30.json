{
  "id": "4c764581bb2b19339988ced9ae8e1f30",
  "title": "鲍勃的熏手撕猪肉",
  "min_age_month": 12,
  "tags": [
    "Dinner",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 1240,
  "cover_image": "images/d6d27a385dfcb1d48e2035900cc65a4f.webp",
  "nutrition_tip": "这个熏拉猪肉食谱将猪肩肉浸泡在苹果酒中，然后涂上……",
  "ingredients": [
    {
      "name": "1 块（8 磅）烤猪肩肉",
      "amount": ""
    },
    {
      "name": "1 夸脱苹果酒，或根据需要",
      "amount": ""
    },
    {
      "name": "5 汤匙白糖",
      "amount": ""
    },
    {
      "name": "5 汤匙 淡红糖",
      "amount": ""
    },
    {
      "name": "2 汤匙粗盐",
      "amount": ""
    },
    {
      "name": "2 汤匙辣椒粉",
      "amount": ""
    },
    {
      "name": "1 汤匙洋葱粉",
      "amount": ""
    },
    {
      "name": "1 汤匙现磨黑胡椒",
      "amount": ""
    },
    {
      "name": "1 汤匙大蒜粉",
      "amount": ""
    },
    {
      "name": "3 杯山核桃片，或根据需要更多，浸泡在水中",
      "amount": ""
    },
    {
      "name": "1 个洋葱，切碎",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将猪肩肉放入一个大锅中，加入足够的苹果汁盖住。将白糖、红糖、盐、辣椒粉、洋葱粉、黑胡椒粉和大蒜粉放入碗中。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将 1/4 杯糖揉入苹果酒中；保留剩余的摩擦力。盖上锅盖，冷藏12小时。将吸烟器预热至 210 华氏度（99 摄氏度）。向吸烟者添加足够的木片。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将苹果盐水倒入吸烟器的水盘中；添加洋葱和 1/4 杯糖粉。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将剩余的糖涂抹在猪肩上。将猪肉转移到吸烟器的中心。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "将猪肉熏至非常嫩或内部温度达到 200 华氏度（95 摄氏度），大约需要 8 小时。监控山核桃木片和液体，根据需要添加更多。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "将猪肉转移到一个大浅盘中，静置 30 分钟，然后用叉子切碎。"
    }
  ],
