  "title": "斑鸡鸡",
  "min_age_month": 12,
  "tags": [
    "Dinner",
    "American",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 50,
  "cover_image": "images/f94302ec66d5e16b78d1a314e841567c.webp",
  "nutrition_tip": "这道美味的斯巴达鸡用龙蒿、辣椒粉、黑胡椒调味......",
  "ingredients": [
    {
      "name": "2 (3 1/2) 磅整只鸡，去掉翼尖",
      "amount": ""
    },
    {
      "name": "2 茶匙盐",
      "amount": ""
    },
    {
      "name": "1 茶匙干龙蒿",
      "amount": ""
    },
    {
      "name": "1 茶匙辣椒粉",
      "amount": ""
    },
    {
      "name": "0.25 茶匙黑胡椒",
      "amount": ""
    },
    {
      "name": "4 茶匙橄榄油",
      "amount": ""
    },
    {
      "name": "2 个柠檬，切成薄片并去籽",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 450 华氏度（230 摄氏度）。在一张大的有边烤盘上铺上箔纸。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将鸡肉放在工作台面上，胸部朝下。从尾部开始，用厨房剪刀沿着主干两侧剪开。去掉骨干。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "抓住鸡肉的两面，像打开一本书一样打开它。将胸部朝上。用手向下推乳房两侧，直到听到破裂的声音。将鸡肉压平并转移到准备好的烤盘的一个短端。对第二只鸡重复上述步骤。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将盐、龙蒿、辣椒粉和胡椒粉放入一个小碗中。拌入油。将手指放在鸡皮下，然后将龙蒿膏擦在鸡皮下。将柠檬片单层滑入皮下。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "烤至外皮酥脆，插入乳房最厚部分的即时读数温度计读数为 165 华氏度，大约需要 35 到 40 分钟。静置 5 分钟，然后将每只鸡切成 8 块。"
    }
  ],
