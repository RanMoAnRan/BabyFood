{
  "id": "968ca3ab30d6dac5bb0d441be3862db6",
  "title": "燕麦山核桃华夫饼",
  "min_age_month": 8,
  "tags": [],
  "difficulty": 1,
  "time_cost": 0,
  "cover_image": "images/29af9ccdad10a530be373bb96b968d7e.webp",
  "nutrition_tip": "孩子们会喜欢这些用全麦面粉和燕麦制成的全麦华夫饼。&n…",
  "ingredients": [],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "预热华夫饼熨斗。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将面粉、燕麦、泡打粉、糖和山核桃放入一个大碗中。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将蛋黄、牛奶和植物油放入另一个碗中，搅拌均匀。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将液体混合物添加到干成分中，并搅拌在一起。不要过度混合；混合物应该有点块状。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将蛋白搅打至中等峰值。轻轻地将蛋白拌入面糊中。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "将面糊倒入预热的华夫饼熨斗中，煮至华夫饼熨斗发出指示灯表明已完成或蒸汽停止从熨斗中冒出。当华夫饼的外部酥脆且呈棕色，内部湿润、轻盈、通风且蓬松时，华夫饼就是完美的。 （或者做煎饼。）"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "在每个华夫饼中加入新鲜水果和少许糖粉，即可食用。"
    }
  ],
