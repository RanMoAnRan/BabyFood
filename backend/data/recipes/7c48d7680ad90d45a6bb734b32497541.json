{
  "id": "7c48d7680ad90d45a6bb734b32497541",
  "title": "南方玉米面包酱",
  "min_age_month": 8,
  "tags": [
    "Dinner",
    "Side Dish",
    "Southern",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 70,
  "cover_image": "images/aee672a8a76f14f8350ee233f3509c28.webp",
  "nutrition_tip": "这种美味的南方玉米面包酱配鸡肉，味道浓郁、舒适、轻松……",
  "ingredients": [
    {
      "name": "0.25 杯黄油",
      "amount": ""
    },
    {
      "name": "0.5 杯切碎的洋葱",
      "amount": ""
    },
    {
      "name": "0.5 杯切碎的芹菜",
      "amount": ""
    },
    {
      "name": "1（1 磅）面包玉米面包，碎",
      "amount": ""
    },
    {
      "name": "1 条（1 磅）日龄白面包，撕成小块",
      "amount": ""
    },
    {
      "name": "1 磅切碎的熟鸡胸肉",
      "amount": ""
    },
    {
      "name": "4 杯鸡汤，或更多品尝",
      "amount": ""
    },
    {
      "name": "1 罐（10.5 盎司）浓缩奶油鸡汤",
      "amount": ""
    },
    {
      "name": "6 个大鸡蛋",
      "amount": ""
    },
    {
      "name": "2 茶匙家禽调味料",
      "amount": ""
    },
    {
      "name": "0.5 茶匙黑胡椒粉",
      "amount": ""
    },
    {
      "name": "0.125 茶匙大蒜粉",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 350 华氏度（175 摄氏度）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在平底锅中用中火融化黄油。加入洋葱和芹菜；煮5到7分钟，搅拌直至变软。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "同时，将碎玉米面包和白面包片放入一个大碗中。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将煮熟的洋葱和芹菜添加到面包混合物中。加入鸡丝、4杯鸡汤、浓缩汤、鸡蛋、家禽调味料、胡椒粉和蒜粉。用土豆捣碎器搅拌直至混合物达到明胶的稠度。添加最多 2 杯肉汤，以达到所需的稠度。转移到 9x13 英寸的烤盘中。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "在预热的烤箱中烘烤约30分钟，直至调料呈金黄色。"
    }
  ],
