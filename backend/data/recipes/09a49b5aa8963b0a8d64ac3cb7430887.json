  ],
  "difficulty": 1,
  "time_cost": 210,
  "cover_image": "images/f112ed2240bfd7ee0aaccda68ac384c5.webp",
  "nutrition_tip": "这个胡桃南瓜饼干食谱是用肉桂、肉豆蔻和生姜调味的，……",
  "ingredients": [
    {
      "name": "1 个胡桃南瓜，切半并去籽",
      "amount": ""
    },
    {
      "name": "1.5 杯自发面粉",
      "amount": ""
    },
    {
      "name": "1.5 杯快煮燕麦",
      "amount": ""
    },
    {
      "name": "1 茶匙肉桂粉",
      "amount": ""
    },
    {
      "name": "0.5 茶匙姜粉",
      "amount": ""
    },
    {
      "name": "0.5 茶匙肉豆蔻粉",
      "amount": ""
    },
    {
      "name": "0.25 杯黄油",
      "amount": ""
    },
    {
      "name": "0.25 杯起酥油",
      "amount": ""
    },
    {
      "name": "0.5 杯白糖",
      "amount": ""
    },
    {
      "name": "0.33333334326744 杯包装红糖",
      "amount": ""
    },
    {
      "name": "1 个鸡蛋",
      "amount": ""
    },
    {
      "name": "2 汤匙牛奶",
      "amount": ""
    },
    {
      "name": "0.25 茶匙香草精",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 400 华氏度（200 摄氏度）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将胡桃南瓜切成两半，切面朝下，放在烤盘上。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "放入预热好的烤箱中烘烤45至60分钟，直至用刀轻松刺穿；凉爽，大约15分钟。用勺子将果肉舀入一个大碗中：捣碎直至光滑。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将面粉、燕麦、肉桂、姜和肉豆蔻放入碗中。放在一边"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将黄油和起酥油放入另一个碗中，用电动搅拌机搅拌至光滑，约 30 秒；加入白糖和红糖，搅打至松发。加入捣碎的南瓜、鸡蛋、牛奶和香草精，搅拌直至面团完全混合；拌入面粉混合物。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "将面团放入冰箱冷藏约 2 小时直至变硬。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "将烤箱预热至 375 华氏度（190 摄氏度）。在 2 个烤盘上铺上羊皮纸。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "将 1 英寸勺的面团（间隔 2 英寸）放在准备好的烤盘上。"
    },
    {
      "step_index": 9,
      "img": "",
      "text": "在预热的烤箱中烘烤 10 到 12 分钟，直至边缘呈金黄色。在将饼干转移到金属架上完全冷却之前，先在烤盘上短暂冷却。"
    }
  ],
