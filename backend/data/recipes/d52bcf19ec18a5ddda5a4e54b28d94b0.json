  "nutrition_tip": "这些豪猪肉丸是用碎牛肉和洋葱制成的，里面充满了小……",
  "ingredients": [
    {
      "name": "1 磅碎牛肉",
      "amount": ""
    },
    {
      "name": "0.5 杯生白米饭",
      "amount": ""
    },
    {
      "name": "0.5 杯水",
      "amount": ""
    },
    {
      "name": "0.33333334326744 杯切碎的洋葱",
      "amount": ""
    },
    {
      "name": "1 茶匙盐",
      "amount": ""
    },
    {
      "name": "0.5 茶匙芹菜盐",
      "amount": ""
    },
    {
      "name": "0.125 茶匙大蒜粉",
      "amount": ""
    },
    {
      "name": "0.125 茶匙黑胡椒粉",
      "amount": ""
    },
    {
      "name": "1 汤匙菜籽油",
      "amount": ""
    },
    {
      "name": "1 罐（15 盎司）番茄酱",
      "amount": ""
    },
    {
      "name": "1 杯低钠鸡汤，或根据需要更多",
      "amount": ""
    },
    {
