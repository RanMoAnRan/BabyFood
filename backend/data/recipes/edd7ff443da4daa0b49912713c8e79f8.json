{
  "id": "edd7ff443da4daa0b49912713c8e79f8",
  "title": "平底锅香肠和蔬菜烘烤",
  "min_age_month": 12,
  "tags": [],
  "difficulty": 1,
  "time_cost": 0,
  "cover_image": "images/ead5f7622ce6ffa1da3b4517e4336462.webp",
  "nutrition_tip": "在不到 40 分钟的时间内享用一顿健康的晚餐，里面有色彩缤纷的蔬菜和…",
  "ingredients": [],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 425°F。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "准备一张带有羊皮纸的烤盘或涂上不粘烹饪喷雾。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将甜椒和洋葱或新鲜蔬菜单层铺在准备好的烤盘上。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将鸡肉香肠片放在蔬菜上。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将切块的胡桃南瓜或红薯添加到鸡肉香肠和蔬菜上。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "在蔬菜和鸡肉上涂上不粘烹饪喷雾。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "在上面撒上胡椒粉、蒜粉和意大利调味料。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "烘烤约 35 分钟，直至蔬菜煮熟且边缘稍微变脆。趁热食用。"
    }
  ],
