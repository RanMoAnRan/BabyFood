  "title": "非常简单的爱尔兰苏打面包",
  "min_age_month": 12,
  "tags": [
    "Breakfast",
    "Irish"
  ],
  "difficulty": 1,
  "time_cost": 60,
  "cover_image": "images/2f1341d805e1fb604fe0397b9b2c3caa.webp",
  "nutrition_tip": "爱尔兰苏打面包是一种用面粉、酪乳和小苏打制作的快速面包……",
  "ingredients": [
    {
      "name": "4 杯通用面粉",
      "amount": ""
    },
    {
      "name": "0.5 杯人造黄油，软化",
      "amount": ""
    },
    {
      "name": "4 汤匙白糖",
      "amount": ""
    },
    {
      "name": "1 茶匙小苏打",
      "amount": ""
    },
    {
      "name": "1 汤匙发酵粉",
      "amount": ""
    },
    {
      "name": "0.5 茶匙盐",
      "amount": ""
    },
    {
      "name": "1 杯酪乳",
      "amount": ""
    },
    {
      "name": "1 个鸡蛋",
      "amount": ""
    },
    {
      "name": "0.25 杯黄油，融化",
      "amount": ""
    },
    {
      "name": "0.25 杯酪乳",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 375 华氏度（190 摄氏度）。在大烤盘上涂上少许油脂。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将面粉、软化黄油、糖、小苏打、泡打粉和盐放入一个大碗中混合。加入 1 杯酪乳和鸡蛋，搅拌。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将面团翻到撒有少许面粉的表面上，轻轻揉捏。将面团形成圆形面包并放在准备好的烤盘上。注意，面团会有点粘。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将融化的黄油与 1/4 杯酪乳混合在一个小碗中；用这种混合物刷面包。用锋利的刀切出“X”字形。进入面包的顶部。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "在预热的烤箱中烘烤 45 到 50 分钟，直至将牙签插入面包中心，拔出时是干净的。 30分钟后检查是否熟了。烘烤时，您可以继续在面包上刷黄油混合物。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "切片并享用！"
    }
  ],
