  ],
  "difficulty": 1,
  "time_cost": 25,
  "cover_image": "images/2673e458d820bbd05cfd1cebef5413e0.webp",
  "nutrition_tip": "这个香蕉布丁食谱是用布丁混合物和炼乳制成的。分层它…",
  "ingredients": [
    {
      "name": "2 杯冷牛奶",
      "amount": ""
    },
    {
      "name": "1 包（5 盎司）即食香草布丁粉",
      "amount": ""
    },
    {
      "name": "1 罐（14 盎司）甜炼乳",
      "amount": ""
    },
    {
      "name": "1 汤匙香草精",
      "amount": ""
    },
    {
      "name": "1 个（12 盎司）容器冷冻搅打配料，解冻",
      "amount": ""
    },
    {
      "name": "1 包（16 盎司）香草薄饼",
      "amount": ""
    },
    {
      "name": "14 根香蕉，切片",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将牛奶和布丁混合物放入一个大碗中；用搅拌器搅拌2分钟。加入炼乳搅拌至光滑。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "拌入香草精，然后拌入打发的配料。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在玻璃碗的底部放置一层威化饼。上面铺上一层香蕉片，然后铺上一层布丁混合物；重复层数，直到使用所有成分。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "为了获得最佳效果，请在食用前将布丁放入冰箱中冷藏至少 1 小时。上菜前，在上面加上额外的碎威化饼。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "享受吧！"
    }
  ],
