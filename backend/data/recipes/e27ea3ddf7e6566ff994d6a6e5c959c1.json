  "nutrition_tip": "这个南瓜面包屑蛋糕有 3 层美味，从黄油皮开始，...",
  "ingredients": [
    {
      "name": "1 包（15.25 盎司）黄色蛋糕粉，分开",
      "amount": ""
    },
    {
      "name": "0.5 杯无盐黄油，融化",
      "amount": ""
    },
    {
      "name": "1 个大鸡蛋，打散",
      "amount": ""
    },
    {
      "name": "1 罐（15 盎司）南瓜泥",
      "amount": ""
    },
    {
      "name": "0.5 杯白糖",
      "amount": ""
    },
    {
      "name": "3 个大鸡蛋，打散",
      "amount": ""
    },
    {
      "name": "0.25 杯包装红糖",
      "amount": ""
    },
    {
      "name": "1.5 茶匙肉桂粉",
      "amount": ""
    },
    {
      "name": "0.5 杯白糖",
      "amount": ""
    },
    {
      "name": "3汤匙无盐黄油，软化",
      "amount": ""
    },
    {
      "name": "0.5 杯核桃碎",
