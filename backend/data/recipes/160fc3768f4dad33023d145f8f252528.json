  "title": "西兰花土豆汤",
  "min_age_month": 8,
  "tags": [],
  "difficulty": 1,
  "time_cost": 0,
  "cover_image": "images/a305e0f569ed1b51c894f92648e35df8.webp",
  "nutrition_tip": "在寒冷的天做西兰花土豆汤来暖身。",
  "ingredients": [],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将西兰花、水、洋葱和肉汤块放入汤锅中混合。煮沸并减少热量。盖上锅盖，小火煮约 10 分钟，直至蔬菜变软。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "加入牛奶并慢慢拌入土豆片。煮，不断搅拌，直至变稠。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "上桌时撒上奶酪。"
    }
  ],
