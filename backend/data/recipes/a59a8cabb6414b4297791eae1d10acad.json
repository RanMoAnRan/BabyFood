  "id": "a59a8cabb6414b4297791eae1d10acad",
  "title": "非常巧克力冰淇淋",
  "min_age_month": 12,
  "tags": [
    "Dessert",
    "American",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 160,
  "cover_image": "images/638955228ccd47926143ac3568147451.webp",
  "nutrition_tip": "这种巧克力冰淇淋使用可可粉和融化的巧克力在蛋奶冻基底中......",
  "ingredients": [
    {
      "name": "1 杯牛奶",
      "amount": ""
    },
    {
      "name": "0.75 杯糖",
      "amount": ""
    },
    {
      "name": "2 汤匙不加糖可可粉",
      "amount": ""
    },
    {
      "name": "0.25 茶匙盐",
      "amount": ""
    },
    {
      "name": "3 个蛋黄，轻轻搅打",
      "amount": ""
    },
    {
      "name": "2 盎司半甜巧克力，切碎",
      "amount": ""
    },
    {
      "name": "2 杯浓奶油",
      "amount": ""
    },
    {
      "name": "1 茶匙香草精",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将牛奶、糖、可可粉和盐放入平底锅中，用中火加热。煮沸，不断搅拌。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将蛋黄放入小碗中。逐渐加入约 1/2 杯热牛奶混合物，然后放回平底锅中。加热并搅拌直至变稠，但不要沸腾。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "从火上移开，加入切碎的巧克力搅拌直至融化。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "倒入冰镇的碗中并冷藏，偶尔搅拌，直至变冷，大约需要 2 小时。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "加入奶油和香草精搅拌。将混合物倒入冰淇淋机中，按照制造商的说明冷冻约 20 分钟。将冰淇淋转移到密封容器中并冷冻直至变硬。"
    }
  ],
