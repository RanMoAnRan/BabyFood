{
  "id": "9e260bc22a36d6a3e79005f409afbbb6",
  "title": "卷心菜卷",
  "min_age_month": 8,
  "tags": [
    "Dinner",
    "Eastern European"
  ],
  "difficulty": 1,
  "time_cost": 75,
  "cover_image": "images/53e4cb841d70cfc992b3cdf4985e65a6.webp",
  "nutrition_tip": "这个卷心菜卷食谱的特色是嫩卷心菜叶，里面充满了美味的牛肉……",
  "ingredients": [
    {
      "name": "0.66666668653488 杯水",
      "amount": ""
    },
    {
      "name": "0.33333334326744 杯生白米饭",
      "amount": ""
    },
    {
      "name": "8 片卷心菜叶",
      "amount": ""
    },
    {
      "name": "1 磅瘦碎牛肉",
      "amount": ""
    },
    {
      "name": "0.25 杯切碎的洋葱",
      "amount": ""
    },
    {
      "name": "1 个鸡蛋，稍微打散",
      "amount": ""
    },
    {
      "name": "1罐（10.5盎司）浓缩番茄汤，分开",
      "amount": ""
    },
    {
      "name": "1 茶匙盐",
      "amount": ""
    },
    {
      "name": "0.25 茶匙黑胡椒粉",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将水和米放入平底锅中煮沸。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将火调至小火，盖上锅盖，小火煮约 20 分钟，直至米饭变软且液体被吸收。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "同时，将一大锅淡盐水煮沸。加入卷心菜叶，煮 2 至 4 分钟或直至变软；流走。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将碎牛肉、1杯米饭、洋葱、打散的鸡蛋、2汤匙番茄汤、盐和胡椒粉放入一个大碗中；充分混合。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "将约 2 汤匙牛肉混合物舀到每片卷心菜叶上。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "将卷心菜叶的一端放在混合物上。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "卷起并塞入两端，以防止馅料掉落。"
    },
    {
      "step_index": 9,
      "img": "",
      "text": "将卷心菜卷接缝面朝下放入大煎锅中，中火加热。"
    },
    {
      "step_index": 10,
      "img": "",
      "text": "将剩余的番茄汤倒在面包卷上。"
    },
    {
      "step_index": 11,
      "img": "",
      "text": "盖上盖子并煮沸。把火调小，煮约40分钟，经常涂上酱汁，直到牛肉煮熟。"
    },
    {
      "step_index": 12,
      "img": "",
      "text": "上菜并享用！"
    }
  ],
