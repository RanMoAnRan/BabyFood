  ],
  "difficulty": 1,
  "time_cost": 75,
  "cover_image": "images/67c1b79a6c5c41b7e7cbe406aca03e9b.webp",
  "nutrition_tip": "这个简单的柿饼是用新鲜成熟的柿子捣成泥制成的…",
  "ingredients": [
    {
      "name": "不粘烹饪喷雾",
      "amount": ""
    },
    {
      "name": "2.5 杯通用面粉",
      "amount": ""
    },
    {
      "name": "2 杯糖",
      "amount": ""
    },
    {
      "name": "2 茶匙小苏打",
      "amount": ""
    },
    {
      "name": "0.5 茶匙泡打粉",
      "amount": ""
    },
    {
      "name": "0.5 茶匙盐",
      "amount": ""
    },
    {
      "name": "2 杯 柿子浆",
      "amount": ""
    },
    {
      "name": "1 杯牛奶",
      "amount": ""
    },
    {
      "name": "2 个大鸡蛋",
      "amount": ""
    },
    {
      "name": "2 茶匙香草精",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 300 华氏度（150 摄氏度）。在 9x13 英寸烤盘上喷上不粘喷雾剂，并撒上面粉。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在一个大碗中将面粉、糖、小苏打、泡打粉和盐搅拌在一起。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将柿子果肉、牛奶、鸡蛋和香草精放入另一个碗中，搅拌至光滑。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将柿子混合物拌入面粉混合物中，直至没有干块残留；将面糊倒入准备好的平底锅中。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "在预热的烤箱中烘烤 50 到 75 分钟，直到插入中心的牙签拔出来时是干净的。在锅中冷却 10 分钟，然后从锅中取出，放在金属架上完全冷却。"
    }
  ],
