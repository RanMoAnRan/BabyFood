{
  "id": "d9bc211fd69ff36bcc6a13064318ea98",
  "title": "西葫芦丝和意大利面",
  "min_age_month": 12,
  "tags": [],
  "difficulty": 1,
  "time_cost": 0,
  "cover_image": "images/579f0f09dd8d0a2e767526cb085614d0.webp",
  "nutrition_tip": "情侣意大利面配蔬菜，孩子们会喜欢的。",
  "ingredients": [],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "用肥皂和水洗手至少 20 秒。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在一个中型锅中，用中高温将水煮沸。添加面食。煮 8 分钟或直至有嚼劲（触感柔软，咬起来坚硬）。沥干意大利面中的水。用冷水冲洗干净。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在中型不粘煎锅中用中火加热油。添加大蒜。煮 15-20 秒。不断搅拌。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将热量调至中高。加入西葫芦、盐和胡椒。再煮10分钟。经常搅拌。煮至温度达到 140°F。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将煮熟的意大利面放入锅中。煮约2分钟。加热至 140°F 或更高并持续至少 15 秒。从火上移开。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "撒上帕尔马干酪。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "提供 ⅔ 杯。"
    }
  ],
