  "nutrition_tip": "这些软糖南瓜布朗尼是巧克力、南瓜饼的完美结合……",
  "ingredients": [
    {
      "name": "0.75 杯通用面粉",
      "amount": ""
    },
    {
      "name": "0.5 茶匙泡打粉",
      "amount": ""
    },
    {
