{
  "id": "de39a3374aac275d8fcb7cda418221fb",
  "title": "脆饼饼干",
  "min_age_month": 12,
  "tags": [
    "Dessert",
    "American",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 25,
  "cover_image": "images/8d8515deb54b4dc415aa39e2158a7ec0.webp",
  "nutrition_tip": "这些经典的脆饼饼干是黄油状的，嫩滑的，入口即化——疯狂……",
  "ingredients": [
    {
      "name": "2 杯黄油，软化",
      "amount": ""
    },
    {
      "name": "1 杯白糖",
      "amount": ""
    },
    {
      "name": "2 茶匙香草精",
      "amount": ""
    },
    {
      "name": "4 杯通用面粉",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将烤箱预热至 350 华氏度（180 摄氏度）。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将软化的黄油和糖放入一个大碗中，用电动搅拌机中速搅拌，直至松软，大约需要 3 到 4 分钟。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "加入香草精搅拌；逐渐加入面粉，搅拌直至形成光滑的面团。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将面团填满饼干压榨机，然后将饼干放在两张未涂油的饼干片上，将它们间隔约 1 ½ 英寸。在预热的烤箱中烘烤约 10 至 12 分钟，直至饼干边缘开始变成金黄色。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "从烤箱中取出饼干片，并将它们放在金属丝冷却架上几分钟。然后将脆饼转移到架子上完全冷却。"
    }
  ],
