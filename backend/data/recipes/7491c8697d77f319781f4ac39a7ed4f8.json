  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将酱油、红糖、大蒜、米酒醋、辣椒酱、黑胡椒或辣椒粉、生姜和芝麻油一起放入锅中搅拌；煮沸。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在一个小碗中搅拌玉米淀粉和水，直至玉米淀粉溶解。倒入煮沸的酱油混合物中。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将火调至中低，煮 3 至 5 分钟，直至酱汁变稠。"
    }
