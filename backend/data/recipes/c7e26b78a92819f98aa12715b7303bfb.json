  "nutrition_tip": "使用厨房主食在不到 10 分钟内烹制一顿健康的饭菜。",
  "ingredients": [],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "在中型平底锅中，用中火加热油，炒大蒜和洋葱 3 分钟或直至洋葱变软。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将豆子、西红柿和肉汤加入锅中。搅拌并煮 5 分钟。加入羽衣甘蓝，煮约 2 分钟，直至变软。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "食用前加入柠檬汁和帕尔马干酪。可选的，用切碎的新鲜罗勒或干罗勒装饰。"
    }
  ],
