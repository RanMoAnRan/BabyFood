{
  "id": "905b76cbf2a5b715267608c917aa5cb1",
  "title": "快速简便的约克郡布丁",
  "min_age_month": 8,
  "tags": [
    "Side Dish",
    "Dinner",
    "British",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 40,
  "cover_image": "images/e591c9dc8cdf209f9101bf2104b3c8df.webp",
  "nutrition_tip": "约克郡布丁是用鸡蛋、面粉和牛奶的简单面糊制成的，在……中烘烤。",
  "ingredients": [
    {
      "name": "3 个鸡蛋",
      "amount": ""
    },
    {
      "name": "1 杯牛奶",
      "amount": ""
    },
    {
      "name": "1 杯通用面粉",
      "amount": ""
    },
    {
      "name": "2 汤匙黄油",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。将烤箱预热至 375 华氏度（190 摄氏度）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在一个中等大小的碗中将鸡蛋和牛奶一起搅拌。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "拌入面粉。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将黄油均匀地分入 12 杯松饼罐的杯子中，每杯约 1/2 茶匙。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将松饼罐放入预热的烤箱中，直至黄油融化并发出嘶嘶声，持续 2 到 3 分钟。从烤箱中取出，将面糊均匀地分布在每个杯子中​​。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "返回烤箱烘烤 5 分钟。将热量降低至 350 华氏度（175 摄氏度），然后烘烤约 25 分钟，直到膨化并呈金黄色，不要偷看。立即上菜。"
    }
  ],
