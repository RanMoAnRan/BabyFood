  "cover_image": "images/f0ff8729d82a534cccbc24eb32ae5ee9.webp",
  "nutrition_tip": "这个南瓜巧克力曲奇饼配方创造了一种类似蛋糕的曲奇饼，其中包括……",
  "ingredients": [
    {
      "name": "1 杯罐装南瓜",
      "amount": ""
    },
    {
      "name": "1 杯白糖",
      "amount": ""
    },
    {
      "name": "0.5 杯植物油",
      "amount": ""
    },
    {
      "name": "1 个大鸡蛋",
      "amount": ""
    },
    {
      "name": "1 茶匙小苏打",
      "amount": ""
    },
    {
      "name": "1 茶匙牛奶",
      "amount": ""
    },
    {
      "name": "2 杯通用面粉",
      "amount": ""
    },
    {
      "name": "2 茶匙泡打粉",
      "amount": ""
    },
    {
      "name": "2 茶匙肉桂粉",
      "amount": ""
    },
    {
      "name": "0.5 茶匙盐",
      "amount": ""
    },
    {
      "name": "2 杯半甜巧克力片",
      "amount": ""
    },
    {
      "name": "0.5 杯核桃碎",
      "amount": ""
    },
    {
      "name": "1 汤匙香草精",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 350 华氏度（175 摄氏度）。在烤盘上涂上油脂；放在一边。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在一个大碗中将南瓜、糖、油和鸡蛋混合在一起。将小苏打和牛奶在一个小碗中搅拌直至小苏打溶解。加入南瓜混合物中搅拌直至充分混合。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将面粉、泡打粉、肉桂和盐放入一个中等大小的碗中搅拌。将面粉混合物加入南瓜混合物中，直至充分混合。加入巧克力片、核桃和香草精，直至完全混合。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "一勺一勺地滴在准备好的烤盘上；在预热的烤箱中烘烤约 10 分钟，直至金黄变硬。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "放在烤盘上冷却2分钟；转移到金属架上完全冷却。"
    }
  ],
