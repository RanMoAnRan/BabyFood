{
  "id": "fb9012266470f38df7c9b846268f40e5",
  "title": "酸橙派",
  "min_age_month": 12,
  "tags": [
    "Dessert",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 80,
  "cover_image": "images/1553867e0d3a0ba26fe5b23b25722165.webp",
  "nutrition_tip": "这个关键的酸橙派馅料是用酸奶油和甜炼乳制成的……",
  "ingredients": [
    {
      "name": "3 杯甜炼乳",
      "amount": ""
    },
    {
      "name": "0.75 杯酸橙汁",
      "amount": ""
    },
    {
      "name": "0.5 杯酸奶油",
      "amount": ""
    },
    {
      "name": "1 汤匙磨碎的酸橙皮",
      "amount": ""
    },
    {
      "name": "1 个（9 英寸）准备好的全麦饼干皮",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料并将烤箱预热至 350 华氏度（175 摄氏度）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将炼乳、酸橙汁、酸奶油和酸橙皮碎放入碗中；搅拌均匀。倒入全麦饼干皮；将馅饼放在烤盘上。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在预热好的烤箱中烘烤5到8分钟，直到馅饼表面出现微小的针孔气泡。馅料会摇晃但不会变成褐色。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将馅饼转移到金属架上冷却，然后在食用前将馅饼放入冰箱中彻底冷却，大约需要 1 小时。如果需要，可以用酸橙片和生奶油装饰。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "上菜并享用！"
    }
  ],
