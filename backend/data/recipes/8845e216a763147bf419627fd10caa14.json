{
  "id": "8845e216a763147bf419627fd10caa14",
  "title": "果冻戳蛋糕",
  "min_age_month": 12,
  "tags": [
    "Dessert",
    "American",
    "Southern"
  ],
  "difficulty": 1,
  "time_cost": 130,
  "cover_image": "images/8992a178e6679499769132a7da1c4b50.webp",
  "nutrition_tip": "这个果冻戳蛋糕是用草莓果冻做的，上面有奶油，很讨喜……",
  "ingredients": [
    {
      "name": "1 包（15.25 盎司）黄色蛋糕粉",
      "amount": ""
    },
    {
      "name": "1 杯水",
      "amount": ""
    },
    {
      "name": "3 个鸡蛋",
      "amount": ""
    },
    {
      "name": "0.33333334326744 杯植物油",
      "amount": ""
    },
    {
      "name": "0.25 杯冷水",
      "amount": ""
    },
    {
      "name": "1 包（3 盎司）草莓味明胶混合物（例如 Jell-O®）",
      "amount": ""
    },
    {
      "name": "1 杯开水",
      "amount": ""
    },
    {
      "name": "1 个（8 盎司）容器搅打配料（例如 Cool Whip®）",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集原料，将烤箱预热至 350 华氏度（175 摄氏度），并在 9x13 英寸烤盘上涂抹油脂。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将蛋糕粉、水、鸡蛋和油放入一个大碗中；用电动搅拌机低速搅拌直至湿润。将速度调至中速，搅拌 2 分钟。将面糊倒入准备好的烤盘中。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在预热的烤箱中烘烤 24 到 29 分钟，直到插入中心的牙签拔出来时是干净的。让其完全冷却，至少 30 分钟。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将冷水倒入碗中。在上面撒上明胶混合物。静置约 1 分钟直至变软。加入沸水并不断搅拌直至颗粒完全溶解。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "用叉子或叉子在蛋糕上戳洞；将明胶混合物倒入孔中。将蛋糕冷藏约 1 小时或最多 6 小时，直至明胶凝固。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "将搅打好的配料涂在蛋糕上。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "享受吧！"
    }
  ],
