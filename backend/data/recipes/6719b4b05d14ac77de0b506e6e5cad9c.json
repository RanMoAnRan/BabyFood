  "title": "叉烧（中国叉烧）",
  "min_age_month": 12,
  "tags": [
    "Dinner",
    "Chinese",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 165,
  "cover_image": "images/f71e504fe4e6fed7952b859e216a6893.webp",
  "nutrition_tip": "中国叉烧肉很容易在家里用猪里脊肉烧烤......",
  "ingredients": [
    {
      "name": "0.5 杯酱油",
      "amount": ""
    },
    {
      "name": "0.333 杯蜂蜜",
      "amount": ""
    },
    {
      "name": "0.333 杯番茄酱",
      "amount": ""
    },
    {
      "name": "0.333 杯红糖",
      "amount": ""
    },
    {
      "name": "0.25 杯中国黄酒",
      "amount": ""
    },
    {
      "name": "2 汤匙海鲜酱",
      "amount": ""
    },
    {
      "name": "2汤匙红豆腐",
      "amount": ""
    },
    {
      "name": "1茶匙五香粉",
      "amount": ""
    },
    {
      "name": "2 块（1 磅）猪里脊肉",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将酱油、蜂蜜、番茄酱、红糖、米酒、海鲜酱、红豆花和五香粉放入锅中，用中低火搅拌。煮并搅拌 2 至 3 分钟，直至完全混合并稍微温热。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "同时，将每块猪里脊肉纵向切成 1 ½ 至 2 英寸厚的条。将猪肉条放入可重新密封的大塑料袋中。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将腌料和猪肉一起倒入袋子中。挤出袋子中的空气，密封，然后转动袋子几次，直到猪肉充分裹上一层。在冰箱里腌制2小时至过夜。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "准备做饭时，将木炭烤架预热至中高火，并在炉排上涂上少许油。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "将猪肉从腌料中取出，摇匀以除去多余的液体。将剩余的腌料放在一边备用。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "将热煤耙成木炭炉排两侧相等的两堆。将一小容器水添加到炉排中。将猪肉条放在炉排中央进行间接烹饪。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "用间接加热方式烹饪猪肉，定期翻转并根据需要涂油，直到插入中心的即时读数温度计读数至少为 145 华氏度（63 摄氏度），持续 30 分钟或更长时间。"
    },
    {
      "step_index": 9,
      "img": "",
      "text": "趁热享用吧！"
    }
  ],
