  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将培根放入一个又大又深的煎锅中。用中高火煮至均匀棕色。取出培根，放在一边。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在热培根油中煮洋葱直至变软。加入卷心菜，加入水、糖、盐和胡椒粉搅拌。煮大约 15 分钟，直到卷心菜枯萎。拌入培根。食用前撒上醋。"
    }
