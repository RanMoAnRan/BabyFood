  "id": "d7551491dbd88a3f8f80f3169bd8f6f5",
  "title": "巧克力松饼",
  "min_age_month": 12,
  "tags": [
    "Snack",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 30,
  "cover_image": "images/f344b8658559ac54c07f9bac55137143.webp",
  "nutrition_tip": "这些巧克力片松饼湿润、嫩滑，巧克力味可口。你…",
  "ingredients": [
    {
      "name": "0.75 杯牛奶",
      "amount": ""
    },
    {
      "name": "0.33333334326744 杯植物油",
      "amount": ""
    },
    {
      "name": "1 个鸡蛋",
      "amount": ""
    },
    {
      "name": "2 杯通用面粉",
      "amount": ""
    },
    {
      "name": "0.5 杯白糖",
      "amount": ""
    },
    {
      "name": "3 茶匙泡打粉",
      "amount": ""
    },
    {
      "name": "0.5 茶匙盐",
      "amount": ""
    },
    {
      "name": "0.75 杯迷你半甜巧克力片",
      "amount": ""
    },
    {
      "name": "3汤匙白糖",
      "amount": ""
    },
    {
      "name": "2 汤匙红糖",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。将烤箱预热至 400 华氏度（200 摄氏度）。在 12 杯松饼罐上涂上油脂，或在杯子上铺上纸垫。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将牛奶、油和鸡蛋放入一个小碗中，直至充分混合。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将面粉、1/2 杯糖、泡打粉和盐混合在一个大碗中，在中间挖一个洞。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将牛奶混合物倒入井中，搅拌至面糊刚好混合；拌入巧克力片。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将面糊舀入准备好的松饼杯中，每个杯装满 2/3。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "将 1 ½ 汤匙白糖和 1 汤匙红糖放入小碗中；撒在松饼的顶部。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "在预热的烤箱中烘烤约 18 至 20 分钟，直至轻压时顶部弹回。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "在罐中短暂冷却，然后转移到金属架上。趁热或完全凉后食用。"
    }
  ],
