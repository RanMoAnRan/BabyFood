  "cover_image": "images/20fcaab2710fa4fa2ba12f37c8b7371d.webp",
  "nutrition_tip": "这个快速简单的秋收饼干食谱是用燕麦、核桃和……制成的",
  "ingredients": [
    {
      "name": "1.5 杯通用面粉",
      "amount": ""
    },
    {
      "name": "1 茶匙泡打粉",
      "amount": ""
    },
    {
      "name": "1 茶匙南瓜派香料",
      "amount": ""
    },
    {
      "name": "0.25 茶匙盐",
      "amount": ""
    },
    {
      "name": "1 杯无盐黄油，软化",
      "amount": ""
    },
    {
      "name": "0.5 杯红糖",
      "amount": ""
    },
    {
      "name": "0.5 杯白糖",
      "amount": ""
    },
    {
      "name": "2 个大鸡蛋",
      "amount": ""
    },
    {
      "name": "0.5 茶匙橙提取物",
      "amount": ""
    },
    {
      "name": "0.5 茶匙香草精",
      "amount": ""
    },
    {
      "name": "2.5 杯燕麦片",
      "amount": ""
    },
    {
      "name": "1 杯蔓越莓干",
      "amount": ""
    },
    {
      "name": "0.5 杯核桃碎",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 350 华氏度（175 摄氏度）。在 2 个烤盘上铺上羊皮纸。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将面粉、泡打粉、南瓜派香料和盐放入碗中搅拌。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "黄油、红糖、白糖放入碗中，用电动搅拌机搅打至光滑；加入鸡蛋、橙子提取物和香草精，搅拌均匀。逐渐加入面粉混合物直至混合。加入燕麦、蔓越莓和核桃，搅拌直至完全混合。将面团分成圆形茶匙，间隔 2 英寸，放在准备好的烤盘上。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在预热的烤箱中烘烤 8 到 10 分钟，直至边缘呈金黄色。将饼干放在烤盘上短暂冷却，然后转移到金属架上完全冷却。"
    }
  ],
