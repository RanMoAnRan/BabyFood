  "title": "三浸炸鸡",
  "min_age_month": 8,
  "tags": [
    "Dinner",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 45,
  "cover_image": "images/fef21939938026f0ea242e237ec4008c.webp",
  "nutrition_tip": "这种炸鸡面糊可以做出最脆、最辣的自制炸鸡……",
  "ingredients": [
    {
      "name": "1 夸脱煎炸用植物油",
      "amount": ""
    },
    {
      "name": "4.333 杯通用面粉，分开",
      "amount": ""
    },
    {
      "name": "1.5 汤匙蒜盐",
      "amount": ""
    },
    {
      "name": "1 汤匙黑胡椒粉",
      "amount": ""
    },
    {
      "name": "1 汤匙辣椒粉",
      "amount": ""
    },
    {
      "name": "0.5 茶匙家禽调味料",
      "amount": ""
    },
    {
      "name": "1.5 杯啤酒，或根据需要",
      "amount": ""
    },
    {
      "name": "2 个蛋黄，打散",
      "amount": ""
    },
    {
      "name": "1 茶匙盐",
      "amount": ""
    },
    {
      "name": "0.25 茶匙黑胡椒粉",
      "amount": ""
    },
    {
      "name": "1 只（3 磅）整只鸡，切成块",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将油炸锅中的油加热至 350 华氏度（175 摄氏度）。将 3 杯面粉、蒜盐、1 汤匙胡椒粉、辣椒粉和家禽调味料放入一个中型碗中混合。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将 1 1/2 杯啤酒、剩余 1 1/3 杯面粉、蛋黄、盐和 1/4 茶匙胡椒粉放入另一个碗中搅拌；如果面糊太稠，可以加点啤酒稀释。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "用少许水润湿鸡块，然后浸入调味面粉混合物中。抖掉多余的部分，浸入啤酒面糊中，然后再次浸入调味过的面粉混合物中。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "小心地将鸡块分批放入热油中。煎约 15 至 18 分钟，直至酥脆并呈褐色。插入骨头附近的即时读数温度计的读数应为 165 华氏度（74 摄氏度）。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "转移到衬有纸巾的盘子上沥干。享受！"
    }
  ],
