{
  "id": "a1fb98c64c22c5778226d925a868ea4b",
  "title": "惠灵顿牛肉",
  "min_age_month": 8,
  "tags": [
    "Dinner",
    "British",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 70,
  "cover_image": "images/6160aa04f0a2ba1b1bd4f5ccf968824c.webp",
  "nutrition_tip": "学习如何用这个包裹牛里脊肉和......的食谱制作惠灵顿牛肉",
  "ingredients": [
    {
      "name": "2.5 磅牛里脊肉",
      "amount": ""
    },
    {
      "name": "4 汤匙黄油，软化，分开",
      "amount": ""
    },
    {
      "name": "2 汤匙黄油",
      "amount": ""
    },
    {
      "name": "1 个洋葱，切碎",
      "amount": ""
    },
    {
      "name": "0.5 杯切片新鲜蘑菇",
      "amount": ""
    },
    {
      "name": "2 盎司肝酱",
      "amount": ""
    },
    {
      "name": "盐和胡椒调味",
      "amount": ""
    },
    {
      "name": "1 包（17.5 盎司）冷冻酥皮，解冻",
      "amount": ""
    },
    {
      "name": "1 个大蛋黄，打散",
      "amount": ""
    },
    {
      "name": "1 罐（10.5 盎司）牛肉汤",
      "amount": ""
    },
    {
      "name": "2 汤匙红酒",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 425 华氏度（220 摄氏度）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将牛里脊肉放入烤盘中。将 2 汤匙软化黄油涂在牛肉上。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在预热的烤箱中烘烤 10 至 15 分钟直至变成棕色。将牛肉从锅中取出，保留锅汁；让牛肉完全冷却。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将烤箱温度提高至 450 华氏度（230 摄氏度）。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "在煎锅中用中火融化 2 汤匙黄油。用黄油炒洋葱和蘑菇 5 分钟。从火上移开并冷却。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "将肉酱和剩余的 2 汤匙软化黄油一起放入碗中混合；用盐和胡椒调味。将肉酱混合物涂在牛肉上。上面放上洋葱和蘑菇混合物。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "将酥皮面团擀成约 1/4 英寸厚，将牛肉放在中间。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "折叠并密封所有边缘，确保接缝不要太厚。将牛肉放入 9x13 英寸的烤盘中，在面团顶部切几条缝，刷上蛋黄。"
    },
    {
      "step_index": 9,
      "img": "",
      "text": "放入预热好的烤箱烤10分钟。将热量降至 425 华氏度（220 摄氏度）并继续烘烤 10 到 15 分钟，直至糕点变成浓郁的金黄色。对于中等稀度，插入中心的即时读数温度计的读数应在 122 至 130 华氏度（50 至 54 摄氏度）之间。放在一边休息。"
    },
    {
      "step_index": 10,
      "img": "",
      "text": "同时，将保留的锅汁放入小平底锅中，用高温加热。加入牛肉汤和红酒搅拌均匀；煮约5分钟，直至稍微减少。过滤并与牛肉一起食用。"
    },
    {
      "step_index": 11,
      "img": "",
      "text": "趁热享用吧！"
    }
  ],
