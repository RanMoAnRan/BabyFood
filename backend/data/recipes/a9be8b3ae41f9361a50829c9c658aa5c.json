  "nutrition_tip": "This Cobb salad is packed with crispy bacon, hard-boiled eggs, chicken, tomatoes…",
  "ingredients": [
    {
      "name": "6 slices bacon",
      "amount": ""
    },
    {
      "name": "3 eggs",
      "amount": ""
    },
    {
      "name": "1 head iceberg lettuce, shredded",
      "amount": ""
    },
    {
      "name": "3 cups chopped, cooked chicken meat",
      "amount": ""
    },
    {
      "name": "2 tomatoes, seeded and chopped",
      "amount": ""
    },
    {
      "name": "0.75 cup blue cheese, crumbled",
      "amount": ""
    },
    {
      "name": "3 green onions, chopped",
      "amount": ""
    },
    {
      "name": "1 avocado - peeled, pitted and diced",
      "amount": ""
    },
    {
      "name": "1 (8 ounce) bottle Ranch-style salad dressing",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "Place eggs in a saucepan and cover completely with cold water; bring to a boil, then cover and remove from heat. Let eggs sit for 10 to 12 minutes, then cool, peel and chop."
    },
    {
      "step_index": 2,
      "img": "",
      "text": "While the eggs are cooking, place bacon in a large, deep skillet. Cook over medium-high heat until evenly brown, 7 to 10 minutes. Drain, crumble, and set aside."
    },
    {
      "step_index": 3,
      "img": "",
      "text": "Divide shredded lettuce among individual plates. Arrange rows of bacon, eggs, chicken, tomatoes, blue cheese, green onions, and avocado on top."
    },
    {
      "step_index": 4,
      "img": "",
      "text": "Drizzle with dressing and enjoy!"
    }
  ],
