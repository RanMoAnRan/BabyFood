{
  "id": "a9be8b3ae41f9361a50829c9c658aa5c",
  "title": "科布沙拉",
  "min_age_month": 12,
  "tags": [
    "Salad",
    "American",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 30,
  "cover_image": "images/9d084d7bb558fb2d2c644e769a6dc1eb.webp",
  "nutrition_tip": "这道科布沙拉里有脆皮培根、煮鸡蛋、鸡肉、西红柿……",
  "ingredients": [
    {
      "name": "6 片培根",
      "amount": ""
    },
    {
      "name": "3 个鸡蛋",
      "amount": ""
    },
    {
      "name": "1 颗卷心生菜，切丝",
      "amount": ""
    },
    {
      "name": "3 杯切碎的熟鸡肉",
      "amount": ""
    },
    {
      "name": "2 个西红柿，去籽并切碎",
      "amount": ""
    },
    {
      "name": "0.75 杯蓝纹奶酪，碎",
      "amount": ""
    },
    {
      "name": "3 个葱，切碎",
      "amount": ""
    },
    {
      "name": "1 个牛油果 - 去皮、去核、切丁",
      "amount": ""
    },
    {
      "name": "1 瓶（8 盎司）牧场风格沙拉酱",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将鸡蛋放入平底锅中，并用冷水完全覆盖；煮沸，然后盖上盖子并远离火源。让鸡蛋静置 10 到 12 分钟，然后冷却、剥皮并切碎。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "煮鸡蛋时，将培根放入一个又大又深的煎锅中。用中高火煮 7 至 10 分钟，直至呈均匀棕色。沥干水分，压碎，放在一边。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将切碎的生菜分到各个盘子中。在上面放上一排培根、鸡蛋、鸡肉、西红柿、蓝纹奶酪、葱和鳄梨。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "淋上调料，尽情享受吧！"
    }
  ],
