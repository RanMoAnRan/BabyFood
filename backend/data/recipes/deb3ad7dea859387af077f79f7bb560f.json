  "nutrition_tip": "这种奶酪土豆和玉米杂烩食谱用文火炖乡村风格的牛奶肉汁混合物，……",
  "ingredients": [
    {
      "name": "2 汤匙人造黄油",
      "amount": ""
    },
    {
      "name": "1 杯切碎的芹菜",
      "amount": ""
    },
    {
      "name": "1 杯切碎的洋葱",
      "amount": ""
    },
    {
      "name": "2 罐（14.5 盎司）鸡汤",
      "amount": ""
    },
    {
      "name": "3 杯去皮切丁的土豆",
      "amount": ""
    },
    {
      "name": "1 罐（15 盎司）整粒玉米",
      "amount": ""
    },
    {
      "name": "1 罐（4 盎司）青辣椒丁",
      "amount": ""
    },
    {
      "name": "1 包（2.5 盎司）乡村风格肉汁混合物",
      "amount": ""
    },
    {
      "name": "2 杯牛奶",
      "amount": ""
    },
    {
