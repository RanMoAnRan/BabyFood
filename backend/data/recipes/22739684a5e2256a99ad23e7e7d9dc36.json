  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "在烤盘上铺上蜡纸。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将奶油糖果片和花生酱放入双锅顶部，盖上沸水。经常搅拌，用橡皮刮刀刮擦侧面以避免烧焦，直至融化，大约需要 5 分钟。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将面条和花生搅拌成融化的花生酱混合物。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "用叉子将面团放到准备好的托盘上。在室温下冷却直至凝固。"
    }
