  "title": "无面粉巧克力蛋糕 II",
  "min_age_month": 12,
  "tags": [
    "Dessert",
    "American",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 100,
  "cover_image": "images/60c68e3ea416b3f42fdf38c5fdddb622.webp",
  "nutrition_tip": "非常适合巧克力爱好者！端上这款浓密而松软的蛋糕，上面撒满了糖果……",
  "ingredients": [
    {
      "name": "4块（1盎司）半甜巧克力块，切碎",
      "amount": ""
    },
    {
      "name": "0.5 杯黄油",
      "amount": ""
    },
    {
      "name": "0.75 杯白糖",
      "amount": ""
    },
    {
      "name": "0.5 杯可可粉",
      "amount": ""
    },
    {
      "name": "3 个大鸡蛋，打散",
      "amount": ""
    },
    {
      "name": "1 茶匙香草精",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 300 华氏度（150 摄氏度）。在8英寸的圆形蛋糕盘上涂上油脂，撒上可可粉。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在双层锅炉的顶部，用小火煮沸水，融化巧克力和黄油。从火上移开，加入糖、可可粉、鸡蛋和香草精搅拌。倒入准备好的平底锅中。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在预热的烤箱中烘烤30分钟。在锅中冷却 10 分钟，然后放在金属架上完全冷却，需要 45 分钟到 1 小时。"
    }
  ],
