  "nutrition_tip": "这个墨西哥披萨食谱的特点是层层酥脆的玉米饼和调味的地面......",
  "ingredients": [
    {
      "name": "0.5 磅碎牛肉",
      "amount": ""
    },
    {
      "name": "1 个中等大小的洋葱，切丁",
      "amount": ""
    },
    {
      "name": "1 瓣大蒜，切碎",
      "amount": ""
    },
    {
      "name": "1 汤匙辣椒粉",
      "amount": ""
    },
    {
      "name": "1 茶匙孜然粉",
      "amount": ""
    },
    {
      "name": "0.5 茶匙辣椒粉",
      "amount": ""
    },
    {
      "name": "0.5 茶匙盐",
      "amount": ""
    },
    {
      "name": "0.5 茶匙黑胡椒",
      "amount": ""
    },
    {
      "name": "1 罐（16 盎司）炸豆泥",
      "amount": ""
    },
    {
      "name": "4 个（10 英寸）玉米饼",
      "amount": ""
    },
    {
      "name": "0.5 杯莎莎酱",
      "amount": ""
    },
    {
      "name": "1 杯切达干酪丝",
      "amount": ""
    },
    {
      "name": "1 杯蒙特利杰克奶酪丝",
      "amount": ""
    },
    {
      "name": "2 个葱，切碎",
      "amount": ""
    },
    {
      "name": "2 个罗马（李子）西红柿，切丁",
      "amount": ""
    },
    {
      "name": "0.25 杯墨西哥辣椒薄片",
      "amount": ""
    },
    {
