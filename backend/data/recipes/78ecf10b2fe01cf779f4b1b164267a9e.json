  "title": "健康胡萝卜蛋糕饼干",
  "min_age_month": 12,
  "tags": [],
  "difficulty": 1,
  "time_cost": 0,
  "cover_image": "images/537ed08b7d8fa75c3e4933bf763fa5d3.webp",
  "nutrition_tip": "与家人和朋友分享这个健康的胡萝卜蛋糕饼干食谱。孩子们…",
  "ingredients": [],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱加热至 350 度。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在一个大碗中，将糖、油、苹果酱、鸡蛋和香草精充分混合。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在另一个碗中，将干成分搅拌在一起。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将干成分混合成湿混合物。拌入葡萄干和胡萝卜。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将一茶匙滴在涂有油脂的烤盘上。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "烘烤 12 至 15 分钟直至金黄色。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "存放在密封容器中。"
    }
  ],
