  "nutrition_tip": "这个巧克力西葫芦饼干食谱可能听起来像是一个奇怪的组合，但是......",
  "ingredients": [
    {
      "name": "0.5 杯黄油味起酥油",
      "amount": ""
    },
    {
      "name": "0.5 杯白糖",
      "amount": ""
    },
    {
      "name": "0.5 杯红糖",
      "amount": ""
    },
    {
      "name": "1 个鸡蛋",
      "amount": ""
    },
    {
      "name": "1 茶匙香草精",
      "amount": ""
    },
    {
      "name": "2.25 杯通用面粉",
      "amount": ""
    },
    {
      "name": "0.33300000429153 杯不加糖可可粉",
      "amount": ""
    },
    {
      "name": "1 茶匙小苏打",
      "amount": ""
    },
    {
      "name": "0.5 茶匙盐",
      "amount": ""
    },
    {
      "name": "1.75 杯磨碎的西葫芦",
      "amount": ""
    }
