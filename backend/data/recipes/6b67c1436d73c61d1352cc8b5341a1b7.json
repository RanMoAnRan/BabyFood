  ],
  "difficulty": 1,
  "time_cost": 85,
  "cover_image": "images/d363a02b369a3e2443bc40cd593ed71c.webp",
  "nutrition_tip": "这种鸡肉腌料很容易混合成美味、嫩滑、多汁的烤鸡……",
  "ingredients": [
    {
      "name": "0.66666668653488 杯 橄榄油",
      "amount": ""
    },
    {
      "name": "0.66666668653488 杯 低钠酱油",
      "amount": ""
    },
    {
      "name": "0.25 杯柠檬汁",
      "amount": ""
    },
    {
      "name": "2 汤匙液体烟熏调味料",
      "amount": ""
    },
    {
      "name": "2 汤匙 辣棕色芥末",
      "amount": ""
    },
    {
      "name": "2 茶匙黑胡椒粉",
      "amount": ""
    },
    {
      "name": "2 茶匙大蒜粉",
      "amount": ""
    },
    {
      "name": "4 块去皮去骨鸡胸肉",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在一个大玻璃或陶瓷碗中将橄榄油、酱油、柠檬汁、烟熏液、芥末、胡椒和大蒜粉混合在一起。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将鸡肉放入碗中，翻面涂上腌料。盖上盖子并在冰箱中腌制1至4小时。为了获得最佳效果，腌制时间不要超过 4 小时。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将户外烤架预热至高温，并在烤架上涂上少许油。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将鸡肉从腌料中取出，抖掉多余的东西。丢弃剩余的腌料。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "在预热的烤架上煮鸡肉，直至中心不再呈粉红色且汁液清澈，每面 6 至 8 分钟。插入中心的即时读数温度计读数应至少为 165 华氏度（74 摄氏度）。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "上菜并享用！"
    }
  ],
