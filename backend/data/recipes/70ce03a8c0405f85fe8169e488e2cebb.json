  "cover_image": "images/6e5bd41f9a5f35c2c214d2e69afd5e24.webp",
  "nutrition_tip": "这个烤球芽甘蓝配方可以产生完美嫩芽和酥脆的......",
  "ingredients": [
    {
      "name": "1.5 磅抱子甘蓝，修剪末端并去除黄叶",
      "amount": ""
    },
    {
      "name": "3 汤匙橄榄油",
      "amount": ""
    },
    {
      "name": "1 茶匙粗盐",
      "amount": ""
    },
    {
      "name": "0.5 茶匙现磨黑胡椒",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将架子放在烤箱中央。将烤箱预热至 400 华氏度（200 摄氏度）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将球芽甘蓝、油、盐和胡椒放入一个可重新密封的大塑料袋中。密封严实；摇匀以涂上涂层。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在烤盘上单层排列。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在预热的烤箱中烤 30 至 45 分钟，每 5 至 7 分钟摇晃一下平底锅，使其均匀褐变。根据需要减少热量以防止燃烧。抱子甘蓝的外皮应呈深棕色且酥脆。如果需要的话，加更多的盐调味。"
    }
  ],
