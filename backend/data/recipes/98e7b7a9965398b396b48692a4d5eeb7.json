{
  "id": "98e7b7a9965398b396b48692a4d5eeb7",
  "title": "波多黎各黄车前草肉砂锅",
  "min_age_month": 12,
  "tags": [],
  "difficulty": 1,
  "time_cost": 0,
  "cover_image": "images/d416badad3a2528e7af4cff6d57fe425.webp",
  "nutrition_tip": "大蕉的天然甜味增强了波多黎各的风味......",
  "ingredients": [],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 350°F。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将碎牛肉放入大锅中煎至棕色。沥干脂肪并添加剩余的馅料。中火煮5分钟。放在一边。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将去皮的车前草放入 10 杯水中煮至变软，然后沥干。在一个大碗中，捣碎车前草，然后加入橄榄油。搅拌均匀，形成柔软的面团。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在另一个碗中，将蛋白搅打至起泡沫。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将一半车前草面团放入 11\" × 14\" 烤盘中。加入一层肉馅、蛋清和一半青豆。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "重复这些层，并在上面放最后一层车前草和蛋清。撒上马苏里拉奶酪。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "烘烤 20 分钟。切成12份。"
    }
  ],
