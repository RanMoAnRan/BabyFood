{
  "id": "8fb04ccd51456067cb42f4d0c25e8656",
  "title": "最好的软圣诞饼干",
  "min_age_month": 12,
  "tags": [
    "Dessert",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 155,
  "cover_image": "images/8f5ca7fd978501a2e13eae6747c755f0.webp",
  "nutrition_tip": "这个圣诞饼干食谱可以制作柔软、嫩滑的糖饼干，可以容纳……",
  "ingredients": [
    {
      "name": "3.75 杯通用面粉",
      "amount": ""
    },
    {
      "name": "1 茶匙泡打粉",
      "amount": ""
    },
    {
      "name": "0.5 茶匙盐",
      "amount": ""
    },
    {
      "name": "1.5 杯白糖",
      "amount": ""
    },
    {
      "name": "1 杯人造黄油，软化",
      "amount": ""
    },
    {
      "name": "2 个鸡蛋",
      "amount": ""
    },
    {
      "name": "2 茶匙香草精",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将面粉、发酵粉和盐一起筛入一个中等大小的碗中；放在一边。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在一个大碗中用电动搅拌机将糖和黄油搅拌至光滑。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将第一个鸡蛋打入黄油混合物中。将第二个鸡蛋与香草精一起打入混合物中；加入面粉混合物并搅拌直至面团完全混合。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将面团包起来放入冰箱冷藏2小时。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "将烤箱预热至 400 华氏度（200 摄氏度）。给两张饼干片涂上油脂。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "在干净的撒了面粉的表面上将面团擀成 1/4 英寸厚。使用圣诞饼干切刀切出形状；将它们排列在准备好的饼干片上。收集碎片并重复此步骤。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "在预热的烤箱中分批烘烤，直至边缘呈金黄色，大约需要 6 到 8 分钟。在烤盘上短暂冷却，然后移至金属架上完全冷却，然后再进行糖霜或装饰。"
    },
    {
      "step_index": 9,
      "img": "",
      "text": "上菜并享用！"
    }
  ],
