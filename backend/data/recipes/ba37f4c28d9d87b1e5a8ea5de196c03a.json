  "id": "ba37f4c28d9d87b1e5a8ea5de196c03a",
  "title": "指纹饼干",
  "min_age_month": 12,
  "tags": [
    "Dessert",
    "American",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 30,
  "cover_image": "images/92d2d162bd1d754bae700f916545ae77.webp",
  "nutrition_tip": "指纹饼干涂有脆核桃，里面填满了你最喜欢的j…",
  "ingredients": [
    {
      "name": "1 个大鸡蛋，分开，分开",
      "amount": ""
    },
    {
      "name": "0.5 杯黄油，软化",
      "amount": ""
    },
    {
      "name": "0.25 杯包装红糖",
      "amount": ""
    },
    {
      "name": "1 杯通用面粉",
      "amount": ""
    },
    {
      "name": "0.5 茶匙香草精",
      "amount": ""
    },
    {
      "name": "0.25 茶匙盐",
      "amount": ""
    },
    {
      "name": "0.25 杯切碎的核桃",
      "amount": ""
    },
    {
      "name": "0.66666668653488 杯 任意口味果酱",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将烤箱预热至 300 华氏度（150 摄氏度）。在两张饼干片上涂上油脂并放在一边。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在一个小碗中搅拌蛋清。将切碎的核桃放入另一个小碗中。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将黄油、红糖和蛋黄放入搅拌碗中，搅打至松软，约 2 分钟。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "加入面粉、香草精和盐；混合直至充分混合。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "将面团舀成 1 ½ 英寸的球。浸入蛋清中，然后在核桃中滚动直至涂上涂层。将 2 英寸间隔放置在准备好的饼干片上。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "在预热的烤箱中烘烤约5分钟，直至稍微膨化。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "从烤箱中取出饼干。用拇指或木勺的末端轻轻地在每块饼干的中心压出一个凹痕。用勺子将果酱放入每个拇指印中，将其填满。"
    },
    {
      "step_index": 9,
      "img": "",
      "text": "将饼干放回烤箱烘烤直至凝固，大约需要 8 分钟。"
    },
    {
      "step_index": 10,
      "img": "",
      "text": "从烤箱中取出并转移到金属架上完全冷却。"
    }
  ],
