  "nutrition_tip": "这种自制的意大利面酱配上新鲜的西红柿、洋葱、大蒜和香草，非常美味……",
  "ingredients": [
    {
      "name": "0.25 杯橄榄油",
      "amount": ""
    },
    {
      "name": "1 个洋葱，切碎",
      "amount": ""
    },
    {
      "name": "0.5 茶匙大蒜粉",
      "amount": ""
    },
    {
      "name": "4 磅新鲜西红柿，去皮并切碎",
      "amount": ""
    },
    {
      "name": "1 汤匙白糖",
      "amount": ""
    },
    {
      "name": "1 汤匙干罗勒",
      "amount": ""
    },
    {
      "name": "1 汤匙干欧芹",
      "amount": ""
    },
    {
      "name": "1 茶匙盐",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在大煎锅中用中火加热橄榄油。加入洋葱和蒜粉；煮约 5 分钟，搅拌直至洋葱半透明。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "加入西红柿、糖、罗勒、欧芹和盐；煮沸。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "小火慢炖，偶尔搅拌，直到酱汁变稠，需要 1 到 2 小时。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "趁热享用吧！"
    }
  ],
