  "id": "f785d20abad53128798df476042cae10",
  "title": "格兰诺拉麦片棒",
  "min_age_month": 12,
  "tags": [
    "Lunch",
    "Snack",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 100,
  "cover_image": "images/9256d0e7f50cb4ae5a428c9074a8ae78.webp",
  "nutrition_tip": "自制格兰诺拉麦片棒，配以烤椰子、燕麦、蜂蜜和花生酱。使…",
  "ingredients": [
    {
      "name": "烹饪喷雾",
      "amount": ""
    },
    {
      "name": "2 杯燕麦片",
      "amount": ""
    },
    {
      "name": "0.5 杯椰丝",
      "amount": ""
    },
    {
      "name": "0.5 杯蜂蜜",
      "amount": ""
    },
    {
      "name": "2 汤匙奶油花生酱",
      "amount": ""
    },
    {
      "name": "1 茶匙香草精",
      "amount": ""
    },
    {
      "name": "0.125 茶匙盐",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。将烤箱预热至 325 华氏度（165 摄氏度）。在9英寸方形烤盘上涂上油脂。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将燕麦和椰子均匀地铺在烤盘上。将燕麦和椰子放入预热的烤箱中烤至褐色，约 10 分钟；转移到一个大搅拌碗中。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在平底锅中用中低火混合蜂蜜、花生酱、香草和盐。煮并搅拌直至光滑。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将蜂蜜混合物倒在燕麦和椰子上。搅拌均匀。将混合物均匀地铺入准备好的烤盘中。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "在预热的烤箱中烘烤直至开始干燥，对于松脆的格兰诺拉麦片棒，烘烤时间约为 15 分钟，如果您喜欢嚼劲，则烘烤时间较短。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "切割前完全冷却。"
    }
  ],
