{
  "id": "163f5050eade0e9d0e461fe1e52aa60e",
  "title": "炸青豆",
  "min_age_month": 8,
  "tags": [
    "Appetizer",
    "Snack",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 20,
  "cover_image": "images/a358fa530f6662d740f30f2aecfccbb1.webp",
  "nutrition_tip": "这些炒青豆焯水，沾上面粉、鸡蛋和面包屑，...",
  "ingredients": [
    {
      "name": "1 磅新鲜青豆",
      "amount": ""
    },
    {
      "name": "0.5 杯通用面粉",
      "amount": ""
    },
    {
      "name": "1 个大鸡蛋",
      "amount": ""
    },
    {
      "name": "1 杯调味面包屑",
      "amount": ""
    },
    {
      "name": "2 杯植物油，或根据需要",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将一大锅水烧开；将豆子放入沸水中煮至呈亮绿色，约 2 分钟。立即将青豆转移到一碗冰水中以停止烹饪过程。沥干豆子并用纸巾拍干。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将油炸锅或大平底锅中的油加热至 350 华氏度（175 摄氏度）。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将面粉倒入碗中。在另一个碗中搅拌鸡蛋。将面包屑倒入第三个碗中。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将青豆裹上面粉；转移到打好的鸡蛋中并均匀地涂上一层。将涂有涂层的青豆压入面包屑中。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "分批工作，将裹有面包屑的青豆在热油中煎至金黄色，持续 3 至 5 分钟。将炸好的豆子转移到衬有纸巾的盘子上沥干。"
    }
  ],
