      "amount": ""
    },
    {
      "name": "1 个红甜椒，切成火柴棍",
      "amount": ""
    },
    {
      "name": "2 根胡萝卜，切成薄片",
      "amount": ""
    },
    {
      "name": "1 个葱，切碎",
      "amount": ""
    },
    {
      "name": "1 茶匙蒜末",
      "amount": ""
    },
    {
      "name": "2汤匙酱油",
      "amount": ""
    },
    {
