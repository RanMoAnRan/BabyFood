  "nutrition_tip": "通过这种简单而美味的方式在家中品尝 Carrabba 的意大利烧烤......",
  "ingredients": [
    {
      "name": "2 汤匙黄油",
      "amount": ""
    },
    {
      "name": "1 汤匙蒜末",
      "amount": ""
    },
    {
      "name": "1 汤匙 切碎的黄洋葱",
      "amount": ""
    },
    {
      "name": "0.5 杯干白葡萄酒",
      "amount": ""
    },
    {
      "name": "0.25 杯新鲜柠檬汁",
      "amount": ""
    },
    {
      "name": "0.66666668653488 杯冷黄油，切片",
      "amount": ""
    },
    {
      "name": "1.5 杯切碎的晒干西红柿",
      "amount": ""
    },
    {
      "name": "0.25 杯切碎的新鲜罗勒",
      "amount": ""
    },
    {
      "name": "0.5 茶匙粗盐",
      "amount": ""
    },
    {
      "name": "0.5 茶匙白胡椒粉",
      "amount": ""
    },
    {
      "name": "6 块去皮去骨鸡胸肉",
      "amount": ""
    },
    {
      "name": "1 汤匙特级初榨橄榄油，或根据需要",
      "amount": ""
    },
    {
      "name": "0.5 茶匙盐",
      "amount": ""
    },
    {
      "name": "0.5 茶匙黑胡椒粉",
      "amount": ""
    },
    {
      "name": "1 包（8 盎司）卡普里诺（羊奶）奶酪",
      "amount": ""
