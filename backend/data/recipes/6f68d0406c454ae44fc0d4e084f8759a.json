{
  "id": "6f68d0406c454ae44fc0d4e084f8759a",
  "title": "鸡肉辣酱玉米饼馅",
  "min_age_month": 12,
  "tags": [],
  "difficulty": 1,
  "time_cost": 0,
  "cover_image": "images/0ba168a2bd677dfd0d89eb385972d16d.webp",
  "nutrition_tip": "这些美味的玉米卷饼里装满了嫩鸡肉、卷心菜、洋葱和奶酪……",
  "ingredients": [],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 350°F。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "用不粘喷雾喷洒 9 x 12 英寸烤盘。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将鸡肉、洋葱、卷心菜和马苏里拉奶酪放入一个大碗中。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将约 ½ 杯鸡肉混合物放在玉米饼上，将混合物铺展到最大宽度上形成一条线。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将配料放入玉米饼中，然后放入烤盘中。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "在玉米饼上放上番茄，撒上帕尔马干酪。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "用铝箔覆盖。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "烘烤 30 分钟。"
    }
  ],
  "warnings": [],
