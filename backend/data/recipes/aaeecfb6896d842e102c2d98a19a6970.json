  "nutrition_tip": "火鸡粉和新鲜食材使这些烤玉米卷饼成为更健康的选择......",
  "ingredients": [
    {
      "name": "烹饪喷雾",
      "amount": ""
    },
    {
      "name": "2 茶匙橄榄油",
      "amount": ""
    },
    {
      "name": "1 磅碎火鸡胸肉",
      "amount": ""
    },
    {
      "name": "0.5 杯切碎的洋葱",
      "amount": ""
    },
    {
      "name": "1.5 茶匙孜然粉",
      "amount": ""
    },
    {
      "name": "0.25 茶匙墨西哥辣椒粉，或更多适量",
      "amount": ""
    },
    {
      "name": "1.5 杯中等大小的萝卜，修剪过",
      "amount": ""
    },
    {
      "name": "2 罐（10 盎司）墨西哥卷饼酱（例如 Old El Paso®）",
      "amount": ""
    },
    {
      "name": "16 个（6 英寸）玉米饼，加热",
      "amount": ""
    },
    {
      "name": "2 汤匙 pepitas（南瓜籽）",
      "amount": ""
    },
    {
