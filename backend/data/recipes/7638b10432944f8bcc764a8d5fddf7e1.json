  "title": "南瓜卷",
  "min_age_month": 6,
  "tags": [
    "Dessert",
    "American",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 55,
  "cover_image": "images/3a0ce21b82dc1a46a8a306a925a240e5.webp",
  "nutrition_tip": "这个南瓜卷食谱很容易制作成优雅的节日甜点，其特点是……",
  "ingredients": [
    {
      "name": "1 杯白糖",
      "amount": ""
    },
    {
      "name": "0.66666698455811 杯南瓜泥",
      "amount": ""
    },
    {
      "name": "3 个大鸡蛋，打散",
      "amount": ""
    },
    {
      "name": "0.5 茶匙肉桂粉",
      "amount": ""
    },
    {
      "name": "0.75 杯通用面粉",
      "amount": ""
    },
    {
      "name": "1 茶匙小苏打",
      "amount": ""
    },
    {
      "name": "8 盎司奶油干酪，软化",
      "amount": ""
    },
    {
      "name": "1 杯糖粉，或更多适量",
      "amount": ""
    },
    {
      "name": "2 汤匙黄油，软化",
      "amount": ""
    },
    {
      "name": "0.25 茶匙香草精",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 375 华氏度（190 摄氏度）。在 10x15 英寸果冻卷盘上涂抹油脂。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "制作蛋糕：在搅拌碗中将糖、南瓜泥、鸡蛋和肉桂一起搅拌，直至光滑并混合。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将面粉和小苏打在另一个碗中混合。将面粉混合物加入南瓜混合物中，搅拌直至光滑且没有面粉条纹。将面糊均匀地铺在准备好的平底锅中。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在预热的烤箱中烘烤 15 至 20 分钟，直至蛋糕轻轻一碰就会弹回。从烤箱中取出并冷却 5 分钟。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将蛋糕翻转到光滑的棉质（不是毛巾布）茶巾上。趁热，将蛋糕和毛巾从短边开始卷起来。将接缝面朝下放在金属架上完全冷却，大约需要 15 分钟。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "当蛋糕冷却时，制作馅料：将奶油芝士、糖粉、黄油和香草精放入搅拌碗中，搅拌至光滑。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "当蛋糕完全冷却后，展开并取出毛巾。将馅料铺在蛋糕上，一直铺到边缘。不用毛巾，再次将蛋糕卷起来。用保鲜膜包裹并冷藏直至可以食用。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "食用时，将糖粉筛在面包卷上，然后切成 10 份。"
    }
  ],
