  "nutrition_tip": "这个简单易做的苹果核桃面包配方是用全麦面粉制成的，应用...",
  "ingredients": [
    {
      "name": "1.75 杯白糖",
      "amount": ""
    },
    {
      "name": "0.75 杯植物油",
      "amount": ""
    },
    {
      "name": "3 个鸡蛋",
      "amount": ""
    },
    {
      "name": "0.25 杯苹果酱",
      "amount": ""
    },
    {
      "name": "1 茶匙香草精",
      "amount": ""
    },
    {
      "name": "2 杯通用面粉",
      "amount": ""
    },
    {
      "name": "1 杯全麦面粉",
      "amount": ""
    },
    {
      "name": "1 茶匙肉桂粉",
      "amount": ""
    },
    {
      "name": "1 茶匙小苏打",
      "amount": ""
    },
    {
      "name": "1 茶匙盐",
      "amount": ""
    },
    {
      "name": "3 杯苹果，去皮、去核、切块",
      "amount": ""
    },
    {
