  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 300 华氏度（150 摄氏度）。在两个 9x5 英寸的面包盘上涂抹少许油脂。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将糖、油、鸡蛋、苹果酱和香草精放入碗中混合。将中筋面粉、全麦面粉、肉桂、小苏打和盐过筛到另一个碗中；加入糖混合物中搅拌，直至完全混合。拌入苹果和核桃。将面糊分装在准备好的平底锅之间。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在预热的烤箱中烘烤约 70 分钟，直到插入中心的刀取出来时是干净的。"
    }
  ],
