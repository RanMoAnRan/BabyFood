{
  "id": "6f5528173a7adf78a5a0bcf51a156d8d",
  "title": "超级快的厚实番茄酱",
  "min_age_month": 12,
  "tags": [],
  "difficulty": 1,
  "time_cost": 0,
  "cover_image": "images/a8c2afa7329a7eee593075a416277bc7.webp",
  "nutrition_tip": "在全麦面食上享用这种快速、厚实的番茄酱。",
  "ingredients": [],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "在一个中型平底锅中，用中火加热橄榄油和大蒜。煮至软，但不要变成棕色（约 30 秒）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "加入红辣椒丁，继续煮 2-3 分钟，直到辣椒开始发出嘶嘶声。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "加入番茄、番茄汁、罗勒和胡椒。煮沸。煮10分钟，或直到酱汁稍微变稠。 （挑食者可将酱汁打成泥。）"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "立即使用。或者，在密封容器中冷藏 3-5 天或冷冻 1-2 个月。"
    }
  ],
  "warnings": [],
