  "id": "44c1210e353efc4679bc134d85b03c16",
  "title": "炒西葫芦",
  "min_age_month": 12,
  "tags": [
    "Dinner",
    "Side Dish",
    "Southern"
  ],
  "difficulty": 1,
  "time_cost": 35,
  "cover_image": "images/b4bc708820a38bcb3239b623c2d280c6.webp",
  "nutrition_tip": "这道油炸西葫芦和南瓜配洋葱，配有调味玉米粉……",
  "ingredients": [
    {
      "name": "2 个西葫芦，切成四等份并切片",
      "amount": ""
    },
    {
      "name": "1 个洋葱，切成圈",
      "amount": ""
    },
    {
      "name": "0.5 杯通用面粉",
      "amount": ""
    },
    {
      "name": "0.5 杯玉米粉",
      "amount": ""
    },
    {
      "name": "0.5 茶匙盐",
      "amount": ""
    },
    {
      "name": "0.5 茶匙黑胡椒粉",
      "amount": ""
    },
    {
      "name": "0.25 茶匙大蒜粉",
      "amount": ""
    },
    {
      "name": "1 杯煎炸植物油",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将西葫芦和洋葱放入一个大碗中。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将面粉、玉米粉、盐、胡椒粉和大蒜粉放入小碗中混合，直至充分混合。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将面粉混合物倒在西葫芦混合物上；盖上碗并摇晃直至蔬菜均匀地涂上。让涂有涂层的蔬菜静置约 30 分钟，直到面粉混合物变得稍微湿润并粘在蔬菜上。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在大煎锅中用中高温加热油。将蔬菜分批放入热油中炸至金黄色酥脆，根据需要翻转以使其受热均匀。食用前用纸巾短暂沥干。"
    }
  ],
