  ],
  "difficulty": 1,
  "time_cost": 50,
  "cover_image": "images/666b1e8ef43851f5a29f0c06fbc7570d.webp",
  "nutrition_tip": "这个简单的“驯鹿食物”用脆脆的饼干制作零食混合食谱很有趣……",
  "ingredients": [
    {
      "name": "1 包（20 盎司）微型椒盐卷饼",
      "amount": ""
    },
    {
      "name": "1 包（17.5 盎司）脆脆玉米麦片方块（例如 Corn Chex®）",
      "amount": ""
    },
    {
      "name": "1 罐（16 盎司）咸干烤花生",
      "amount": ""
    },
    {
      "name": "1 包（14 盎司）包衣牛奶巧克力块（例如 M&M's®）",
      "amount": ""
    },
    {
      "name": "24 盎司白巧克力，切碎",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "用蜡纸覆盖柜台空间的大面积并用胶带粘住。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将椒盐卷饼、玉米麦片、花生和糖衣牛奶巧克力块放入一个大碗中混合。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将白巧克力放入双锅顶部，用沸水融化，经常搅拌，并用橡皮刮刀刮擦侧面，以免烧焦。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将融化的白巧克力倒在椒盐卷饼混合物上；搅拌均匀。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将混合物快速转移到准备好的蜡纸上并铺成薄层；让其完全冷却，至少 30 分钟。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "分成碎片并存放在密封容器中。"
    }
  ],
