{
  "id": "2b41eb1ee4cf8f8f2b4ed3ecd80cb619",
  "title": "咖喱鸡卷",
  "min_age_month": 12,
  "tags": [],
  "difficulty": 1,
  "time_cost": 0,
  "cover_image": "images/9b25fddf40ea38873bccb221f6511d91.webp",
  "nutrition_tip": "您可以在各种食谱中使用咖喱粉。在这个食谱中，它添加了……",
  "ingredients": [],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "用肥皂和水洗手至少 20 秒。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在一个中等大小的碗中，将酸奶和咖喱粉混合。搅拌直至充分混合。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "使用橡皮刮刀，拌入鸡肉、苹果和葡萄干（见注释）。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将 ½ 杯鸡肉沙拉放在每个玉米饼的中心。将玉米饼的每一面折叠起来，然后卷起来。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将接缝面朝下放在切板上并切成两半。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "服务两半。"
    }
  ],
