  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在大汤锅中用中高火加热橄榄油；将洋葱和大蒜煮 2 至 3 分钟，直至变软。加入羽衣甘蓝，煮约 2 分钟直至枯萎。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "加入水、土豆、豆类、西红柿、蔬菜汤、欧芹和意大利调味料。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "煮沸，然后转小火，煮约 25 分钟，直至土豆煮熟。用盐和胡椒调味。"
    }
  ],
