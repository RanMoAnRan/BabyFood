  "title": "一锅意大利面",
  "min_age_month": 12,
  "tags": [],
  "difficulty": 1,
  "time_cost": 0,
  "cover_image": "images/527258600c6d646e807b999139384079.webp",
  "nutrition_tip": "这个奶酪意大利面食谱很容易做，孩子们喜欢它！",
  "ingredients": [],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将肉和洋葱放入大煎锅中，用中火加热（电煎锅中为 300 度）。排出脂肪。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "加入水、番茄酱和香料搅拌。煮沸。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "加入意大利面条，盖上锅盖，煮 10-15 分钟，经常搅拌以防止粘连。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "当意大利面变软时，在上面放上磨碎的奶酪。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "在 2 小时内将剩菜冷藏。"
    }
  ],
