{
  "id": "8e0c6c639f1b452e0abc779a0742351c",
  "title": "芦笋巴马干酪",
  "min_age_month": 12,
  "tags": [],
  "difficulty": 1,
  "time_cost": 0,
  "cover_image": "images/2fdc942b057dc8295ae48aa97f98d06e.webp",
  "nutrition_tip": "享用新鲜出炉的奶酪芦笋帕尔马干酪。",
  "ingredients": [],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 400 华氏度。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将芦笋放入浅烤盘中。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "沥干蘑菇，保留液体。将一半蘑菇切碎。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "用油煮洋葱直至变软。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "加入面粉和盐，搅拌均匀。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "加入牛奶和蘑菇液搅拌。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "煮至变稠，不断搅拌。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "添加切碎的蘑菇。"
    },
    {
      "step_index": 9,
      "img": "",
      "text": "将酱汁倒在芦笋上，撒上奶酪。将剩余的蘑菇放在上面，撒上奶酪。将剩余的蘑菇放在上面。"
    },
    {
      "step_index": 10,
      "img": "",
      "text": "烘烤 30 到 40 分钟，或直至芦笋变软。"
    }
  ],
  "warnings": [],
