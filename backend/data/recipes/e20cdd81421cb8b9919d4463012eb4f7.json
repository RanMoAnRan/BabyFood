    },
    {
      "name": "2 包（8 盎司）奶油干酪，软化",
      "amount": ""
    },
    {
      "name": "1 个（12 盎司）容器冷冻搅打配料（例如 Cool Whip®），解冻",
      "amount": ""
    },
    {
      "name": "1 杯白糖",
