  "nutrition_tip": "烤鸡肉沙爹串，用嫩鸡肉腌制在美味的…",
  "ingredients": [
    {
      "name": "2 汤匙奶油花生酱",
      "amount": ""
    },
    {
      "name": "0.5 杯酱油",
      "amount": ""
    },
    {
      "name": "0.5 杯柠檬汁或酸橙汁",
      "amount": ""
    },
    {
      "name": "1 汤匙红糖",
      "amount": ""
    },
    {
      "name": "2 汤匙咖喱粉",
      "amount": ""
    },
    {
      "name": "2 瓣大蒜，切碎",
      "amount": ""
    },
    {
      "name": "1 茶匙辣椒酱",
      "amount": ""
    },
    {
      "name": "6 块去皮去骨鸡胸肉 - 切成方块",
      "amount": ""
    },
    {
