  "nutrition_tip": "这道奶油芹菜汤配上胡萝卜、洋葱和白胡椒，味道浓郁……",
  "ingredients": [
    {
      "name": "3 夸脱鸡汤",
      "amount": ""
    },
    {
      "name": "3 磅芹菜，粗切碎",
      "amount": ""
    },
    {
      "name": "0.5 磅胡萝卜，切丝",
      "amount": ""
    },
    {
      "name": "0.5 磅洋葱，切碎",
      "amount": ""
    },
    {
      "name": "1 杯通用面粉",
      "amount": ""
    },
    {
      "name": "1 汤匙盐",
      "amount": ""
    },
    {
      "name": "1 茶匙白胡椒粉",
      "amount": ""
    },
    {
      "name": "3 夸脱热牛奶",
      "amount": ""
    },
    {
      "name": "1 杯人造黄油",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将鸡汤倒入大锅中，煮沸。将芹菜、胡萝卜和洋葱加入锅中。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将面粉、盐、胡椒粉和牛奶放入碗中搅拌；与黄油一起加入锅中。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "煮约10分钟直至变稠。从火上移开，用浸入式搅拌机将蔬菜打成泥放入汤中。"
    }
  ],
