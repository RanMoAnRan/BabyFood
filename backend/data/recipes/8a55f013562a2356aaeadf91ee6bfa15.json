  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将冷牛奶、南瓜泥、搅打过的配料、布丁粉和南瓜派香料放入一个窄底深碗中。用电动搅拌机以最低速度搅拌直至充分混合，大约需要 1 分钟。"
    },
    {
      "step_index": 3,
