  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将 1 汤匙酒、1 汤匙酱油、1 汤匙芝麻油和 1 ½ 茶匙玉米淀粉放入大玻璃碗中，搅拌至光滑。添加鸡块并搅拌均匀。盖上盘子并冷藏 30 分钟。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将剩余的 1 汤匙酒、1 汤匙酱油和 1 汤匙芝麻油放入一个中等大小的碗中。加入辣椒酱、红糖和醋，搅拌。加入荸荠、花生、葱和大蒜，搅拌均匀。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将菱角酱混合物转移到中型煎锅中。用中火慢慢加热直至芳香。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "同时，将鸡肉从腌料转移到一个大煎锅中；用中高火煮，搅拌，直到鸡肉煮熟并且汁液清澈。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "将菱角混合物和煮熟的鸡肉一起放入一个煎锅中。调节火力，煮 1 至 2 分钟，直至酱汁变稠并覆盖鸡肉。"
    }
  ],
