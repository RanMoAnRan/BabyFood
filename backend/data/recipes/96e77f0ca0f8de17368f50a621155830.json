  "nutrition_tip": "这个简单的宫保鸡丁食谱，用甜甜的酱料炒嫩的腌制鸡肉……",
  "ingredients": [
    {
      "name": "2 汤匙白葡萄酒，分开",
      "amount": ""
    },
    {
      "name": "2汤匙酱油，分开",
      "amount": ""
    },
    {
      "name": "2汤匙芝麻油，分开",
      "amount": ""
    },
    {
      "name": "2 汤匙玉米淀粉，溶解在 2 汤匙水中",
      "amount": ""
    },
    {
      "name": "1 磅去皮去骨鸡胸肉半块 - 切成块",
      "amount": ""
    },
    {
      "name": "1 盎司热智利酱",
      "amount": ""
    },
    {
      "name": "2 茶匙红糖",
      "amount": ""
    },
    {
      "name": "1 茶匙蒸馏白醋",
      "amount": ""
    },
    {
      "name": "1 罐（8 盎司）荸荠",
      "amount": ""
    },
    {
      "name": "4 盎司碎花生",
      "amount": ""
    },
    {
      "name": "4 个葱，切碎",
      "amount": ""
    },
    {
      "name": "1 汤匙切碎的大蒜",
      "amount": ""
    }
