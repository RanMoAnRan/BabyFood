  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "在平底锅中将 2 杯水煮沸。加入米饭并搅拌。减少热量，盖上锅盖，煮 20 分钟。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在一个大碗中混合煮熟、冷却的米饭、糖、菠萝和棉花糖。拌入鲜奶油。冷藏4小时。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将米饭混合物倒入 6 个甜点盘中，并在每个甜点盘上放一颗樱桃。"
    }
