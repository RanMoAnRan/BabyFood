  "title": "甜第戎巴沙鱼片",
  "min_age_month": 12,
  "tags": [
    "Dinner",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 25,
  "cover_image": "images/2cbdd5eeaa23dcbe1a4fcac6fa3a5d83.webp",
  "nutrition_tip": "美味的巴沙鱼片食谱，配有奶油蜂蜜芥末酱……",
  "ingredients": [
    {
      "name": "0.25 杯蜂蜜",
      "amount": ""
    },
    {
      "name": "3 汤匙蛋黄酱",
      "amount": ""
    },
    {
      "name": "2 汤匙橄榄油",
      "amount": ""
    },
    {
      "name": "2 汤匙全麦第戎芥末",
      "amount": ""
    },
    {
      "name": "1 汤匙柠檬汁",
      "amount": ""
    },
    {
      "name": "4 块（4 盎司）swai 鱼片",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 425 华氏度（220 摄氏度）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将蜂蜜、蛋黄酱、橄榄油、芥末和柠檬汁放入碗中混合。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将每块鱼片放在单独的铝箔上。在每片鱼片上淋上蜂蜜酱。轻轻地将铝箔包裹在每个涂有涂层的鱼片上，将箔纸在顶部卷曲在一起以密封成小包。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在预热的烤箱中烘烤鱼片，直至鱼用叉子轻松剥落，大约需要 13 分钟。将一片鱼片放在每个盘子上，并在上面涂上铝箔袋中剩下的酱汁。"
    }
  ],
