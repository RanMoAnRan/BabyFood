{
  "id": "caffcb3bd31f2a55fc50db4622eb4763",
  "title": "火鸡内脏肉汁",
  "min_age_month": 12,
  "tags": [
    "Sauce",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 90,
  "cover_image": "images/d13f57a4f489435323a4d602731594e9.webp",
  "nutrition_tip": "这种火鸡内脏肉汁是用鸡胗、内脏和美味的锅滴油制成的……",
  "ingredients": [
    {
      "name": "1 包火鸡内脏和颈部，不包括肝脏",
      "amount": ""
    },
    {
      "name": "4 杯水",
      "amount": ""
    },
    {
      "name": "1 杯火鸡汁",
      "amount": ""
    },
    {
      "name": "0.5 杯冷水",
      "amount": ""
    },
    {
      "name": "6 汤匙玉米淀粉",
      "amount": ""
    },
    {
      "name": "1 个大熟鸡蛋，切碎",
      "amount": ""
    },
    {
      "name": "盐和黑胡椒粉适量",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将火鸡内脏、脖子和 4 杯水放入平底锅中；煮沸。将火调至小火，煮约 1 小时，直至肉汤减少至 3 杯。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "过滤肉汤并保留 1/2 杯内脏。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将滤过的肉汤和火鸡汁放入平底锅中，用中火加热。将 1/2 杯冷水和玉米淀粉放入小碗中，搅拌至光滑；倒入锅中的肉汤混合物中，煮沸。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "当肉汤沸腾时，将内脏切碎。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "将热量降至最低；将内脏和煮熟的鸡蛋搅拌成肉汁。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "煮约5分钟，直至肉汁变稠。用盐和黑胡椒调味。"
    }
  ],
