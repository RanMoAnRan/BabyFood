  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在中型平底锅中用中火融化黄油。加入面粉搅拌直至形成糊状。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "倒入牛奶并搅拌直至混合物变稠。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "加入奶酪和盐；煮约 15 分钟，搅拌直至奶酪融化。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "享受吧！"
