  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 350 华氏度（175 摄氏度）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将 10.25 盎司蛋糕粉、1 个鸡蛋和 ½ 杯融化的黄油放入碗中；拍入 9x13 英寸的烤盘中。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将剩下的 2 个鸡蛋、南瓜、½ 杯糖、淡奶、肉豆蔻和肉桂一起放入碗中搅拌；倒在蛋糕混合面糊上。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将剩余的蛋糕粉和剩余的 3/4 杯糖放入碗中；用 2 刀或糕点搅拌机切入 ½ 杯软化黄油，直至混合物呈粗面包屑状。将混合物撒在南瓜混合物上。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "在预热的烤箱中烘烤55分钟。"
    }
  ],
