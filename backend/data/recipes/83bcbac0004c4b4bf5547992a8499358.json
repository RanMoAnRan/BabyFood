  "nutrition_tip": "在这个南瓜脆食谱中，黄色蛋糕与鸡蛋和黄油混合形成......",
  "ingredients": [
    {
      "name": "1 包（18.25 盎司）黄色蛋糕粉",
      "amount": ""
    },
    {
      "name": "1 个鸡蛋",
      "amount": ""
    },
    {
