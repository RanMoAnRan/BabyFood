  "title": "自制鳄梨酱",
  "min_age_month": 12,
  "tags": [],
  "difficulty": 1,
  "time_cost": 0,
  "cover_image": "images/dc2ac4a3755f27de3f5b243e659bfc0e.webp",
  "nutrition_tip": "你是鳄梨迷吗？按照这个食谱，将自制鳄梨酱带到您的餐桌上。",
  "ingredients": [],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "用肥皂和水洗手。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在冷水下轻轻擦拭农产品。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将牛油果切成两半，去核，将果肉舀入一个中等大小的碗中。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "用叉子捣碎鳄梨果肉，并与剩余成分混合。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "搅拌混合。与生蔬菜棒或烤玉米片一起食用。"
    }
  ],
