  "title": "山核桃派饼干",
  "min_age_month": 12,
  "tags": [
    "Dessert",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 60,
  "cover_image": "images/c57e711c8ddc6503bdf4073c5e2d159b.webp",
  "nutrition_tip": "这些漂亮的山核桃派饼干，里面有美味丰富的坚果馅料，味道......",
  "ingredients": [
    {
      "name": "0.25 杯黄油",
      "amount": ""
    },
    {
      "name": "0.5 杯糖果糖",
      "amount": ""
    },
    {
      "name": "3 汤匙 淡玉米糖浆",
      "amount": ""
    },
    {
      "name": "0.75 杯切碎的山核桃",
      "amount": ""
    },
    {
      "name": "2 杯通用面粉",
      "amount": ""
    },
    {
      "name": "1 茶匙泡打粉",
      "amount": ""
    },
    {
      "name": "1 杯红糖，包装",
      "amount": ""
    },
    {
      "name": "0.75 杯黄油，软化",
      "amount": ""
    },
    {
      "name": "1 个大鸡蛋",
      "amount": ""
    },
    {
      "name": "1 茶匙香草精",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "制作馅料：在平底锅中融化 1/4 杯黄油；加入糖果搅拌。糖和玉米糖浆直至糖溶解。用中火煮沸，经常搅拌，然后加入山核桃直至混合。将馅料冷藏 30 分钟以冷却。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "制作饼干：将烤箱预热至 350 华氏度（175 摄氏度）。将面粉和发酵粉一起筛入碗中；放在一边。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将红糖、3/4 杯黄油、鸡蛋和香草精放入一个大碗中，用电动搅拌机中速搅拌，直至混合物呈奶油状，大约需要 2 分钟。逐渐加入面粉混合物，形成面团。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "捏掉约1汤匙面团，搓成球状；压入未抹油的纸杯蛋糕盘杯的底部，使其沿着底部和侧面排列，就像馅饼皮一样。对剩余的面团重复上述步骤。在每个饼皮中加入约 1 茶匙准备好的山核桃馅料。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "在预热的烤箱中烘烤 10 到 13 分钟，直至饼干壳呈浅棕色。 10分钟后仔细观察。让饼干在平底锅中短暂冷却，然后移至金属架上完成冷却。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "上菜并享用。"
    }
  ],
