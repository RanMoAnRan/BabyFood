{
  "id": "2edc9039795a936d888499ccf522e5bf",
  "title": "约翰·韦恩砂锅菜",
  "min_age_month": 12,
  "tags": [
    "Dinner",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 60,
  "cover_image": "images/4c9aea5c78ee5b65a9c16cf3465652dd.webp",
  "nutrition_tip": "约翰·韦恩砂锅菜是用饼干面团烹制的美味玉米卷牛肉砂锅菜......",
  "ingredients": [
    {
      "name": "1 罐（16.3 盎司）冷藏饼干",
      "amount": ""
    },
    {
      "name": "2 磅碎牛肉",
      "amount": ""
    },
    {
      "name": "1 包（1 盎司）玉米卷调味料",
      "amount": ""
    },
    {
      "name": "0.75 杯水",
      "amount": ""
    },
    {
      "name": "1 个中等大小的洋葱，切半切片",
      "amount": ""
    },
    {
      "name": "1 个中等大小的红甜椒，切半切片（1 1/2 杯）",
      "amount": ""
    },
    {
      "name": "0.5 杯酸奶油",
      "amount": ""
    },
    {
      "name": "0.5 杯蛋黄酱",
      "amount": ""
    },
    {
      "name": "8 盎司切达干酪丝，分开",
      "amount": ""
    },
    {
      "name": "2 个中等大小的西红柿，切片",
      "amount": ""
    },
    {
      "name": "1罐（4盎司）墨西哥辣椒片，沥干",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集原料。将烤箱预热至 350 华氏度（175 摄氏度），并在 9x13 英寸烤盘上涂上少许油脂。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将饼干面团放入烤盘底部并压入两侧的中间位置。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在预热的烤箱中烘烤 15 至 20 分钟，直至呈浅棕色。让烤箱保持打开状态。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "同时，用中高火加热不粘锅，将碎牛肉煮至棕色且易碎，大约需要 5 分钟。排出脂肪。加入玉米卷调味料和水。煮沸，调小火，小火煮 5 分钟，偶尔搅拌。将煮熟的肉转移到碗中并擦干净煎锅。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将洋葱和甜椒加入同一个煎锅中，用中火煮至稍微变软，大约需要 5 分钟。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "将酸奶油、蛋黄酱、1/2 切达干酪和 1/2 洋葱胡椒混合物放入碗中混合。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "将棕色肉、西红柿、洋葱辣椒混合物、墨西哥辣椒和酸奶油混合物铺在预烤饼干面团上。撒上剩余的切达干酪。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "在预热的烤箱中不盖盖子烘烤 30 到 40 分钟，直至奶酪呈浅棕色并起泡。"
    }
  ],
