  "nutrition_tip": "这个李子扣食谱的特点是由于湿润的......",
  "ingredients": [
    {
      "name": "7 杯去核并切成四等分的李子",
      "amount": ""
    },
    {
      "name": "1.5 杯白糖",
      "amount": ""
    },
    {
      "name": "0.66666668653488 杯黄油，软化",
      "amount": ""
    },
    {
      "name": "2 个鸡蛋",
      "amount": ""
    },
    {
      "name": "3 杯过筛的通用面粉",
      "amount": ""
    },
    {
      "name": "1 汤匙发酵粉",
      "amount": ""
    },
    {
      "name": "0.5 茶匙盐",
      "amount": ""
    },
    {
      "name": "2 杯牛奶",
      "amount": ""
    },
    {
      "name": "2 茶匙香草精",
      "amount": ""
    },
    {
      "name": "1/2 杯黄油",
      "amount": ""
    },
    {
      "name": "0.25 杯通用面粉",
      "amount": ""
    },
    {
