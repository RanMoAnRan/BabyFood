  "nutrition_tip": "西班牙凉菜汤 (Gazpacho) 是一种令人难以置信的清爽番茄蔬菜汤，冷食后可享用……",
  "ingredients": [
    {
      "name": "4 个大的新鲜西红柿，去皮切丁",
      "amount": ""
    },
    {
      "name": "0.5 根英国黄瓜，去皮并切碎",
      "amount": ""
    },
    {
      "name": "0.5 杯切碎的红甜椒",
      "amount": ""
    },
    {
      "name": "0.25 杯葱末",
      "amount": ""
    },
    {
      "name": "1 个大墨西哥辣椒，去籽并切碎",
      "amount": ""
    },
    {
      "name": "2 瓣大蒜，切碎",
      "amount": ""
    },
    {
      "name": "1 茶匙盐",
      "amount": ""
    },
    {
      "name": "0.5 茶匙孜然粉",
      "amount": ""
    },
    {
      "name": "1 撮干牛至",
      "amount": ""
    },
    {
      "name": "1 撮辣椒，或适量",
      "amount": ""
    },
    {
      "name": "新鲜磨碎的黑胡椒粉",
      "amount": ""
    },
    {
      "name": "1 品脱樱桃番茄",
      "amount": ""
    },
    {
      "name": "0.25 杯特级初榨橄榄油",
      "amount": ""
    },
    {
      "name": "1 个酸橙，榨汁",
      "amount": ""
    },
    {
      "name": "1 汤匙香醋",
      "amount": ""
    },
    {
      "name": "1 茶匙伍斯特酱",
      "amount": ""
    },
    {
      "name": "盐和黑胡椒粉适量",
      "amount": ""
    },
    {
      "name": "2 汤匙切成薄片的新鲜罗勒",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将切块的西红柿、黄瓜、甜椒、葱、墨西哥辣椒和大蒜放入一个大碗中。加入盐、孜然、牛至、辣椒和黑胡椒。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将樱桃番茄、橄榄油、酸橙汁、香醋和伍斯特沙司放入搅拌机中。盖上盖子，打成泥直至光滑。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将泥状混合物通过过滤器倒入番茄黄瓜混合物中；搅拌混合。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将 1/3 的番茄混合物放入搅拌机中。盖上盖子，打开搅拌机，打成泥直至光滑。将糊状混合物放回剩余的番茄黄瓜混合物中。搅拌混合。盖上盖子，放入冰箱冷藏2小时。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "用盐和黑胡椒调味冷汤。用勺子舀进碗里，上面撒上罗勒。"
    }
  ],
