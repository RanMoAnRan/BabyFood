{
  "id": "52841c364822692a2c1b491e49ec3dff",
  "title": "培根卷烟熏",
  "min_age_month": 12,
  "tags": [
    "Appetizer",
    "American",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 60,
  "cover_image": "images/f61eefa1fca27d3610e17baccca160a2.webp",
  "nutrition_tip": "培根包裹的烟熏酒加红糖是一个快速而轻松的假期或比赛日......",
  "ingredients": [
    {
      "name": "1 磅培根片，切成三份",
      "amount": ""
    },
    {
      "name": "1 包（14 盎司）牛肉鸡尾酒香肠",
      "amount": ""
    },
    {
      "name": "牙签",
      "amount": ""
    },
    {
      "name": "0.75 杯红糖，或适量",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将烤箱预热至 325 华氏度（165 摄氏度）。在一张大的有边烤盘上铺上羊皮纸或铝箔。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "用一片培根包裹每个鸡尾酒维纳；用牙签固定。将培根包裹的维也纳香肠放在准备好的烤盘上。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将红糖均匀地撒在培根包裹的维也纳香肠上。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "在预热的烤箱中烘烤约 40 分钟，直至培根变脆且糖起泡。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "立即食用，或放入设置为“低”的慢炖锅中保温。"
    }
  ],
