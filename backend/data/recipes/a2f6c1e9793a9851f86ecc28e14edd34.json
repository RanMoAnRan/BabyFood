  "nutrition_tip": "一个简单的慢炖锅奶酪西兰花汤食谱，从炉灶开始，但是……",
  "ingredients": [
    {
      "name": "1 个中等大小的黄洋葱，大致切碎",
      "amount": ""
    },
    {
      "name": "2 瓣大蒜，大致切碎",
      "amount": ""
    },
    {
      "name": "10 汤匙咸黄油，分开",
      "amount": ""
    },
    {
      "name": "3 杯鸡汤",
      "amount": ""
    },
    {
      "name": "2 包 Swanson® Flavor Boost™ 浓缩鸡汤",
      "amount": ""
    },
    {
      "name": "0.5 杯通用面粉",
      "amount": ""
    },
    {
      "name": "0.5 茶匙盐",
      "amount": ""
    },
    {
      "name": "0.25 茶匙黑胡椒粉",
      "amount": ""
    },
    {
      "name": "1.5 袋（16 盎司）冷冻西兰花小花",
      "amount": ""
    },
    {
      "name": "19 盎司加工奶酪食品（例如 Velveeta®），切成方块",
      "amount": ""
    },
    {
      "name": "0.5 杯切达干酪丝",
      "amount": ""
    },
    {
      "name": "0.5 杯蒙特利杰克奶酪丝",
      "amount": ""
    },
    {
      "name": "2 盎司奶油干酪",
      "amount": ""
    },
    {
