  "nutrition_tip": "这个南瓜苹果糖粉奶油细末松饼食谱的特点是苹果的质地......",
  "ingredients": [
    {
      "name": "2.5 杯通用面粉",
      "amount": ""
    },
    {
      "name": "0.25 杯白糖",
      "amount": ""
    },
    {
      "name": "1 汤匙南瓜派香料",
      "amount": ""
    },
    {
      "name": "1 茶匙小苏打",
      "amount": ""
    },
    {
      "name": "0.5 茶匙盐",
      "amount": ""
    },
    {
      "name": "1 杯罐装南瓜泥",
      "amount": ""
    },
    {
      "name": "0.5 杯植物油",
      "amount": ""
    },
    {
      "name": "2 个鸡蛋，轻轻打散",
      "amount": ""
    },
    {
      "name": "2 杯苹果，去皮、去核、切碎",
      "amount": ""
    },
    {
      "name": "2 汤匙通用面粉",
      "amount": ""
    },
    {
      "name": "0.5 茶匙肉桂粉",
      "amount": ""
    },
    {
