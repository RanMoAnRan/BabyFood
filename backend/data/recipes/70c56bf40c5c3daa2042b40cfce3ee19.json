  "title": "脆皮烤鸡大腿",
  "min_age_month": 12,
  "tags": [
    "Dinner",
    "American",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 60,
  "cover_image": "images/f0ad667f44204fee9f7d6e1bd3a6acaf.webp",
  "nutrition_tip": "一个美味简单的烤鸡大腿食谱，皮脆金黄，还有……",
  "ingredients": [
    {
      "name": "6 个带皮带骨鸡大腿",
      "amount": ""
    },
    {
      "name": "盐和黑胡椒粉适量",
      "amount": ""
    },
    {
      "name": "1 撮大蒜粉，或适量",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 475 华氏度（245 摄氏度）。在烤盘或烤盘内放置一个金属架。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "用纸巾拍干鸡大腿。轻轻提起肌肤；在皮下撒上盐、胡椒粉和大蒜粉。更换皮肤。用盐、胡椒和大蒜粉调味皮肤和大腿内侧。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "放在架子上。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "放入预热好的烤箱中烤至金黄色，约20分钟。将烤箱温度降低至 400 华氏度（200 摄氏度）。继续烘烤约 30 分钟，直至汁液清澈。食用前休息 5 分钟。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "趁热享用吧！"
    }
  ],
