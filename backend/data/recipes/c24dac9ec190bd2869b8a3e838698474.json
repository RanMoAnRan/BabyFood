  ],
  "difficulty": 1,
  "time_cost": 60,
  "cover_image": "images/bdd5e9df50ed6af5b3e1570c8cebb23f.webp",
  "nutrition_tip": "这个苹果酥有一层苹果片，上面涂有黄油面包屑，烘烤……",
  "ingredients": [
    {
      "name": "4 杯 去皮青苹果片",
      "amount": ""
    },
    {
      "name": "1 汤匙水",
      "amount": ""
    },
    {
      "name": "1 茶匙柠檬汁",
      "amount": ""
    },
    {
      "name": "1 杯白糖",
      "amount": ""
    },
    {
      "name": "0.75 杯通用面粉",
      "amount": ""
    },
    {
      "name": "0.5 茶匙肉桂粉",
      "amount": ""
    },
    {
      "name": "0.25 茶匙肉豆蔻粉",
      "amount": ""
    },
    {
      "name": "0.25 茶匙盐",
      "amount": ""
    },
    {
      "name": "0.5 杯冷无盐黄油，切成小块",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 375 华氏度（190 摄氏度）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将切片苹果放入 8x10 英寸的砂锅中。将水和柠檬汁混合在一起，撒在苹果上。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "制作酥皮配料：将糖、面粉、肉桂、肉豆蔻和盐放入搅拌碗中混合。使用电动搅拌机搅拌均匀。加入黄油块，搅拌直至混合物变得易碎；均匀地撒在苹果上。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在预热的烤箱中烘烤约 45 分钟，直至苹果冒泡且碎屑呈金黄色且酥脆。稍微冷却使其变稠，然后盛入碗中。"
    }
  ],
