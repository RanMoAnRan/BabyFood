  ],
  "difficulty": 1,
  "time_cost": 40,
  "cover_image": "images/6be6cec59801bd50695724f2e84cf19e.webp",
  "nutrition_tip": "这个南瓜山核桃白巧克力饼干食谱是用南瓜泥制成的，br…",
  "ingredients": [
    {
      "name": "1.5 杯 深红糖",
      "amount": ""
    },
    {
      "name": "1 杯无盐黄油",
      "amount": ""
    },
    {
      "name": "2 个鸡蛋",
      "amount": ""
    },
    {
      "name": "1 茶匙香草精",
      "amount": ""
    },
    {
      "name": "1 杯固体包装南瓜泥",
      "amount": ""
    },
    {
      "name": "2.25 杯通用面粉",
      "amount": ""
    },
    {
      "name": "0.5 茶匙小苏打",
      "amount": ""
    },
    {
      "name": "0.5 茶匙南瓜派香料",
      "amount": ""
    },
    {
      "name": "10 盎司白巧克力，切碎",
      "amount": ""
    },
    {
      "name": "0.5 杯山核桃半块",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 300 华氏度（150 摄氏度），给烤盘涂上油脂。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将红糖和黄油放入碗中，用电动搅拌机搅拌至光滑；打入1个鸡蛋。将剩下的 1 个鸡蛋与香草精一起搅拌：加入南瓜泥，搅拌均匀。将面粉、小苏打和南瓜派香料混合在另一个碗中；搅拌成南瓜混合物。拌入白巧克力和山核桃。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将一勺面团放在准备好的烤盘上，间隔 2 英寸。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在预热的烤箱中烘烤 20 到 22 分钟，直至边缘呈金黄色。将饼干放在烤盘上冷却 5 分钟；将饼干转移到金属架上完全冷却。"
    }
  ],
