{
  "id": "389a176e9371757c718d9cbdbbeddfc4",
  "title": "巧克力山核桃派",
  "min_age_month": 12,
  "tags": [
    "Dessert",
    "Southern",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 50,
  "cover_image": "images/cadd2fe1efacbd1aaf0738797cf33046.webp",
  "nutrition_tip": "这个巧克力山核桃派就像经典的一样，但是用巧克力片......",
  "ingredients": [
    {
      "name": "1 杯淡玉米糖浆",
      "amount": ""
    },
    {
      "name": "0.66666698455811 杯白糖",
      "amount": ""
    },
    {
      "name": "0.33333298563957 杯人造黄油，融化",
      "amount": ""
    },
    {
      "name": "3 个大鸡蛋",
      "amount": ""
    },
    {
      "name": "0.5 茶匙盐",
      "amount": ""
    },
    {
      "name": "1.5 杯半甜巧克力片",
      "amount": ""
    },
    {
      "name": "1 杯半山核桃",
      "amount": ""
    },
    {
      "name": "1 个（9 英寸）未烘烤的馅饼皮",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。将烤箱预热至 375 华氏度（190 摄氏度）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将玉米糖浆、糖、融化的黄油、鸡蛋和盐放入搅拌碗中；用电动搅拌机搅拌直至混合。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "加入巧克力片和山核桃。将混合物倒入未烘烤的馅饼皮中。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在预热的烤箱中烘烤 40 至 50 分钟，直至外皮呈金黄色且中心凝固。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "在切片之前在金属架上完全冷却以获得完美的粘稠质地。馅饼冷却后会变硬。"
    }
  ],
