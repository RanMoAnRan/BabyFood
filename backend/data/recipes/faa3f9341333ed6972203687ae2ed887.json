      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集原料并在搅拌机中加入冰块。脉冲直至冰被压碎。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "倒入龙舌兰酒和三秒酒，然后加入草莓和浓缩酸橙汁。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "搅拌直至光滑，大约需要 30 秒。倒入四个玛格丽塔酒杯（带或不带盐边）并立即享用。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "享受吧！"
    }
