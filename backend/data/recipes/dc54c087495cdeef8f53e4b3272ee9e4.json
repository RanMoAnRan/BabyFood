{
  "id": "dc54c087495cdeef8f53e4b3272ee9e4",
  "title": "韭菜蘑菇米粒",
  "min_age_month": 12,
  "tags": [],
  "difficulty": 1,
  "time_cost": 0,
  "cover_image": "images/e6d2b1a43f9a3ac735894d95debfd70c.webp",
  "nutrition_tip": "45 分钟内煮出这道美味的意大利面，作为晚餐和......",
  "ingredients": [],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "在中型煎锅中用中火炒油韭菜，偶尔搅拌，直到韭菜变软（约 5 分钟）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "加入蘑菇，煮至软（约 5 分钟）。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "拌入米粒并轻轻烘烤约 3 分钟，经常搅拌。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "加入肉汤并煮沸。将火调小，煮约 8 分钟，偶尔搅拌，直到米粒几乎变软。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "加入西红柿，煮至米粒变软（约 2 分钟）。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "从火上移开，拌入奶油干酪、大蒜粉、盐和胡椒。趁热食用。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "在 2 小时内将剩菜冷藏。"
    }
  ],
