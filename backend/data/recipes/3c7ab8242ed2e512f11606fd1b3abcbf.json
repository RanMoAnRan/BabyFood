  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 350 华氏度（175 摄氏度）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将苹果放入 9 英寸方形烤盘中。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将红糖、燕麦、面粉、肉桂和肉豆蔻放入碗中；用叉子将黄油捣碎直至酥脆。将红糖撒在苹果上。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在预热的烤箱中烘烤约 30 分钟，直至苹果变软。"
    }
