  "ingredients": [
    {
      "name": "2 包（8 盎司）奶油干酪，软化",
      "amount": ""
    },
    {
      "name": "1 杯蛋黄酱",
      "amount": ""
    },
    {
      "name": "1罐（4盎司）切碎的青辣椒，沥干",
      "amount": ""
    },
    {
