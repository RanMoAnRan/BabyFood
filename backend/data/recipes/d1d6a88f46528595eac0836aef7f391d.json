      "amount": ""
    },
    {
      "name": "1 杯磨碎的帕尔马干酪",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将奶油干酪和蛋黄酱放入一个大碗中，直至光滑。拌入青辣椒和墨西哥辣椒；转移到可用于微波炉的盘子中。"
    },
    {
      "step_index": 3,
