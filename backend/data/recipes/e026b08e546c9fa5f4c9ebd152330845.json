{
  "id": "e026b08e546c9fa5f4c9ebd152330845",
  "title": "快速超级美味的托斯卡纳汤",
  "min_age_month": 8,
  "tags": [
    "Soup",
    "Italian Inspired",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 60,
  "cover_image": "images/099ea7f115fe0bc4474afd1c91d285d6.webp",
  "nutrition_tip": "如果您喜欢当地 Olive Garden® 的 Zuppa Toscana，您一定会喜欢这个……",
  "ingredients": [
    {
      "name": "1 磅散装淡味意大利香肠",
      "amount": ""
    },
    {
      "name": "1.25 茶匙红辣椒片",
      "amount": ""
    },
    {
      "name": "4 片培根，切成 1/2 英寸的块",
      "amount": ""
    },
    {
      "name": "1 个大洋葱，切丁",
      "amount": ""
    },
    {
      "name": "1 汤匙 蒜末",
      "amount": ""
    },
    {
      "name": "8.75 杯鸡汤",
      "amount": ""
    },
    {
      "name": "6 个土豆，切成薄片",
      "amount": ""
    },
    {
      "name": "6 杯切碎的新鲜羽衣甘蓝",
      "amount": ""
    },
    {
      "name": "1 杯浓奶油",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "在荷兰烤箱中用中高温烹调并搅拌意大利香肠和红辣椒片，直至香肠变成棕色且易碎，需要 10 到 15 分钟。将香肠混合物转移到碗中。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将培根放入同一个荷兰烤箱中搅拌，用中火煮至培根变脆，大约需要 10 分钟。沥干脂肪，在荷兰烤箱中留下几汤匙的油滴。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将洋葱和大蒜拌入培根中；煮约 5 分钟，搅拌直至洋葱变软且半透明。将鸡汤倒入培根混合物中；煮沸。将土豆和羽衣甘蓝放入肉汤中搅拌；煮约 15 分钟，直至土豆变软且汤有香味。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将香肠和浓奶油搅拌到汤中，将火调至中火，煮至汤热透，再煮约 5 分钟。"
    }
  ],
