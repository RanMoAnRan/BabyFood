  "nutrition_tip": "这些软糖和超湿润的巧克力布朗尼从卡鲁瓦咖啡中得到了咖啡的味道，并且......",
  "ingredients": [
    {
      "name": "1.5 杯通用面粉",
      "amount": ""
    },
    {
      "name": "1 茶匙盐",
      "amount": ""
    },
    {
      "name": "1 茶匙小苏打",
      "amount": ""
    },
    {
      "name": "2 块（1 盎司）方形不加糖巧克力",
      "amount": ""
    },
    {
      "name": "0.5 磅黄油，软化",
      "amount": ""
    },
    {
      "name": "0.75 杯白糖",
      "amount": ""
    },
    {
      "name": "0.75 磅深红糖，包装牢固",
      "amount": ""
    },
    {
      "name": "2 个大鸡蛋",
      "amount": ""
    },
    {
      "name": "2 汤匙咖啡味利口酒（例如 Kahlua®）",
      "amount": ""
    },
    {
      "name": "1 汤匙香草精",
      "amount": ""
    },
    {
      "name": "0.25 杯速溶咖啡颗粒",
      "amount": ""
    },
    {
      "name": "6 盎司半甜巧克力块",
      "amount": ""
    },
    {
      "name": "0.75 杯核桃碎",
      "amount": ""
    },
    {
      "name": "0.75 杯切碎的山核桃",
      "amount": ""
    },
    {
      "name": "0.5（16 盎司）容器现成黑巧克力糖霜",
      "amount": ""
    }
