{
  "id": "e848dd67d9bfe7de77035e02ce487c62",
  "title": "芦笋蘑菇融化",
  "min_age_month": 12,
  "tags": [],
  "difficulty": 1,
  "time_cost": 0,
  "cover_image": "images/444db32463b669bb5189aea4745ae992.webp",
  "nutrition_tip": "这个温暖的奶酪三明治会让你的味蕾流口水。",
  "ingredients": [],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将松饼切成两半，单层放在烤盘上。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在一个大煎锅中，用中火炒洋葱和蘑菇，经常搅拌，直到开始变成棕色。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "加入芦笋、调味料和醋。炒，经常搅拌，直到芦笋几乎变软。用盐和胡椒轻轻调味。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将蔬菜混合物均匀地分成两半松饼。在每个松饼上撒上切碎的奶酪。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "烤松饼直至奶酪融化。仔细观察以避免燃烧。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "在 2 小时内将剩菜冷藏。"
    }
  ],
