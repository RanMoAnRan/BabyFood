  "title": "香蕉巧克力片面包",
  "min_age_month": 6,
  "tags": [
    "Snack",
    "Brunch",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 95,
  "cover_image": "images/c09bb48a0e8c269837041bb42f21bd02.webp",
  "nutrition_tip": "这款巧克力片香蕉面包由于添加了...",
  "ingredients": [
    {
      "name": "2 杯通用面粉",
      "amount": ""
    },
    {
      "name": "1 茶匙泡打粉",
      "amount": ""
    },
    {
      "name": "1 茶匙小苏打",
      "amount": ""
    },
    {
      "name": "1 茶匙盐",
      "amount": ""
    },
    {
      "name": "3 根熟香蕉，捣碎",
      "amount": ""
    },
    {
      "name": "1 汤匙牛奶",
      "amount": ""
    },
    {
      "name": "1 茶匙肉桂粉，或适量",
      "amount": ""
    },
    {
      "name": "1 杯白糖",
      "amount": ""
    },
    {
      "name": "0.5 杯黄油，软化",
      "amount": ""
    },
    {
      "name": "2 个大鸡蛋",
      "amount": ""
    },
    {
      "name": "1 杯半甜巧克力片",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将烤箱预热至 325 华氏度（165 摄氏度）。在 9x5 英寸的烤盘（最好是玻璃烤盘）上涂抹油脂。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在碗中混合面粉、泡打粉、小苏打和盐。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在另一个碗中搅拌香蕉、牛奶和肉桂。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将糖和黄油放入第三个碗中，用电动搅拌机搅拌至松软；一次加入一个鸡蛋，每次加入后搅拌均匀。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "将香蕉混合物搅拌成黄油混合物；加入面粉混合物直至混合。拌入巧克力片；将面糊倒入准备好的面包盘中。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "在预热的烤箱中烘烤约 70 分钟，直至插入中心的牙签拔出时是干净的。在平底锅中冷却 10 分钟，然后取出放在金属架上完全冷却，然后切片。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "切片并享用！"
    }
  ],
