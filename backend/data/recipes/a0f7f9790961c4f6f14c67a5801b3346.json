  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将黄瓜、洋葱和盐放入碗中混合。盖上保鲜膜，静置 15 至 30 分钟。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将黄瓜混合物放入放在碗或水槽上的漏勺中。沥干水分，偶尔搅拌，直至大部分液体和盐排出，需要 15 至 30 分钟。将沥干的黄瓜混合物转移到一个大碗中。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将蛋黄酱、醋、糖、莳萝、大蒜粉和胡椒粉放入碗中搅拌均匀。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "倒在黄瓜混合物上，搅拌直至涂上一层。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "用保鲜膜覆盖并冷藏 1 至 2 小时，然后食用。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "享受吧！"
    }
  ],
