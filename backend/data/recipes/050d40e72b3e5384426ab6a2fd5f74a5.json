  "title": "二豆辣椒",
  "min_age_month": 12,
  "tags": [],
  "difficulty": 1,
  "time_cost": 0,
  "cover_image": "images/bffa41f6b8f8bd6568c1e8458743eb95.webp",
  "nutrition_tip": "提前准备好这个辣椒，带个碗去上班做馅，平日里…",
  "ingredients": [],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将碎牛肉、洋葱、芹菜、胡萝卜和大蒜放入大平底锅中煎至棕色。沥干并冲洗以减少脂肪含量。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "添加除盐和胡椒外的其余成分。搅拌均匀，如果辣椒太稠就加水。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "煮约 10 分钟，直至蔬菜煮熟且味道混合。如果需要的话，用盐和胡椒调味。"
    }
  ],
