{
  "id": "53248172672fcf361865fab9326b4e1a",
  "title": "南瓜香料蛋糕",
  "min_age_month": 6,
  "tags": [
    "Cake",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 70,
  "cover_image": "images/f86e289ecb3e5922cba037fb07511020.webp",
  "nutrition_tip": "这个湿润的南瓜香料蛋糕配上肉桂、肉豆蔻、生姜和多香果，味道很丰富……",
  "ingredients": [
    {
      "name": "3 杯通用面粉",
      "amount": ""
    },
    {
      "name": "3.5 茶匙肉桂粉",
      "amount": ""
    },
    {
      "name": "2 茶匙小苏打",
      "amount": ""
    },
    {
      "name": "1 茶匙盐",
      "amount": ""
    },
    {
      "name": "1 茶匙肉豆蔻粉",
      "amount": ""
    },
    {
      "name": "0.5 茶匙姜末",
      "amount": ""
    },
    {
      "name": "0.5 茶匙五香粉粉",
      "amount": ""
    },
    {
      "name": "1.25 杯起酥油",
      "amount": ""
    },
    {
      "name": "1.25 杯白糖",
      "amount": ""
    },
    {
      "name": "1 杯包装红糖",
      "amount": ""
    },
    {
      "name": "2 个大鸡蛋，打散",
      "amount": ""
    },
    {
      "name": "1 罐（15 盎司）南瓜泥",
      "amount": ""
    },
    {
      "name": "0.5 杯切碎的山核桃",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。将烤箱预热至 350 华氏度（175 摄氏度）。在 10 英寸的平底锅上涂上油脂并撒上面粉。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将面粉、肉桂、小苏打、盐、肉豆蔻、姜和五香粉一起过筛。放在一边。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将黄油、糖和鸡蛋放入一个大碗中，用电动搅拌机搅打至松软。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "加入南瓜泥。逐渐加入面粉混合物直至混合。拌入切碎的山核桃。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将面糊倒入准备好的平底锅中。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "在预热的烤箱中烘烤 50 到 60 分钟，直到用牙签插入蛋糕中心，拔出来时是干净的。从烤箱中取出，在锅中冷却 10 分钟，然后放在金属架上完全冷却。"
    }
  ],
