      "amount": ""
    },
    {
      "name": "1 个大番茄，切碎",
      "amount": ""
    },
    {
      "name": "1 个中等大小的青椒，切碎",
      "amount": ""
    },
    {
      "name": "1 束切碎的葱",
      "amount": ""
    },
    {
