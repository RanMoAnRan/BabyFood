  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将炸豆泥和炸玉米饼调味料放入一个中等大小的碗中混合；将混合物铺在一个大盘子上。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在一个中等大小的碗中混合酸奶油和奶油干酪；铺在豆泥上。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "上面撒上莎莎酱。将番茄、甜椒、葱和生菜铺在上面。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "撒在切达干酪上，并用黑橄榄装饰。"
    }
  ],
