  "nutrition_tip": "这个慢炖锅猪里脊肉用红酒、香脂和大蒜煮，直到……",
  "ingredients": [
    {
      "name": "1 块（2 磅）猪里脊肉",
      "amount": ""
    },
    {
      "name": "1 个（1 盎司）信封干洋葱汤混合物",
      "amount": ""
    },
    {
      "name": "1 杯水",
      "amount": ""
    },
    {
      "name": "0.75 杯红酒",
      "amount": ""
    },
    {
      "name": "3汤匙酱油",
      "amount": ""
    },
    {
      "name": "3 汤匙 蒜末",
      "amount": ""
    },
    {
      "name": "现磨黑胡椒粉",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将猪里脊肉和汤料放入慢炖锅中。将水、酒和香醋倒在上面，将猪肉裹上。将大蒜均匀地撒在猪肉上，尽可能多地留在上面。用胡椒调味。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "盖上锅盖，用低火烹饪 2 到 3 小时，直至内部温度达到 145 华氏度（63 摄氏度）。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "从慢炖锅中取出猪肉；休息 10 分钟。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将猪里脊肉切片，配以烹调液作为原汁。享受！"
    }
  ],
