  "ingredients": [
    {
      "name": "2 杯开水",
      "amount": ""
    },
    {
      "name": "2 包（0.3 盎司）无糖樱桃味明胶混合物（例如 Jell-O®）",
      "amount": ""
    },
    {
      "name": "1 罐（16 盎司）蔓越莓酱果冻",
      "amount": ""
    },
    {
      "name": "1罐（20盎司）菠萝碎，沥干",
      "amount": ""
    },
    {
      "name": "0.5 杯切碎的山核桃",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将沸水和明胶混合在碗中；搅拌直至明胶溶解。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "加入蔓越莓酱和碎菠萝搅拌。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "转移到一个大玻璃盘子或 12 个单独的盘子中。在上面撒上山核桃。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "冷却至凝固，单个菜肴需要 3 到 4 小时，一份大菜需要 4 小时到过夜。"
    }
  ],
