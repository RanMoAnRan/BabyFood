  "cover_image": "images/6329f7216cacfb5648c59c530a7c4306.webp",
  "nutrition_tip": "这个怪异的万圣节血腥碎玻璃纸杯蛋糕食谱的特点是含糖硬质…",
  "ingredients": [
    {
      "name": "1 包（18.25 盎司）白蛋糕粉",
      "amount": ""
    },
    {
      "name": "1 杯水",
      "amount": ""
    },
    {
      "name": "3 个鸡蛋",
      "amount": ""
    },
    {
      "name": "0.33333334326744 杯植物油",
      "amount": ""
    },
    {
      "name": "1 罐（16 盎司）白色糖霜",
      "amount": ""
    },
    {
      "name": "3.5 杯白糖",
      "amount": ""
    },
    {
      "name": "2 杯水",
      "amount": ""
    },
    {
      "name": "1 杯淡玉米糖浆",
      "amount": ""
    },
    {
      "name": "0.25 茶匙塔塔粉",
      "amount": ""
    },
    {
      "name": "0.5 杯淡玉米糖浆",
      "amount": ""
    },
    {
      "name": "1 汤匙玉米淀粉",
      "amount": ""
    },
    {
      "name": "0.25 杯水，或根据需要更多",
      "amount": ""
    },
    {
      "name": "15 滴红色食用色素",
