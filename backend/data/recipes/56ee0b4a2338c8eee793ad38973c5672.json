  "title": "装烤土豆",
  "min_age_month": 12,
  "tags": [
    "Dinner",
    "Side Dish",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 90,
  "cover_image": "images/18452c88f1179606c645d94bea3581e1.webp",
  "nutrition_tip": "这个烤土豆很简单，可以做一顿全餐。与您定制...",
  "ingredients": [
    {
      "name": "6 个赤褐色土豆",
      "amount": ""
    },
    {
      "name": "12 条培根",
      "amount": ""
    },
    {
      "name": "1 磅西兰花小花",
      "amount": ""
    },
    {
      "name": "0.75 杯 红甜椒丁",
      "amount": ""
    },
    {
      "name": "0.5 杯水",
      "amount": ""
    },
    {
      "name": "1 杯酸奶油",
      "amount": ""
    },
    {
      "name": "1 茶匙盐",
      "amount": ""
    },
    {
      "name": "0.25 茶匙黑胡椒粉",
      "amount": ""
    },
    {
      "name": "4 杯磨碎的切达干酪",
      "amount": ""
    },
    {
      "name": "8 个葱，切碎",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集原料。将烤箱预热至 400 华氏度（200 摄氏度）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "用削皮刀刺穿每个土豆，然后在烤箱中烤至变软，大约需要 1 小时，具体取决于土豆的大小。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "同时，将培根切丁。用中火加热炒锅，将培根煎至酥脆，大约需要 7 分钟。取出培根并放在一边，将培根脂肪留在锅中。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将带有保留的培根脂肪的炒锅放回火上。将西兰花和红辣椒煮 2 分钟。加水并煮至水蒸发。从火上移开并放在一边。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "土豆煮熟后，取出并冷却至足以处理。将它们切成两半，用勺子挖出一部分内部，在皮上留下大约 1/4 英寸的边缘。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "将挖出的土豆与 1/2 培根、西兰花红辣椒混合物、酸奶油、盐、胡椒和 1/2 切达干酪一起放入碗中混合。将馅料分开，然后将其放回土豆皮中。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "将酿好的土豆放回烤箱，烘烤 10 到 12 分钟直至热透。取出并在上面放上剩余的培根、切达干酪和葱。"
    }
  ],
