  "difficulty": 1,
  "time_cost": 30,
  "cover_image": "images/279709c7951c6a8e8960c3e9cc5bf990.webp",
  "nutrition_tip": "这种香肠馅料将盒装馅料与新鲜的香肠香肠、火鸡搭配在一起......",
  "ingredients": [
    {
      "name": "1 磅墨西哥香肠，去肠",
      "amount": ""
    },
    {
      "name": "1 杯洋葱丁",
      "amount": ""
    },
    {
      "name": "1 杯芹菜丁",
      "amount": ""
    },
    {
      "name": "1.25 杯水",
      "amount": ""
    },
    {
      "name": "0.25 杯黄油",
      "amount": ""
    },
    {
      "name": "1 包（6 盎司）干面包馅料混合物",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将香肠、洋葱和芹菜放入大煎锅中，用中火加热。煮并搅拌，用勺子将香肠打碎，直到香肠变成棕色且易碎，蔬菜变软，需要 7 到 9 分钟。转移到一个大碗里。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在同一个煎锅中加水；煮沸。将黄油加入沸水中并融化。拌入馅料混合物，离火，盖上盖子。静置约 5 分钟，直至馅料混合物吸收液体。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将香肠混合物添加到馅料混合物中，搅拌直至充分混合。"
    }
  ],
