  "nutrition_tip": "这个越南河粉食谱很容易从头开始制作，用光和令人难以置信的......",
  "ingredients": [
    {
      "name": "4磅牛肉汤骨头（小腿和膝盖）",
      "amount": ""
    },
    {
      "name": "1 个中等大小的洋葱，未去皮，切成两半",
      "amount": ""
    },
    {
      "name": "5 片鲜姜",
      "amount": ""
    },
    {
      "name": "1 汤匙盐",
      "amount": ""
    },
    {
      "name": "2 豆荚八角",
      "amount": ""
    },
    {
      "name": "2.5 汤匙 鱼露",
      "amount": ""
    },
    {
      "name": "4 夸脱水",
      "amount": ""
    },
    {
      "name": "1 包（8 盎司）干米粉",
      "amount": ""
    },
    {
      "name": "1.5 磅牛上腰肉，切成薄片",
      "amount": ""
    },
    {
      "name": "0.5 杯切碎的香菜",
      "amount": ""
    },
    {
      "name": "1 汤匙 葱花",
      "amount": ""
    },
    {
      "name": "1.5 杯豆芽",
      "amount": ""
    },
    {
      "name": "1 束泰国罗勒",
      "amount": ""
    },
    {
      "name": "1 个中等大小的青柠，切成 4 块",
      "amount": ""
    },
    {
      "name": "0.25 杯海鲜酱",
      "amount": ""
    },
    {
      "name": "0.25 杯智利大蒜酱（例如 Sriracha®）",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将烤箱预热至 425 华氏度（220 摄氏度）。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将牛骨放在烤盘上，放入预热的烤箱中烤至棕色，约 1 小时。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将洋葱半块放在第二个烤盘上，然后在另一个架子上烤至变黑变软，大约 45 分钟。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将牛骨和洋葱半块转移到一个大汤锅中。加入姜、盐、八角、鱼露和4夸脱水；煮沸。将火调至小火，煮 6 至 10 小时。将肉汤滤入平底锅中并放在一边。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "将米粉放入装有室温水的大碗中。浸泡 1 小时。流走。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "当面条浸泡1小时后，将保留的肉汤小火加热。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "将一大锅水烧开。将面条放入沸水中煮1分钟。流走。"
    },
    {
      "step_index": 9,
      "img": "",
      "text": "将面条分装在 4 个碗中；上面放上牛腩、香菜和葱。将热汤浇在上面。搅拌并静置 1 到 2 分钟，直至牛肉部分煮熟且不再呈粉红色。"
    },
    {
      "step_index": 10,
      "img": "",
      "text": "配上豆芽、泰国罗勒、酸橙角、海鲜酱和智利大蒜酱。"
    }
  ],
