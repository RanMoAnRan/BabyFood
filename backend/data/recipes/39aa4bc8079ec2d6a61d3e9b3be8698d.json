  "nutrition_tip": "这个红糖培根食谱很容易在烤箱里用厚片培根做……",
  "ingredients": [
    {
      "name": "1 磅厚片培根",
      "amount": ""
    },
    {
      "name": "0.5 杯红糖",
      "amount": ""
    },
    {
      "name": "0.25 杯切碎的山核桃",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 350 华氏度（175 摄氏度）。在烤盘上铺上铝箔。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将培根单层铺在准备好的烤盘上；边缘可以接触或稍微重叠。在上面撒上大量的红糖，然后撒上山核桃。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在预热的烤箱中烘烤 10 到 15 分钟，直至变成棕色并上釉。"
    }
  ],
