{
  "id": "b1f4eb9f8c7aaf52e6d9e80a91bff174",
  "title": "简易米饭布丁",
  "min_age_month": 8,
  "tags": [],
  "difficulty": 1,
  "time_cost": 0,
  "cover_image": "images/df1381371bf02d62cfbed29187ce8b8b.webp",
  "nutrition_tip": "用微波炉煮这个适合儿童的米饭布丁。",
  "ingredients": [],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将大米、水和黄油或人造黄油（如果使用）放入大砂锅中混合。松散地盖住，以便蒸汽逸出。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在微波炉中高火煮 5 分钟或直至混合物沸腾。降低除霜设置（50% 功率），然后再煮 10 分钟。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "煮米饭时，将其他配料放入碗中混合。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在不让米饭冷却的情况下，取下盖子，将干牛奶葡萄干混合物快速搅拌到热米饭中。再次松松地盖上盖子，在解冻 (50%) 下继续烹饪 10 分钟。烹饪时间结束后，将布丁盖上盖子静置 10 分钟。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "轻轻搅拌并放入单独的盘子中。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "剩余的食物在 2 小时内趁热食用并冷藏，或立即盖上盖子冷藏。冷藏布丁请在2天内享用。"
    }
  ],
