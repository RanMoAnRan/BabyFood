  ],
  "difficulty": 1,
  "time_cost": 75,
  "cover_image": "images/3978ef534c3ebe5ad6f6f1c4921ace3f.webp",
  "nutrition_tip": "这个苹果脆食谱烘烤了一层苹果片，发出美味的嘎吱声……",
  "ingredients": [
    {
      "name": "10 杯通用苹果，去皮、去核并切片",
      "amount": ""
    },
    {
      "name": "1 杯白糖",
      "amount": ""
    },
    {
      "name": "1 汤匙通用面粉",
      "amount": ""
    },
    {
      "name": "1 茶匙肉桂粉",
      "amount": ""
    },
    {
      "name": "0.5 杯水",
      "amount": ""
    },
    {
      "name": "1 杯快煮燕麦",
      "amount": ""
    },
    {
      "name": "1 杯通用面粉",
      "amount": ""
    },
    {
      "name": "1 杯包装红糖",
      "amount": ""
    },
    {
      "name": "0.25 茶匙泡打粉",
      "amount": ""
    },
    {
      "name": "0.25 茶匙小苏打",
      "amount": ""
    },
    {
      "name": "0.5 杯黄油，融化",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。将烤箱预热至 350 华氏度（175 摄氏度）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将切片苹果放入 9x13 英寸的烤盘中。将白糖、1汤匙面粉和肉桂粉混合在一起；撒在苹果上。将水均匀地倒在苹果上。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将燕麦、1 杯面粉、红糖、泡打粉和小苏打放入一个大碗中。加入融化的黄油，用叉子搅拌至易碎；均匀地撒在苹果混合物上。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在预热的烤箱中烘烤约 45 分钟，直至苹果馅冒泡，顶部呈金黄色、酥脆，边缘焦糖化。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "享受吧！"
    }
  ],
