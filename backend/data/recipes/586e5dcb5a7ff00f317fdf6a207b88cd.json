{
  "id": "586e5dcb5a7ff00f317fdf6a207b88cd",
  "title": "苹果玉米片",
  "min_age_month": 12,
  "tags": [],
  "difficulty": 1,
  "time_cost": 0,
  "cover_image": "images/4a174f7d53dfe668d2a9932aa2ffaab7.webp",
  "nutrition_tip": "这些健康、果味的玉米片对于孩子来说制作起来很简单。",
  "ingredients": [],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "用肥皂和水洗手。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在凉爽的流水下轻轻擦拭苹果。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在苹果片中加入柠檬汁以减少褐变。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将苹果片铺在盘子上。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "在苹果片上撒上葵花籽、蔓越莓干和迷你巧克力片。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "将花生酱和蜂蜜放入一个小型、可微波安全的容器中。微波炉加热 20 秒，搅拌至光滑。从微波炉中取出时要小心。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "将花生酱淋在苹果片上。"
    }
  ],
  "warnings": [],
