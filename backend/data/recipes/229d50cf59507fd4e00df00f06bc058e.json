  "nutrition_tip": "这个水果蛋糕食谱制作了一个丰富、湿润的蛋糕，里面装满了金色的葡萄干、糖果……",
  "ingredients": [
    {
      "name": "3 杯金色葡萄干",
      "amount": ""
    },
    {
      "name": "1.5 杯蜜饯菠萝块",
      "amount": ""
    },
    {
      "name": "1.5 杯蜜饯樱桃",
      "amount": ""
    },
    {
      "name": "1 杯 干醋栗",
      "amount": ""
    },
    {
      "name": "2 盎司蜜饯橙皮",
      "amount": ""
    },
    {
      "name": "2 盎司蜜饯柚子皮",
      "amount": ""
    },
    {
      "name": "0.5 杯橙汁",
      "amount": ""
    },
    {
      "name": "2 杯无盐黄油，软化",
      "amount": ""
    },
    {
      "name": "4 杯糖果糖",
      "amount": ""
    },
    {
      "name": "8 个大鸡蛋，分开",
      "amount": ""
    },
    {
      "name": "4 杯山核桃，切碎",
      "amount": ""
    },
    {
      "name": "3 杯过筛的通用面粉",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将葡萄干、菠萝块和樱桃切成小块，然后放入一个大碗中。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将醋栗、橙皮和柚子皮放入碗中。倒入橙汁，盖上盖子，浸泡8小时至过夜。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将烤箱预热至 275 华氏度（135 摄氏度）。将一小盘水放在烤箱的下层架子上。在一个 5x9 英寸面包盘和两个 3x8 英寸面包盘上铺上羊皮纸。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在一个大碗中用电动搅拌机将黄油搅打至奶油状。逐渐击败糖果店的加糖直至合并。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "在另一个碗中搅拌蛋黄，直至变稠且颜色变浅。添加到黄油混合物中并混合直至合并。加入浸泡过的水果和橙汁混合物，然后逐渐加入过筛的面粉。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "在另一个干净的碗中，搅打蛋白直至形成峰状。将蛋白拌入面糊中。将每个准备好的平底锅倒入 2/3 满的面糊。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "在预热的烤箱中烘烤 2 到 2 ½ 小时，直至呈金黄色，牙签插入中心时拔出时是干净的。"
    }
  ],
