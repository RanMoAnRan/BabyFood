{
  "id": "fac9ec280a82041818db83edfc41ccae",
  "title": "阳光易拉宝",
  "min_age_month": 12,
  "tags": [],
  "difficulty": 1,
  "time_cost": 0,
  "cover_image": "images/8c6cb83e86647992417f8252964f1a13.webp",
  "nutrition_tip": "这种亚洲风味的卷饼既咸又甜，是一顿令人满意的午餐……",
  "ingredients": [],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "在中型碗中，混合鸡肉、芹菜、橙子和洋葱。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "添加蛋黄酱、酱油、大蒜和胡椒。轻轻搅拌直至鸡肉混合物涂满。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将玉米饼放在干净的切菜板或大盘子上。用刀或干净的剪刀，将玉米饼切成四等份。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在每个玉米饼四分之一上放置 1 片生菜叶，修剪叶子，使其不会悬挂在玉米饼边缘。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将 1/4 的鸡肉混合物放在每片生菜叶的中间。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "将玉米饼卷成圆锥体，两个直边合在一起，弯曲的边缘形成圆锥体的开口。像三明治一样吃！"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "在 2 小时内将剩菜冷藏。"
    }
  ],
