{
  "id": "b041d2657f8593eb50a1cb3ed40fe1f7",
  "title": "拉面煎锅",
  "min_age_month": 12,
  "tags": [],
  "difficulty": 1,
  "time_cost": 0,
  "cover_image": "images/81a55cacc3c1d7677eb75dab67ba8a15.webp",
  "nutrition_tip": "用更健康的自制调味料和蔬菜来提升你的面条包装......",
  "ingredients": [],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "在大煎锅中加热油。加入洋葱和胡萝卜，炒至软（约 5 分钟）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在微波炉中解冻西兰花混合物并沥干。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将西兰花混合物和煮熟的豆腐放入煎锅中。搅拌并加热（约1-2分钟）。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将自制拉面调味料加入肉汤中，然后放入煎锅中搅拌。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将拉面分开。当肉汤沸腾时加入煎锅。搅拌使面条湿润。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "盖上煎锅，煮至熟（约 2 分钟）。立即上菜。"
    }
  ],
  "warnings": [],
