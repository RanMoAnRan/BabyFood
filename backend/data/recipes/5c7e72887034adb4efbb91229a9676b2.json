{
  "id": "5c7e72887034adb4efbb91229a9676b2",
  "title": "蜂蜜核桃虾",
  "min_age_month": 12,
  "tags": [
    "Dinner",
    "Chinese"
  ],
  "difficulty": 1,
  "time_cost": 35,
  "cover_image": "images/790328f3c7726f0f5689673a5f6befae.webp",
  "nutrition_tip": "这款蜂蜜核桃虾是中式脆皮炸虾的食谱......",
  "ingredients": [
    {
      "name": "1 杯水",
      "amount": ""
    },
    {
      "name": "0.66666668653488 杯 白糖",
      "amount": ""
    },
    {
      "name": "0.5 杯核桃",
      "amount": ""
    },
    {
      "name": "4 个大蛋白",
      "amount": ""
    },
    {
      "name": "0.66666668653488 杯 mochiko（糯米粉）",
      "amount": ""
    },
    {
      "name": "1 杯煎炸植物油",
      "amount": ""
    },
    {
      "name": "1 磅大虾，去皮、去肠",
      "amount": ""
    },
    {
      "name": "0.25 杯蛋黄酱",
      "amount": ""
    },
    {
      "name": "2 汤匙蜂蜜",
      "amount": ""
    },
    {
      "name": "1 汤匙罐装甜炼乳",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在小平底锅中用大火将水和糖搅拌在一起。煮沸并加入核桃。煮2分钟，然后沥干核桃并将其放在烤盘上晾干。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将蛋白放入一个中等大小的碗中，搅打至起泡。加入年糕搅拌直至呈糊状。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在重深煎锅中用中高火加热油。将虾沾上年糕面糊，然后分批放入热油中煎至金黄色，约 5 分钟。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "用漏勺取出并用纸巾沥干。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "将蛋黄酱、蜂蜜和甜炼乳放入一个中等大小的碗中搅拌。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "加入炸好的虾，拌匀，裹上酱汁。在上面撒上蜜饯核桃即可食用。"
    }
  ],
