  "nutrition_tip": "这个巧克力纸杯蛋糕配方从头开始制作湿润、丰富的巧克力纸杯蛋糕......",
  "ingredients": [
    {
      "name": "1.3333333730698 杯 通用面粉",
      "amount": ""
    },
    {
      "name": "0.75 杯不加糖可可粉",
      "amount": ""
    },
    {
      "name": "2 茶匙泡打粉",
      "amount": ""
    },
    {
      "name": "0.25 茶匙小苏打",
      "amount": ""
    },
    {
