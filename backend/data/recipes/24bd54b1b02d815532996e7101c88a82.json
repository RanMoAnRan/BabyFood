  "id": "24bd54b1b02d815532996e7101c88a82",
  "title": "柠檬蛋糕",
  "min_age_month": 12,
  "tags": [
    "Dessert",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 60,
  "cover_image": "images/716214724a559f56e1dee5aa3876d462.webp",
  "nutrition_tip": "这个带有奶油芝士的柠檬蛋糕很容易用柠檬派馅料制作......",
  "ingredients": [
    {
      "name": "不粘烹饪喷雾",
      "amount": ""
    },
    {
      "name": "1 罐（22 盎司）柠檬派馅料",
      "amount": ""
    },
    {
      "name": "1 包（15.25 盎司）柠檬蛋糕粉",
      "amount": ""
    },
    {
      "name": "1 包（8 盎司）奶油干酪，切块",
      "amount": ""
    },
    {
      "name": "0.5 杯咸黄油，切成小块",
      "amount": ""
    },
    {
      "name": "1 个（8 盎司）容器冷冻搅打配料（例如 Cool Whip®），解冻",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 350 华氏度（175 摄氏度）。在 9x13 英寸烤盘上喷洒不粘烹饪喷雾。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "用抹刀将柠檬派馅料均匀地铺在准备好的烤盘底部。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将一半蛋糕粉均匀地撒在柠檬派馅料上。将小块奶油干酪均匀地添加到蛋糕混合物上，然后在上面均匀地铺上剩余的蛋糕混合物。添加黄油块，均匀地分布在最终蛋糕混合物层的顶部。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在预热的烤箱中烘烤 35 至 45 分钟，直至配料变成棕色且蛋糕粉全部吸收并烘烤。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "趁热将蛋糕与搅打过的配料一起上桌。"
    }
  ],
