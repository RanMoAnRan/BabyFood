  "nutrition_tip": "准备好的披萨面团里充满了奶酪和意大利辣香肠，然后烘烤这些奎…",
  "ingredients": [
    {
      "name": "1罐（13.8盎司）准备好的披萨面团",
      "amount": ""
    },
    {
      "name": "2 杯马苏里拉奶酪丝",
      "amount": ""
    },
    {
      "name": "1 包（8 盎司）意大利辣香肠片",
      "amount": ""
    },
    {
      "name": "1.5 杯新鲜磨碎的帕尔马干酪",
      "amount": ""
    },
    {
      "name": "烹饪喷雾",
      "amount": ""
    },
    {
      "name": "1 杯披萨酱",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 350 华氏度（175 摄氏度）。在烤盘上铺上羊皮纸。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将披萨面团展开到烤盘上并稍微拉伸。均匀地覆盖马苏里拉奶酪。将意大利辣香肠撒在奶酪上。在上面撒上帕尔马干酪。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将面团从最短的一端开始卷起来。将卷放在烤盘的中心。用烹饪喷雾喷洒外部。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "放入预热好的烤箱中烘烤约25分钟至金黄色。切片并与披萨酱一起食用。"
    }
  ],
