      "amount": ""
    },
    {
      "name": "1 罐（5 盎司）淡奶",
      "amount": ""
    },
    {
      "name": "3 汤匙橄榄油",
      "amount": ""
    },
    {
      "name": "1 个大鸡蛋，打散",
      "amount": ""
    },
    {
      "name": "2 茶匙南瓜派香料",
      "amount": ""
    },
    {
      "name": "5 杯通用面粉，如果需要的话可以更多",
      "amount": ""
    },
    {
      "name": "0.25 杯融化的黄油",
      "amount": ""
    },
    {
      "name": "1.25 杯红糖，包装",
      "amount": ""
    },
    {
      "name": "2 汤匙南瓜派香料",
      "amount": ""
    },
    {
      "name": "1 杯糖果糖",
      "amount": ""
    },
    {
      "name": "0.25 杯牛奶",
      "amount": ""
    },
    {
      "name": "2 汤匙黄油，融化",
      "amount": ""
    },
    {
      "name": "1 包（3 盎司）奶油干酪，软化",
      "amount": ""
    },
