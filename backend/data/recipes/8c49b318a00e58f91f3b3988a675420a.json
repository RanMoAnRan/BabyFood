  "nutrition_tip": "这个越橘脆食谱是夏季甜点，由新鲜、甜美的越橘制成......",
  "ingredients": [
    {
      "name": "6 杯越橘",
      "amount": ""
    },
    {
      "name": "0.5 茶匙柠檬汁",
      "amount": ""
    },
    {
      "name": "1 杯白糖",
      "amount": ""
    },
    {
      "name": "0.5 杯玉米淀粉",
      "amount": ""
    },
    {
      "name": "1 茶匙肉桂粉，或适量",
      "amount": ""
    },
    {
      "name": "1.3333333730698 杯 红糖",
      "amount": ""
    },
    {
      "name": "1 杯通用面粉",
      "amount": ""
    },
    {
      "name": "1 杯燕麦片",
      "amount": ""
    },
    {
      "name": "1.5 茶匙肉豆蔻粉",
      "amount": ""
    },
    {
      "name": "1.5 茶匙肉桂粉",
      "amount": ""
    },
    {
      "name": "0.66666668653488 杯融化的黄油",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 375 华氏度（190 摄氏度）。在 9x13 英寸的烤盘上涂上少许油脂。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将越橘和柠檬汁放入碗中。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将白糖、玉米淀粉和 1 茶匙肉桂放入另一个碗中；倒在越橘上，搅拌均匀。将馅料倒入准备好的平底锅中。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将红糖、面粉、燕麦、肉豆蔻粉和 1 ½ 茶匙肉桂放入碗中，直至混合。加入黄油搅拌直至开始结块；铺在越橘馅料上。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "放入预热好的烤箱中烘烤至金黄色，约30分钟。冷却 15 分钟后即可享用。"
    }
  ],
