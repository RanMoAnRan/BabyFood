{
  "id": "0b2c3d32e13a3bb7d3ac2e0a0f367c0c",
  "title": "原始幻想软糖",
  "min_age_month": 12,
  "tags": [
    "Dessert",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 75,
  "cover_image": "images/4d221a8795bb9f3890d2bd27619ce121.webp",
  "nutrition_tip": "棉花糖奶油罐背面的原始幻想软糖配方。特…",
  "ingredients": [
    {
      "name": "3 杯白糖",
      "amount": ""
    },
    {
      "name": "0.75 杯人造黄油",
      "amount": ""
    },
    {
      "name": "0.66666668653488 杯淡奶",
      "amount": ""
    },
    {
      "name": "1 袋（12 盎司）半甜巧克力片",
      "amount": ""
    },
    {
      "name": "1 罐（7 盎司）棉花糖奶油",
      "amount": ""
    },
    {
      "name": "1 杯核桃碎",
      "amount": ""
    },
    {
      "name": "1 茶匙香草精",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在 9x13 英寸的平底锅上涂抹油脂。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在一个大而重的平底锅中用中火混合糖、黄油和淡奶，搅拌以溶解糖。将混合物完全煮沸，煮 5 分钟，不断搅拌，直至混合物稍微变稠。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "离火并加入巧克力片；搅拌直至巧克力片融化并且混合物彻底混合。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "加入棉花糖奶油搅拌直至合并。加入核桃和香草。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "将软糖转移到准备好的平底锅中，然后使用抹刀将软糖均匀地摊开并压平。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "冷却至少 1 小时，然后切成方块。享受！"
    }
  ],
