  "nutrition_tip": "北京烤鸭是用香料擦整只鸭子调味而成的，然后...",
  "ingredients": [
    {
      "name": "1 只（4 磅）整只鸭子，去皮",
      "amount": ""
    },
    {
      "name": "0.5 茶匙肉桂粉",
      "amount": ""
    },
    {
      "name": "0.5 茶匙姜末",
      "amount": ""
    },
    {
      "name": "0.25 茶匙肉豆蔻粉",
      "amount": ""
    },
    {
      "name": "0.25 茶匙白胡椒粉",
      "amount": ""
    },
    {
      "name": "0.125 茶匙丁香粉",
      "amount": ""
    },
    {
      "name": "3汤匙酱油，分开",
      "amount": ""
    },
    {
      "name": "1 汤匙蜂蜜",
      "amount": ""
    },
    {
      "name": "5 个葱，分开",
      "amount": ""
    },
    {
      "name": "0.5 杯李子酱",
      "amount": ""
    },
    {
      "name": "0.25 杯切碎的酸辣酱",
      "amount": ""
    },
    {
      "name": "1.5 茶匙糖",
      "amount": ""
    },
    {
      "name": "1.5 茶匙蒸馏白醋",
      "amount": ""
    },
    {
      "name": "1 个橙子，切成圆片",
      "amount": ""
    },
    {
      "name": "1 汤匙切碎的新鲜欧芹，用于装饰",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将鸭子里里外外冲洗干净；拍干。剪掉尾巴并丢弃。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将肉桂、生姜、肉豆蔻、白胡椒和丁香放入一个小碗中混合。将 1 茶匙香料混合物撒入鸭腔中。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将 1 汤匙酱油搅拌到剩余的香料混合物中，然后均匀地涂抹在鸭子的整个外部。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将 1 个葱切成两半并将其塞入空腔内。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "盖上鸭子并冷藏至少 2 小时或最多过夜。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "将鸭胸朝上放在炒锅或锅中的架子上。蒸1小时，水蒸发后加入更多水。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "用两个大勺子将鸭子提起，沥干汁液和葱。"
    },
    {
      "step_index": 9,
      "img": "",
      "text": "将烤箱预热至 375 华氏度（190 摄氏度）。将鸭胸朝上放入烤盘中，用叉子将鸭皮全部刺破。"
    },
    {
      "step_index": 10,
      "img": "",
      "text": "将鸭子放入预热好的烤箱中烤30分钟。"
    },
    {
      "step_index": 11,
      "img": "",
      "text": "将剩余的 2 汤匙酱油和蜂蜜放入小碗中混合。将蜂蜜混合物刷在鸭子上。"
    },
    {
      "step_index": 12,
      "img": "",
      "text": "将烤箱温度提高到 500 华氏度（260 摄氏度）。烤约 5 分钟，直至表皮呈深褐色。不要让皮肤烧焦。"
    },
    {
      "step_index": 13,
      "img": "",
      "text": "将李子酱、酸辣酱、糖和醋放入一个小碗中混合。将剩余的葱切碎，放入另一个碗中。"
    },
    {
      "step_index": 14,
      "img": "",
      "text": "将整只鸭子放在盘子上，并用橙片和新鲜欧芹装饰。与梅子酱和切碎的葱一起食用。"
    }
  ],
