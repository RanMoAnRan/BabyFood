  "nutrition_tip": "学习如何用嫩烤糖南瓜制作南瓜泥。非常适合…",
  "ingredients": [
    {
      "name": "1 个糖南瓜",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。将烤箱预热至 325 华氏度（165 摄氏度）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将南瓜切成两半，从茎到基部。去除种子和果肉。用箔纸盖住每一半。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在预热的烤箱中烘烤，铝箔面朝上，直至变软，大约需要 1 小时。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将南瓜肉从半壳上刮下来，放入搅拌机中打成泥。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "拉紧以除去任何剩余的细丝碎片。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "使用或存放在冷冻安全袋中。"
    }
  ],
