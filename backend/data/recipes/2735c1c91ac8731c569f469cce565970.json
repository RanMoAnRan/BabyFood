  "nutrition_tip": "这个馅饼是素食的。土豆、蘑菇、花椰菜、青豆和……",
  "ingredients": [
    {
      "name": "2 汤匙橄榄油",
      "amount": ""
    },
    {
      "name": "8 盎司蘑菇，切片",
      "amount": ""
    },
    {
      "name": "1 个洋葱，切碎",
      "amount": ""
    },
    {
      "name": "1 瓣大蒜，切碎",
      "amount": ""
    },
    {
      "name": "2 个大胡萝卜，切丁",
      "amount": ""
    },
    {
      "name": "2 个土豆，去皮切丁",
      "amount": ""
    },
    {
      "name": "2 茎芹菜，切成 1/4 英寸宽",
      "amount": ""
    },
    {
      "name": "2 杯花椰菜小花",
      "amount": ""
    },
    {
      "name": "1 杯新鲜青豆，修剪并折成 1/2 英寸的碎片",
      "amount": ""
    },
    {
      "name": "3 杯蔬菜汤",
      "amount": ""
    },
    {
      "name": "1 茶匙粗盐",
      "amount": ""
    },
    {
      "name": "1 茶匙黑胡椒粉",
      "amount": ""
    },
    {
