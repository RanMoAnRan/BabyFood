{
  "id": "d0e0842248260bfbcabbdd46e798a010",
  "title": "简单的花生酱花",
  "min_age_month": 12,
  "tags": [
    "Dessert",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 50,
  "cover_image": "images/e7dc2e3476c1ce1b427234466976bbce.webp",
  "nutrition_tip": "这些花生酱花饼干制作简单，而且非常完美……",
  "ingredients": [
    {
      "name": "1 3/4 杯白糖",
      "amount": ""
    },
    {
      "name": "1 罐（18 盎司）光滑花生酱",
      "amount": ""
    },
    {
      "name": "2 个鸡蛋",
      "amount": ""
    },
    {
      "name": "36 个牛奶巧克力糖果之吻（例如 Hershey's Kisses®），未包装",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集原料。将烤箱预热至 325 华氏度（165 摄氏度）。将 1/2 杯糖放入浅碗中。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将花生酱、剩余的 1 ¼ 杯糖和鸡蛋放入搅拌碗中搅拌直至充分混合。搓成36个小球。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将球放入预留的糖中滚动直至涂上糖衣，然后以 1 英寸间隔排列在未涂油的烤盘上。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在预热的烤箱中烘烤 12 到 14 分钟，直至底部呈浅棕色且边缘开始破裂。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "从烤箱中取出，立即将一个巧克力吻压入每块饼干的中心。在烤盘上冷却 1 到 2 分钟，然后转移到金属架上完全冷却，大约需要 15 分钟。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "享受吧！"
    }
  ],
