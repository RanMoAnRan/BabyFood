  "nutrition_tip": "这个经典的鸡肉沙拉食谱很容易制作，非常适合使用剩菜......",
  "ingredients": [
    {
      "name": "0.5 杯漂白杏仁片",
      "amount": ""
    },
    {
      "name": "0.5 杯蛋黄酱",
      "amount": ""
    },
    {
      "name": "1 汤匙柠檬汁",
      "amount": ""
    },
    {
      "name": "0.25 茶匙黑胡椒粉",
      "amount": ""
    },
    {
      "name": "2 杯切碎的熟鸡肉",
      "amount": ""
    },
    {
      "name": "1 茎芹菜，切碎",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将杏仁放入煎锅中，中低火加热。煮至金黄色并烘烤，经常摇晃并仔细观察，因为它们很容易燃烧。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将蛋黄酱、柠檬汁和胡椒粉放入一个中等大小的碗中，直至混合。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "加入鸡肉、烤杏仁和芹菜；搅拌直至完全混合。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "享受吧！"
    }
  ],
