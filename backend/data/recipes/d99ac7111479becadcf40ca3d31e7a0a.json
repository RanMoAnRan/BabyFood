{
  "id": "d99ac7111479becadcf40ca3d31e7a0a",
  "title": "酪乳馅饼",
  "min_age_month": 12,
  "tags": [
    "Dessert",
    "Pie",
    "Southern",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 110,
  "cover_image": "images/71c3a869d7474d84384548b9210fccfc.webp",
  "nutrition_tip": "这个酪乳派很容易用酪乳、鸡蛋、黄油和糖搅拌……",
  "ingredients": [
    {
      "name": "3 个鸡蛋",
      "amount": ""
    },
    {
      "name": "1.5 杯白糖",
      "amount": ""
    },
    {
      "name": "0.5 杯黄油，软化",
      "amount": ""
    },
    {
      "name": "3 汤匙通用面粉",
      "amount": ""
    },
    {
      "name": "1 杯酪乳",
      "amount": ""
    },
    {
      "name": "1 汤匙柠檬汁",
      "amount": ""
    },
    {
      "name": "1 茶匙香草精",
      "amount": ""
    },
    {
      "name": "0.125 茶匙新鲜磨碎的肉豆蔻",
      "amount": ""
    },
    {
      "name": "1 个（9 英寸）未烘烤的馅饼皮",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。将烤箱预热至 350 华氏度（175 摄氏度）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将鸡蛋放入一个大碗中，用电动搅拌机搅拌直至起泡。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "加入糖、黄油和面粉；打至光滑。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "加入酪乳、柠檬汁、香草和肉豆蔻。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "倒入馅饼壳中。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "在预热的烤箱中烘烤 40 至 60 分钟，直至中心变硬。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "从烤箱中取出并冷却 1 小时，然后食用。"
    }
  ],
