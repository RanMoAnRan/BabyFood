  "nutrition_tip": "这个蓝莓松饼食谱与甜肉桂面包屑的配料很容易制作......",
  "ingredients": [
    {
      "name": "1.5 杯通用面粉",
      "amount": ""
    },
    {
      "name": "0.75 杯白糖",
      "amount": ""
    },
    {
      "name": "2 茶匙泡打粉",
      "amount": ""
    },
    {
      "name": "0.5 茶匙盐",
      "amount": ""
    },
    {
      "name": "0.33333334326744 杯植物油",
      "amount": ""
    },
    {
      "name": "1 个鸡蛋",
      "amount": ""
    },
    {
      "name": "0.33333334326744 杯牛奶，或根据需要更多",
      "amount": ""
    },
    {
      "name": "1 杯新鲜蓝莓",
      "amount": ""
    },
    {
      "name": "0.5 杯白糖",
      "amount": ""
    },
    {
      "name": "0.33333334326744 杯通用面粉",
      "amount": ""
    },
    {
