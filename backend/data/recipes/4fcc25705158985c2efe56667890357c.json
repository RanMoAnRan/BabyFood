  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将烤箱预热至 400 华氏度（200 摄氏度）。在 8 个松饼杯上涂上油脂或铺上纸垫。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "制作松饼：在一个大碗中将面粉、糖、泡打粉和盐一起搅拌。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将油倒入小液体量杯中。加入鸡蛋和足够的牛奶至1杯标记；搅拌直至混合。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "倒入面粉混合物中，搅拌直至面糊混合。拌入蓝莓；将面糊放在一边。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "制作面包屑配料：将糖、面粉、黄油和肉桂放入一个小碗中。用叉子搅拌直至易碎。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "将面糊舀入准备好的松饼杯中，填满至顶部。撒上面包屑。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "在预热的烤箱中烘烤 20 到 25 分钟，直到插入松饼中心的牙签拔出来时是干净的。享受！"
    }
  ],
