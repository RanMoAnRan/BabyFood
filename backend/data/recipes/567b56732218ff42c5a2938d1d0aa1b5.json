  ],
  "difficulty": 1,
  "time_cost": 60,
  "cover_image": "images/33cfa7ce7bdaea660f5221caffc3045c.webp",
  "nutrition_tip": "这个奶酪土豆砂锅菜有很多碎薯饼和脆皮......",
  "ingredients": [
    {
      "name": "不粘烹饪喷雾",
      "amount": ""
    },
    {
      "name": "1 罐（10.5 盎司）浓缩奶油鸡汤",
      "amount": ""
    },
    {
      "name": "2 杯酸奶油",
      "amount": ""
    },
    {
      "name": "1 茶匙盐",
      "amount": ""
    },
    {
      "name": "0.25 茶匙黑胡椒粉",
      "amount": ""
    },
    {
      "name": "2 杯切达干酪丝",
      "amount": ""
    },
    {
      "name": "0.33333334326744 杯 葱片",
      "amount": ""
    },
    {
      "name": "1 包（30 盎司）Ore-Ida® 碎土豆丝",
      "amount": ""
    },
    {
      "name": "2 杯碎玉米片麦片",
      "amount": ""
    },
    {
      "name": "0.25 杯黄油，融化",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集原料。将烤箱预热至 350 华氏度（175 摄氏度）。用不粘喷雾剂喷洒 9x13 英寸烤盘。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将酸奶油、浓缩汤、盐和胡椒粉放入一个大碗中混合。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "加入切达干酪、葱和土豆煎至充分混合。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "均匀地铺入准备好的烤盘中。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将碎麦片和融化的黄油放入一个中等大小的碗中混合。均匀地撒在砂锅上。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "不盖盖子烘烤 45 到 50 分钟，直至变热并起泡。从烤箱中取出，放置 5 分钟后再食用。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "趁热享用吧！"
    }
  ],
