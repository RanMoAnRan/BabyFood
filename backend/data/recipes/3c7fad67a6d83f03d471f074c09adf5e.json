{
  "id": "3c7fad67a6d83f03d471f074c09adf5e",
  "title": "草莓椒盐卷饼沙拉",
  "min_age_month": 12,
  "tags": [
    "Dessert",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 150,
  "cover_image": "images/94ac643b6394a5e8df785a8990cd6740.webp",
  "nutrition_tip": "草莓椒盐卷饼沙拉是完美的大众喜爱的甜点，其特点是松脆......",
  "ingredients": [
    {
      "name": "2 杯碎椒盐卷饼",
      "amount": ""
    },
    {
      "name": "0.75 杯黄油，融化",
      "amount": ""
    },
    {
      "name": "3汤匙白糖",
      "amount": ""
    },
    {
      "name": "1 包（8 盎司）奶油干酪，软化",
      "amount": ""
    },
    {
      "name": "1 杯白糖",
      "amount": ""
    },
    {
      "name": "1 个（8 盎司）容器冷冻搅打配料，解冻",
      "amount": ""
    },
    {
      "name": "2 包（3 盎司）草莓味 Jell-O®",
      "amount": ""
    },
    {
      "name": "2 杯开水",
      "amount": ""
    },
    {
      "name": "2 包（10 盎司）冷冻草莓",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料并将烤箱预热至 400 华氏度（200 摄氏度）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将压碎的椒盐卷饼、融化的黄油和 3 汤匙糖一起搅拌直至充分混合；充分混合并将混合物压入 9x13 英寸烤盘的底部。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "放入预热好的烤箱中烘烤至凝固，约8至10分钟；放在一边冷却。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将奶油干酪和 1 杯糖放入一个大碗中。用电动搅拌机搅打至顺滑；拌入搅打好的配料。将混合物涂在冷却的外壳上。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将明胶溶解在沸水中。拌入仍冷冻的草莓并短暂放置。倒入并铺在奶油芝士层上；冷藏至少2小时直至凝固。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "上菜并享用！"
    }
  ],
