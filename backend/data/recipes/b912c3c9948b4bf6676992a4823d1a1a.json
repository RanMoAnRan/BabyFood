{
  "id": "b912c3c9948b4bf6676992a4823d1a1a",
  "title": "剩下的火腿土豆砂锅",
  "min_age_month": 12,
  "tags": [
    "Breakfast",
    "American",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 65,
  "cover_image": "images/78d6baa60c459ea47df16c37c7522655.webp",
  "nutrition_tip": "这个奶酪火腿土豆砂锅结合了剩下的节日火腿和土豆......",
  "ingredients": [
    {
      "name": "6 个小土豆，去皮并切成 1/2 英寸的方块",
      "amount": ""
    },
    {
      "name": "7 汤匙黄油，分开",
      "amount": ""
    },
    {
      "name": "0.667 磅剩下的熟火腿，切成 1/2 英寸的方块",
      "amount": ""
    },
    {
      "name": "1 个小洋葱，切碎",
      "amount": ""
    },
    {
      "name": "3 汤匙通用面粉",
      "amount": ""
    },
    {
      "name": "1.5 杯牛奶",
      "amount": ""
    },
    {
      "name": "盐和黑胡椒粉适量",
      "amount": ""
    },
    {
      "name": "1 包（8 盎司）切达干酪丝",
      "amount": ""
    },
    {
      "name": "0.25 杯面包屑",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将土豆放入大锅中，盖上盐水；煮沸。将火调至中低，煮 10 至 15 分钟直至变软。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "同时，将烤箱预热至 350 华氏度（175 摄氏度）。在 1 ½ 夸脱的烤盘上涂上油脂。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "当土豆快吃完时，在平底锅中用中火融化 3 汤匙黄油。加入火腿和洋葱；煮约 5 分钟，搅拌直至洋葱变软并变成半透明。从火上移开。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "沥干土豆；添加到火腿混合物中并搅拌混合。转移到准备好的烤盘中。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将剩余的 4 汤匙黄油放入平底锅中，用中火融化。加入面粉，搅拌约 5 分钟，直至混合物变成糊状并呈浅金黄色。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "将牛奶逐渐搅拌到面粉混合物中；用盐和黑胡椒调味。继续烹饪并搅拌直至变稠，大约 2 分钟。将火调至中低，加入切达干酪搅拌直至融化。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "将奶酪酱倒在火腿和土豆上。在上面撒上面包屑。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "在预热的烤箱中烘烤 25 至 30 分钟，直至酱汁起泡并呈棕色。"
    },
    {
      "step_index": 9,
      "img": "",
      "text": "趁热享用吧！"
    }
  ],
