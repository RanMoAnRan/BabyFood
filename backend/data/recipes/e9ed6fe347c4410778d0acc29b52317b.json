  "nutrition_tip": "红色天鹅绒镂空饼干，里面充满了甜巧克力片和奶油奶酪…",
  "ingredients": [
    {
      "name": "1 杯红糖",
      "amount": ""
    },
    {
      "name": "0.75 杯无盐黄油，软化",
      "amount": ""
    },
    {
      "name": "0.5 杯白糖",
      "amount": ""
    },
    {
      "name": "0.75 杯淡酸奶油",
      "amount": ""
    },
    {
      "name": "4 汤匙红色食用色素",
      "amount": ""
    },
    {
      "name": "1 个鸡蛋",
      "amount": ""
    },
    {
      "name": "3 杯通用面粉，分开",
      "amount": ""
    },
    {
      "name": "4 汤匙黑可可粉（例如 Hershey's® Special Dark®）",
      "amount": ""
    },
    {
      "name": "3 汤匙不加糖可可粉",
      "amount": ""
    },
    {
      "name": "0.5 茶匙小苏打",
      "amount": ""
    },
    {
      "name": "0.5 茶匙盐",
      "amount": ""
    },
    {
      "name": "4.25 杯糖粉，分开",
      "amount": ""
    },
    {
      "name": "4 包（8 盎司）Neufchatel 奶酪，软化",
      "amount": ""
    },
    {
      "name": "1 杯黄油，软化",
      "amount": ""
    },
    {
      "name": "2 茶匙香草精",
      "amount": ""
    },
    {
      "name": "1 包（12 盎司）微型半甜巧克力片",
      "amount": ""
    },
    {
      "name": "0.25 杯糖粉",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将红糖、黄油和白糖放入一个大碗中；用电动搅拌机搅拌直至光滑且呈奶油状。加入酸奶油、食用色素和鸡蛋。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将 2 1/2 杯面粉、黑可可粉、普通可可粉、小苏打和盐放入另一个碗中。逐渐将面粉混合物搅拌到黄油混合物中，直至充分混合。将面团放入冰箱冷藏至少1小时。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将烤箱预热至 375 华氏度（190 摄氏度）。在烤盘上铺上一张涂有油脂和面粉的羊皮纸。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将剩余的 1/2 杯面粉撒在干净、干燥的表面上，并用一些面粉涂在擀面杖上。将冷冻面团擀成约 1/4 英寸的厚度，然后用您喜欢的任何形状的饼干切刀切饼干。将间隔 2 英寸放在准备好的烤盘上。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "在预热的烤箱中分批烘烤，直到饼干接触后立即反弹，大约需要7分钟。在烤盘上冷却 1 分钟，然后移至金属架上完全冷却，再冷却 8 至 10 分钟。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "在一个大碗中搅拌 4 杯糖粉、Neufchatel 奶酪、黄油和香草精，直至呈奶油状。拌入巧克力片。将糖霜转移到可重新密封的塑料袋中。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "从塑料袋上剪下一个角，然后在 1/2 饼干上涂上糖霜。上面放上剩余的饼干，撒上剩余的 1/4 杯糖粉。"
    }
  ],
