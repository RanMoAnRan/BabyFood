{
  "id": "a88fccf3bc50b148c6ae8d7405b19be8",
  "title": "超越基本的烤奶酪",
  "min_age_month": 12,
  "tags": [],
  "difficulty": 1,
  "time_cost": 0,
  "cover_image": "images/ce041f656132bb9577738f4b2ce702ff.webp",
  "nutrition_tip": "使用不同的方法将这个经典的最爱从普通提升到非凡......",
  "ingredients": [],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "用中火加热平底锅。如果需要，在平底锅上喷上一层薄薄的油/油喷雾。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将一片面包放入锅中。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将哈里萨辣酱（或其他美味酱）舀到一片上，然后均匀地铺开。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "加入一半磨碎的奶酪，均匀地铺开。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "添加蔬菜，并在上面放上剩余的奶酪，确保覆盖蔬菜。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "将三明治每面烤三分钟，或直到切片变成完美的棕色。将三明治沿对角线切成薄片，搭配沙拉、蔬菜汤和/或时令水果享用。"
    }
  ],
