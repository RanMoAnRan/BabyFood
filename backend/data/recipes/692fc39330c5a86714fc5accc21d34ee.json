  "cover_image": "images/c283f98285b67b4983c3dffdd54828ea.webp",
  "nutrition_tip": "这个多汁的感恩节火鸡食谱与她一起制作出万无一失的烤火鸡......",
  "ingredients": [
    {
      "name": "2 汤匙干欧芹",
      "amount": ""
    },
    {
      "name": "2 汤匙干迷迭香粉",
      "amount": ""
    },
    {
      "name": "2 汤匙擦干鼠尾草",
      "amount": ""
    },
    {
      "name": "2 汤匙干百里香叶",
      "amount": ""
    },
    {
      "name": "1 汤匙柠檬胡椒调味料",
      "amount": ""
    },
    {
      "name": "1 汤匙盐",
      "amount": ""
    },
    {
      "name": "1 只（15 磅）整只火鸡，去掉脖子和内脏",
      "amount": ""
    },
    {
      "name": "1 个中等大小的橙子，切成 8 块",
      "amount": ""
    },
    {
      "name": "1 个中等大小的洋葱，切成大块",
      "amount": ""
    },
    {
      "name": "1 根中等大小的胡萝卜，切成 1/2 英寸的片",
      "amount": ""
    },
    {
      "name": "2 茎芹菜，切成 1/2 英寸的片",
      "amount": ""
    },
    {
      "name": "1 瓶（750 毫升）香槟",
      "amount": ""
    },
    {
      "name": "1 罐（14.5 盎司）鸡汤",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 350 华氏度（175 摄氏度）。在烤盘上铺上足够的铝箔，将火鸡包裹起来。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将欧芹、迷迭香、鼠尾草、百里香、柠檬胡椒调味料和盐放入小碗中搅拌。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将草药混合物擦入火鸡腔内；用橙子、洋葱、胡萝卜和芹菜填充。用厨房绳将火鸡腿绑在一起；将翅膀收在身体后面。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将火鸡放在烤盘的箔纸上。将香槟和鸡汤倒在火鸡上，让一些进入火鸡的空腔。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将铝箔纸放在火鸡周围；尽量不要让箔纸接触到火鸡。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "在预热的烤箱中烤火鸡，直至汁液清澈，需要 2.5 至 3 小时。揭开火鸡的面纱；继续煮30到60分钟，直到皮肤变成金黄色。将即时读数温度计插入大腿最厚的部分（靠近骨头），读数应为 180 华氏度（80 摄氏度）。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "将火鸡从烤箱中取出，盖上两张铝箔；雕刻前在温暖的地方休息 10 至 15 分钟。"
    }
  ],
