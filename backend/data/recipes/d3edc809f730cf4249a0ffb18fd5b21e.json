{
  "id": "d3edc809f730cf4249a0ffb18fd5b21e",
  "title": "七层饼干棒",
  "min_age_month": 12,
  "tags": [
    "Dessert",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 35,
  "cover_image": "images/2b2beec844da1355fcb719d2832c6557.webp",
  "nutrition_tip": "这些 7 层饼干配有奶油糖果、椰子、巧克力和碎坚果…",
  "ingredients": [
    {
      "name": "1.5 杯全麦饼干屑",
      "amount": ""
    },
    {
      "name": "0.5 杯黄油或人造黄油，融化",
      "amount": ""
    },
    {
      "name": "1 罐（14 盎司）EAGLE BRAND® 甜炼乳",
      "amount": ""
    },
    {
      "name": "1 杯半甜巧克力片",
      "amount": ""
    },
    {
      "name": "1 杯奶油糖果味薯片",
      "amount": ""
    },
    {
      "name": "1.3333333730698 杯 椰子片",
      "amount": ""
    },
    {
      "name": "1 杯碎坚果",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 350 华氏度（175 摄氏度）或 325 华氏度（165 摄氏度）（对于玻璃烤盘）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将全麦饼干屑和黄油在一个小碗中混合直至混合。将面包屑混合物牢固地压在 13x9 英寸烤盘的底部。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将甜炼乳均匀地倒在面包屑混合物上；均匀地铺上巧克力片和奶油糖果片。上面放上椰子片，撒上切碎的坚果；用叉子用力按下。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在预热的烤箱中烘烤约 25 分钟，直至呈浅棕色。凉爽的。如果需要的话可以冷却一下。切成条状或钻石状。室温下盖好保存。"
    }
  ],
