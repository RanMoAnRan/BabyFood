  "cover_image": "images/7e1fab968d26f7507f24a72e331c53b3.webp",
  "nutrition_tip": "薄荷馅饼是用糖果制造商制作的。糖、薄荷提取物、...",
  "ingredients": [
    {
      "name": "0.75 杯甜炼乳",
      "amount": ""
    },
    {
      "name": "1.5 茶匙薄荷提取物",
      "amount": ""
    },
    {
      "name": "4 杯糖果糖",
      "amount": ""
    },
    {
      "name": "3 杯半甜巧克力片",
      "amount": ""
    },
    {
      "name": "2 茶匙起酥油",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "在烤盘上铺上蜡纸。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将炼乳和薄荷提取物混合在一个大碗中；加入足够的糖果&#334;糖，一次一点，形成不再粘的硬面团。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将薄荷混合物制成 1 英寸的球并放在蜡纸上；用手指压扁，形成肉饼。让肉饼在室温下干燥两个小时，翻转一次。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在中型平底锅中用小火搅拌巧克力和起酥油直至融化；从火上移开。将肉饼放在叉子的尖头上，然后将叉子放入巧克力混合物中，一次一个地浸入巧克力中；用叉子敲击锅的边缘，抖掉多余的东西。将肉饼滑回蜡纸上，放入冰箱冷藏直至凝固。"
    }
  ],
