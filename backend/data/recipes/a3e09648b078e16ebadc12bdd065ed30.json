  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集原料。将烤箱预热至 350 华氏度（175 摄氏度）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将切好的桃子均匀地放入 8x8 英寸的烤盘中。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "使用糕点刀将面粉、红糖、黄油、肉桂和盐放入碗中混合直至酥脆。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将燕麦拌入面粉混合物中。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将混合物均匀地撒在桃子上，轻轻按下。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "在预热的烤箱中烘烤约 30 分钟，直至表面酥脆并呈金黄色。享受！"
    }
  ],
