{
  "id": "5014187bd30db0406be7312e25551ae6",
  "title": "苹果酿鸡胸肉",
  "min_age_month": 12,
  "tags": [
    "Dinner",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 40,
  "cover_image": "images/91b081631e38cd3ad4743ced28df1887.webp",
  "nutrition_tip": "这个食谱在鸡胸肉中塞满切碎的苹果、切达干酪和面包……",
  "ingredients": [
    {
      "name": "0.5 杯切碎的苹果",
      "amount": ""
    },
    {
      "name": "2 汤匙切达干酪丝",
      "amount": ""
    },
    {
      "name": "1 汤匙 意大利式干面包屑",
      "amount": ""
    },
    {
      "name": "2 个去皮去骨鸡胸肉",
      "amount": ""
    },
    {
      "name": "1 汤匙黄油",
      "amount": ""
    },
    {
      "name": "0.25 杯干白葡萄酒",
      "amount": ""
    },
    {
      "name": "0.25 杯水",
      "amount": ""
    },
    {
      "name": "1 汤匙水",
      "amount": ""
    },
    {
      "name": "1.5 茶匙玉米淀粉",
      "amount": ""
    },
    {
      "name": "1 汤匙切碎的新鲜欧芹，用于装饰",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将苹果、切达干酪和面包屑放入碗中。放在一边。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将鸡胸肉放在坚固、水平表面上的两张蜡纸之间；用肉槌光滑的一面将鸡肉捣成 1/4 英寸厚。将苹果混合物分装在鸡胸肉之间，摊开，然后卷起每个鸡胸肉。用牙签固定。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在 7 英寸煎锅中用中火融化黄油。添加填充的乳房；煮至全部变成褐色。加入酒和 1/4 杯水；盖上锅盖，小火煮 15 至 20 分钟，直至鸡肉不再呈粉红色且汁液流干净。插入乳房最厚部分的即时读数温度计读数应至少为 165 华氏度（74 摄氏度）。将鸡胸肉转移到盘子上，将汁液留在煎锅中。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将 1 汤匙水和玉米淀粉放入小碗中搅拌至光滑；在煎锅中搅拌成汁。煮并搅拌直至酱汁变稠。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将酱汁倒在鸡肉上；用欧芹装饰。"
    }
  ],
