  "nutrition_tip": "这个椰子派食谱有一个简单的馅料，用椰子片制成，而且简单……",
  "ingredients": [
    {
      "name": "1 杯白糖",
      "amount": ""
    },
    {
      "name": "2 汤匙通用面粉",
      "amount": ""
    },
    {
      "name": "3 个大鸡蛋",
      "amount": ""
    },
    {
      "name": "0.5 杯黄油，软化",
      "amount": ""
    },
    {
      "name": "1 杯牛奶",
      "amount": ""
    },
    {
      "name": "1 茶匙香草精",
      "amount": ""
    },
    {
      "name": "1 杯椰子片",
      "amount": ""
    },
    {
      "name": "1 个（9 英寸）未烘烤的馅饼皮",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 300 华氏度（150 摄氏度）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在一个大碗中将糖和面粉混合在一起。加入鸡蛋和黄油，搅拌均匀。加入牛奶和香草精搅拌直至混合。拌入椰子。倒入准备好的馅饼皮中。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在预热好的烤箱中烘烤1小时。切片前完全冷却。"
    }
  ],
