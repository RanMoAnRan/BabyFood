{
  "id": "5afe706cb6da227303adf8c97c0dd10c",
  "title": "烤侧腹牛排",
  "min_age_month": 12,
  "tags": [
    "Dinner",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 265,
  "cover_image": "images/86aecd52b7449db3fb9bab287bad20e3.webp",
  "nutrition_tip": "腌制过夜后烤侧腹牛排，使其成为永恒的美味……",
  "ingredients": [
    {
      "name": "0.5 杯植物油",
      "amount": ""
    },
    {
      "name": "0.5 杯酱油",
      "amount": ""
    },
    {
      "name": "2 汤匙水",
      "amount": ""
    },
    {
      "name": "2 汤匙红糖",
      "amount": ""
    },
    {
      "name": "1 汤匙切碎的鲜姜",
      "amount": ""
    },
    {
      "name": "2 瓣大蒜，切碎",
      "amount": ""
    },
    {
      "name": "0.25 茶匙黑胡椒粉",
      "amount": ""
    },
    {
      "name": "2 块（2.5 磅）侧腹牛排",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将油、酱油、水、红糖、生姜、大蒜和胡椒粉放入一个小碗中。混合直至合并。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在牛排两侧以十字线图案切浅斜线，小心不要完全切穿。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将牛排放入一个低平的盘子中，然后将腌料倒在上面，完全覆盖肉。盖上盖子冷藏至少 4 小时或过夜，将牛排翻面一次。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将烤箱架放置在距热源约 6 英寸的位置，并预热烤箱的烤鸡。从腌料中取出牛排，放在烤盘上。储备腌料。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "烤，偶尔刷上腌料，直至变成棕色并加热透，每面约 5 分钟。将牛排放入盘中，并用箔纸松松地覆盖。休息至少 5 分钟。顺着纹理切成 1 到 2 英寸的条。"
    }
  ],
