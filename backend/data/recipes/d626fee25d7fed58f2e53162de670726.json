{
  "id": "d626fee25d7fed58f2e53162de670726",
  "title": "不烤草莓芝士蛋糕",
  "min_age_month": 12,
  "tags": [
    "Dessert",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 240,
  "cover_image": "images/fa090df11ad65a2ca32fbb79916c6510.webp",
  "nutrition_tip": "这个简单、轻盈、蓬松的免烤芝士蛋糕有令人愉快的草莓糖浆……",
  "ingredients": [
    {
      "name": "1 包（3 盎司）草莓味明胶（例如 Jell-O®）",
      "amount": ""
    },
    {
      "name": "1 杯开水",
      "amount": ""
    },
    {
      "name": "1 包（8 盎司）奶油干酪，软化",
      "amount": ""
    },
    {
      "name": "1 杯白糖",
      "amount": ""
    },
    {
      "name": "1 茶匙香草精",
      "amount": ""
    },
    {
      "name": "1罐（5盎司）冷淡奶",
      "amount": ""
    },
    {
      "name": "1 个（9 英寸）准备好的全麦饼干皮",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将草莓明胶放入碗中，用沸水溶解；放入冰箱冷却约 20 分钟，直至变稠，但不凝固。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在碗中将奶油芝士、糖和香草精一起搅拌至光滑。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在另一个碗中用电动搅拌机搅拌淡奶，直至搅打并变稠。逐渐将草莓明胶混合物倒入淡奶中，不断搅拌。将奶油芝士混合物拌入明胶牛奶混合物中，形成芝士蛋糕馅料。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将全麦饼干皮放在烤盘或烤盘上以保持稳定性。将芝士蛋糕馅料倒入饼皮中。冷藏至少 3 1/2 小时直至蛋糕凝固。"
    }
  ],
