  "id": "f305da17167500c86a4097257961acdb",
  "title": "南瓜方块",
  "min_age_month": 6,
  "tags": [
    "Dessert",
    "American",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 35,
  "cover_image": "images/9f36939207adbb0cc10209e18ed995e4.webp",
  "nutrition_tip": "美味的南瓜块质地像蛋糕，而且没有硬皮！南瓜迷…",
  "ingredients": [
    {
      "name": "1 罐（15 盎司）南瓜泥",
      "amount": ""
    },
    {
      "name": "2 杯白糖",
      "amount": ""
    },
    {
      "name": "1 杯植物油",
      "amount": ""
    },
    {
      "name": "4 个大鸡蛋",
      "amount": ""
    },
    {
      "name": "2 杯通用面粉",
      "amount": ""
    },
    {
      "name": "2 茶匙肉桂粉",
      "amount": ""
    },
    {
      "name": "2 茶匙泡打粉",
      "amount": ""
    },
    {
      "name": "1 茶匙小苏打",
      "amount": ""
    },
    {
      "name": "0.5 茶匙丁香粉",
      "amount": ""
    },
    {
      "name": "0.5 茶匙姜末",
      "amount": ""
    },
    {
      "name": "0.5 茶匙肉豆蔻粉",
      "amount": ""
    },
    {
      "name": "0.5 茶匙盐",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。将烤箱预热至 350 华氏度（175 摄氏度）。在 9x13 英寸烤盘上涂抹油脂。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将南瓜、糖、油和鸡蛋在搅拌碗中混合直至光滑。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将面粉、肉桂、发酵粉、小苏打、丁香、生姜、肉豆蔻和盐一起过筛到另一个碗中。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将面粉混合物搅拌到南瓜混合物中，直至充分混合。均匀地铺入准备好的平底锅中。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "在预热的烤箱中烘烤 25 至 30 分钟，直到顶部轻压时顶部弹回。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "从烤箱中取出并完全冷却，然后切成 24 个方块。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "如果需要的话，在上面撒上奶油奶酪糖霜或釉料。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "上菜并享用！"
    }
  ],
