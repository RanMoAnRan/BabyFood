  "cover_image": "images/655e8e27b1d346d83bd69acbee412c96.webp",
  "nutrition_tip": "这个简单的慢炖锅焦糖苹果脆食谱的特点是酸苹果、甜汽车……",
  "ingredients": [
    {
      "name": "4 个酸苹果，去皮切片，或更多适量",
      "amount": ""
    },
    {
      "name": "2汤匙白糖",
      "amount": ""
    },
    {
      "name": "2 汤匙红糖",
      "amount": ""
    },
    {
      "name": "1.5 茶匙肉桂粉",
      "amount": ""
    },
    {
      "name": "0.33333334326744 杯焦糖配料",
      "amount": ""
    },
    {
      "name": "2 汤匙融化的黄油",
      "amount": ""
    },
    {
      "name": "1 包（15.25 盎司）黄色蛋糕粉",
      "amount": ""
    },
    {
      "name": "1 杯燕麦片",
      "amount": ""
    },
    {
      "name": "0.75 杯黄油",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将苹果、白糖、红糖和肉桂放入慢炖锅中混合；淋上焦糖配料和 2 汤匙融化的黄油。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将蛋糕粉和燕麦片放入碗中混合；用 2 刀或糕点搅拌机切入 3/4 杯黄油，直至混合物呈粗面包屑状。将燕麦混合物撒在苹果混合物上。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "盖上慢炖锅。用高火煮 2.5 至 3 小时，直至煮熟并表面呈金黄色。"
    }
  ],
