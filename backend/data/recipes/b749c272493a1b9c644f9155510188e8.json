  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 350 华氏度（175 摄氏度）。在 9x13 英寸的烤盘上涂上少许油脂。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "黄油、白糖、红糖和鸡蛋一起放入碗中，用电动搅拌机搅打至光滑；加入面粉搅拌均匀。加入发酵粉，然后加入肉桂粉。折叠苹果。转移到准备好的烤盘中。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在预热的烤箱中烘烤约 45 分钟，直至插入中心的牙签带出潮湿的面包屑。"
    }
  ],
