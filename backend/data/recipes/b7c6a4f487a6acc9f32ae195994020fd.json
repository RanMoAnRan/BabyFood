      "name": "1.5 磅苹果 - 去皮、去核、切块",
      "amount": ""
    },
    {
      "name": "1.5 磅梨 - 去皮、去核、切块",
      "amount": ""
    },
    {
      "name": "2 杯苹果醋",
      "amount": ""
    },
    {
      "name": "1.5 杯白糖",
      "amount": ""
    },
    {
      "name": "1.5 杯樱桃干",
      "amount": ""
    },
    {
      "name": "1 个大黄洋葱，切碎",
      "amount": ""
    },
    {
      "name": "1 个柠檬，去籽并切碎",
      "amount": ""
    },
    {
      "name": "2 汤匙黄芥菜籽",
      "amount": ""
    },
    {
      "name": "2 茶匙盐",
      "amount": ""
    },
    {
      "name": "1 茶匙肉桂粉",
      "amount": ""
    },
    {
      "name": "1 茶匙姜末",
      "amount": ""
    },
    {
      "name": "1 茶匙五香粉",
      "amount": ""
