  "title": "烤青豆",
  "min_age_month": 12,
  "tags": [
    "Side Dish",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 25,
  "cover_image": "images/d0e7a4d5b0ae0532f3405c029fc4ebde.webp",
  "nutrition_tip": "这些烤青豆，用橄榄油、盐和胡椒调味，煮熟了……",
  "ingredients": [
    {
      "name": "2 磅新鲜青豆，修剪",
      "amount": ""
    },
    {
      "name": "1 汤匙橄榄油，或根据需要",
      "amount": ""
    },
    {
      "name": "1 茶匙粗盐",
      "amount": ""
    },
    {
      "name": "0.5 茶匙现磨黑胡椒",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料并将烤箱预热至 400 华氏度（200 摄氏度）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将青豆冲洗干净，用纸巾拍干；铺在有边的烤盘上。在豆子上淋上橄榄油，然后用盐和胡椒调味。用手将豆子翻炒至均匀地沾上油；散布在单层中。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在预热的烤箱中烤 15 至 25 分钟，直至豆子变得脆嫩，看起来稍微干瘪，并开始出现金色焦糖斑点。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "上菜并享用！"
    }
  ],
