  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "Gather all ingredients."
    },
    {
      "step_index": 2,
      "img": "",
      "text": "Mix 1 cup sugar, butter, and egg together in a medium bowl until smooth."
    },
    {
      "step_index": 3,
      "img": "",
      "text": "Stir in molasses."
    },
    {
      "step_index": 4,
      "img": "",
      "text": "Combine flour, baking soda, cinnamon, salt, cloves, and ginger in a separate medium bowl; add to the molasses mixture and stir until well combined. Cover and chill dough for 1 hour."
    },
    {
      "step_index": 5,
      "img": "",
      "text": "Preheat the oven to 375 degrees F (190 degrees C). While the oven is preheating, roll dough into 1-inch diameter balls; roll each ball in remaining 1/2 cup white sugar before placing 2 inches apart on ungreased cookie sheets."
    },
    {
      "step_index": 6,
      "img": "",
      "text": "Bake in batches in the preheated oven until tops are cracked, about 8 to 10 minutes."
    },
    {
      "step_index": 7,
      "img": "",
      "text": "Cool on wire racks. Enjoy!"
    }
  ],
