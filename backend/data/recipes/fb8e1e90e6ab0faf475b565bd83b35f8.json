  ],
  "difficulty": 1,
  "time_cost": 110,
  "cover_image": "images/74b546f4c3446b187e39453fc2719bc3.webp",
  "nutrition_tip": "耐嚼的糖蜜饼干，加姜和肉桂调味。这些美味的饼干……",
  "ingredients": [
    {
      "name": "1.5 杯白糖，分开",
      "amount": ""
    },
    {
      "name": "0.75 杯人造黄油，融化",
      "amount": ""
    },
    {
      "name": "1 个鸡蛋",
      "amount": ""
    },
    {
      "name": "0.25 杯糖蜜",
      "amount": ""
    },
    {
      "name": "2 杯通用面粉",
      "amount": ""
    },
    {
      "name": "2 茶匙小苏打",
      "amount": ""
    },
    {
      "name": "1 茶匙肉桂粉",
      "amount": ""
    },
    {
      "name": "0.5 茶匙盐",
      "amount": ""
    },
    {
      "name": "0.5 茶匙丁香粉",
      "amount": ""
    },
    {
      "name": "0.5 茶匙姜末",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将 1 杯糖、黄油和鸡蛋放入一个中等大小的碗中混合直至光滑。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "加入糖蜜搅拌。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将面粉、小苏打、肉桂、盐、丁香和生姜混合在一个单独的中等大小的碗中；添加到糖蜜混合物中并搅拌直至充分混合。盖上面团并冷藏 1 小时。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将烤箱预热至 375 华氏度（190 摄氏度）。烤箱预热时，将面团擀成直径1英寸的球；将每个球放入剩余的 1/2 杯白糖中滚动，然后将其间隔 2 英寸放在未涂油的饼干片上。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "在预热的烤箱中分批烘烤，直至顶部破裂，大约需要 8 到 10 分钟。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "在金属架上冷却。享受！"
    }
  ],
