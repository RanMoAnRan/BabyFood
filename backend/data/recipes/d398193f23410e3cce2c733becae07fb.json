  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在汤锅中用中火加热油。加入洋葱和大蒜；炒至软，约5分钟。加入辣椒粉和牛至。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "拌入碎番茄、浓缩肉汤和水；煮沸。减少热量并煮 5 至 10 分钟。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "加入黑豆、煮熟的鸡肉、玉米、玉米粥、智利辣椒和香菜。煮10分钟。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将汤舀入单独的碗中，并在上面放上压碎的玉米饼片、鳄梨片、蒙特利杰克奶酪和葱。"
    }
  ],
