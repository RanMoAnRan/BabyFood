{
  "id": "66b9b8f5cc0d9e8bd16baf65108062b1",
  "title": "素煎锅鸡蛋",
  "min_age_month": 12,
  "tags": [],
  "difficulty": 1,
  "time_cost": 0,
  "cover_image": "images/0ac6f0698a641779c86acfb611b9bc7e.webp",
  "nutrition_tip": "快速健康的早餐，富含蛋白质、蔬菜和切达干酪。",
  "ingredients": [],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将鸡蛋与胡椒、牛至或罗勒以及奶酪放入一个中等大小的碗中搅拌。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在中型煎锅中加热油。加入洋葱、大蒜和其他蔬菜，用中火（电煎锅中 300 华氏度）煮至软。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将鸡蛋混合物倒在蔬菜上。用刀或抹刀提起鸡蛋的外边缘，使鸡蛋混合物流到锅底。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "煮至鸡蛋凝固，大约需要 6 分钟。上面放上番茄片。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "切成8块；趁热上桌。"
    }
  ],
  "warnings": [],
