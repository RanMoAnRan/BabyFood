  "nutrition_tip": "这个屡获殊荣的桃子和奶油派食谱在外皮中加入了布丁混合物，......",
  "ingredients": [
    {
      "name": "0.75 杯通用面粉",
      "amount": ""
    },
    {
      "name": "1 包（3 盎司）即煮香草布丁（非速溶）",
      "amount": ""
    },
    {
      "name": "1 茶匙泡打粉",
      "amount": ""
    },
    {
      "name": "0.5 茶匙盐",
      "amount": ""
    },
    {
      "name": "0.5 杯牛奶",
      "amount": ""
    },
    {
      "name": "3 汤匙黄油，软化",
      "amount": ""
    },
    {
      "name": "1 个大鸡蛋",
      "amount": ""
    },
    {
      "name": "1 罐（29 盎司）重糖浆桃片",
      "amount": ""
    },
    {
      "name": "1汤匙白糖",
      "amount": ""
    },
    {
      "name": "1 茶匙肉桂粉",
      "amount": ""
    },
    {
      "name": "1 包（8 盎司）奶油干酪，软化",
      "amount": ""
    },
    {
      "name": "0.5 杯白糖",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将烤箱预热至 350 华氏度（175 摄氏度）。在 10 英寸深盘馅饼盘上涂抹油脂。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将面粉、布丁粉、泡打粉和盐放入碗中搅拌均匀；加入牛奶、黄油和鸡蛋。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "用电动搅拌机将饼皮混合物搅打2分钟；转移到准备好的馅饼盘上。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "沥干桃子，保留 3 汤匙糖浆。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "将 1 汤匙糖和肉桂放入一个小碗中。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "在单独的碗中用电动搅拌机搅拌奶油干酪直至蓬松；加入 ½ 杯糖和保留的糖浆，搅拌 2 分钟。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "将切片桃子放在饼皮混合物上。"
    },
    {
      "step_index": 9,
      "img": "",
      "text": "将奶油芝士混合物舀到桃子上，距离馅饼盘边缘 1 英寸以内；在上面撒上肉桂糖。"
    },
    {
      "step_index": 10,
      "img": "",
      "text": "在预热的烤箱中烘烤 30 至 35 分钟，直至呈金黄色。"
    },
    {
      "step_index": 11,
      "img": "",
      "text": "在柜台上放置 20 分钟，然后放入冰箱冷藏至少 2 小时。"
    }
  ],
