  "title": "蘑菇牛肉马虎乔",
  "min_age_month": 12,
  "tags": [],
  "difficulty": 1,
  "time_cost": 0,
  "cover_image": "images/43a61d9fe67ad6ea86196431baa4009c.webp",
  "nutrition_tip": "切碎的蘑菇在炒时与碎肉无缝混合。交换或...",
  "ingredients": [],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将蘑菇切碎至与煮熟的碎牛肉近似的大小和质地。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "用中高火加热炒锅。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "加入碎牛肉和蘑菇，然后煮。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "炒至碎牛肉熟。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "从锅中取出蘑菇牛肉混合物。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "将洋葱和大蒜加入锅中；煮至金黄色。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "将蘑菇牛肉混合物与剩余成分一起放回锅中。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "煮约10分钟；从火上移开。"
    }
  ],
