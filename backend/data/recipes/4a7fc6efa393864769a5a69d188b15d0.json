  "title": "传统酸牛肉",
  "min_age_month": 12,
  "tags": [
    "Dinner",
    "German"
  ],
  "difficulty": 1,
  "time_cost": 3135,
  "cover_image": "images/1273b7c0bac4e8b2c2b7e9056c72b436.webp",
  "nutrition_tip": "这道酸牛肉至少要腌制两天，才能烤得味道浓郁……",
  "ingredients": [
    {
      "name": "3 磅烤牛臀肉",
      "amount": ""
    },
    {
      "name": "2 个大洋葱，切碎",
      "amount": ""
    },
    {
      "name": "1 杯红酒醋，或适量",
      "amount": ""
    },
    {
      "name": "1 杯水",
      "amount": ""
    },
    {
      "name": "1 汤匙盐",
      "amount": ""
    },
    {
      "name": "1 汤匙黑胡椒粉",
      "amount": ""
    },
    {
      "name": "1汤匙白糖",
      "amount": ""
    },
    {
      "name": "10 整个丁香，或更多品尝",
      "amount": ""
    },
    {
      "name": "2 片月桂叶，或更多品尝",
      "amount": ""
    },
    {
      "name": "2 汤匙通用面粉",
      "amount": ""
    },
    {
      "name": "盐和黑胡椒粉适量",
      "amount": ""
    },
    {
      "name": "2 汤匙植物油",
      "amount": ""
    },
    {
      "name": "10 块姜饼，碎",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤牛臀肉、洋葱、醋、水、1 汤匙盐、1 汤匙黑胡椒、糖、丁香和月桂叶放入大锅中。盖上盖子冷藏 2 至 3 天，每天翻动肉。将肉从腌料中取出，用纸巾拍干，保留腌料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在一个大碗中用盐和黑胡椒调味面粉。将面粉混合物撒在牛肉上。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在大型荷兰烤箱或锅中用中火加热植物油；将牛肉煮至各面呈棕色，大约需要 10 分钟。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将保留的腌料倒在牛肉上，盖上盖子，将火调至中低。小火煮 3 1/2 至 4 小时，直至牛肉变软。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将牛肉放入盘中并切片。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "从剩余液体中滤出固体，然后用中火继续烹饪。加入姜饼，小火煮约 10 分钟，直至肉汁变稠。将肉汁浇在牛肉片上。"
    }
  ],
