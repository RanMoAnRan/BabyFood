{
  "id": "7ac556ce13e2197b71c425303ec52563",
  "title": "绿色肉馅卷饼",
  "min_age_month": 6,
  "tags": [],
  "difficulty": 1,
  "time_cost": 0,
  "cover_image": "images/0ead45eb13aaae56573890ec5f3dbecd.webp",
  "nutrition_tip": "小馅饼，里面填满了捣碎的车前草和奶酪。",
  "ingredients": [],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "煮车前草。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "当车前草沸腾时，用橄榄油炒洋葱直至焦糖化。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将洋葱放在一边。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "当车前草叉嫩时，沥干水并保留液体。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将车前草捣碎，根据需要添加液体（应该是土豆泥的稠度）。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "加入橄榄油和盐调味，备用。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "将奶酪与捣碎的车前草和洋葱一起放在一边。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "混合面粉、糖、泡打粉和盐。"
    },
    {
      "step_index": 9,
      "img": "",
      "text": "将黄油/猪油切成小块并添加到干成分中。"
    },
    {
      "step_index": 10,
      "img": "",
      "text": "用手将黄油加入面粉中，直到面糊像面包屑一样均匀。"
    },
    {
      "step_index": 11,
      "img": "",
      "text": "添加奶油和水。"
    },
    {
      "step_index": 12,
      "img": "",
      "text": "继续混合和揉捏直至充分混合，根据需要添加面粉或更多冰水。"
    },
    {
      "step_index": 13,
      "img": "",
      "text": "它应该能做成一个漂亮的面团。"
    },
    {
      "step_index": 14,
      "img": "",
      "text": "将面团分成两半，将一半冷藏，同时处理另一半。"
    },
    {
      "step_index": 15,
      "img": "",
      "text": "不要过度揉捏面团，否则黄油会融化并改变稠度和质地。"
    },
    {
      "step_index": 16,
      "img": "",
      "text": "抓起一小块面团，做成一个球。"
    },
    {
      "step_index": 17,
      "img": "",
      "text": "在工作区撒上面粉，然后将球擀薄至垒球大小。"
    },
    {
      "step_index": 18,
      "img": "",
      "text": "用一汤匙左右的填充物填充。"
    },
    {
      "step_index": 19,
      "img": "",
      "text": "在中间加一点奶酪和洋葱。"
    },
    {
      "step_index": 20,
      "img": "",
      "text": "将面团折叠成半圆形，并用叉子卷曲边缘。"
    },
    {
      "step_index": 21,
      "img": "",
      "text": "对所有剩余的面团和馅料重复此过程。"
    },
    {
      "step_index": 22,
      "img": "",
      "text": "在大锅中加热油煎炸。"
    },
    {
      "step_index": 23,
      "img": "",
      "text": "将肉馅卷饼煎至金黄色。"
    }
  ],
