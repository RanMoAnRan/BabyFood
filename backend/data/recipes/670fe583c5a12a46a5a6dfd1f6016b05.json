    "Australian"
  ],
  "difficulty": 1,
  "time_cost": 140,
  "cover_image": "images/b7153c0aaa27ce488657aa2dfbf98c55.webp",
  "nutrition_tip": "Banoffee pavlova 是一种烤蛋白酥皮，上面撒上香蕉片、焦糖酱、…",
  "ingredients": [
    {
      "name": "1 杯细糖或超细糖",
      "amount": ""
    },
    {
      "name": "2 茶匙玉米淀粉",
      "amount": ""
    },
    {
      "name": "1 撮塔塔粉",
      "amount": ""
    },
    {
      "name": "4 个蛋白",
      "amount": ""
    },
    {
      "name": "1 茶匙白葡萄酒醋",
      "amount": ""
    },
    {
      "name": "1 撮盐",
      "amount": ""
    },
    {
      "name": "1 滴香草精",
      "amount": ""
    },
    {
      "name": "2 个小香蕉，切片",
      "amount": ""
    },
    {
      "name": "1 杯焦糖冰淇淋配料",
      "amount": ""
    },
    {
      "name": "2 杯加糖鲜奶油",
      "amount": ""
    },
    {
      "name": "1 汤匙磨碎的半甜巧克力，用于装饰",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 350 华氏度（175 摄氏度）。在烤盘上铺上羊皮纸或铝箔；在表面画一个 8 英寸的圆圈。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在一个小碗中将糖、玉米淀粉和塔塔粉一起搅拌。将蛋白、醋、盐和香草精放入单独的玻璃或金属碗中，用电动搅拌器搅拌直至形成软峰。逐渐撒上糖混合物；继续搅拌直至形成闪亮且坚硬的峰。将蛋白霜堆放在准备好的烤盘上画出的圆圈中；使用金属抹刀将顶部和侧面弄平。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "放入预热好的烤箱中，立即将烤箱温度降至 300 华氏度（150 摄氏度）。烘烤 1 至 1 ½ 小时，直至呈浅金黄色。关闭烤箱；将门微开，将巴甫洛娃放在里面，直到完全冷却，大约需要 1 小时。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将冷却的巴甫洛娃转移到盘子上。上桌前撒上香蕉片；在上面淋上焦糖酱。上面涂上鲜奶油；撒上巧克力。"
    }
  ],
