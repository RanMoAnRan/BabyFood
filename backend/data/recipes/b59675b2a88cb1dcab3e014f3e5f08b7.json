  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在煎锅中用中火加热橄榄油。拌入洋葱；煮约5分钟直至变软。拌入大蒜并煮1分钟。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "加入冷冻豌豆并在高汤中搅拌。用盐和胡椒调味。盖上锅盖，煮约 5 分钟，直至豌豆变软。"
    }
  ],
