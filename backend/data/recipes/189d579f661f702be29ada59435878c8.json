  "nutrition_tip": "这个酿茄子食谱可以制作出丰盛的香肠馅，并用蘑菇调味......",
  "ingredients": [
    {
      "name": "1 个茄子，纵向切成两半",
      "amount": ""
    },
    {
      "name": "0.5 杯橄榄油，分开",
      "amount": ""
    },
    {
      "name": "盐和胡椒调味",
      "amount": ""
    },
    {
      "name": "1/2 茶匙黑胡椒粉",
      "amount": ""
    },
    {
      "name": "1 磅意大利甜香肠，去壳",
      "amount": ""
    },
    {
      "name": "1 杯切碎的洋葱",
      "amount": ""
    },
    {
      "name": "1 杯新鲜蘑菇片",
      "amount": ""
    },
    {
