{
  "id": "e7488b591704b90bba50e9ec63673e55",
  "title": "烤肉串",
  "min_age_month": 12,
  "tags": [
    "Dinner",
    "Greek",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 160,
  "cover_image": "images/fb174b51f9a580d6855bbc4024c7765e.webp",
  "nutrition_tip": "美味的烤肉串，由腌制猪肉、洋葱和青椒制成……",
  "ingredients": [
    {
      "name": "0.25 杯橄榄油",
      "amount": ""
    },
    {
      "name": "0.25 杯酱油",
      "amount": ""
    },
    {
      "name": "1 个中等大小的柠檬，榨汁",
      "amount": ""
    },
    {
      "name": "3 瓣大蒜，压碎",
      "amount": ""
    },
    {
      "name": "1 茶匙干牛至",
      "amount": ""
    },
    {
      "name": "3 磅猪里脊肉，切成 1 英寸的方块",
      "amount": ""
    },
    {
      "name": "2 个中等大小的黄洋葱，切成 1 英寸的块",
      "amount": ""
    },
    {
      "name": "2 个中等大小的青椒，切成 1 英寸的块",
      "amount": ""
    },
    {
      "name": "烤肉串",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在一个大玻璃碗中将油、酱油、柠檬汁、大蒜和牛至混合在一起。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "加入猪肉、洋葱和青椒，搅拌直至裹上一层。盖上盖子并冷藏 2 至 3 小时。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将户外烤架预热至中高温，并在烤架上涂上少许油。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "从腌料中取出猪肉和蔬菜，抖掉多余的；穿在串上。丢弃剩余的腌料。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "在预热的烤架上烹饪 10 到 15 分钟，经常翻转，直到猪肉中间不再呈粉红色。插入中心的即时读数温度计读数应至少为 145 华氏度（63 摄氏度）。"
    }
  ],
