  "nutrition_tip": "制作这个秋季风味的苹果酱甜甜圈食谱，撒上糖果......",
  "ingredients": [
    {
      "name": "2 夸脱煎炸用油",
      "amount": ""
    },
    {
      "name": "2.25 杯通用面粉",
      "amount": ""
    },
    {
      "name": "1.5 茶匙泡打粉",
      "amount": ""
    },
    {
      "name": "0.5 茶匙小苏打",
      "amount": ""
    },
    {
      "name": "0.5 茶匙肉桂粉",
      "amount": ""
    },
    {
      "name": "0.5 茶匙肉豆蔻",
      "amount": ""
    },
    {
      "name": "0.25 茶匙丁香粉",
      "amount": ""
    },
    {
      "name": "0.25 茶匙盐",
      "amount": ""
    },
    {
      "name": "0.5 杯白糖",
      "amount": ""
    },
    {
      "name": "2 个大鸡蛋",
      "amount": ""
    },
    {
      "name": "0.25 杯 包装牢固的淡红糖",
      "amount": ""
    },
    {
      "name": "2 汤匙植物油",
      "amount": ""
    },
    {
      "name": "0.25 杯牛奶",
      "amount": ""
    },
    {
      "name": "1 杯不加糖的苹果酱",
      "amount": ""
    },
    {
      "name": "0.5 茶匙香草精",
      "amount": ""
