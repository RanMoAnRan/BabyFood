  "cover_image": "images/412da0b5d9a282fa71ba52ce4155d104.webp",
  "nutrition_tip": "用自制披萨面团制作馅饼比你想象的更容易......",
  "ingredients": [
    {
      "name": "1 包（0.25 盎司）活性干酵母",
      "amount": ""
    },
    {
      "name": "1 杯温水",
      "amount": ""
    },
    {
      "name": "1 汤匙橄榄油",
      "amount": ""
    },
    {
      "name": "1 茶匙白糖",
      "amount": ""
    },
    {
      "name": "1 茶匙盐",
      "amount": ""
    },
    {
      "name": "2.5 杯通用面粉，再加一些用于撒粉",
      "amount": ""
    },
    {
      "name": "1 茶匙橄榄油",
      "amount": ""
    },
    {
      "name": "1 个大鸡蛋，打散",
      "amount": ""
    },
    {
      "name": "1.5 杯切达干酪丝",
      "amount": ""
    },
    {
      "name": "0.5 杯意大利乳清干酪",
      "amount": ""
    },
    {
      "name": "0.5 杯 意大利辣香肠丁",
      "amount": ""
    },
    {
      "name": "0.5 杯切片新鲜蘑菇",
      "amount": ""
    },
    {
      "name": "1 汤匙干罗勒叶",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "制作面团：将酵母放入搅拌碗中，用温水溶解；静置约 5 分钟，直至形成泡沫。加入1汤匙油、糖、盐；加入 1 杯面粉，搅拌至光滑。逐渐加入剩余的面粉，直到面团光滑且可以使用。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将面团翻到撒有少许面粉的表面上。揉面团直至有弹性，大约需要5分钟。将 1 茶匙橄榄油放入一个大碗中；将面团放入碗中并翻转以涂上油。盖上盖子，发酵约 40 分钟，直至体积几乎翻倍。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "同时，制作馅料：将切达干酪、乳清干酪、意大利辣香肠、蘑菇和罗勒叶放入一个中等大小的碗中。充分混合，盖上盖子，冷藏至冷却。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将烤箱预热至 375 华氏度（190 摄氏度）。在烤盘上涂油脂。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "打孔面团；分成2等份。在撒了少许面粉的表面上将每块擀成 1/8 英寸厚的圆圈。每个圆圈填满 1/2 的奶酪和肉馅。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "将面团折叠到馅料上，形成半圆形。用叉子尖压边缘以密封。在每个馅饼的顶部刷上打好的鸡蛋，然后放在准备好的烤盘上。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "放入预热好的烤箱中烘烤至金黄色，约30分钟。趁热食用。"
    }
  ],
