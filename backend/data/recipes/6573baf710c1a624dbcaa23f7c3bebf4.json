  "nutrition_tip": "这种苹果酒的配方很简单，只需在家里慢煮苹果、糖……即可制作。",
  "ingredients": [
    {
      "name": "10 个大苹果，切成四等分",
      "amount": ""
    },
    {
      "name": "水，用于覆盖",
      "amount": ""
    },
    {
      "name": "0.75 杯白糖",
      "amount": ""
    },
    {
      "name": "1 汤匙肉桂粉",
      "amount": ""
    },
    {
      "name": "1 汤匙 多香粉粉",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将苹果放入一个大汤锅中；用水覆盖至少 2 英寸。加入糖、肉桂和五香粉搅拌。用中高火煮沸。不盖盖子，煮1小时。将热量降至低；盖上锅盖，煮2小时。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "用细网筛过滤苹果混合物；丢弃固体。再次通过衬有粗棉布的筛子沥干苹果酒。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "加热或冷藏苹果酒直至变冷。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "享受吧！"
    }
  ],
