  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将西葫芦切成面条状的细条（螺旋器或曼陀林非常适合此操作）。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "加入 2 茶匙盐，放入漏勺中沥干 15 至 30 分钟。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在大煎锅中用中高温加热黄油。加入西葫芦和大蒜；煮约 5 分钟，搅拌直至变软。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "用盐和胡椒调味。撒上帕尔马干酪。服务并享受。"
    }
