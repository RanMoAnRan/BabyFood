{
  "id": "b5986791fe6c363c8a1365558d52fa04",
  "title": "索帕皮拉芝士蛋糕派",
  "min_age_month": 12,
  "tags": [
    "Dessert",
    "Mexican Inspired"
  ],
  "difficulty": 1,
  "time_cost": 170,
  "cover_image": "images/02d223c8c4e4b618299052c28be2c550.webp",
  "nutrition_tip": "Sopapilla 芝士蛋糕，由多层片状新月形面团、甜奶油芝士制成……",
  "ingredients": [
    {
      "name": "烹饪喷雾",
      "amount": ""
    },
    {
      "name": "2 包（8 盎司）奶油干酪，软化",
      "amount": ""
    },
    {
      "name": "1.75 杯白糖，分开",
      "amount": ""
    },
    {
      "name": "1 茶匙墨西哥香草精",
      "amount": ""
    },
    {
      "name": "2 罐（8 盎司）冷藏月牙卷",
      "amount": ""
    },
    {
      "name": "0.5 杯黄油，室温",
      "amount": ""
    },
    {
      "name": "1 茶匙肉桂粉",
      "amount": ""
    },
    {
      "name": "0.25 杯蜂蜜",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。将烤箱预热至 350 华氏度（175 摄氏度）。在 9x13 英寸的烤盘上涂上烹饪喷雾。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将奶油芝士、1 杯糖和香草精放入碗中，搅拌至光滑。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将月牙卷面团展开，然后用擀面杖将每张面团擀成 9x13 英寸的矩形。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将一块压入准备好的烤盘底部。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将奶油奶酪混合物均匀地涂在上面。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "用剩余的新月形面团覆盖。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "用叉子将剩余的 3/4 杯糖、黄油和肉桂捣碎直至混合。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "将混合物点在面团上。"
    },
    {
      "step_index": 9,
      "img": "",
      "text": "在预热的烤箱中烘烤约 30 分钟，直至月牙形面团膨化并变成金黄色。从烤箱中取出，淋上蜂蜜。将芝士蛋糕在平底锅中完全冷却约 2 小时，然后切成 12 块。"
    }
  ],
