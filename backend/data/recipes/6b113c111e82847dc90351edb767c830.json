  ],
  "difficulty": 1,
  "time_cost": 30,
  "cover_image": "images/b6605c0b21ae13c74e3384a63648c8b1.webp",
  "nutrition_tip": "这个士力架食谱确实很受欢迎。谁不喜欢偷笑……",
  "ingredients": [
    {
      "name": "1.5 杯白糖",
      "amount": ""
    },
    {
      "name": "0.5 杯黄油，软化",
      "amount": ""
    },
    {
      "name": "0.5 杯起酥油",
      "amount": ""
    },
    {
      "name": "2 个大鸡蛋",
      "amount": ""
    },
    {
      "name": "2 茶匙香草精",
      "amount": ""
    },
    {
      "name": "2.75 杯通用面粉",
      "amount": ""
    },
    {
      "name": "2 茶匙塔塔粉",
      "amount": ""
    },
    {
      "name": "1 茶匙小苏打",
      "amount": ""
    },
    {
      "name": "0.25 茶匙盐",
      "amount": ""
    },
    {
      "name": "2汤匙白糖",
      "amount": ""
    },
    {
      "name": "2 茶匙肉桂粉",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将烤箱预热至 400 华氏度（200 摄氏度）。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "制作饼干：在一个大碗中将糖、黄油、起酥油、鸡蛋和香草精搅拌至光滑细腻。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在另一个碗中将面粉、塔塔粉、小苏打和盐一起搅拌。逐渐将干成分混合物与湿成分混合直至混合。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将面团做成核桃大小的球。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "制作肉桂糖：将糖和肉桂混合在一个小碗或带拉链的塑料袋中。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "将面团球放入肉桂糖中，滚动或摇晃直至涂上肉桂糖。将其放置在未抹油的烤盘上，间隔 2 英寸。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "在预热的烤箱中烘烤 8 到 10 分钟，直至凝固，但不要太硬，中途更换架子。"
    },
    {
      "step_index": 9,
      "img": "",
      "text": "从烤箱中取出并立即转移到金属架上冷却。"
    },
    {
      "step_index": 10,
      "img": "",
      "text": "享受吧！"
    }
  ],
