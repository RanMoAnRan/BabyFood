  "title": "真正的香肠和洋葱肉汁土豆泥",
  "min_age_month": 6,
  "tags": [
    "Dinner",
    "Irish"
  ],
  "difficulty": 1,
  "time_cost": 65,
  "cover_image": "images/13d037b4c8a0472f399e90c6b37f20b0.webp",
  "nutrition_tip": "香肠和土豆泥搭配洋葱肉汁，是英国的经典主食……",
  "ingredients": [
    {
      "name": "4 链接猪肉香肠",
      "amount": ""
    },
    {
      "name": "2 磅土豆，去皮切块",
      "amount": ""
    },
    {
      "name": "0.25 杯黄油",
      "amount": ""
    },
    {
      "name": "2 汤匙牛奶",
      "amount": ""
    },
    {
      "name": "1 茶匙干芥末粉",
      "amount": ""
    },
    {
      "name": "盐和黑胡椒粉适量",
      "amount": ""
    },
    {
      "name": "1 汤匙黄油",
      "amount": ""
    },
    {
      "name": "2 个大洋葱，切碎",
      "amount": ""
    },
    {
      "name": "6 杯牛肉汤",
      "amount": ""
    },
    {
      "name": "2 杯红酒",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 200 华氏度（95 摄氏度）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将香肠放入煎锅中，用中低火煮至棕色，每面约 5 分钟；转移到烤箱安全盘中并在预热的烤箱中保温。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将土豆放入平底锅中，中火加热，盖上水；煮沸并小火煮 10 至 15 分钟，直至土豆变软。沥干并用蒸汽干燥一两分钟。加入1/4杯黄油、牛奶、干芥末、盐和黑胡椒粉；捣碎直至蓬松光滑。放在一边。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将 1 汤匙黄油放入煎锅中，用中高火融化。加入洋葱；煮并搅拌直至半透明并开始变成棕色，大约需要 8 分钟。倒入牛肉汤和红酒；煮沸并小火煮约 10 分钟，直至体积减至一半。用盐和黑胡椒调味。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将香肠和土豆泥一起上桌；将洋葱汁倒在上面。"
    }
  ],
