  "cover_image": "images/01b404ce702dba8b141378ae1b412d8e.webp",
  "nutrition_tip": "这些釉面柠檬乳清干酪饼干是一大口柠檬的美味......",
  "ingredients": [
    {
      "name": "1 杯白糖",
      "amount": ""
    },
    {
      "name": "0.5 杯无盐黄油，软化",
      "amount": ""
    },
    {
      "name": "1 杯乳清干酪，室温",
      "amount": ""
    },
    {
      "name": "2 汤匙柠檬汁",
      "amount": ""
    },
    {
      "name": "1 汤匙杏仁提取物",
      "amount": ""
    },
    {
      "name": "0.5 茶匙柠檬皮屑",
      "amount": ""
    },
    {
      "name": "1 个大鸡蛋，室温",
      "amount": ""
    },
    {
      "name": "2 杯通用面粉",
      "amount": ""
    },
    {
      "name": "1.5 茶匙泡打粉",
      "amount": ""
    },
    {
      "name": "0.5 茶匙盐",
      "amount": ""
    },
    {
      "name": "0.5 杯糖粉",
      "amount": ""
    },
    {
      "name": "2 汤匙柠檬汁",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 350 华氏度（175 摄氏度）。在烤盘上铺上羊皮纸。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在一个大碗中用电动搅拌机低速搅拌糖和黄油直至混合。将速度调至最高，搅打至松软，约 5 分钟。加入乳清干酪、柠檬汁、杏仁提取物、柠檬皮碎和鸡蛋，中速搅拌直至充分混合。将速度降低至低速。加入面粉、泡打粉和盐；慢慢搅拌直至形成面团。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "使用饼干勺将面团放在准备好的烤盘上，间隔约 2 英寸。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在预热的烤箱中烘烤 12 至 15 分钟，直至饼干呈浅金黄色但仍然柔软。从烤箱中取出，转移到金属架上，并在结冰之前完全冷却，大约需要 30 分钟。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将糖粉和柠檬汁放入小碗中搅拌，形成光滑的糖霜。将糖霜淋在饼干上。将饼干放在一边，让柠檬釉完全干燥。"
    }
  ],
