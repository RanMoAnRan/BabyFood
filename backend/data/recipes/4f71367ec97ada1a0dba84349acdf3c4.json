  "title": "简易慢炖锅沙拉酱牛肉",
  "min_age_month": 8,
  "tags": [
    "Dinner",
    "American",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 375,
  "cover_image": "images/7b4ed78b81c2cf7822a543b7aa87888f.webp",
  "nutrition_tip": "这种简单的牛肉沙拉酱是用慢炖锅用新鲜蘑菇、红葡萄酒制成的……",
  "ingredients": [
    {
      "name": "1.5 磅炖牛肉块",
      "amount": ""
    },
    {
      "name": "盐和黑胡椒粉适量",
      "amount": ""
    },
    {
      "name": "1 个洋葱，切碎",
      "amount": ""
    },
    {
      "name": "1 罐（10.75 盎司）浓缩奶油蘑菇汤",
      "amount": ""
    },
    {
      "name": "0.25 杯水",
      "amount": ""
    },
    {
      "name": "1 汤匙干韭菜",
      "amount": ""
    },
    {
      "name": "2 瓣大蒜，切碎",
      "amount": ""
    },
    {
      "name": "1 汤匙伍斯特酱",
      "amount": ""
    },
    {
      "name": "1 块牛肉汤",
      "amount": ""
    },
    {
      "name": "0.5 杯红酒",
      "amount": ""
    },
    {
      "name": "1 汤匙玉米淀粉",
      "amount": ""
    },
    {
      "name": "1 汤匙通用面粉",
      "amount": ""
    },
    {
      "name": "1 罐（8 盎司）酸奶油",
      "amount": ""
    },
    {
      "name": "1 包（8 盎司）新鲜蘑菇片",
      "amount": ""
    },
    {
      "name": "4 盎司奶油干酪",
      "amount": ""
    },
    {
      "name": "0.5 杯切碎的新鲜欧芹",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将炖牛肉放入慢炖锅底部；用盐和胡椒调味。将洋葱铺在牛肉上。将蘑菇汤和水倒在牛肉上；加入细香葱、大蒜、伍斯特酱和牛肉汤。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将红酒、玉米淀粉和面粉放入小碗中搅拌；将混合物倒入慢炖锅中。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "低火煮 6 至 7 小时。将酸奶油、蘑菇、奶油干酪和欧芹加入牛肉混合物中搅拌；继续煮1小时以上。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "与意大利面一起食用。"
    }
  ],
