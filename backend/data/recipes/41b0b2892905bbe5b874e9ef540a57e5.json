  "nutrition_tip": "Pan de muerto 是一种甜酵母面包，或称 pan dulce，上面撒上含糖的橙子……",
  "ingredients": [
    {
      "name": "0.25 杯牛奶",
      "amount": ""
    },
    {
      "name": "0.25 杯人造黄油",
      "amount": ""
    },
    {
      "name": "0.25 杯温水（110 华氏度/45 摄氏度）",
      "amount": ""
    },
    {
      "name": "3 杯通用面粉",
      "amount": ""
    },
    {
      "name": "0.25 杯白糖",
      "amount": ""
    },
    {
      "name": "2 茶匙茴香籽",
      "amount": ""
    },
    {
      "name": "1.25 茶匙活性干酵母",
      "amount": ""
    },
    {
      "name": "0.5 茶匙盐",
      "amount": ""
    },
    {
      "name": "2 个鸡蛋，打散",
      "amount": ""
    },
    {
      "name": "1 汤匙 橙皮碎",
      "amount": ""
    },
    {
      "name": "0.25 杯白糖",
      "amount": ""
    },
    {
      "name": "0.25 杯橙汁",
      "amount": ""
    },
    {
      "name": "2 茶匙橙皮碎",
      "amount": ""
    },
    {
      "name": "2汤匙白糖",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "制作面包：在中型平底锅中用小火加热牛奶和黄油，直至黄油融化。从火上移开并加入温水。混合物温度应约为 110 华氏度（43 摄氏度）。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将 1 杯面粉、糖、茴香籽、酵母和盐放入一个大碗中。加入温牛奶混合物，然后加入鸡蛋和橙皮碎；搅拌直至充分混合。加入 1/2 杯面粉，然后继续添加更多面粉，直至面团变软。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将面团翻到撒有少许面粉的表面上；揉至光滑有弹性。将面团放入涂有少许油脂的碗中。盖上保鲜膜，放在温暖的地方发酵 1 到 2 小时，直至体积翻倍。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将面团打下来，形成一个顶部有圆形旋钮的大圆面包。将面团放在烤盘上；用保鲜膜松散地覆盖。放在温暖的地方发酵约 1 小时，直至体积增大一倍左右。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "将烤箱预热至 350 华氏度（175 摄氏度）。在预热的烤箱中烘烤 35 至 45 分钟，直至呈金黄色。在刷釉之前稍微冷却。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "制作釉料：将 1/4 杯糖、橙汁和橙皮放入小平底锅中混合。用中火煮沸并煮2分钟。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "在热面包上刷上釉料。撒上2汤匙糖。"
    }
  ],
