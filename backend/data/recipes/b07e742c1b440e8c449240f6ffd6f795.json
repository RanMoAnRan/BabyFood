{
  "id": "b07e742c1b440e8c449240f6ffd6f795",
  "title": "山核桃袋",
  "min_age_month": 12,
  "tags": [
    "Dessert",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 40,
  "cover_image": "images/d91c350833f2a3dbda159d33e8dfde75.webp",
  "nutrition_tip": "山核桃塔西很容易大批量制作，可用作节日礼物、圣诞礼物……",
  "ingredients": [
    {
      "name": "2 杯人造黄油",
      "amount": ""
    },
    {
      "name": "4 包（3 盎司）奶油奶酪",
      "amount": ""
    },
    {
      "name": "4 杯通用面粉",
      "amount": ""
    },
    {
      "name": "2.5 杯包装红糖",
      "amount": ""
    },
    {
      "name": "3 个鸡蛋",
      "amount": ""
    },
    {
      "name": "3 汤匙融化的黄油",
      "amount": ""
    },
    {
      "name": "0.5 茶匙香草精",
      "amount": ""
    },
    {
      "name": "1 撮盐",
      "amount": ""
    },
    {
      "name": "1.5 杯山核桃碎",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 350 华氏度（175 摄氏度）。给迷你挞盘或迷你松饼盘涂上油脂。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在一个大碗中用电动搅拌机将黄油和奶油干酪搅拌至光滑。加入面粉，一次 1 杯，直至混合物形成光滑的面团。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "滚成小球，压入准备好的平底锅的底部和侧面。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将红糖、鸡蛋、融化的黄油、香草精和盐放入一个中等大小的碗中，搅拌至光滑。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "拌入山核桃；将混合物倒入每个饼皮中，直至 2/3 满。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "在预热的烤箱中烘烤约 15 至 18 分钟，直至外皮呈金黄色且馅料膨胀。让平底锅短暂冷却，然后小心地将它们转移到金属架上以完全冷却。"
    }
  ],
