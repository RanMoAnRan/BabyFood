  "id": "3f9f3560eef228fc2a8207b33a23d431",
  "title": "波本山核桃派",
  "min_age_month": 12,
  "tags": [
    "Dessert",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 45,
  "cover_image": "images/a882cc6ecdb4a93275f556a20a44244b.webp",
  "nutrition_tip": "这个粘糊糊的波本山核桃派将香草换成了波本威士忌，给了这个经典的洒红节……",
  "ingredients": [
    {
      "name": "0.5 杯白糖",
      "amount": ""
    },
    {
      "name": "0.5 杯红糖",
      "amount": ""
    },
    {
      "name": "3汤匙无盐黄油，融化",
      "amount": ""
    },
    {
      "name": "0.5 杯淡玉米糖浆",
      "amount": ""
    },
    {
      "name": "3 个大鸡蛋，打散",
      "amount": ""
    },
    {
      "name": "2 汤匙波本威士忌",
      "amount": ""
    },
    {
      "name": "2 杯半山核桃",
      "amount": ""
    },
    {
      "name": "1 个（9 英寸）未烘烤的深盘馅饼皮",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有材料。将烤箱预热至 375 华氏度（190 摄氏度）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将白糖、红糖和黄油在碗中混合。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "加入玉米糖浆、鸡蛋和波本威士忌，然后拌入山核桃。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将混合物倒入馅饼皮中。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "在预热好的烤箱中烘烤10分钟。将热量降低至 350 华氏度（175 摄氏度）并继续烘烤 25 到 30 分钟，直至中心凝固但略有摇晃。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "从烤箱中取出并在切片前在金属架上完全冷却。馅饼冷却后就会凝固。"
    }
  ],
