  "nutrition_tip": "肉桂烤柑橘食谱 烤柑橘，一种芳香水果，搭配红酒......",
  "ingredients": [
    {
      "name": "3 个榅桲，未剥皮，洗净，切半，去核",
      "amount": ""
    },
    {
      "name": "18 整个丁香",
      "amount": ""
    },
    {
      "name": "1.5 杯水",
      "amount": ""
    },
    {
      "name": "0.5 杯波特酒",
      "amount": ""
    },
    {
      "name": "3 根肉桂棒",
      "amount": ""
    },
    {
      "name": "0.33333334326744 杯白糖",
      "amount": ""
    },
    {
      "name": "0.33333334326744 杯浓奶油，搅打",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 375 华氏度（190 摄氏度）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在每半个榅桲中压入 3 颗丁香；将木瓜切面朝下放入烤盘中。将水、酒和肉桂棒加入锅中；在水果上撒上糖。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在预热的烤箱中烘烤 35 至 40 分钟，直至呈浅棕色。将木瓜翻面；继续烘烤约10分钟直至变软。稍微冷却木瓜，大约 10 分钟。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将每半个榅桲与烤盘中的一汤匙果汁一起盛上；半块加生奶油。"
    }
  ],
