{
  "id": "1a9406ba0c8a54e308a4add78c5a4635",
  "title": "简单的初学者火鸡与馅料",
  "min_age_month": 12,
  "tags": [
    "Dinner",
    "American",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 240,
  "cover_image": "images/1c882d5e41ab5b1bfd9b469b1a1ad542.webp",
  "nutrition_tip": "这个简单的火鸡和馅料食谱非常适合初学者寻找步骤......",
  "ingredients": [
    {
      "name": "12 磅整只火鸡",
      "amount": ""
    },
    {
      "name": "1.5 杯水",
      "amount": ""
    },
    {
      "name": "5 汤匙黄油，分开",
      "amount": ""
    },
    {
      "name": "1 包（6 盎司）干面包馅料混合物",
      "amount": ""
    },
    {
      "name": "1 杯切碎的芹菜",
      "amount": ""
    },
    {
      "name": "0.25 杯切碎的洋葱",
      "amount": ""
    },
    {
      "name": "4 片烤白面包，撕成小块",
      "amount": ""
    },
    {
      "name": "盐和黑胡椒粉适量",
      "amount": ""
    },
    {
      "name": "2 汤匙植物油",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 350 华氏度（175 摄氏度）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "取出并丢弃内脏。用纸巾将火鸡拍干。将火鸡放入浅烤盘中。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将水和 4 汤匙黄油放入中型平底锅中煮沸。拌入馅料混合物，盖上盖子，离火，静置 5 分钟。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "静置馅料时，将剩余的 1 汤匙黄油放入中型平底锅中，用中火融化。加入芹菜和洋葱；煮5到7分钟，搅拌直至变软。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "在馅料中加入芹菜和洋葱。拌入烤面包片，用盐和胡椒调味。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "将馅料松散地舀入火鸡的身体和颈部腔中。用植物油擦拭火鸡的外部，并用铝箔松散地覆盖。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "在预热的烤箱中烤火鸡，直到插入大腿最厚部分的即时温度计达到 180 华氏度（85 摄氏度）并且馅料内部达到 165 华氏度（70 摄氏度），大约需要 3 ½ 到 4 小时。在烹饪的最后 30 分钟去除箔纸，使皮肤变成棕色。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "在雕刻之前，让火鸡休息，用箔纸松散地覆盖。"
    }
  ],
