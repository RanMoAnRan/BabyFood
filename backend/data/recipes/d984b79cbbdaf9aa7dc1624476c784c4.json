{
  "id": "d984b79cbbdaf9aa7dc1624476c784c4",
  "title": "最好的爱尔兰土豆",
  "min_age_month": 12,
  "tags": [
    "Dinner",
    "Side Dish",
    "Irish"
  ],
  "difficulty": 1,
  "time_cost": 120,
  "cover_image": "images/8fe2c696b88bb76b470dd4437fe990c5.webp",
  "nutrition_tip": "奶油爱尔兰土豆用砂锅式制作，配上切碎的洋葱、融化的黄油和……",
  "ingredients": [
    {
      "name": "8 个大赤褐色土豆",
      "amount": ""
    },
    {
      "name": "1 汤匙黄油",
      "amount": ""
    },
    {
      "name": "0.5 个小洋葱，切碎",
      "amount": ""
    },
    {
      "name": "盐和黑胡椒粉适量",
      "amount": ""
    },
    {
      "name": "0.5 杯黄油，融化",
      "amount": ""
    },
    {
      "name": "0.5 杯浓奶油",
      "amount": ""
    },
    {
      "name": "0.5 杯半杯",
      "amount": ""
    },
    {
      "name": "0.25 茶匙辣椒粉",
      "amount": ""
    },
    {
      "name": "2 汤匙切碎的新鲜欧芹",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将土豆放入大锅中，盖上盐水；煮沸并煮10分钟；流走。将土豆放在一边冷却。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "一旦土豆冷却到可以处理的程度，将土豆皮从土豆上滑下来并丢弃；将去皮的土豆冷藏约 1 小时，直至完全冷却。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将烤箱预热至 350 华氏度（175 摄氏度）。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在 9x13 英寸的烤盘上涂上 1 汤匙黄油。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将 2 个土豆磨碎，放入准备好的烤盘底部。将约1/4的切碎洋葱撒在土豆层上；用盐和黑胡椒调味。重复分层，直到所有原料都用完并且盘子装满。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "将融化的黄油、鲜奶油和一半的奶油淋在土豆混合物上；用辣椒粉调味。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "在预热的烤箱中烘烤约 30 分钟，直至顶部冒泡。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "用切碎的新鲜欧芹装饰即可食用。"
    }
  ],
