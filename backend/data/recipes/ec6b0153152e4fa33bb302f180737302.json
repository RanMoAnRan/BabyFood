  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集原料并将烤箱预热至 350 华氏度（175 摄氏度）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将一大锅盐水用高火煮沸。添加意大利面并根据包装说明进行烹饪，使其口感有嚼劲。流走。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "煮意大利面时，在大型荷兰烤箱中将油加热至中高温。加入牛肉，煮约 5 分钟，经常搅拌直至碎裂，直至不再呈粉红色。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "拌入洋葱、青椒、辣椒粉、蒜粉和盐；煮约 4 分钟，偶尔搅拌，直至蔬菜变软。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "拌入番茄酱、番茄酱、芥末、伍斯特酱和红糖；用中高火煮沸。将火调至中火，煮约 5 分钟，偶尔搅拌，直至稍微变稠。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "从火上移开，加入煮熟的意大利面、玉米和 3/4 杯奶酪。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "在 9x13 英寸的烤盘上涂上烹饪喷雾；将牛肉和面食混合物放入盘中。均匀地撒上剩余的 3/4 杯奶酪。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "在预热的烤箱中烘烤约 20 分钟，直至热透且奶酪融化。"
    },
    {
      "step_index": 9,
      "img": "",
      "text": "趁热享用吧！"
    }
  ],
