  ],
  "difficulty": 1,
  "time_cost": 50,
  "cover_image": "images/59655c51c8ad6f3aabff76dfd0a93e20.webp",
  "nutrition_tip": "Tinola，一种简单的菲律宾汤，由鸡肉、白菜和菠菜制成，特点是……",
  "ingredients": [
    {
      "name": "1汤匙食用油",
      "amount": ""
    },
    {
      "name": "1 个中等大小的洋葱，切碎",
      "amount": ""
    },
    {
      "name": "2 瓣大蒜，切碎",
      "amount": ""
    },
    {
      "name": "1 片（1 1/2 英寸）新鲜生姜，去皮并切成薄片",
      "amount": ""
    },
    {
      "name": "1汤匙鱼露",
      "amount": ""
    },
    {
      "name": "3 磅鸡腿和大腿，冲洗并拍干",
      "amount": ""
    },
    {
      "name": "2 罐（14 盎司）鸡汤",
      "amount": ""
    },
    {
      "name": "1 个佛手瓜，去皮并切成一口大小的块",
      "amount": ""
    },
    {
      "name": "盐和黑胡椒粉适量",
      "amount": ""
    },
    {
      "name": "1 头白菜，切碎",
      "amount": ""
    },
    {
      "name": "1 包（8 盎司）新鲜菠菜，切碎",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在一个大锅中用中火加热油。加入洋葱和大蒜；煮约2分钟，搅拌至香味四溢。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "加入姜和鱼露；煮并搅拌 1 至 2 分钟。拌入鸡肉并煮5分钟。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "倒入鸡汤，煮5分钟。加入南瓜，煮约 10 分钟，直至鸡肉中心不再呈粉红色。用盐和胡椒调味。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "加入白菜和菠菜；煮1到2分钟，直到菠菜刚刚枯萎。趁热食用。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "享受吧！"
    }
  ],
