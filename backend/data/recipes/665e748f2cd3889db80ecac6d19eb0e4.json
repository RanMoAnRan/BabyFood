{
  "id": "665e748f2cd3889db80ecac6d19eb0e4",
  "title": "南瓜煎饼",
  "min_age_month": 12,
  "tags": [],
  "difficulty": 1,
  "time_cost": 0,
  "cover_image": "images/3899c823645cc40a1ba47a4476ef4aae.webp",
  "nutrition_tip": "这些令人垂涎欲滴的煎饼带有南瓜派香料和红糖的味道……",
  "ingredients": [],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "用肥皂和水洗手。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在一个大碗中，使用钢丝搅拌器将面粉、泡打粉、盐、红糖和南瓜派香料混合。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在另一个碗中混合南瓜、牛奶、油和鸡蛋。混合直至光滑。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将南瓜混合物搅拌到干成分中，搅拌直至湿润。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将面糊舀到稍微涂油的预热煎锅上。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "慢慢煮，直到顶部出现气泡，底部变成金黄色。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "将煎饼翻面，煎至另一面呈金黄色。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "趁热享用。上面撒上糖粉或煎饼糖浆。"
    }
  ],
