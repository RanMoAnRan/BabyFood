  "title": "自制番茄酱",
  "min_age_month": 12,
  "tags": [
    "Condiment",
    "American",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 730,
  "cover_image": "images/24c4ac3af7dc0c246913d26caba4084b.webp",
  "nutrition_tip": "约翰厨师的自制番茄酱很容易在慢炖锅中用碎番茄酱制作......",
  "ingredients": [
    {
      "name": "2 罐（28 盎司）碎番茄罐头",
      "amount": ""
    },
    {
      "name": "0.5 杯水，分开",
      "amount": ""
    },
    {
      "name": "0.66666668653488 杯 白糖",
      "amount": ""
    },
    {
      "name": "0.75 杯蒸馏白醋",
      "amount": ""
    },
    {
      "name": "1 茶匙洋葱粉",
      "amount": ""
    },
    {
      "name": "0.5 茶匙大蒜粉",
      "amount": ""
    },
    {
      "name": "1.75 茶匙盐",
      "amount": ""
    },
    {
      "name": "0.125 茶匙芹菜盐",
      "amount": ""
    },
    {
      "name": "0.125 茶匙芥末粉",
      "amount": ""
    },
    {
      "name": "0.25 茶匙细磨黑胡椒",
      "amount": ""
    },
    {
      "name": "1/4 茶匙辣椒，或适量",
      "amount": ""
    },
    {
      "name": "1 整瓣丁香",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将碎番茄倒入慢炖锅中。在每个空罐中加入 1/4 杯水，然后倒入慢炖锅中。加入糖、醋、洋葱粉、大蒜粉、盐、芹菜盐、芥末粉、黑胡椒、辣椒和整个丁香；搅拌混合。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "不盖盖子，用高温烹饪 10 到 12 小时，直至混合物减半且变得非常稠。每隔一小时左右搅拌一次。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "使用浸入式搅拌机搅拌约 20 秒，使番茄酱的质地变得光滑。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将番茄酱舀入细滤器中，然后用勺子背面按压混合物，滤出任何外皮和种子。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将滤过的番茄酱转移到碗中。完全冷却。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "根据需要品尝并调整盐、黑胡椒和辣椒。"
    }
  ],
