  "nutrition_tip": "这个经典的蜜饯红薯食谱，用红糖和奶油制成，但是......",
  "ingredients": [
    {
      "name": "6 个黄肉红薯",
      "amount": ""
    },
    {
      "name": "1 杯包装红糖",
      "amount": ""
    },
    {
      "name": "0.5 杯黄油",
      "amount": ""
    },
    {
      "name": "0.5 杯水",
      "amount": ""
    },
    {
      "name": "1 茶匙盐",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 350 华氏度（175 摄氏度）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将蒸篮放入大锅中。添加2英寸水并煮沸。将土豆放入蒸笼中，盖上锅盖，煮约 30 分钟，直至用叉子轻松刺穿。沥干并冷却。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "红薯去皮切片；转移到 9x13 英寸的烤盘中。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将红糖、黄油、水和盐放入中型平底锅中，用中火融化，直至糖溶解且混合物起泡；倒在土豆上。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "在预热的烤箱中烘烤约1小时，直至呈金黄色并焦糖化，偶尔涂上红糖酱。"
    }
  ],
