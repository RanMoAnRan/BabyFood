{
  "id": "9081a67dd3dd8a8cc47efa0316d290d9",
  "title": "培根奶酪意大利面南瓜烘烤",
  "min_age_month": 12,
  "tags": [
    "Dinner",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 120,
  "cover_image": "images/fc6b84d30bd97cac85cf1d42805ac2cd.webp",
  "nutrition_tip": "这个快速简单的意大利面南瓜烘焙食谱是用简单的原料制成的……",
  "ingredients": [
    {
      "name": "1 个意大利面南瓜，切半并去籽",
      "amount": ""
    },
    {
      "name": "1 汤匙橄榄油",
      "amount": ""
    },
    {
      "name": "1.5 杯切碎的超锐切达干酪，分开",
      "amount": ""
    },
    {
      "name": "0.75 杯培根片",
      "amount": ""
    },
    {
      "name": "4 汤匙黄油",
      "amount": ""
    },
    {
      "name": "1 茶匙盐",
      "amount": ""
    },
    {
      "name": "0.5 茶匙黑胡椒粉",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 350 华氏度（175 摄氏度）。在砂锅盘上涂油。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在切好的南瓜上涂上大约一汤匙橄榄油。将南瓜切面朝下放在烤盘上。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在预热的烤箱中烘烤约 30 分钟，直至南瓜变软。冷却 10 分钟。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "用叉子将南瓜肉刮成意大利面条状的丝；转移到一个大碗里。加入 3/4 杯切达干酪、培根块、黄油、盐和黑胡椒；混合直至充分混合。转移到准备好的砂锅中。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "在预热的烤箱中烘烤约 45 分钟直至热透。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "在砂锅中撒上剩余的 3/4 杯切达干酪；继续烘烤 15 到 20 分钟，直到奶酪变成棕色并起泡。"
    }
  ],
