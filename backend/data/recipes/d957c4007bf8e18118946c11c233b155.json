{
  "id": "d957c4007bf8e18118946c11c233b155",
  "title": "蓝带奶油鸡砂锅",
  "min_age_month": 8,
  "tags": [
    "Dinner",
    "American",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 55,
  "cover_image": "images/3a74ddcf1e154c1dd0f06d6cb9525d8d.webp",
  "nutrition_tip": "这道蓝带鸡肉砂锅菜的特色是煮熟的鸡肉、火腿和面条……",
  "ingredients": [
    {
      "name": "1 包（8 盎司）宽鸡蛋面",
      "amount": ""
    },
    {
      "name": "2 杯切碎的熟鸡胸肉",
      "amount": ""
    },
    {
      "name": "8 盎司熟火腿，切块",
      "amount": ""
    },
    {
      "name": "8 盎司瑞士奶酪，切块",
      "amount": ""
    },
    {
      "name": "1罐（10.5盎司）低脂低钠奶油鸡汤（例如Campbell's® Healthy Request）",
      "amount": ""
    },
    {
      "name": "0.5 杯 2% 牛奶",
      "amount": ""
    },
    {
      "name": "0.5 杯淡酸奶油",
      "amount": ""
    },
    {
      "name": "2 汤匙黄油",
      "amount": ""
    },
    {
      "name": "0.33333334326744 杯调味面包屑",
      "amount": ""
    },
    {
      "name": "0.25 杯磨碎的帕尔马干酪",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将烤箱预热至 350 华氏度（175 摄氏度）。在 9x13 英寸的砂锅盘上涂上少许油脂。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将一大锅淡盐水煮沸。在沸水中煮鸡蛋面，偶尔搅拌，直到咬起来又软又硬，需要 7 到 9 分钟。将面条沥干并转移到准备好的砂锅中。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在面条上放上鸡肉、火腿和瑞士奶酪。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将浓缩汤、牛奶和酸奶油放入一个中等大小的碗中混合直至混合；用勺子将面条混合物倒入砂锅中。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "在平底锅中用中火融化黄油；将面包屑和帕尔马干酪放入热黄油中，煮并搅拌 2 至 3 分钟，直至面包屑充分裹上一层。撒在砂锅上。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "在预热的烤箱中烘烤约 30 分钟，直至砂锅冒泡并呈浅棕色。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "食用前稍微冷却。"
    }
  ],
