  "cover_image": "images/d66411448579e57d766978c732424fdf.webp",
  "nutrition_tip": "用这个简单的食谱制作最好的土豆泥——只需土豆、温牛奶……",
  "ingredients": [
    {
      "name": "2 磅烤土豆，去皮并切成四等分",
      "amount": ""
    },
    {
      "name": "3 瓣大蒜，去皮，或适量",
      "amount": ""
    },
    {
      "name": "1 杯牛奶",
      "amount": ""
    },
    {
      "name": "2 汤匙黄油",
      "amount": ""
    },
    {
      "name": "盐和黑胡椒粉适量",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将一大锅盐水煮沸。加入土豆和大蒜，将火调至中火，煮约 15 分钟，直至土豆变软。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "当土豆快吃完时，在小平底锅中用小火加热牛奶和黄油，直至黄油融化。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "沥干土豆并返回锅中。慢慢加入温热的牛奶混合物，用土豆捣碎器或电动搅拌机将其混合，直至土豆变得光滑且呈奶油状。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "用盐和胡椒调味。淋上额外的黄油即可享用！"
    }
  ],
