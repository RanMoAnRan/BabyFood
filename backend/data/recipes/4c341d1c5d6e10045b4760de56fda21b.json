  ],
  "difficulty": 1,
  "time_cost": 35,
  "cover_image": "images/a3be0e33300272bb14874c831430b435.webp",
  "nutrition_tip": "这个又大又软的姜曲奇食谱充满了温暖的糖蜜和姜味。…",
  "ingredients": [
    {
      "name": "2汤匙白糖",
      "amount": ""
    },
    {
      "name": "2.25 杯通用面粉",
      "amount": ""
    },
    {
      "name": "2 茶匙姜末",
      "amount": ""
    },
    {
      "name": "1 茶匙小苏打",
      "amount": ""
    },
    {
      "name": "0.75 茶匙肉桂粉",
      "amount": ""
    },
    {
      "name": "0.5 茶匙丁香粉",
      "amount": ""
    },
    {
      "name": "0.25 茶匙盐",
      "amount": ""
    },
    {
      "name": "0.75 杯人造黄油，软化",
      "amount": ""
    },
    {
      "name": "1 杯白糖",
      "amount": ""
    },
    {
      "name": "1 个大鸡蛋",
      "amount": ""
    },
    {
      "name": "0.25 杯糖蜜",
      "amount": ""
    },
    {
      "name": "1 汤匙水",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 350 华氏度（175 摄氏度）。将2汤匙糖放入小碗中；放在一边。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将面粉、生姜、小苏打、肉桂、丁香和盐一起过筛到一个中等大小的碗中。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将黄油和 1 杯糖放入一个大碗中，用电动搅拌机搅拌至松软。打入鸡蛋；加入糖蜜和水搅拌。逐渐将面粉香料混合物搅拌到糖蜜混合物中，直至充分混合。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "用撒了面粉的手将面团揉成 24 个核桃大小的球。将每个球放入预留的糖中滚动以涂上糖衣。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将饼干放在未抹油的饼干片上，间隔 2 英寸；用玻璃杯底部稍微压平。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "在预热的烤箱中烘烤 8 到 10 分钟，直至顶部破裂且中心变软，中途更换架子。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "从烤箱中取出；在烤盘上冷却 5 分钟，然后转移到金属架上完全冷却。"
    }
  ],
