{
  "id": "348de92ce6001f4f06bdc808fe5968a7",
  "title": "牛油挞",
  "min_age_month": 12,
  "tags": [
    "Dessert",
    "American",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 35,
  "cover_image": "images/8da683ac3b72386a57517d77871762c4.webp",
  "nutrition_tip": "这些黄油馅饼的馅料丰富、甜美、坚果味，是用红糖制成的，……",
  "ingredients": [
    {
      "name": "30 个（2 英寸）未烘烤的挞皮",
      "amount": ""
    },
    {
      "name": "1.5 杯包装红糖",
      "amount": ""
    },
    {
      "name": "0.5 杯黄油",
      "amount": ""
    },
    {
      "name": "2 个鸡蛋",
      "amount": ""
    },
    {
      "name": "2 杯葡萄干",
      "amount": ""
    },
    {
      "name": "1 杯核桃碎",
      "amount": ""
    },
    {
      "name": "2 汤匙浓奶油",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 325 华氏度（170 摄氏度）。将挞皮放在烤盘上。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将糖、黄油和鸡蛋放入一个大碗中，用电动搅拌机搅拌直至呈奶油状。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "加入葡萄干、核桃和奶油，直至完全混合。将面糊倒入挞皮中，不要超过半满。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将蛋挞放入预热的烤箱中烘烤 20 至 25 分钟，直至糕点呈金黄色且馅料凝固。让馅饼在金属架上冷却。"
    }
  ],
