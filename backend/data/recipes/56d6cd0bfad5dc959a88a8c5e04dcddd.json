{
  "id": "56d6cd0bfad5dc959a88a8c5e04dcddd",
  "title": "菲力牛排搭配浓郁的香醋釉",
  "min_age_month": 12,
  "tags": [
    "Dinner",
    "American",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 15,
  "cover_image": "images/bac6ece252508c47c98eaeb55301f0dc.webp",
  "nutrition_tip": "这是最好的菲力牛排食谱，其中包括浓郁的红酒香脂酱……",
  "ingredients": [
    {
      "name": "2 块（4 盎司）菲力牛排",
      "amount": ""
    },
    {
      "name": "0.5 茶匙黑胡椒粉，或适量",
      "amount": ""
    },
    {
      "name": "加盐调味",
      "amount": ""
    },
    {
      "name": "0.25 杯香醋",
      "amount": ""
    },
    {
      "name": "0.25 杯干红葡萄酒",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在牛排两面撒上胡椒和盐。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "用中高温加热不粘锅。将牛排放入热锅中煎至焦黄，每面煎约 1 分钟。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将火调至中低，倒入香醋和红酒。盖上锅盖煮 4 分钟。将牛排翻面，涂上酱汁；盖上盖子再煮4分钟。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将牛排移至两个温热的盘子中。在每块牛排上舀一汤匙釉料，然后立即食用。"
    }
  ],
