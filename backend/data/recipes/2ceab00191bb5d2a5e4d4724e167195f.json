  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在一个大锅中用中火加热油。加入姜、咖喱酱和柠檬草；加入热油煮并搅拌1分钟。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "逐渐加入鸡汤，然后加入鱼露和红糖；把火调小，煮 15 分钟。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "加入椰奶和蘑菇；煮约 5 分钟，搅拌直至蘑菇变软。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "加入虾；煮约5分钟，直至不再半透明。加入酸橙汁搅拌；加盐调味，并用香菜装饰。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "享受吧！"
    }
  ],
