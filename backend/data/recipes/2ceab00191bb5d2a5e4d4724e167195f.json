  "nutrition_tip": "这道泰式椰子汤是用红咖喱酱、柠檬草、酸橙汁、虾做成的……",
  "ingredients": [
    {
      "name": "1 汤匙植物油",
      "amount": ""
    },
    {
      "name": "2 汤匙 磨碎的鲜姜",
      "amount": ""
    },
    {
      "name": "2 茶匙红咖喱酱",
      "amount": ""
    },
    {
      "name": "1 茎柠檬草，切碎",
      "amount": ""
    },
    {
      "name": "4 杯鸡汤",
      "amount": ""
    },
    {
      "name": "3汤匙鱼露",
      "amount": ""
    },
    {
      "name": "1汤匙淡红糖",
      "amount": ""
    },
    {
      "name": "3 罐（13.5 盎司）椰奶",
      "amount": ""
    },
    {
      "name": "0.5 磅新鲜香菇，切片",
      "amount": ""
    },
    {
      "name": "1 磅中号虾 - 去皮、去肠",
      "amount": ""
    },
    {
      "name": "2 汤匙新鲜酸橙汁",
      "amount": ""
    },
    {
      "name": "加盐调味",
