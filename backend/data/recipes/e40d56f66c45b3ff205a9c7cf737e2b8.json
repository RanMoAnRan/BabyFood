  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在大煎锅中用中高温加热油。将牛尾煎4分钟。翻转并继续烹饪，直至各面都变成棕色，大约需要 4 分钟。将牛尾转移到慢炖锅中。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "添加土豆、胡萝卜、芹菜、洋葱、番茄酱、牛肉汤、红酒、欧芹、伍斯特酱、百里香和辣椒粉。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "低火煮 7 小时。添加蘑菇和豌豆。再煮 1 小时。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "用勺子舀入碗中，用盐和胡椒调味。"
    }
  ],
