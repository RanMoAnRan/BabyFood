  "cover_image": "images/971e05252d9094d95cda2a05466f8651.webp",
  "nutrition_tip": "这个纯素烤豆腐食谱非常简单，你每周都会想做。...",
  "ingredients": [
    {
      "name": "烹饪喷雾",
      "amount": ""
    },
    {
      "name": "2汤匙酱油",
      "amount": ""
    },
    {
      "name": "2 汤匙龙舌兰花蜜",
      "amount": ""
    },
    {
      "name": "1 汤匙烤芝麻油",
      "amount": ""
    },
    {
      "name": "1 茶匙蒜末",
      "amount": ""
    },
    {
      "name": "1 茶匙切碎的鲜姜",
      "amount": ""
    },
    {
      "name": "1 汤匙芝麻，或适量",
      "amount": ""
    },
    {
      "name": "1 磅豆腐，切成均匀的 8 块",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将烤箱预热至 350 华氏度（175 摄氏度）。用烹饪喷雾在大烤盘上轻轻涂抹油脂。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将酱油、龙舌兰、芝麻油、大蒜和姜放入碗中搅拌均匀。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "轻轻按压豆腐块，释放尽可能多的水分。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将豆腐放在准备好的烤盘上，并刷上 1/2 的大豆混合物。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "将豆腐放入预热好的烤箱中烤30分钟。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "翻转豆腐并刷上剩余的大豆混合物。在上面撒上芝麻。继续烘烤约30分钟，直至豆腐变脆。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "从烤箱中取出，用抹刀将豆腐转移到金属架上冷却。"
    }
  ],
