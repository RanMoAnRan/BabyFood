{
  "id": "700e7383ebf37bb8241b2bb00816b1e3",
  "title": "山核桃派配枫糖浆",
  "min_age_month": 12,
  "tags": [
    "Dessert",
    "American",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 45,
  "cover_image": "images/f3d7965f9cd08d4d7110b8f567c0f7a4.webp",
  "nutrition_tip": "试试这个山核桃派和枫糖浆（而不是玉米糖浆）！很容易制作…",
  "ingredients": [
    {
      "name": "1 杯纯枫糖浆",
      "amount": ""
    },
    {
      "name": "0.5 杯包装淡红糖",
      "amount": ""
    },
    {
      "name": "3 个大鸡蛋",
      "amount": ""
    },
    {
      "name": "2 汤匙无盐黄油，融化",
      "amount": ""
    },
    {
      "name": "1 茶匙香草精",
      "amount": ""
    },
    {
      "name": "1.25 杯山核桃半块或块",
      "amount": ""
    },
    {
      "name": "1 个（9 英寸）未烘烤的馅饼壳",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 350 华氏度（175 摄氏度）。将架子放在最低位置。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在一个大碗中混合枫糖浆、红糖、鸡蛋、融化的黄油和香草精，直至充分混合。拌入山核桃直至涂上涂层。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将面糊倒入馅饼壳中。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在预热烤箱的下层烤架上烘烤 35 至 40 分钟，直至馅饼皮呈金黄色且馅料凝固。"
    }
  ],
