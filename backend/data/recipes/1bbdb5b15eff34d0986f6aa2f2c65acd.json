  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 400 华氏度（200 摄氏度）。在烤盘上涂上少许橄榄油。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将南瓜切面朝下放在准备好的烤盘上。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将苹果、芹菜、水、洋葱和黄油放入一个小烤盘中；覆盖。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在预热的烤箱中烘烤南瓜和苹果混合物，直至南瓜和苹果混合物变软，大约需要 45 分钟。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将苹果混合物填入南瓜两半；淋上枫糖浆，撒上肉桂粉。"
    }
