  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将苹果放入慢炖锅中。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将面包块、红糖、肉桂、肉豆蔻和盐一起放入碗中；撒在苹果上，然后淋上融化的黄油。"
    },
    {
      "step_index": 3,
