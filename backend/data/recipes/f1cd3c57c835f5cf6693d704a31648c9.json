  "title": "盖伊的微波炉软糖",
  "min_age_month": 12,
  "tags": [
    "Dessert",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 15,
  "cover_image": "images/cf1a988953bf128f477560003b3b50ec.webp",
  "nutrition_tip": "这种巧克力微波软糖是用糖果制造商制作的。糖、可可、牛奶……",
  "ingredients": [
    {
      "name": "4 杯糖果糖",
      "amount": ""
    },
    {
      "name": "0.5 杯不加糖可可粉",
      "amount": ""
    },
    {
      "name": "0.5 杯黄油",
      "amount": ""
    },
    {
      "name": "0.25 杯牛奶",
      "amount": ""
    },
    {
      "name": "2 茶匙香草精",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "在 9x9 英寸的盘子上涂抹油脂。搅拌糖果将糖和可可一起放入微波炉安全的碗中；加入黄油并倒入牛奶，但不要混合。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "用微波炉加热约 2 分钟，直至黄油融化。加入香草精，剧烈搅拌直至光滑。倒入准备好的盘子里。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在冰箱中冷却 10 分钟，然后切成方块。"
    }
  ],
