  ],
  "difficulty": 1,
  "time_cost": 150,
  "cover_image": "images/d1b5a3b1b78effcbbca327fe82d8626f.webp",
  "nutrition_tip": "苹果黄油给这个士力架配方带来了独特的风味，补充了……",
  "ingredients": [
    {
      "name": "2.75 杯通用面粉",
      "amount": ""
    },
    {
      "name": "0.5 茶匙塔塔粉",
      "amount": ""
    },
    {
      "name": "0.5 茶匙小苏打",
      "amount": ""
    },
    {
      "name": "0.5 茶匙盐",
      "amount": ""
    },
    {
      "name": "0.25 茶匙肉桂粉",
      "amount": ""
    },
    {
      "name": "0.25 茶匙肉豆蔻粉",
      "amount": ""
    },
    {
      "name": "1.75 杯白糖，分开",
      "amount": ""
    },
    {
      "name": "0.5 杯无盐黄油，软化",
      "amount": ""
    },
    {
      "name": "1 个大鸡蛋，室温",
      "amount": ""
    },
    {
      "name": "0.5 茶匙香草精",
      "amount": ""
    },
    {
      "name": "0.75 杯苹果酱",
      "amount": ""
    },
    {
      "name": "2 汤匙肉桂粉",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将面粉、塔塔粉、小苏打、盐、1/4 茶匙肉桂和肉豆蔻放入碗中搅拌直至混合。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将 1 ½ 杯糖和黄油一起放入碗中，搅拌至呈奶油状；加入鸡蛋和香草精搅拌直至混合。加入苹果酱搅拌直至充分混合。加入 1/2 面粉混合物，搅拌直至混合；加入剩余的 1/2 面粉混合物，搅拌直至没有干面粉块残留。用保鲜膜盖住碗；将面团冷藏2至24小时。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将烤箱预热至 375 华氏度（190 摄氏度）。在 2 个烤盘上铺上羊皮纸。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将剩余的 1/4 杯糖和 2 汤匙肉桂放入浅碗或馅饼盘中。将一汤匙面团放入肉桂糖混合物中；滚成球，涂好。将涂有涂层的面团球放在准备好的烤盘上，间隔 1 英寸。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "在预热的烤箱中烘烤约 10 分钟，直至边缘刚刚定型。将饼干放在烤盘上冷却 5 分钟，然后转移到金属架上完全冷却。"
    }
  ],
