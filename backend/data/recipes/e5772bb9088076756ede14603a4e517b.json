  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料并将烤箱预热至 350 华氏度（175 摄氏度）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将罐装豆子与猪肉、红糖、洋葱、番茄酱、芥末、伍斯特酱、醋、盐和胡椒粉放入 9 英寸见方的烤盘中。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将培根片放在上面。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "放入已预热的烤箱中烘烤，直至酱汁变稠且培根煮熟，大约需要1小时。"
    }
