  "nutrition_tip": "这种肉质、奶酪味的蘸酱非常适合一小群人聚集在一起观看周日美食……",
  "ingredients": [
    {
      "name": "1 磅碎牛肉",
      "amount": ""
    },
    {
      "name": "1 包（8 盎司）奶油奶酪，室温",
      "amount": ""
    },
    {
      "name": "1 罐（8 盎司）准备好的莎莎酱",
      "amount": ""
    },
    {
      "name": "1 条（1 磅）面包加工奶酪食品，切片",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 400 华氏度（200 摄氏度）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将碎牛肉放入大煎锅中，中高火加热。煮，搅拌至碎，直到不再呈粉红色。沥干油脂。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将奶油干酪均匀地铺在 9 英寸方形烤盘的底部。在奶油奶酪上铺上一层莎莎酱，然后盖上一层碎牛肉。上面放上加工奶酪片，并用铝箔盖住盘子。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在预热的烤箱中烘烤 15 分钟，或直至热透。趁热食用。"
    }
  ],
