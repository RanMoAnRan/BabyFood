  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在大汤锅中用中火加热油。用调味盐和胡椒调味鸡肉，加入锅中，煮约 5 分钟，偶尔搅拌，直至中心不再呈粉红色。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "加入洋葱，煮至几乎半透明，约 5 分钟。加入大蒜，煮约 2 分钟，直至略呈褐色。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "加入肉汤、水、土豆、胡萝卜和芹菜；煮 15 至 20 分钟，直至土豆和胡萝卜变软。品尝并用盐、胡椒和辣椒调整调味。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "趁热享用吧！"
    }
