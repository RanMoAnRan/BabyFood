  "nutrition_tip": "海陆大餐，搭配多汁的腌制虾和完美烤的菲力牛排……",
  "ingredients": [
    {
      "name": "1 汤匙橄榄油",
      "amount": ""
    },
    {
      "name": "1 汤匙黄油，融化",
      "amount": ""
    },
    {
      "name": "1 汤匙切碎的洋葱",
      "amount": ""
    },
    {
      "name": "1 汤匙白葡萄酒",
      "amount": ""
    },
    {
      "name": "1 茶匙伍斯特酱",
      "amount": ""
    },
    {
      "name": "1 茶匙柠檬汁",
      "amount": ""
    },
    {
      "name": "1 茶匙干欧芹",
      "amount": ""
    },
    {
      "name": "1 茶匙海鲜调味料（例如 Old Bay®）",
      "amount": ""
    },
    {
      "name": "1 瓣大蒜，切碎",
      "amount": ""
    },
    {
      "name": "0.125 茶匙现磨黑胡椒",
      "amount": ""
    },
    {
      "name": "12 只中等大小的虾，去皮、去肠",
      "amount": ""
    },
    {
      "name": "2 块（4 盎司）菲力牛排",
      "amount": ""
    },
    {
      "name": "2 茶匙橄榄油",
      "amount": ""
    },
    {
      "name": "1 茶匙牛排调味料",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将 1 汤匙橄榄油、黄油、洋葱、葡萄酒、伍斯特酱、柠檬汁、欧芹、海鲜调味料、大蒜和胡椒一起放入碗中搅拌。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "添加虾。搅拌均匀。用保鲜膜盖住碗并冷藏至少 15 分钟，使味道混合。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将户外烤架预热至中高温，并在烤架上涂上少许油。在牛排上涂上2茶匙橄榄油；撒上牛排调味料。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "在预热的烤架上烹制牛排，直至牛排开始变硬、变热且中心略呈粉红色，达到中等熟度，每面煎 5 到 7 分钟。插入中心的即时读数温度计读数应为 140 华氏度（60 摄氏度）。将牛排转移到盘子上，并用一块铝箔松散地盖住。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "将虾从腌料中取出，烤至外部呈亮粉色且肉不透明，每面烤 2 至 3 分钟。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "将虾和牛排一起上桌，尽情享用吧！"
    }
  ],
