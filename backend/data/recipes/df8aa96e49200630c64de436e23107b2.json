  "id": "df8aa96e49200630c64de436e23107b2",
  "title": "柿饼",
  "min_age_month": 6,
  "tags": [
    "Dessert",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 30,
  "cover_image": "images/41b0419e091383c11e85e907638a25d5.webp",
  "nutrition_tip": "这些湿柿子饼干是用柿子果肉、葡萄干、核桃……制成的。",
  "ingredients": [
    {
      "name": "2 个熟柿子，捣成泥",
      "amount": ""
    },
    {
      "name": "1 茶匙小苏打",
      "amount": ""
    },
    {
      "name": "2 杯通用面粉",
      "amount": ""
    },
    {
      "name": "0.5 茶匙肉桂粉",
      "amount": ""
    },
    {
      "name": "0.5 茶匙丁香粉",
      "amount": ""
    },
    {
      "name": "0.5 茶匙肉豆蔻粉",
      "amount": ""
    },
    {
      "name": "0.5 茶匙盐",
      "amount": ""
    },
    {
      "name": "1 杯白糖",
      "amount": ""
    },
    {
      "name": "0.5 杯黄油",
      "amount": ""
    },
    {
      "name": "1 个大鸡蛋",
      "amount": ""
    },
    {
      "name": "1 杯葡萄干",
      "amount": ""
    },
    {
      "name": "1 杯碎核桃",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。将烤箱预热至 350 华氏度（180 摄氏度）。给饼干片涂上油脂。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将柿子果肉放入小碗中；加入小苏打搅拌直至溶解并放在一边。将面粉、肉桂、丁香、肉豆蔻和盐筛入一个大碗中；放在一边。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在另一个大碗中用电动搅拌机将糖和黄油搅拌至光滑。加入鸡蛋和柿子混合物。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "加入面粉混合物并搅拌直至混合。拌入葡萄干和核桃。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将一勺面团放在准备好的烤盘上，间隔 2 英寸。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "在预热的烤箱中烘烤约 15 分钟，直至边缘呈金黄色。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "在烤盘上短暂冷却，然后移至金属架上完全冷却。"
    }
  ],
