  "title": "豆泥",
  "min_age_month": 12,
  "tags": [],
  "difficulty": 1,
  "time_cost": 0,
  "cover_image": "images/4a721e2bb5d429db67a1f5ee63f324c6.webp",
  "nutrition_tip": "这些炸豆泥是罐装豆子的简单自制替代品。",
  "ingredients": [],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "清洁豆子。让它们浸泡过夜。流走。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在一个中等平底锅中，放入浸泡过的豆子、水、洋葱、大蒜粉和橄榄油。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "用中火煮 2.5 小时或直至豆子变软。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在大而重的煎锅中捣碎 3 杯煮熟的豆子。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "添加 1 杯豆类烹饪液。用中火煮至浓稠并达到所需的稠度。"
    }
  ],
