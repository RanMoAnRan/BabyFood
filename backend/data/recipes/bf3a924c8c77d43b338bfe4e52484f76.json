{
  "id": "bf3a924c8c77d43b338bfe4e52484f76",
  "title": "荷兰婴儿",
  "min_age_month": 12,
  "tags": [
    "Breakfast",
    "German"
  ],
  "difficulty": 1,
  "time_cost": 25,
  "cover_image": "images/1b61aa804482e753870f007398e00ba0.webp",
  "nutrition_tip": "这个荷兰婴儿食谱制作了一个美味的烤箱烤煎饼，适合两个人吃，让你……",
  "ingredients": [
    {
      "name": "2 个大鸡蛋",
      "amount": ""
    },
    {
      "name": "0.5 杯牛奶",
      "amount": ""
    },
    {
      "name": "0.5 杯过筛的通用面粉",
      "amount": ""
    },
    {
      "name": "1 撮 肉豆蔻粉",
      "amount": ""
    },
    {
      "name": "1 撮盐",
      "amount": ""
    },
    {
      "name": "2 汤匙黄油",
      "amount": ""
    },
    {
      "name": "2 汤匙糖粉，用于撒粉",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将 10 英寸铸铁煎锅放入烤箱并预热至 475 华氏度（245 摄氏度）。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在一个中等大小的碗中搅拌鸡蛋直至变轻。加入牛奶搅拌，然后逐渐加入面粉、肉豆蔻和盐。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "从烤箱中取出煎锅，将温度降至 425 华氏度（220 摄氏度）。将黄油放入热煎锅中，旋转使其在底部和侧面融化。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将面糊倒入煎锅中，然后返回烤箱。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "烘烤约 12 分钟，直至膨化并呈浅棕色。取出糖果并立即过筛糖在上面。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "享受吧！"
    }
  ],
