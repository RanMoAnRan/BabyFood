{
  "id": "387e19c9a2be9e81ff6c45d757b765ef",
  "title": "巧克力饼干",
  "min_age_month": 12,
  "tags": [
    "Dessert",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 25,
  "cover_image": "images/47ef72418d7da935c5a989b8e1921ff0.webp",
  "nutrition_tip": "用松脆的核桃碎制成的巧克力饼干只需 10 分钟即可准备好......",
  "ingredients": [
    {
      "name": "2 杯白糖",
      "amount": ""
    },
    {
      "name": "1.25 杯人造黄油，软化",
      "amount": ""
    },
    {
      "name": "2 个大鸡蛋",
      "amount": ""
    },
    {
      "name": "2 茶匙香草精",
      "amount": ""
    },
    {
      "name": "2 杯通用面粉",
      "amount": ""
    },
    {
      "name": "0.75 杯不加糖可可粉",
      "amount": ""
    },
    {
      "name": "1 茶匙小苏打",
      "amount": ""
    },
    {
      "name": "0.125 茶匙盐",
      "amount": ""
    },
    {
      "name": "1 杯核桃碎",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 350 华氏度（175 摄氏度）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将糖和人造黄油放入一个大碗中，搅打至松软。打入鸡蛋，一次一个，然后加入香草精搅拌。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将面粉、可可、小苏打和盐放入另一个碗中。添加到奶油混合物中并混合直至混合。拌入核桃。将一勺面团放在未抹油的饼干片上，间隔 2 英寸。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在预热的烤箱中烘烤 8 到 10 分钟，直至边缘凝固且中心变软。在转移到金属架上完全冷却之前先静置一会儿。"
    }
  ],
