  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将黄油放入微波炉安全杯中。用微波炉加热约 20 秒直至融化。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将糖、面粉、奶粉、泡打粉、肉桂和盐放入一个小碗中：加水搅拌。用叉子将糖混合物倒入杯子中融化的黄油中，搅拌至面糊充分混合；在上面添加桃子。"
    },
    {
      "step_index": 3,
