{
  "id": "7c78093dcb3215d07eb3b5ffff475743",
  "title": "新鲜大黄馅饼",
  "min_age_month": 12,
  "tags": [
    "Dessert",
    "Pie",
    "American",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 90,
  "cover_image": "images/fb3c212588e3aab9c14ee099855b48e3.webp",
  "nutrition_tip": "这个大黄派是用新鲜大黄和简单的食品储藏室原料制成的……",
  "ingredients": [
    {
      "name": "1.3333333730698 杯 白糖",
      "amount": ""
    },
    {
      "name": "6 汤匙通用面粉",
      "amount": ""
    },
    {
      "name": "1 包（14.1 盎司）双皮馅饼，解冻",
      "amount": ""
    },
    {
      "name": "4 杯切碎的大黄",
      "amount": ""
    },
    {
      "name": "1 汤匙黄油",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料，并将烤箱预热至 450 华氏度（230 摄氏度）。将烤箱架放在最低位置。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在 9 英寸馅饼盘的底部和侧面铺上一块馅饼皮。将糖和面粉混合在一个小碗中；将 1/4 的糖混合物撒在准备好的底皮上。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将切碎的大黄堆在上面，撒上剩余的糖混合物。点上黄油并盖上顶皮。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将馅饼放入预热的烤箱中烘烤 15 分钟。将温度降至 350 华氏度（175 摄氏度）并继续烘烤，直至馅料起泡且外皮呈金黄色，大约需要 40 至 45 分钟。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将馅饼热食或冷食。享受！"
    }
  ],
