  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在另一个碗中搅拌蛋黄酱、糖、牛奶、酪乳、柠檬汁、醋、盐和黑胡椒，直至光滑且糖溶解。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将卷心菜、胡萝卜和洋葱放入一个大沙拉碗中混合。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将调料倒在卷心菜混合物上并充分混合。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "盖上碗并将沙拉冷藏至少 2 小时（时间越长越好）。食用前再次混合。"
    }
