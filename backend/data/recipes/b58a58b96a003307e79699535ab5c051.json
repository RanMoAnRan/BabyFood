  "id": "b58a58b96a003307e79699535ab5c051",
  "title": "帕尔马干酪烤罗非鱼",
  "min_age_month": 12,
  "tags": [
    "Dinner",
    "American",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 15,
  "cover_image": "images/83df9b61e00e78363dc74e809baac8de.webp",
  "nutrition_tip": "帕尔玛罗非鱼片在…下快速旅行后变得超级湿润和片状。",
  "ingredients": [
    {
      "name": "0.5 杯帕尔马干酪",
      "amount": ""
    },
    {
      "name": "0.25 杯黄油，软化",
      "amount": ""
    },
    {
      "name": "3 汤匙蛋黄酱",
      "amount": ""
    },
    {
      "name": "2 汤匙新鲜柠檬汁",
      "amount": ""
    },
    {
      "name": "0.25 茶匙干罗勒",
      "amount": ""
    },
    {
      "name": "0.25 茶匙黑胡椒粉",
      "amount": ""
    },
    {
      "name": "0.125 茶匙洋葱粉",
      "amount": ""
    },
    {
      "name": "0.125 茶匙芹菜盐",
      "amount": ""
    },
    {
      "name": "2 磅罗非鱼片",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱架放置在距热源约 4 英寸的位置，并预热烤箱的烤鸡。在烤盘上铺上铝箔。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将帕尔马干酪、黄油、蛋黄酱、柠檬汁、罗勒、胡椒、洋葱粉和芹菜盐一起放入碗中，直至充分混合。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将罗非鱼片单层排列在准备好的平底锅上。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在预热好的烤箱中烤4分钟，中途翻转。从烤箱中取出，将帕尔马干酪混合物涂在鱼片上。返回烤箱，再烤约 2 分钟，直至顶部变成棕色，并且用叉子轻松将鱼片剥落；小心不要煮过头。"
    }
  ],
