{
  "id": "d1db01b3949a9f888e66bdb0ad37830b",
  "title": "酿辣椒",
  "min_age_month": 12,
  "tags": [],
  "difficulty": 1,
  "time_cost": 0,
  "cover_image": "images/633b6e7d032e1d3f36f838da59ef4f24.webp",
  "nutrition_tip": "孩子们会喜欢这些酿辣椒的。在出发之前先提供这个食谱......",
  "ingredients": [],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 400 华氏度。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "用肥皂和水洗手。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "根据包装说明在炉灶上煮糙米或大麦。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在冷水下轻轻擦拭农产品。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "切掉辣椒顶部并用勺子挖出种子。放在一边。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "用不粘烹饪喷雾喷洒小煎锅。在平底锅中用中火将切碎的洋葱煮至变软，大约需要 5 分钟。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "将鹰嘴豆、½ 杯奶酪、西红柿、煮熟的洋葱、青辣椒、大蒜、辣椒粉、香菜、盐和胡椒粉放入一个中等大小的搅拌碗中混合。加入煮熟的米饭并轻轻搅拌混合。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "将混合物均匀地倒入辣椒中。"
    },
    {
      "step_index": 9,
      "img": "",
      "text": "将辣椒添加到烤盘中。烤40分钟。在上面放上剩余的奶酪，再烘烤 10-15 分钟。"
    }
  ],
