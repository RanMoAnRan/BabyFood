  "id": "49548c5eb7af681a2e36951b497e537d",
  "title": "米兰鸡肉",
  "min_age_month": 12,
  "tags": [
    "Dinner",
    "Italian Inspired",
    "Italian"
  ],
  "difficulty": 1,
  "time_cost": 30,
  "cover_image": "images/2b5af06507579e882f8856c90475464b.webp",
  "nutrition_tip": "米兰鸡是用薄鸡胸肉或鸡排制成的，轻轻裹上面包屑......",
  "ingredients": [
    {
      "name": "2 个大鸡蛋",
      "amount": ""
    },
    {
      "name": "粗盐和黑胡椒粉适量",
      "amount": ""
    },
    {
      "name": "0.75 杯通用面粉",
      "amount": ""
    },
    {
      "name": "1 杯意大利调味面包屑",
      "amount": ""
    },
    {
      "name": "2 块去皮去骨鸡胸肉，切成薄片",
      "amount": ""
    },
    {
      "name": "0.25 杯煎炸植物油",
      "amount": ""
    },
    {
      "name": "1 个柠檬，切成楔形",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。将烤箱预热至 200 华氏度（95 摄氏度）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在浅盘中加入盐和胡椒粉，搅打鸡蛋。在另一个盘子里撒上面粉，在第三个盘子里撒上面包屑。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "一次处理一块，轻轻地将鸡肉压入面粉中，裹上面粉，抖掉多余的部分。浸入打散的鸡蛋中，然后压入面包屑中。轻轻地在双手之间搅拌，这样多余的面包屑就可以掉下来。将裹上面包屑的鸡肉放在盘子上，同时将其余的面包屑裹上面包屑；不要堆叠。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在大煎锅中用中火加热植物油。将鸡肉分 2 至 3 块煎至金黄色且中心不再呈粉红色，每面煎 2 至 4 分钟。插入中心的即时读数温度计读数应至少为 165 华氏度（74 摄氏度）。将煮熟的鸡肉转移到烤盘上，并在预热的烤箱中保温，同时烹饪剩余的鸡肉。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "与柠檬角一起食用。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "享受吧！"
    }
  ],
