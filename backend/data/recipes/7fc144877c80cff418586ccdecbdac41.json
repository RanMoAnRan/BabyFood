{
  "id": "7fc144877c80cff418586ccdecbdac41",
  "title": "苏格兰鸡蛋",
  "min_age_month": 12,
  "tags": [
    "Appetizer",
    "British"
  ],
  "difficulty": 1,
  "time_cost": 50,
  "cover_image": "images/404f4be645df16ce41087fcc05b85942.webp",
  "nutrition_tip": "苏格兰鸡蛋是用香肠包裹的半熟鸡蛋，涂上面包屑，还有……",
  "ingredients": [
    {
      "name": "1 夸脱煎炸油",
      "amount": ""
    },
    {
      "name": "4 个大鸡蛋",
      "amount": ""
    },
    {
      "name": "2 磅散装猪肉香肠",
      "amount": ""
    },
    {
      "name": "1 杯通用面粉",
      "amount": ""
    },
    {
      "name": "4 个大鸡蛋，打散",
      "amount": ""
    },
    {
      "name": "4 杯干面包屑，调味",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。将烤箱预热至 350 华氏度（175 摄氏度）。将油炸锅中的油加热至 375 华氏度（190 摄氏度）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将鸡蛋放入平底锅中，盖上水。煮沸。盖上盖子，离火，让鸡蛋在热水中静置 10 到 12 分钟。从热水中取出，冷却并剥皮。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将香肠压平并制作一个肉饼来包围每个鸡蛋。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在香肠外层撒上少许面粉，然后涂上打散的鸡蛋。滚入面包屑，均匀覆盖。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将准备好的鸡蛋放入热油中炸至金黄色，同时确保每一面都煮熟。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "在预热好的烤箱中烘烤10分钟。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "切成两半即可食用。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "享受吧！"
    }
  ],
