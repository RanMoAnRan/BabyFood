  "nutrition_tip": "这个绿色番茄砂锅菜谱的特色是将番茄拌入酱油中……",
  "ingredients": [
    {
      "name": "6 个绿色西红柿，切成 1 英寸的方块",
      "amount": ""
    },
    {
      "name": "16 个葱（仅限白色和浅绿色部分），切碎",
      "amount": ""
    },
    {
      "name": "3 茎芹菜，切成 1/2 英寸的块",
      "amount": ""
    },
    {
      "name": "1 束香菜，切碎",
      "amount": ""
    },
    {
      "name": "0.25 杯橄榄油",
      "amount": ""
    },
    {
      "name": "5汤匙酱油",
      "amount": ""
    },
    {
      "name": "1汤匙红糖",
      "amount": ""
    },
    {
      "name": "1 汤匙苹果醋",
      "amount": ""
    },
    {
      "name": "0.5 茶匙黑胡椒粉",
      "amount": ""
    },
    {
      "name": "0.5 茶匙盐",
      "amount": ""
    },
    {
      "name": "0.5 茶匙红辣椒片",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 350 华氏度（175 摄氏度）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将绿色西红柿、大葱、芹菜和香菜放入 2 夸脱的砂锅中。将油、酱油、红糖、苹果醋、黑胡椒、盐和胡椒粉放入碗中，搅拌均匀；倒在绿色番茄混合物上，搅拌均匀。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在预热的烤箱中烘烤约 45 分钟，直至蔬菜变软，中途搅拌以使酱汁重新分布。"
    }
  ],
