    },
    {
      "name": "0.5 茶匙盐",
      "amount": ""
    },
    {
      "name": "0.5 杯酸奶油",
      "amount": ""
    },
    {
      "name": "2 个鸡蛋",
      "amount": ""
    },
    {
      "name": "1 杯黄油",
      "amount": ""
    },
    {
      "name": "1 杯水",
      "amount": ""
    },
    {
      "name": "5 汤匙不加糖可可粉",
      "amount": ""
    },
    {
