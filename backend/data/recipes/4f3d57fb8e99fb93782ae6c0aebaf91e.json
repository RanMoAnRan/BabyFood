  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将烤箱预热至 350 华氏度（175 摄氏度）。在 10x15 英寸的果冻卷盘上涂上油脂并撒上面粉。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "制作蛋糕：将面粉、糖、小苏打和盐放入搅拌碗中混合。加入酸奶油和鸡蛋。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在平底锅中用小火融化黄油。加入水和可可粉搅拌。将混合物煮沸，然后离火。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "稍微冷却，然后将可可混合物搅拌到面粉和鸡蛋混合物中直至混合。将面糊倒入准备好的平底锅中。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "在预热的烤箱中烘烤约 20 分钟，直至插入中心的牙签拔出时是干净的。烘烤蛋糕时，制作糖霜：将牛奶、可可粉和黄油放入大平底锅中，用中火混合。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "煮沸，然后离火。加入糖果搅拌均匀。糖和香草精，然后拌入核桃，搅拌直至混合。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "在热蛋糕上撒上糖霜。"
    },
    {
      "step_index": 9,
      "img": "",
      "text": "上菜并享用！"
    }
  ],
