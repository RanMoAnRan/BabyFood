  "title": "辣切奶酪三明治",
  "min_age_month": 12,
  "tags": [
    "Dinner",
    "Lunch",
    "U.S."
  ],
  "difficulty": 1,
  "time_cost": 25,
  "cover_image": "images/c34fb558a3c20b2147891cd4407cb441.webp",
  "nutrition_tip": "切碎奶酪三明治起源于纽约，但这个版本很辣……",
  "ingredients": [
    {
      "name": "1 汤匙黄油",
      "amount": ""
    },
    {
      "name": "0.25 杯切碎的洋葱",
      "amount": ""
    },
    {
      "name": "12 盎司瘦碎牛肉",
      "amount": ""
    },
    {
      "name": "1汤匙是拉差酱",
      "amount": ""
    },
    {
      "name": "盐和现磨黑胡椒粉适量",
      "amount": ""
    },
    {
      "name": "3 片美国奶酪",
      "amount": ""
    },
    {
      "name": "2 个三明治面包，切开并烘烤",
      "amount": ""
    },
    {
      "name": "1 杯生菜丝",
      "amount": ""
    },
    {
      "name": "1 个罗马番茄，切成薄片",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "在小煎锅中用中高火融化黄油。加入洋葱，煮约 5 分钟，直至洋葱变软并开始焦糖化。从火上移开并放在一边。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将碎牛肉和是拉差酱放入一个大碗中；充分搅拌直至是拉差均匀分布。将混合物制成两个薄饼，用盐和胡椒调味。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "用中高火加热一个大铸铁煎锅。加入汉堡肉饼，煮 5 分钟或直至底部形成硬皮。将肉饼翻面，煮 3 分钟。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "使用宽抹刀将肉饼分成大块。将煮熟的洋葱撒在汉堡块之间。将奶酪铺在上面，煮 2 分钟或直至奶酪融化。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将汉堡和奶酪混合物均匀地分布在烤三明治卷之间。在上面放上生菜丝和番茄片。"
    }
  ],
