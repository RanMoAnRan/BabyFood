  "title": "坎贝尔金枪鱼面砂锅",
  "min_age_month": 8,
  "tags": [
    "Dinner",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 45,
  "cover_image": "images/9d3ec392858deaec1be3ab735ef329c1.webp",
  "nutrition_tip": "这个金枪鱼面砂锅菜用蘑菇汤为奶油酱增添风味……",
  "ingredients": [
    {
      "name": "4 杯热熟中等鸡蛋面",
      "amount": ""
    },
    {
      "name": "2 罐（10.5 盎司）Campbell's® 浓缩奶油蘑菇汤（普通或 25% 低钠）",
      "amount": ""
    },
    {
      "name": "2 罐（10 盎司）金枪鱼罐头，沥干",
      "amount": ""
    },
    {
      "name": "2 杯冷冻豌豆",
      "amount": ""
    },
    {
      "name": "1 杯牛奶",
      "amount": ""
    },
    {
      "name": "2 汤匙干面包屑",
      "amount": ""
    },
    {
      "name": "1 汤匙黄油，融化",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料并将烤箱预热至 400 华氏度（200 摄氏度）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将煮熟的面条、浓缩汤、金枪鱼、豌豆和牛奶放入 3 夸脱的砂锅中搅拌。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "入预热好的烤箱烤至热，约30分钟；搅拌均匀。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将面包屑与融化的黄油在碗中混合；撒在金枪鱼砂锅上，继续烘烤 5 分钟，直至面包屑呈金黄色酥脆。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "上菜并享用！"
    }
  ],
