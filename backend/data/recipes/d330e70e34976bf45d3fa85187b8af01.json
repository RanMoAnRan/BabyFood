  "ingredients": [
    {
      "name": "6 个大鸡蛋，打散",
      "amount": ""
    },
    {
      "name": "2 茶匙磨碎的酸橙皮",
      "amount": ""
    },
    {
      "name": "3 罐（14 盎司）甜炼乳",
      "amount": ""
    },
    {
      "name": "0.75 杯罐装淡奶",
      "amount": ""
    },
    {
      "name": "1.5 杯朗姆酒",
      "amount": ""
    },
    {
      "name": "1 汤匙芳香苦味酒",
      "amount": ""
    },
    {
      "name": "1 撮新鲜磨碎的肉豆蔻",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将鸡蛋和酸橙皮放入一个大碗中，用电动搅拌机搅拌至松软。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "逐渐倒入炼乳，同时继续搅拌，然后倒入淡奶。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "拌入朗姆酒和苦精酒，撒上肉豆蔻。装入瓶中并冷藏至少 1 小时，然后享用。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "与碎冰一起食用。"
    }
  ],
