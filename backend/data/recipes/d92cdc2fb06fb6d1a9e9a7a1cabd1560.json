  "nutrition_tip": "墨西哥热巧克力是通过融化含有糖和……的墨西哥巧克力制成的。",
  "ingredients": [
    {
      "name": "1 杯全脂牛奶",
      "amount": ""
    },
    {
      "name": "0.5 片墨西哥热巧克力饮料片（例如 Nestle® Abuelita®）",
      "amount": ""
    },
    {
      "name": "1 颗干红辣椒，轻微烘烤",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将牛奶和巧克力放入小锅中，用中低火煮，搅拌，直到巧克力融化但不沸腾，大约 5 分钟。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将巧克力混合物倒入搅拌机中。用隔热垫盖住盖子；搅拌直至形成泡沫。倒入杯子中。将辣椒切成 2 或 3 块，去掉种子，然后放入热巧克力中。立即饮用。"
    }
  ],
