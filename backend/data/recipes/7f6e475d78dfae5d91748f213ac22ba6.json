  "nutrition_tip": "碎牛肉是一道经典的军菜，用厚厚的奶油干牛肉制成……",
  "ingredients": [
    {
      "name": "2 汤匙黄油",
      "amount": ""
    },
    {
      "name": "2 汤匙通用面粉",
      "amount": ""
    },
    {
      "name": "1.5 杯热牛奶",
      "amount": ""
    },
    {
      "name": "1罐（8盎司）干牛肉，切碎",
      "amount": ""
    },
    {
      "name": "1 撮辣椒",
      "amount": ""
    },
    {
      "name": "面包，烤的",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在中型平底锅中用小火融化黄油。加入面粉，搅拌至光滑。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "一次添加一点牛奶，每次添加后搅拌均匀。用中高火煮沸，边搅拌边煮，直至变稠。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "拌入牛肉和辣椒；煮至热透。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "搭配吐司一起食用。"
    }
  ],
