  "title": "我妈妈的雪碧饼干",
  "min_age_month": 12,
  "tags": [
    "Dessert",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 30,
  "cover_image": "images/d834c3f04d78ed0c22d5532e78294c0b.webp",
  "nutrition_tip": "这个喷雾饼干食谱可以制作出美丽的甜黄油压饼干。而且，…",
  "ingredients": [
    {
      "name": "1 杯无盐黄油，软化",
      "amount": ""
    },
    {
      "name": "0.5 杯白糖",
      "amount": ""
    },
    {
      "name": "2 个蛋黄",
      "amount": ""
    },
    {
      "name": "0.5 茶匙香草精",
      "amount": ""
    },
    {
      "name": "2.25 杯通用面粉",
      "amount": ""
    },
    {
      "name": "0.5 茶匙泡打粉",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 400 华氏度（200 摄氏度）。在 2 个烤盘上铺上羊皮纸。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将黄油和糖放入碗中。用电动搅拌机搅拌直至呈奶油状。加入蛋黄和香草精。混合直至充分混合。加入面粉和发酵粉。如果面团没有粘在一起，请用手完成混合。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将面团放入压饼机中，然后将喷洒形状的饼干压到准备好的烤盘上。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在预热的烤箱中烘烤 8 到 10 分钟，直至饼干呈浅棕色。在烤盘上短暂冷却；装饰前小心地转移到金属架上完全冷却。"
    }
  ],
