{
  "id": "24e57fcf04cec838f809933daca1c833",
  "title": "蜜饯山核桃",
  "min_age_month": 12,
  "tags": [
    "Snack",
    "American",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 50,
  "cover_image": "images/5b302ce90c4dc12afa2d1cfa0001feca.webp",
  "nutrition_tip": "蜜饯山核桃是一种简单的在家制作的节日礼物。用甜肉桂烘烤……",
  "ingredients": [
    {
      "name": "0.333 杯白糖，或更多适量",
      "amount": ""
    },
    {
      "name": "1 茶匙肉桂粉",
      "amount": ""
    },
    {
      "name": "0.25 茶匙盐，或更多调味",
      "amount": ""
    },
    {
      "name": "1 个大蛋白",
      "amount": ""
    },
    {
      "name": "1 汤匙水",
      "amount": ""
    },
    {
      "name": "1 磅山核桃半块",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。将烤箱预热至 250 华氏度（120 摄氏度）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将糖、肉桂和盐放入一个小碗中混合。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在一个大碗中将蛋白和水一起搅拌直至起泡。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将山核桃放入蛋清混合物中，裹上一层。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "慢慢倒入糖混合物并搅拌直至山核桃均匀地涂上一层。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "铺在烤盘上。"
    },
    {
      "step_index": 7,
      "img": "",
      "text": "在预热好的烤箱中烘烤10分钟。搅拌山核桃并重新排列成单层。继续煮，每 10 到 15 分钟搅拌一次，直到山核桃均匀变成棕色，再煮 30 到 50 分钟。"
    },
    {
      "step_index": 8,
      "img": "",
      "text": "上菜并享用！"
    }
  ],
