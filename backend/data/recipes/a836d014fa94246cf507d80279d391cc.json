  "cover_image": "images/24d2d90aa4e0bc78cdef91a86267b442.webp",
  "nutrition_tip": "这个希腊蜂蜜蛋糕配方可以制作出非常湿润的蛋糕，里面充满了橙子和……",
  "ingredients": [
    {
      "name": "1 杯蜂蜜",
      "amount": ""
    },
    {
      "name": "0.75 杯白糖",
      "amount": ""
    },
    {
      "name": "0.75 杯水",
      "amount": ""
    },
    {
      "name": "1 茶匙柠檬汁",
      "amount": ""
    },
    {
      "name": "1 杯通用面粉",
      "amount": ""
    },
    {
      "name": "1.5 茶匙泡打粉",
      "amount": ""
    },
    {
      "name": "1 茶匙橙皮碎",
      "amount": ""
    },
    {
      "name": "0.5 茶匙肉桂粉",
      "amount": ""
    },
    {
      "name": "0.25 茶匙盐",
      "amount": ""
    },
    {
      "name": "0.75 杯黄油",
      "amount": ""
    },
    {
      "name": "3 个鸡蛋",
      "amount": ""
    },
    {
      "name": "0.25 杯牛奶",
      "amount": ""
    },
    {
      "name": "1 杯碎核桃",
      "amount": ""
