{
  "id": "b5fecb30320c51f2c50f244a36a08858",
  "title": "肯塔基波旁球",
  "min_age_month": 8,
  "tags": [
    "Dessert",
    "Candy",
    "Southern",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 990,
  "cover_image": "images/dddd6a923dd4f97ce5cd2cfac85b05b2.webp",
  "nutrition_tip": "这些波本球是用肯塔基州波本浸泡坚果与黄油混合制成的......",
  "ingredients": [
    {
      "name": "1 杯碎坚果",
      "amount": ""
    },
    {
      "name": "5 汤匙肯塔基波本威士忌",
      "amount": ""
    },
    {
      "name": "1 包（16 盎司）糖果糖",
      "amount": ""
    },
    {
      "name": "0.5 杯黄油，软化",
      "amount": ""
    },
    {
      "name": "蜡纸",
      "amount": ""
    },
    {
      "name": "18 盎司半甜巧克力",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将螺母放入可密封的罐子中。将波本威士忌倒在坚果上；密封并浸泡 8 小时至过夜。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在一个中等大小的碗中混合糖和黄油；将浸泡过的坚果与波本威士忌拌匀。将混合物制成 3/4 英寸的球并冷藏 8 小时至过夜。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在烤盘上铺上蜡纸；放在一边。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将巧克力放在双层锅炉的顶部，在刚刚沸腾的水中融化，经常搅拌，并用橡皮刮刀刮掉侧面，以免烧焦。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "在融化的巧克力中滚球以涂上涂层；排列在准备好的托盘上。存放在冰箱中直至食用。"
    }
  ],
