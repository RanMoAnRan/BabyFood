{
  "id": "7ab0abf15c3c375a67056332837d1ee3",
  "title": "柑橘沙拉配柠檬酸奶",
  "min_age_month": 8,
  "tags": [],
  "difficulty": 1,
  "time_cost": 0,
  "cover_image": "images/ee1ccacf5b9141151b3927cb08e0e2fe.webp",
  "nutrition_tip": "用这道甜美健康的水果沙拉结束您的用餐。",
  "ingredients": [],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "在切菜板上，切掉橙子和葡萄柚的顶部和底部，使每块水果都有两个平坦的末端。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将水果放在一个平坦的一端，小心地从上到下切掉果皮和果核。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "去除果皮后，将水果切碎。切得越少，水果中保留的汁液就越多。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将葡萄减半。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将水果放入碗中并冷藏直至完全冷却，大约需要 2 小时。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "在酸奶中添加蜂蜜。食用前将混合物淋在水果上。"
    }
  ],
  "warnings": [],
