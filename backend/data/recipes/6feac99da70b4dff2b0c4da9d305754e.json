  ],
  "difficulty": 1,
  "time_cost": 60,
  "cover_image": "images/9f0e702e0c24778b410ee5330ab80203.webp",
  "nutrition_tip": "这个料理鼠王食谱配有成熟的夏季西红柿、西葫芦、茄子和铃铛……",
  "ingredients": [
    {
      "name": "2汤匙橄榄油，分开",
      "amount": ""
    },
    {
      "name": "3 瓣大蒜，切碎",
      "amount": ""
    },
    {
      "name": "1 个茄子，切成 1/2 英寸的方块",
      "amount": ""
    },
    {
      "name": "2 茶匙干欧芹",
      "amount": ""
    },
    {
      "name": "加盐调味",
      "amount": ""
    },
    {
      "name": "1 杯磨碎的帕尔马干酪",
      "amount": ""
    },
    {
      "name": "2 个西葫芦，切片",
      "amount": ""
    },
    {
      "name": "2 个大西红柿，切碎",
      "amount": ""
    },
    {
      "name": "2 杯新鲜蘑菇片",
      "amount": ""
    },
    {
      "name": "1 个大洋葱，切成圈",
      "amount": ""
    },
    {
      "name": "1 个青椒，切片",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将烤箱预热至 350 华氏度（175 摄氏度）。在 1 ½ 夸脱的砂锅菜的底部和侧面涂上 1 汤匙橄榄油。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "在中型煎锅中用中火加热剩余的 1 汤匙橄榄油。煮并搅拌大蒜直至散发出香味并呈金黄色。加入茄子和欧芹；煮约10分钟，搅拌直至茄子变软。加盐调味。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将茄子混合物均匀地铺在准备好的砂锅底部；撒上几汤匙帕尔马干酪。将西葫芦均匀地铺在上面。撒上少许盐，再撒上一点奶酪。继续以这种方式分层，加入西红柿、蘑菇、洋葱和甜椒，在每一层上撒上盐和奶酪。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "在预热的烤箱中烘烤约 45 分钟，直至蔬菜变软。"
    }
  ],
