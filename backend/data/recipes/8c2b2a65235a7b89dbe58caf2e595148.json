  "nutrition_tip": "这个土蛋糕食谱是一种最喜欢的、简单的、免烘烤的甜点，由多层咖啡制成……",
  "ingredients": [
    {
      "name": "32 盎司奶油夹心巧克力夹心饼干",
      "amount": ""
    },
    {
      "name": "1 包（8 盎司）奶油干酪，软化",
      "amount": ""
    },
    {
      "name": "0.5 杯黄油，软化",
      "amount": ""
    },
    {
      "name": "0.5 杯糖果糖",
      "amount": ""
    },
    {
      "name": "3.5 杯牛奶",
      "amount": ""
    },
    {
      "name": "1 个（12 盎司）容器冷冻搅打配料，解冻",
      "amount": ""
    },
    {
      "name": "2 包（3.5 盎司）即食香草布丁混合物",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "在食品加工机中精细粉碎巧克力饼干；将面包屑放在一边。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将奶油奶酪、黄油和糖粉放入一个大碗中；用电动搅拌机搅拌至光滑。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将牛奶、搅打过的配料和布丁放在一个单独的大碗中搅拌；拌入奶油干酪混合物直至充分混合。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将压碎的饼干和布丁混合物交替放入一个中等花盆中，以饼干开始和结束。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "将泥土蛋糕放入冰箱冷藏直至可以食用；根据需要装饰。享受！"
    }
  ],
