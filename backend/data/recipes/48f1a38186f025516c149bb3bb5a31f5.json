{
  "id": "48f1a38186f025516c149bb3bb5a31f5",
  "title": "软糖饼干",
  "min_age_month": 12,
  "tags": [
    "Dessert",
    "American",
    "publisher-tested"
  ],
  "difficulty": 1,
  "time_cost": 25,
  "cover_image": "images/771cf275e055b0225dd15a02daf1dcad.webp",
  "nutrition_tip": "这种软糖曲奇食谱制作起来又快又容易。使用任何颜色的糖...",
  "ingredients": [
    {
      "name": "0.333 杯彩色装饰糖",
      "amount": ""
    },
    {
      "name": "0.66666668653488 罩杯缩短",
      "amount": ""
    },
    {
      "name": "0.66666668653488 杯无盐黄油，软化",
      "amount": ""
    },
    {
      "name": "1.5 杯白糖",
      "amount": ""
    },
    {
      "name": "2 个大鸡蛋",
      "amount": ""
    },
    {
      "name": "2 茶匙香草精",
      "amount": ""
    },
    {
      "name": "3.5 杯通用面粉",
      "amount": ""
    },
    {
      "name": "2 茶匙泡打粉",
      "amount": ""
    },
    {
      "name": "1 茶匙盐",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "收集所有原料并将烤箱预热至 350 华氏度（175 摄氏度）。将装饰糖放入一个小碗中（或使用多种颜色和单独的碗）。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "将起酥油和黄油放入立式搅拌机的碗中，搅拌 2 到 3 分钟，直至光滑且呈奶油状。加入糖直至混合，然后加入鸡蛋，一次一个，必要时刮擦碗的侧面。加入香草精混合。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "在一个中等大小的碗中搅拌面粉、泡打粉和盐直至混合。逐渐添加到湿成分中并混合直至合并并且面团混合在一起。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将面团擀成核桃大小的球。将每个球滚上糖衣，然后将其间隔 2 英寸放在未抹油的饼干片上。"
    },
    {
      "step_index": 5,
      "img": "",
      "text": "在预热的烤箱中烘烤 10 到 12 分钟，直至底部呈浅棕色，中途更换架子。从烤箱中取出并转移到金属架上冷却。"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "享受吧！"
    }
  ],
