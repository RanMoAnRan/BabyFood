<view class="custom-nav" style="height: {{navHeight}}px;">
  <view class="custom-nav-box" style="top: {{navCapsuleTop}}px; height: {{navCapsuleHeight}}px;">
    <view class="custom-nav-title">全部辅食</view>
  </view>
</view>
<view class="nav-placeholder" style="height: {{navHeight}}px;"></view>

<view class="container safe-tabbar">
  <view class="filters card" style="top: {{navHeight}}px;">
    <view class="filters-row">
      <view class="filters-search" bindtap="onGoSearch">
        <icon class="search-icon" type="search" size="18" color="#94A3B8"></icon>
        <view class="search-input {{query ? '' : 'search-placeholder'}}">
          {{query || '搜索菜名/食材'}}
        </view>
        <view class="search-btn" catchtap="onGoSearch">搜索</view>
      </view>
      <view class="filters-sort" bindtap="onShowSortMenu">
        <text>{{sortLabel || '排序'}}</text>
        <view class="sort-triangle"></view>
      </view>
    </view>

    <scroll-view class="chips" scroll-x="true" enhanced show-scrollbar="{{false}}">
      <view
        class="chip {{activeTag === '' ? 'chip-active' : ''}}"
        hover-class="chip-hover"
        data-tag=""
        bindtap="onTagTap"
      >全部</view>
      <view
        wx:for="{{tagOptions}}"
        wx:key="*this"
        class="chip {{activeTag === item ? 'chip-active' : ''}}"
        hover-class="chip-hover"
        data-tag="{{item}}"
        bindtap="onTagTap"
      >
        {{item}}
      </view>
    </scroll-view>
  </view>

  <view class="meta muted">
    已显示 {{filtered.length}} / {{totalCount}}
  </view>

  <view class="grid">
    <view class="col">
      <view
        wx:for="{{left}}"
        wx:key="id"
        class="item card"
        hover-class="card-hover"
        data-id="{{item.id}}"
        bindtap="onOpenDetail"
      >
        <image
          class="img"
          mode="aspectFill"
          src="{{item.cover_image || defaultCover}}"
          lazy-load="true"
          binderror="onCoverError"
          data-id="{{item.id}}"
        ></image>
        <view class="body">
          <view class="title">{{item.title}}</view>
          <view class="row">
            <text class="tag">{{item.min_age_month}}m+</text>
            <text class="muted">{{item.time_cost}}分钟</text>
          </view>
        </view>
      </view>
    </view>

    <view class="col">
      <view
        wx:for="{{right}}"
        wx:key="id"
        class="item card"
        hover-class="card-hover"
        data-id="{{item.id}}"
        bindtap="onOpenDetail"
      >
        <image
          class="img"
          mode="aspectFill"
          src="{{item.cover_image || defaultCover}}"
          lazy-load="true"
          binderror="onCoverError"
          data-id="{{item.id}}"
        ></image>
        <view class="body">
          <view class="title">{{item.title}}</view>
          <view class="row">
            <text class="tag">{{item.min_age_month}}m+</text>
            <text class="muted">{{item.time_cost}}分钟</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{filtered.length === 0}}" class="empty muted">没有匹配的辅食</view>

  <view wx:if="{{filtered.length > 0 && hasMore}}" class="load muted">下拉加载更多…</view>
  <view wx:if="{{filtered.length > 0 && !hasMore}}" class="load muted">没有更多了</view>

  <view class="back-top {{showBackTop ? 'back-top-show' : ''}}" bindtap="onBackTop">
    <view class="arrow-up"></view>
  </view>
</view>
