@import "../../app.wxss";

.filters {
  position: sticky;
  top: 0;
  z-index: 10;
  margin: -24rpx -24rpx 20rpx -24rpx;
  padding: 24rpx 24rpx 24rpx 24rpx;
  background: rgba(255, 255, 255, 0.88);
  backdrop-filter: blur(30rpx);
  -webkit-backdrop-filter: blur(30rpx);
  border-radius: 0 0 28rpx 28rpx;
  border-bottom: 1rpx solid rgba(15, 23, 42, 0.05);
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.03);
  transition: none !important;
  transform: none !important;
}

.filters-row {
  padding: 0 4rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.filters-search {
  flex: 1;
  background: #F8FAFC;
  border-radius: 999rpx;
  padding: 10rpx 12rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  border: 2rpx solid #F1F5F9;
}

.filters-sort {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #64748B;
  padding: 10rpx 20rpx;
  background: #F8FAFC;
  border-radius: 999rpx;
  border: 2rpx solid #F1F5F9;
}

.sort-triangle {
  width: 0;
  height: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-top: 10rpx solid #94A3B8;
}

.search-icon {
  margin-left: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #334155;
}

.search-placeholder {
  color: #94A3B8;
}

.search-btn {
  padding: 8rpx 24rpx;
  background: #F97316;
  color: #ffffff;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.chips {
  margin-top: 24rpx;
  white-space: nowrap;
  width: 100%;
}

.chips::-webkit-scrollbar {
  display: none;
}

.chip {
  display: inline-block;
  padding: 12rpx 28rpx;
  background: #F1F5F9;
  color: #64748B;
  border-radius: 999rpx;
  font-size: 26rpx;
  margin-right: 16rpx;
  font-weight: 600;
  transition: all 0.15s ease;
}

.chip-active {
  background: #FFF7ED;
  color: #F97316;
  font-weight: 700;
  border: 2rpx solid rgba(249, 115, 22, 0.2);
}

.chip-hover {
  opacity: 0.8;
}

.meta {
  margin-bottom: 20rpx;
  padding: 0 8rpx;
  font-size: 24rpx;
}

.grid {
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
}

.col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.item {
  padding: 0;
  border-radius: 20rpx;
}

.img {
  width: 100%;
  height: 200rpx;
  background: #f0f0f0;
}

.body {
  padding: 16rpx 20rpx;
}

.title {
  font-size: 30rpx;
  line-height: 1.4;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.empty {
  text-align: center;
  padding: 100rpx 0;
}

.load {
  text-align: center;
  padding: 30rpx;
  font-size: 24rpx;
}

.back-top {
  position: fixed;
  right: 32rpx;
  bottom: calc(160rpx + env(safe-area-inset-bottom));
  width: 88rpx;
  height: 88rpx;
  background: rgba(255, 255, 255, 0.96);
  border-radius: 50%;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  opacity: 0;
  transform: translateY(20rpx);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  pointer-events: none;
  border: 1rpx solid rgba(15, 23, 42, 0.06);
}

.back-top-show {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

.arrow-up {
  width: 0;
  height: 0;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-bottom: 14rpx solid #64748B;
  transform: translateY(-2rpx);
}