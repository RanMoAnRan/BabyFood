.block {
  padding: 28rpx;
  margin-bottom: 22rpx;
}

.block-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #0F172A;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
}

.block-title::before {
  content: '';
  display: block;
  width: 8rpx;
  height: 32rpx;
  background: #F97316;
  border-radius: 4rpx;
  margin-right: 16rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx dashed rgba(15, 23, 42, 0.12);
}

.row:last-child {
  border-bottom: none;
}

.picker {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(15, 23, 42, 0.04);
  border: 2rpx solid rgba(15, 23, 42, 0.08);
  color: #0F172A;
  font-weight: 700;
}

.btn-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.note {
  margin-top: 16rpx;
  font-size: 24rpx;
}

.about-block {
  margin-top: 24rpx;
  margin-bottom: 120rpx;
}
