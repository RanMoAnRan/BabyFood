.block-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #0F172A;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
}

.block-title::before {
  content: '';
  display: block;
  width: 8rpx;
  height: 32rpx;
  background: #F97316;
  border-radius: 4rpx;
  margin-right: 16rpx;
}

.fav-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.fav-header .block-title {
  margin-bottom: 0;
  flex: 1;
}

.fav-actions {
  display: flex;
  align-items: center;
  gap: 6rpx;
  justify-content: flex-end;
}

.select-all {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.select-text {
  font-size: 26rpx;
  color: #64748B;
}

.del-selected {
  flex: 0 0 130rpx;
  font-size: 24rpx;
  width: 130rpx;
  padding: 8rpx 0;
  line-height: 1.2;
  border-radius: 999rpx;
  text-align: center;
  margin-left: 100rpx;
}

.del-selected[disabled] {
  color: #CBD5E1;
  border-color: rgba(203, 213, 225, 0.7);
}

.select-box {
  width: 110rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.check {
  width: 34rpx;
  height: 34rpx;
  border-radius: 999rpx;
  border: 2rpx solid #CBD5E1;
  background: #FFFFFF;
  position: relative;
}

.check-active {
  border-color: #F97316;
  background: #F97316;
}

.check-active::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 12rpx;
  height: 20rpx;
  border-right: 4rpx solid #FFFFFF;
  border-bottom: 4rpx solid #FFFFFF;
  transform: translate(-50%, -60%) rotate(45deg);
}

.reco-card {
  margin-top: 12rpx;
  margin-left: -24rpx;
  margin-right: -24rpx;
  padding: 12rpx 24rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  overflow: hidden;
  border-radius: 0;
}

.reco-main {
  flex: 1;
  display: flex;
  align-items: center;
}

.reco-img {
  width: 200rpx;
  height: 200rpx;
  background: rgba(0, 0, 0, 0.04);
  flex-shrink: 0;
  border-radius: 16rpx;
  margin-left: 15rpx;
}

.reco-body {
  padding: 16rpx 20rpx;
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.reco-title {
  font-size: 32rpx;
  line-height: 1.25;
  display: -webkit-box;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.reco-chips {
  margin-top: 8rpx;
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.reco-chip {
  font-size: 24rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.04);
  color: #555;
}

.reco-bottom {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.reco-meta {
  display: flex;
  gap: 12rpx;
  align-items: center;
  flex-wrap: wrap;
}

.reco-del {
  font-size: 24rpx;
  width: 150rpx;
  padding: 10rpx 0;
  line-height: 1.2;
  border-radius: 999rpx;
  color: #EF4444;
  border-color: rgba(239, 68, 68, 0.35);
  text-align: center;
}
