  "nutrition_tip": "汉堡肉、加工奶酪、洋葱、土豆和牛奶混合在一起……",
  "ingredients": [
    {
      "name": "2 磅碎牛肉",
      "amount": ""
    },
    {
      "name": "2 罐（15 盎司）新土豆丁",
      "amount": ""
    },
    {
      "name": "1 杯切碎的洋葱",
      "amount": ""
    },
    {
      "name": "4 杯牛奶",
      "amount": ""
    },
    {
      "name": "1 磅加工奶酪食品（例如 Velveeta ®），切成块",
      "amount": ""
    },
    {
      "name": "0.5 磅切达干酪，切成块",
      "amount": ""
    },
    {
      "name": "黑胡椒粉适量",
      "amount": ""
    },
