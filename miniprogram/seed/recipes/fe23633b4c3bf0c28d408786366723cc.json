  "nutrition_tip": "商店购买的新鲜或冷冻奶酪馄饨上面放着甜甜的自制泵……",
  "ingredients": [
    {
      "name": "2 杯鸡汤",
      "amount": ""
    },
    {
      "name": "1 罐（15 盎司）南瓜泥",
      "amount": ""
    },
    {
      "name": "0.25 杯牛奶",
      "amount": ""
    },
    {
      "name": "2 汤匙红糖",
      "amount": ""
    },
    {
      "name": "2汤匙白糖",
      "amount": ""
    },
    {
      "name": "2 汤匙黄油",
      "amount": ""
    },
    {
      "name": "0.5 茶匙姜末",
      "amount": ""
    },
    {
      "name": "0.5 茶匙肉桂粉",
      "amount": ""
    },
    {
      "name": "0.125 茶匙丁香粉",
      "amount": ""
    },
    {
      "name": "0.125 茶匙肉豆蔻",
      "amount": ""
    },
    {
      "name": "1 包（30 盎司）奶酪馄饨",
      "amount": ""
    },
    {
      "name": "0.33333334326744 杯磨碎的帕尔马干酪",
      "amount": ""
    }
