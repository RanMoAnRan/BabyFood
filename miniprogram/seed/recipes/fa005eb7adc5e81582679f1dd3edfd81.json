  "id": "fa005eb7adc5e81582679f1dd3edfd81",
  "title": "焦糖胡桃南瓜汤",
  "min_age_month": 6,
  "tags": [
    "Lunch",
    "American"
  ],
  "difficulty": 1,
  "time_cost": 50,
  "cover_image": "images/51c1e7fe553902826f4608e028773340.webp",
  "nutrition_tip": "焦糖胡桃南瓜汤配方包括甜蜂蜜和少许坚果……",
  "ingredients": [
    {
      "name": "3 汤匙 特级初榨橄榄油",
      "amount": ""
    },
    {
      "name": "3 磅胡桃南瓜，去皮并切块",
      "amount": ""
    },
    {
      "name": "1 个大洋葱，切片",
      "amount": ""
    },
    {
      "name": "3 汤匙黄油",
      "amount": ""
    },
    {
      "name": "1 汤匙海盐",
      "amount": ""
    },
    {
      "name": "1 茶匙新鲜白胡椒",
      "amount": ""
    },
    {
      "name": "4 杯鸡汤，或根据需要更多",
      "amount": ""
    },
    {
      "name": "0.25 杯蜂蜜",
      "amount": ""
    },
    {
      "name": "0.5 杯浓奶油",
      "amount": ""
    },
    {
      "name": "1 撮肉豆蔻粉，或更多适量",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "在一个大锅中用高火加热橄榄油。添加南瓜；煮约 10 分钟，搅拌直至完全变成棕色。加入洋葱、黄油、1汤匙海盐和1茶匙白胡椒；煮约 10 分钟，搅拌直至洋葱完全变软并开始变成棕色。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "加入鸡汤和蜂蜜；煮沸。将热量降至中低；煮约5分钟，直至南瓜变软。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将搅拌机倒入一半汤。用隔热垫盖住盖子；在继续混合之前脉冲几次。倒入锅中。对剩下的汤重复上述步骤。"
    },
    {
      "step_index": 4,
      "img": "",
      "text": "将奶油和肉豆蔻放入汤泥中搅拌直至充分混合；用海盐和白胡椒调味。"
    }
  ],
