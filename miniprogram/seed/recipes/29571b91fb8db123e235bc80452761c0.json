      "amount": ""
    },
    {
      "name": "1 cup tequila",
      "amount": ""
    },
    {
      "name": "0.5 cup white sugar",
      "amount": ""
    },
    {
      "name": "0.25 cup orange-flavored liqueur (such as Cointreau)",
      "amount": ""
    },
    {
      "name": "0.25 teaspoon kosher salt",
      "amount": ""
    },
    {
      "name": "3 cups ice, or as needed",
      "amount": ""
    },
    {
      "name": "6 slices lime",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "Gather all ingredients."
    },
    {
      "step_index": 2,
      "img": "",
      "text": "Cut limes into quarters; remove and discard the center part of the rinds. Blend until completely smooth, about 1 minute."
    },
    {
      "step_index": 3,
      "img": "",
      "text": "Transfer lime quarters to a blender with cold water, tequila, sugar, orange-flavored liqueur, and salt."
    },
    {
      "step_index": 4,
      "img": "",
      "text": "Blend until completely smooth, about 1 minute."
    },
    {
      "step_index": 5,
      "img": "",
      "text": "Strain mixture into a large measuring cup or small pitcher"
    },
    {
      "step_index": 6,
      "img": "",
      "text": "Serve over ice and garnish with lime slices."
    }
  ],
