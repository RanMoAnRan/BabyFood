  "ingredients": [
    {
      "name": "3 tablespoons butter",
      "amount": ""
    },
    {
      "name": "0.5 cup finely diced onion",
      "amount": ""
    },
    {
      "name": "0.5 cup chopped green bell pepper",
      "amount": ""
    },
    {
      "name": "0.5 cup chopped celery",
      "amount": ""
    },
    {
