    "American"
  ],
  "difficulty": 1,
  "time_cost": 40,
  "cover_image": "images/fd667b8fcf1f0aefef43a2f2adbaa9c8.webp",
  "nutrition_tip": "Make your own corn dogs using beef frankfurters skewered on sticks, dipped in co…",
  "ingredients": [
    {
      "name": "1 cup yellow cornmeal",
      "amount": ""
    },
    {
      "name": "1 cup all-purpose flour",
      "amount": ""
    },
    {
      "name": "0.25 cup white sugar",
      "amount": ""
    },
    {
      "name": "4 teaspoons baking powder",
      "amount": ""
    },
    {
      "name": "0.25 teaspoon salt",
      "amount": ""
    },
    {
      "name": "0.125 teaspoon black pepper",
      "amount": ""
    },
    {
      "name": "1 cup milk",
      "amount": ""
    },
    {
      "name": "1 egg",
      "amount": ""
    },
    {
      "name": "1 quart vegetable oil for frying",
      "amount": ""
    },
    {
      "name": "2 (16 ounce) packages beef frankfurters",
      "amount": ""
    },
    {
      "name": "16 wooden skewers",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "Gather all ingredients."
    },
    {
      "step_index": 2,
      "img": "",
      "text": "Combine cornmeal, flour, sugar, baking powder, salt, and pepper in a medium bowl; stir in milk and egg to make a batter."
    },
    {
      "step_index": 3,
      "img": "",
      "text": "Heat oil in a deep fryer or large saucepan to 375 degrees F (190 degrees C)."
    },
    {
      "step_index": 4,
      "img": "",
      "text": "Meanwhile, pat frankfurters dry and insert a skewer into each one."
    },
    {
      "step_index": 5,
      "img": "",
      "text": "Roll frankfurters in batter until well coated."
    },
    {
      "step_index": 6,
      "img": "",
      "text": "Fry 2 or 3 corn dogs at a time in preheated oil until lightly browned, about 3 minutes."
    },
    {
      "step_index": 7,
      "img": "",
      "text": "Drain on paper towels."
    },
    {
      "step_index": 8,
      "img": "",
      "text": "Serve and enjoy!"
    }
  ],
