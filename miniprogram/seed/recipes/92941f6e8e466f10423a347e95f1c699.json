  ],
  "difficulty": 1,
  "time_cost": 15,
  "cover_image": "images/15a81feb6db38de29caef141d77e5cb1.webp",
  "nutrition_tip": "将半个橡子南瓜涂上黄油和红糖，然后在烤箱中烘烤……",
  "ingredients": [
    {
      "name": "1 个橡子南瓜，切半并去籽",
      "amount": ""
    },
    {
      "name": "0.25 杯黄油，分开",
      "amount": ""
    },
    {
      "name": "0.25 杯包装红糖，分开",
      "amount": ""
    }
  ],
  "steps": [
    {
      "step_index": 1,
      "img": "",
      "text": "将南瓜切成两半，切面朝上，放在微波炉专用的盘子或盘子上。在每一半的空腔中放入2汤匙黄油和2汤匙红糖。"
    },
    {
      "step_index": 2,
      "img": "",
      "text": "用微波炉全功率加热 8 到 10 分钟，直至南瓜肉变软。将南瓜旋转大约两次，以确保均匀烹饪。"
    },
    {
      "step_index": 3,
      "img": "",
      "text": "将肉与糖和黄油一起舀入碗中；稍微捣碎混合。"
    }
  ],
